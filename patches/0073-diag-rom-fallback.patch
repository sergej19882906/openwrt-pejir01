@@ -34,6 +34,8 @@ msgstr "Данные STM32 через mcud: mcu getvolt / getsys / getver. Со
 "питания (pwroff/pr/paerr) видны в logread."
 msgid "Failed to run diagnostics: "
 msgstr "Не удалось выполнить диагностику: "
+msgid "unknown error"
+msgstr "неизвестная ошибка"
 msgid "USB, LTE and battery diagnostics (PEJIR01)"
 msgstr "Диагностика USB, LTE и батареи (PEJIR01)"
 msgid "Status summary: USB controller and connected devices, modem, LTE "
diff --git a/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json b/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json
index 636e8eb..1b4ade4 100644
--- a/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json
+++ b/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json
@@ -76,6 +76,9 @@
 				"/usr/libexec/perenio-diag": [
 					"exec"
 				],
+				"/rom/usr/libexec/perenio-diag": [
+					"exec"
+				],
 				"/usr/libexec/pejir-ussd": [
 					"exec"
 				],
