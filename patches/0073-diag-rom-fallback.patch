На устройстве корневая ФС - overlay, верхний слой лежит на флешке
extroot. Если файл helper'а оказался в верхнем слое (например, там
осталась копия от горячего фикса, скачанная wget'ом), exec отдаёт
EACCES, а rpcd - code 127. Страница показывала "(empty)", хотя
helper на месте и имел права 0755.

Копия в /rom лежит в squashfs образа, overlay её не перекрывает, и она
всегда исполняема. Страница теперь при неудаче основного пути
обращается к /rom/usr/libexec/perenio-diag, а если и он не отработал -
показывает ошибку вместо пустоты. В ACL добавлен грант exec на /rom.
---
 .../resources/view/perenio/diag.js            | 61 +++++++++++++++----
 .../po/ru/luci-app-perenio.po                 |  2 +
 .../share/rpcd/acl.d/luci-app-perenio.json    |  3 +
 3 files changed, 55 insertions(+), 11 deletions(-)

diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
index 5997383..8e2a4c4 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
@@ -17,19 +17,58 @@
    проблемы: аргументов нет, путь один и известный. */
 var DIAG = '/usr/libexec/perenio-diag';
 
+/* Запасной путь - неизменяемая копия образа в /rom.
+   На устройстве корневая ФС - overlay: верхний слой лежит на флешке
+   extroot. Если он смонтирован с noexec (или в верхнем слое осталась
+   "висящая" копия файла от горячего фикса), exec файла из объединённого
+   пути возвращает EACCES, а rpcd отдаёт code 127 - страница показывала
+   "(empty)", хотя helper на месте. Копия в /rom лежит в squashfs образа,
+   который не перекрывается overlay, и всегда исполняема. */
+var DIAG_ROM = '/rom/usr/libexec/perenio-diag';
+
+/* Запуск helper'а диагностики.
+   fs.exec в LuCI 25.12 возвращает объект {code, stdout, stderr}.
+   Считаем запуск удачным, только если код 0 и вывод непустой: пустой
+   stdout означает, что helper отработал вхолостую, и тогда есть смысл
+   попробовать запасной путь. */
+function runDiag(path) {
+	return fs.exec(path, []).then(function(r) {
+		var out = (r && r.stdout ? r.stdout : '');
+		var err = (r && r.stderr ? r.stderr : '');
+		var code = (r && typeof r.code !== 'undefined') ? r.code : 0;
+
+		if (code === 0 && out.length > 0)
+			return { ok: true, text: out + (err ? '\n' + err : '') };
+
+		return {
+			ok: false,
+			text: '',
+			err: (code !== 0 ? 'exit code ' + code : '') +
+				(err ? (code !== 0 ? ': ' : '') + err : (code !== 0 ? '' : 'empty output'))
+		};
+	}).catch(function(e) {
+		return {
+			ok: false,
+			text: '',
+			err: (e && e.message ? e.message : String(e || ''))
+		};
+	});
+}
+
 return view.extend({
 	load: function() {
-		/* fs.exec в LuCI 25.12 возвращает объект {code, stdout, stderr},
-		 * а не строку. Если принять его за текст, страница покажет
-		 * "[object Object]" вместо вывода диагностики. */
-		return fs.exec(DIAG, []).then(function(r) {
-			var out = (r && r.stdout ? r.stdout : '');
-			var err = (r && r.stderr ? r.stderr : '');
-
-			return [ out + (err ? '\n' + err : '') ];
-		}).catch(function(e) {
-			return [ _('Failed to run diagnostics: ') +
-				(e && e.message ? e.message : String(e || '')) ];
+		return runDiag(DIAG).then(function(r) {
+			if (r.ok)
+				return [ r.text ];
+
+			/* Основной путь не сработал - пробуем /rom. */
+			return runDiag(DIAG_ROM).then(function(r2) {
+				if (r2.ok)
+					return [ r2.text ];
+
+				return [ _('Failed to run diagnostics: ') +
+					(r2.err ? r2.err : r.err ? r.err : _('unknown error')) ];
+			});
 		});
 	},
 
diff --git a/package/luci-app-perenio/po/ru/luci-app-perenio.po b/package/luci-app-perenio/po/ru/luci-app-perenio.po
