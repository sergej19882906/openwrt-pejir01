diff --git a/target/linux/ramips/mt7621/base-files/etc/board.d/02_network b/target/linux/ramips/mt7621/base-files/etc/board.d/02_network
index 77b90a6..c97bc90 100644
--- a/target/linux/ramips/mt7621/base-files/etc/board.d/02_network
+++ b/target/linux/ramips/mt7621/base-files/etc/board.d/02_network
@@ -340,8 +340,11 @@ ramips_setup_macs()
 		;;
 	perenio,pejir01-34-BA)
 		local config="$(dd if=/dev/mtd$(find_mtd_index idata) bs=1 skip=19 count=474)"
-		wan_mac="$(echo "$config" | awk '/option mac_wan/{gsub("'''","");print $3}')"
-		lan_mac="$(echo "$config" | awk '/option mac_lan/{gsub("'''","");print $3}')"
+		# idata — это UCI-экспорт: option mac_wan 'AA:BB:CC:DD:EE:FF'.
+		# Кавычки снимаем со всей строки, а не по полям — так одинаково
+		# работает и со значением в кавычках, и без них.
+		wan_mac="$(echo "$config" | awk '/option mac_wan/{print $3}' | tr -d "'")"
+		lan_mac="$(echo "$config" | awk '/option mac_lan/{print $3}' | tr -d "'")"
 		label_mac=$lan_mac
 		;;
 	yuncore,ax820)
diff --git a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
index 02ef0c6..9436468 100644
--- a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
+++ b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
@@ -24,10 +24,40 @@ platform_check_image() {
 	return 0
 }
 
+# Perenio PEJIR01: ядро лежит в MTD-разделах kernel0/kernel1 (по 4 МиБ),
+# rootfs — в UBI. MTD-раздела "kernel" здесь нет, а U-Boot выбирает
+# активный слот A/B по переменной imgidx, значение которой нам неизвестно.
+# Поэтому новый kernel пишем в оба слота — ровно так же, как это делает
+# factory.bin. U-Boot env при этом не трогаем: если запись не удалась,
+# устройство всё равно загрузится со старым ядром из активного слота.
+perenio_do_upgrade() {
+	local tar_file="$1"
+	local cmd="${2:-cat}"
+	local board_dir part idx
+
+	board_dir="$($cmd < "$tar_file" | tar tf - | grep -m 1 '^sysupgrade-.*/$')"
+	board_dir="${board_dir%/}"
+
+	for part in kernel0 kernel1; do
+		idx="$(find_mtd_index "$part")"
+		[ -n "$idx" ] || continue
+		echo "writing kernel to $part"
+		$cmd < "$tar_file" | tar xOf - "$board_dir/kernel" | \
+			mtd write - "$part" || return 1
+	done
+
+	# rootfs уходит в UBI; kernel в UBI этому устройству не нужен
+	CI_KERNPART=none
+	nand_do_upgrade "$tar_file" "$cmd"
+}
+
 platform_do_upgrade() {
 	local board=$(board_name)
 
 	case "$board" in
+	perenio,pejir01-34-BA)
+		perenio_do_upgrade "$1"
+		;;
 	alfa-network,quad-e4g)
 		[ "$(fw_printenv -n dual_image 2>/dev/null)" = "1" ] &&\
 		[ -n "$(find_mtd_part backup)" ] && {
@@ -139,7 +169,6 @@ platform_do_upgrade() {
 	netgear,wax214v2|\
 	netis,n6|\
 	netis,wf2881|\
-	perenio,pejir01-34-BA|\
 	raisecom,msg1500-x-00|\
 	rostelecom,rt-fe-1a|\
 	rostelecom,rt-sf-1|\
