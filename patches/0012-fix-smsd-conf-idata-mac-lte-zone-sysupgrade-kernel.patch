diff --git a/package/pejir-sms/root/etc/smsd.conf b/package/pejir-sms/root/etc/smsd.conf
new file mode 100644
index 0000000..e4239dd
--- /dev/null
+++ b/package/pejir-sms/root/etc/smsd.conf
@@ -0,0 +1,24 @@
+# SMS Server Tools 3 — PEJIR01 / GM510
+# Конфиг по умолчанию. При первом запуске скрипт /etc/uci-defaults/41-pejir-sms
+# определяет AT-порт модема и перезаписывает файл целиком.
+devices = GM510
+loglevel = notice
+logfile = /var/log/smsd.log
+pidfile = /var/run/smsd.pid
+infofile = /var/run/smsd.working
+outgoing = /var/spool/sms/outgoing
+checked = /var/spool/sms/checked
+failed = /var/spool/sms/failed
+incoming = /var/spool/sms/incoming
+sent = /var/spool/sms/sent
+receive_before_send = no
+
+[GM510]
+device = /dev/ttyUSB0
+baudrate = 115200
+init = AT+CPMS="SM","SM","SM"
+init = AT+CMGF=1
+init = AT+CNMI=2,1,0,2,0
+incoming = yes
+outgoing = yes
+decode_unicode_text = yes
diff --git a/package/perenio-mcu/Makefile b/package/perenio-mcu/Makefile
index 47e7e19..c917262 100644
--- a/package/perenio-mcu/Makefile
+++ b/package/perenio-mcu/Makefile
@@ -2,7 +2,25 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=perenio-mcu
 PKG_VERSION:=9.0.4
-PKG_RELEASE:=3
+PKG_RELEASE:=4
+
+# Вендорные блобы (mcu/mcud/stm32flash) — MIPS mipsel musl, линкуются к
+# конкретным SONAME libubox/libubus. SONAME зашит в самих блобах, поэтому
+# жёсткая зависимость вида +libubox20260213 ломала бы сборку при любом
+# обновлении OpenWrt (невнятная ошибка satisfy_dependencies).
+#
+# Вместо этого тянем обычные libubox/libubus, а в /usr/lib кладём symlink'и:
+#   - под текущий SONAME этого дерева OpenWrt;
+#   - под тот SONAME, который зашит в вендорный блоб.
+# Второй нужен, чтобы блоб продолжал запускаться, когда upstream сменил
+# версию библиотеки. Если ABI библиотеки реально изменился, блоб может
+# работать неверно — тогда его нужно пересобрать у вендора.
+VENDOR_LIBUBOX_SONAME:=libubox.so.20260213
+VENDOR_LIBUBUS_SONAME:=libubus.so.20251202
+
+# Текущий SONAME в этом дереве: берём из upstream Makefile'ов.
+LIBUBOX_ABI:=$(shell grep -oE 'PKG_ABI_VERSION:=[0-9]+' $(TOPDIR)/package/libs/libubox/Makefile 2>/dev/null | head -1 | cut -d= -f2)
+LIBUBUS_ABI:=$(shell grep -oE 'PKG_ABI_VERSION:=[0-9]+' $(TOPDIR)/package/system/ubus/Makefile 2>/dev/null | head -1 | cut -d= -f2)
 
 include $(INCLUDE_DIR)/package.mk
 
@@ -10,7 +28,7 @@ define Package/perenio-mcu
   SECTION:=utils
   CATEGORY:=Utilities
   TITLE:=Perenio PEJIR01 STM32 MCU tools (vendor binaries)
-  DEPENDS:=+libubox20260213 +libubus20251202
+  DEPENDS:=+libubox +libubus
 endef
 
 define Package/perenio-mcu/description
@@ -33,10 +51,16 @@ define Package/perenio-mcu/install
 	$(INSTALL_DIR) $(1)/etc/init.d
 	$(INSTALL_BIN) ./files/mcud.init $(1)/etc/init.d/mcud
 	$(INSTALL_DIR) $(1)/usr/lib
-	bv=$$$$(grep -o 'libubox\.so\.[0-9]*' $(STAGING_DIR)/pkginfo/libubox.provides | head -n1); \
-	uv=$$$$(grep -o 'libubus\.so\.[0-9]*' $(STAGING_DIR)/pkginfo/libubus.provides | head -n1); \
+	bv=$$$$(grep -o 'libubox\.so\.[0-9]*' $(STAGING_DIR)/pkginfo/libubox.provides 2>/dev/null | head -n1); \
+	[ -n "$$$$bv" ] || bv="libubox.so.$(LIBUBOX_ABI)"; \
+	uv=$$$$(grep -o 'libubus\.so\.[0-9]*' $(STAGING_DIR)/pkginfo/libubus.provides 2>/dev/null | head -n1); \
+	[ -n "$$$$uv" ] || uv="libubus.so.$(LIBUBUS_ABI)"; \
 	[ -n "$$$$bv" ] && ln -sf $$$$bv $(1)/usr/lib/libubox.so; \
 	[ -n "$$$$uv" ] && ln -sf $$$$uv $(1)/usr/lib/libubus.so; \
+	[ -n "$$$$bv" ] && [ "$$$$bv" != "$(VENDOR_LIBUBOX_SONAME)" ] && \
+		ln -sf $$$$bv $(1)/usr/lib/$(VENDOR_LIBUBOX_SONAME); \
+	[ -n "$$$$uv" ] && [ "$$$$uv" != "$(VENDOR_LIBUBUS_SONAME)" ] && \
+		ln -sf $$$$uv $(1)/usr/lib/$(VENDOR_LIBUBUS_SONAME); \
 	true
 endef
 
