diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/lte-indicator.js b/package/luci-app-perenio/htdocs/luci-static/resources/lte-indicator.js
new file mode 100644
index 00000000..464d7b89
--- /dev/null
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/lte-indicator.js
@@ -0,0 +1,156 @@
+'use strict';
+'require baseclass';
+'require fs';
+'require poll';
+
+/*
+ * Значок сети (LTE/3G/2G) в шапке веб-интерфейса - рядом со значком
+ * батареи, как в стоковой прошивке Perenio.
+ *
+ * Данные берём не из модема напрямую, а из файла состояния, который
+ * пишет демон /usr/libexec/pejir-signal (раз в минуту опрашивает модем
+ * в фоне). Брать AT-данные из браузера нельзя: тогда на каждой
+ * странице пришлось бы дёргать модем, а AT-порт в это время занят
+ * smsd - запросы сбивают отправку SMS.
+ *
+ * Файл состояния - строки "ключ=значение":
+ *   ts=1730000000 rssi=21 pct=68 net=LTE operator=MegaFon
+ *
+ * Модуль лежит в resources/preload/, поэтому LuCI подключает его сам
+ * на каждой странице - отдельно подключать его в теме не нужно.
+ */
+
+var STATE_FILE = '/tmp/pejir-signal';
+var LTE_LINK = 'admin/status/perenio-lte';
+
+var COLORS = {
+	'LTE': '#2e7d32',
+	'3G': '#ef6c00',
+	'2G': '#6d4c41',
+	'none': '#757575'
+};
+
+function parseState(text) {
+	var st = {};
+
+	(text || '').split('\n').forEach(function(line) {
+		var i = line.indexOf('=');
+
+		if (i > 0)
+			st[line.substring(0, i).trim()] = line.substring(i + 1).trim();
+	});
+
+	return st;
+}
+
+function escapeHtml(s) {
+	return String(s == null ? '' : s)
+		.replace(/&/g, '&amp;')
+		.replace(/</g, '&lt;')
+		.replace(/>/g, '&gt;')
+		.replace(/"/g, '&quot;');
+}
+
+/* Столбики уровня сигнала: 4 полоски, заполнено по уровню в процентах. */
+function barsSvg(pct) {
+	var filled = 0, s, i, h, y;
+
+	if (!isNaN(pct))
+		filled = Math.min(4, Math.max(0, Math.ceil(pct / 25)));
+
+	s = '<svg width="18" height="12" viewBox="0 0 18 12" style="vertical-align:middle">';
+
+	for (i = 0; i < 4; i++) {
+		h = 3 + i * 3;
+		y = 12 - h;
+		s += '<rect x="' + (i * 5) + '" y="' + y + '" width="3.5" height="' + h +
+			'" rx="1" fill="' + (i < filled ? 'currentColor' : 'rgba(128,128,128,0.35)') + '"/>';
+	}
+
+	return s + '</svg>';
+}
+
+function indicator() {
+	var div = document.getElementById('indicators');
+
+	if (!div)
+		return null;
+
+	var el = div.querySelector('span[data-indicator="lte-status"]');
+
+	if (!el) {
+		el = document.createElement('span');
+		el.setAttribute('data-indicator', 'lte-status');
+		el.setAttribute('data-style', 'active');
+		el.className = 'pejir-lte-indicator';
+		el.style.cursor = 'pointer';
+		el.style.whiteSpace = 'nowrap';
+		el.style.marginLeft = '8px';
+		el.addEventListener('click', function() {
+			window.location.href = L.url(LTE_LINK);
+		});
+
+		div.appendChild(el);
+	}
+
+	return el;
+}
+
+function render(el, st) {
+	var net = st.net || 'none';
+	var pct = parseInt(st.pct, 10);
+	var op = st.operator || '';
+	var title, label;
+
+	if (isNaN(pct))
+		pct = NaN;
+
+	label = (net === 'none') ? '—' : net;
+	title = _('Network type') + ': ' + label;
+
+	if (op)
+		title += ', ' + _('Operator') + ': ' + op;
+
+	if (!isNaN(pct))
+		title += ', ' + _('Signal level') + ': ' + pct + '%';
+
+	el.innerHTML =
+		'<span style="display:inline-block;padding:0 5px;border-radius:3px;' +
+		'color:#fff;background:' + (COLORS[net] || COLORS.none) + ';' +
+		'font-size:85%;font-weight:bold;vertical-align:middle">' + escapeHtml(label) + '</span>' +
+		'<span style="margin-left:3px">' + barsSvg(pct) + '</span>';
+
+	el.setAttribute('title', title);
+	el.style.display = '';
+}
+
+function update() {
+	return fs.read(STATE_FILE).then(function(text) {
+		var el = indicator();
+
+		if (!el)
+			return;
+
+		var st = parseState(text);
+
+		if (!st.net && !st.pct) {
+			el.style.display = 'none';
+
+			return;
+		}
+
+		render(el, st);
+	}).catch(function() {
+		var el = indicator();
+
+		if (el)
+			el.style.display = 'none';
+	});
+}
+
+poll.add(update, 15);
+update();
+
+return baseclass.extend({
+	__name__: 'lte-indicator'
+});
