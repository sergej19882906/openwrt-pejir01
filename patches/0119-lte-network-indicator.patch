diff --git a/package/pejir-lte-base/root/etc/init.d/46-pejir-signal b/package/pejir-lte-base/root/etc/init.d/46-pejir-signal
new file mode 100755
index 00000000..c013f6f3
--- /dev/null
+++ b/package/pejir-lte-base/root/etc/init.d/46-pejir-signal
@@ -0,0 +1,26 @@
+#!/bin/sh /etc/rc.common
+# Демон состояния сети модема (тип сети, сигнал, оператор).
+#
+# Его данные использует индикатор в шапке веб-интерфейса: значок
+# LTE/3G рядом со значком батареи. Опрос идёт раз в минуту, в фоне,
+# поэтому браузеру не нужно дёргать AT-порт модема (он занят smsd).
+#
+# Порядок запуска: 41-pejir-modem (93) создаёт AT-порт,
+# 47-pejir-lte (94) поднимает связь, демон стартует после них (95).
+
+START=95
+STOP=0
+USE_PROCD=1
+
+start_service() {
+	procd_open_instance
+	procd_set_param command /usr/libexec/pejir-signal watch
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_set_param respawn 3600 5 5
+	procd_close_instance
+}
+
+stop_service() {
+	return 0
+}
diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-signal b/package/pejir-lte-base/root/usr/libexec/pejir-signal
new file mode 100755
index 00000000..db944e9e
--- /dev/null
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-signal
@@ -0,0 +1,177 @@
+#!/bin/sh
+# Состояние сети модема: тип сети (LTE/3G/2G), уровень сигнала, оператор.
+#
+# Зачем отдельный демон. Эти данные нужны индикатору в шапке веб-интерфейса
+# (значок сети рядом со значком батареи). Брать их прямо из браузера
+# нельзя: тогда на каждой странице пришлось бы дёргать модем AT-командами,
+# а AT-порт в это время занят smsd - запросы сбивают отправку SMS.
+# Поэтому демон сам опрашивает модем раз в минуту и кладёт короткий файл
+# состояния, который LuCI просто читает.
+#
+# Команды:
+#   refresh - один раз опросить модем и обновить файл состояния;
+#   watch   - бесконечный цикл (раз в PEJIR_SIGNAL_INTERVAL секунд);
+#   status  - показать текущее состояние.
+
+PORT_FILE="${PEJIR_AT_PORT_FILE:-/etc/pejir/at-port}"
+STATE_FILE="${PEJIR_SIGNAL_STATE:-/tmp/pejir-signal}"
+INTERVAL="${PEJIR_SIGNAL_INTERVAL:-60}"
+TIMEOUT="${PEJIR_SIGNAL_TIMEOUT:-4}"
+SMS_OUTBOX="${PEJIR_SMS_OUTBOX:-/var/spool/sms/outgoing}"
+LOCK_FILE="${PEJIR_SIGNAL_LOCK:-/tmp/pejir-signal.lock}"
+
+log() {
+	logger -t pejir-signal "$*" 2>/dev/null
+}
+
+at() {
+	MDM_AT_TIMEOUT="$TIMEOUT" mdm-at "$1" "$2" 2>/dev/null
+}
+
+current_port() {
+	[ -f "$PORT_FILE" ] && head -n 1 "$PORT_FILE" 2>/dev/null
+}
+
+# "+CSQ: 21,99" -> 21
+parse_csq() {
+	printf '%s' "$1" | sed -n 's/.*+CSQ: *\([0-9][0-9]*\).*/\1/p' | head -1
+}
+
+# "+NWINFO: LTE,FDD,2100,..." -> LTE
+parse_nwinfo() {
+	printf '%s' "$1" | sed -n 's/.*+NWINFO: *\([A-Za-z-]*\).*/\1/p' | head -1
+}
+
+# '+COPS: 0,0,"MegaFon",2' -> MegaFon
+parse_cops_op() {
+	printf '%s' "$1" | awk '
+		match($0, /\+COPS: *[0-9]+,[0-9]+,"[^"]*"/) {
+			s = substr($0, RSTART, RLENGTH)
+			sub(/^.*,"/, "", s)
+			sub(/"$/, "", s)
+			print s
+			exit
+		}'
+}
+
+# '+COPS: 0,0,"MegaFon",2' -> 2
+parse_cops_act() {
+	printf '%s' "$1" | awk '
+		match($0, /\+COPS: *[0-9]+,[0-9]+("[^"]*"|[^,]*),[0-9]+/) {
+			s = substr($0, RSTART, RLENGTH)
+			n = split(s, a, ",")
+			print a[n]
+			exit
+		}'
+}
+
+# Тип сети по NWINFO
+net_from_nwinfo() {
+	case "$1" in
+	LTE|E-UTRAN|EP-DUP) echo "LTE" ;;
+	UMTS) echo "3G" ;;
+	EDGE|GPRS|GSM|CSD) echo "2G" ;;
+	"No Service"|"no service") echo "none" ;;
+	esac
+}
+
+# Тип сети по коду активности COPS (0=GSM, 2=EPS/LTE, 3..6=UMTS/HSPA)
+net_from_act() {
+	case "$1" in
+	0|1|8) echo "2G" ;;
+	2|7) echo "LTE" ;;
+	3|4|5|6) echo "3G" ;;
+	esac
+}
+
+# Замок считается протухшим, если он старше двух минут (процесс убили).
+lock_stale() {
+	local t now
+
+	[ -d "$LOCK_FILE" ] || return 0
+	t="$(stat -c %Y "$LOCK_FILE" 2>/dev/null)"
+	case "$t" in
+	''|*[!0-9]*) rm -rf "$LOCK_FILE" 2>/dev/null; return 0 ;;
+	esac
+	now="$(date +%s)"
+	[ "$((now - t))" -gt 120 ] && rm -rf "$LOCK_FILE" 2>/dev/null
+	return 0
+}
+
+cmd_refresh() {
+	local port csq nw cops rssi pct net op act
+
+	port="$(current_port)"
+	[ -n "$port" ] || return 1
+
+	# Не мешаем отправке SMS: если в очереди есть исходящие, порт занят
+	# smsd, и AT-запросы в этот момент могут сбить отправку.
+	if [ -n "$(ls -1 "$SMS_OUTBOX" 2>/dev/null | head -1)" ]; then
+		return 1
+	fi
+
+	# Один опрос за раз: иначе два цикла могут лезть в порт одновременно.
+	# Если процесс убили и замок остался - снимаем его через 2 минуты.
+	lock_stale
+	if ! mkdir "$LOCK_FILE" 2>/dev/null; then
+		return 1
+	fi
+	trap 'rmdir "$LOCK_FILE" 2>/dev/null' EXIT INT TERM
+
+	csq="$(at 'AT+CSQ' "$port")"
+	nw="$(at 'AT+NWINFO' "$port")"
+	cops="$(at 'AT+COPS?' "$port")"
+
+	rssi="$(parse_csq "$csq")"
+	net="$(net_from_nwinfo "$(parse_nwinfo "$nw")")"
+	op="$(parse_cops_op "$cops")"
+	act="$(parse_cops_act "$cops")"
+
+	[ -n "$net" ] || net="$(net_from_act "$act")"
+
+	[ -n "$rssi" ] || [ -n "$net" ] || return 1
+
+	case "$rssi" in
+	''|*[!0-9]*) pct="" ;;
+	0) pct="0" ;;
+	99) pct="" ;;
+	*) pct="$(( (rssi * 100 + 15) / 31 ))" ;;
+	esac
+
+	{
+		echo "ts=$(date +%s)"
+		echo "rssi=${rssi:-}"
+		echo "pct=${pct:-}"
+		echo "net=${net:-}"
+		echo "operator=${op:-}"
+	} > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null
+
+	rmdir "$LOCK_FILE" 2>/dev/null
+	trap - EXIT INT TERM
+	return 0
+}
+
+cmd_watch() {
+	while :; do
+		sleep "$INTERVAL"
+		cmd_refresh >/dev/null 2>&1
+	done
+}
+
+cmd_status() {
+	if [ -f "$STATE_FILE" ]; then
+		cat "$STATE_FILE"
+	else
+		echo "нет данных"
+	fi
+}
+
+case "$1" in
+refresh) cmd_refresh ;;
+watch)   cmd_watch ;;
+status)  cmd_status ;;
+*)
+	echo "usage: $0 {refresh|watch|status}" >&2
+	exit 2
+	;;
+esac

