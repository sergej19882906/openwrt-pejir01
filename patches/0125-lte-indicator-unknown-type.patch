Если модем не отдал код активности (net= пусто), плашка значка была
пустой: значок в шапке выглядел как ничего, и непонятно было, работает
он или нет. Теперь в этом случае видно "?" серым цветом, а в
подсказке - "тип сети: неизвестно".
---
 .../htdocs/luci-static/resources/lte-indicator.js      | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/lte-indicator.js b/package/luci-app-perenio/htdocs/luci-static/resources/lte-indicator.js
index 464d7b89..112d35f6 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/lte-indicator.js
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/lte-indicator.js
@@ -105,8 +105,14 @@ function render(el, st) {
 	if (isNaN(pct))
 		pct = NaN;
 
-	label = (net === 'none') ? '—' : net;
-	title = _('Network type') + ': ' + label;
+	/* net может быть пустым (модем не отдал код активности) - тогда
+	 * показываем "?" вместо пустой плашки: иначе непонятно, что
+	 * значок есть, но тип сети не определён. */
+	if (!net || net === 'none')
+		label = (net === 'none') ? '—' : '?';
+	else
+		label = net;
+	title = _('Network type') + ': ' + ((!net || net === 'none') ? _('unknown') : net);
 
 	if (op)
 		title += ', ' + _('Operator') + ': ' + op;
