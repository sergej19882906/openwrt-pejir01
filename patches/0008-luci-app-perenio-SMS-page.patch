new file mode 100644
index 0000000..4cd494d
--- /dev/null
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
@@ -0,0 +1,70 @@
+'use strict';
+'require view';
+'require fs';
+'require ui';
+'require poll';
+
+var DIR = '/var/spool/sms/incoming';
+
+return view.extend({
+	render: function() {
+		var body = E([
+			E('h2', _('SMS (GM510)')),
+			E('div', { 'class': 'cbi-map' }, [
+				E('div', { 'class': 'cbi-section' }, [
+					E('div', { 'id': 'sms-list' },
+						E('em', {}, _('Loading…'))),
+					E('div', { 'class': 'cbi-value-description' },
+						_('Incoming SMS from /var/spool/sms/incoming (smstools3). ' +
+						  'Files: 1 line — sender, 2 line — timestamp, rest — text.'))
+				])
+			])
+		]);
+
+		poll.add(L.bind(function() {
+			return fs.list(DIR).then(L.bind(function(list) {
+				var files = (list || []).filter(function(f) { return f.type == 'file'; });
+				files.sort(function(a, b) { return b.mtime - a.mtime; });
+				files = files.slice(0, 50);
+
+				return Promise.all(files.map(function(f) {
+					return fs.read(DIR + '/' + f.name).then(function(txt) {
+						var lines = (txt || '').split('\n');
+						return { name: f.name, mtime: f.mtime,
+							from: lines[0] || '', date: lines[1] || '',
+							text: lines.slice(2).join('\n').trim() };
+					});
+				}));
+			}, this)).then(function(msgs) {
+				var box = document.getElementById('sms-list');
+				if (!box) return;
+				if (!msgs.length) {
+					box.innerHTML = '<em>' + _('No SMS') + '</em>';
+					return;
+				}
+				var rows = msgs.map(function(m) {
+					return E('tr', { 'class': 'tr' }, [
+						E('td', { 'class': 'td', 'style': 'white-space:nowrap' },
+							new Date(m.mtime * 1000).toLocaleString()),
+						E('td', { 'class': 'td' }, m.from),
+						E('td', { 'class': 'td', 'style': 'white-space:pre-wrap' }, m.text)
+					]);
+				});
+				box.innerHTML = '';
+				box.appendChild(E('table', { 'class': 'table' }, [
+					E('tr', { 'class': 'tr table-titles' }, [
+						E('th', { 'class': 'th' }, _('Time')),
+						E('th', { 'class': 'th' }, _('Sender')),
+						E('th', { 'class': 'th' }, _('Text'))
+					])
+				].concat(rows)));
+			});
+		}, this), 20);
+
+		return body;
+	},
+
+	handleSaveApply: null,
+	handleSave: null,
+	handleReset: null
+});
