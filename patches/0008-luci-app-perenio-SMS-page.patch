diff --git a/package/modeminfo/root/usr/share/modeminfo/modeminfo b/package/modeminfo/root/usr/share/modeminfo/modeminfo
new file mode 100755
index 0000000..332aff7
--- /dev/null
+++ b/package/modeminfo/root/usr/share/modeminfo/modeminfo
@@ -0,0 +1,120 @@
+#!/bin/sh
+
+trap 'cleanup >/dev/null 2>&1; exit 0' INT TERM
+SECTIONS=$(echo $(uci show modeminfo | awk -F [\]\[\@=] '/=modeminfo/{print $3}'))
+
+get_vars(){
+	for v in device device_qmi qmi_trap decimail qmi_mode;  do
+		eval $v=$(uci -q get modeminfo.@modeminfo[${s}].${v} 2>/dev/null)
+	done
+}
+
+
+cleanup(){
+	CURRENT_PID=$$
+	ps ww | grep "/bin/sh.*modeminfo" | grep -v grep | awk '{print $1}' | grep -v "^$CURRENT_PID\$" | xargs -r kill -9 >/dev/null 2>&1
+	ps ww | grep "atinout" | grep -v grep | awk '{print $1}' | xargs -r kill -9 >/dev/null 2>&1
+}
+
+
+function json_status() {
+	cat << EOF
+	{
+		"device": "$DEVICE",
+		"cops": "$COPS",
+		"mode": "$MODE",
+		"csq_per": "$CSQ_PER",
+		"lac": "$LAC",
+		"cid": "$CID",
+		"rssi": "$CSQ_RSSI",
+		"sinr": "$SINR",
+		"rsrp": "$RSRP",
+		"rsrq": "$RSRQ",
+		"imei": "$IMEI",
+		"reg": "$REGST",
+		"csq_col": "$CSQ_COL",
+		"arfcn": "$EARFCN",
+		"chiptemp": "$CHIPTEMP",
+		"firmware": "$FW",
+		"bwdl": "$BWDL",
+		"lteca": "$LTE_CA",
+		"enbid": "$ENBID",
+		"distance": "$DISTANCE",
+		"cell": "$CELL",
+		"scc": "$SCC",
+		"bwca": "$BWCA",
+		"iccid": "$ICCID",
+		"imsi": "$IMSI",
+		"pci": "$PCI"
+EOF
+}
+
+
+
+function if_null() {
+        for var in DEVICE COPS MODE CSQ_PER LAC CSQ_RSSI SINR RSRP \
+                        RSRQ IMEI REGST EARFCN CHIPTEMP FW BWDL ICCID IMSI; do
+                if [ "x$(eval echo \${$var})" = "x" ]; then
+                        eval $var='--'
+                fi
+        done
+}
+
+
+qmi_device(){
+	[ "$qmi_mode" = "1" ] || SCRIPT=/usr/share/modeminfo/scripts/modeminfo
+	[ -r $SCRIPT ] && {
+		. $SCRIPT
+	} || {
+		exit 0
+	}
+}
+
+
+args(){
+    echo "$#"
+}
+
+ARGSLEN=$(args $SECTIONS)
+
+echo "{ \"modem\" : ["
+
+for s in $SECTIONS; do
+	m=$((${s} + 1))
+	get_vars
+	if [ $qmi_mode ]; then
+		if [ "$s" ]; then
+			/usr/bin/qminfo $device_qmi --json --${qmi_trap} 
+		fi
+		if [ "$ARGSLEN" != "${m}" ]; then
+			echo ","
+		fi
+	else
+		if [ "$s" ]; then
+			qmi_device
+			get_device_info
+			get_data_in >/dev/null 2>&1
+			if_null
+			json_status
+		fi
+		if [ "$ARGSLEN" = "${m}" ]; then
+			echo "	}"
+		else
+			echo "	},"
+		fi
+		# flush modem variables
+		unset BWCA SCC SC BWDx BWPx BWCx BWDL LTE_CA \
+        	        DEVICE COPS MODE CSQ_PER LAC CSQ_RSSI \
+                	SINR RSRP IMEI REGST EARFCN CHIPTEMP FW \
+	                ICCID IMSI RSRQ DISTANCE
+	fi
+done
+
+echo "]}"
+
+DELAY=$(uci get modeminfo.@general[0].delay >/dev/null 2>&1)
+
+kill -9 $(pgrep atinout) >/dev/null 2>&1
+[ $DELAY ] || DELAY=0 && sleep $DELAY
+
+exit 0
diff --git a/package/modeminfo/root/usr/share/modeminfo/scripts/DELL b/package/modeminfo/root/usr/share/modeminfo/scripts/DELL
new file mode 100644
index 0000000..516ccc5
--- /dev/null
+++ b/package/modeminfo/root/usr/share/modeminfo/scripts/DELL
@@ -0,0 +1,62 @@
+modem_data(){
+        # hwinfo
+	OIFS="$IFS"; IFS="|"
+	set -- $(echo "$O" | awk '
+		BEGIN{IGNORECASE=1} $0 ~ /DELL|Telit/ {manufacturer=$1; getline model; getline fw}
+		/^ICCID:/{iccid=$2; getline imei; getline imsi}
+		/^PA:|^xo_therm_buf:/ {sub(/C/, "", $2); split($0,arr,":"); if (arr[2] !="") temp = arr[2]; else temp=$2 }
+		END {print manufacturer "|" model "|" fw "|" iccid "|" imei "|" imsi "|" temp }')
+	DEVICE="${1} ${2}"; MANUF=${1}; MODEL=${2}; FW=${3}; ICCID=${4}; IMEI=${5}; IMSI=${6}; CHIPTEMP=${7}
+	IFS="$OIFS"; unset OIFS
+	generic_data
+	# get signal info
+	OIFS="$IFS"; IFS="|"
+	set -- $(echo "$O" | awk -v mode="$MODE" '
+		BEGIN {
+			lac=""; cid=""; earfcn=""; pci=""; bw=""; bwc=""; rsrp=""; rssi=""; rsrq=""; sinr=""; rscp=""; csq=""; lte_ca=0
+			map[3]=1; map[5]=2; map[10]=3; map[15]=4; map[20]=5
+		}
+		# LTE Carrier Aggregation
+		/SCC[0-9]+ info:/ {lte_ca++}
+    		# LTE 
+		mode == "LTE" {
+			if (/\+CEREG/) { gsub(/"/, ""); split($0, arr, ","); lac = arr[3]; cid = arr[5]}
+			if (/EARFCN\(DL\/UL\):/ && earfcn == "") {split($0, arr, /[ \/]/); earfcn = arr[3]}
+			if (/PCI\)/ && pci == "") {gsub("\)","",$0); gsub("\("," ",$0); pci=$NF}
+			if (/^RSRP:/ && rsrp == "") {sub(/dBm/, "", $2); rsrp = sprintf("%.0f", $2)}
+			if (/^RSSI:/ && rssi == "") {sub(/dBm/, "", $2); rssi = sprintf("%.0f", $2)}
+			if (/^RSRQ:/ && rsrq == "") {sub(/dB/, "", $2); rsrq = sprintf("%.0f", $2)}
+			if (/^RS-SINR:/ && sinr == "") {sub(/dB/, "", $2); sinr = sprintf("%.0f", $2)}
+			if (/^RS-SNR:/ && sinr == "") {sub(/dB/, "", $2);sinr = sprintf("%.0f", $2)}
+			if (/PCC info/ && bwc == "") { bwc = sprintf("%.0f", $8); bw=map[bwc] }
+			cell = sprintf("%d", "0x" substr(cid, length(cid) - 1, 2)) 
+			enbid = sprintf("%d", "0x" substr(cid, 1, length(cid) - 2))
+		}
+    
+		# Other mode (3G)
+		mode != "LTE" {
+			if (/\+CREG/) {gsub(/"/, "");split($0, arr, ",");lac = arr[3]; cid = arr[4]}
+			if (/Active channel/ && earfcn == "") {split($0, arr, /:/); gsub(/ /, "", arr[2]); earfcn = arr[2]}
+			if (/QCSQ/ && csq == "") { split($0, arr, /[:,]/); rscp = arr[2]; sinr = arr[3]; rssi = arr[6] }
+		
+		}
+    
+		END {print lac "|" cid "|" earfcn "|" rssi "|" sinr "|" pci "|" bw "|" bwc "|" rsrp "|" rsrq "|" rscp "|" csq "|" lte_ca "|" cell "|" enbid}')
+	LAC=${1}; CID=${2}; EARFCN=${3}; CSQ_RSSI=${4}; SINR=${5}; PCI=${6}; BWDL=${7}; BWDx=${8}; RSRP=${9}; RSRQ=${10}; LTE_CA=${13}
+	CELL=${14}; ENBID=${15}
+	IFS="$OIFS"; unset OIFS
+	if [ $LTE_CA -ge 1 ]; then
+		OIFS="$IFS"; IFS="|"
+		set -- $(echo "$O" | awk -v bwc=${BWDx:-0} '
+			/^SCC\d info:/ {for(i=1; i<=NF; i++) { if($i ~ /LTE_B/) { gsub(/[^0-9]/, "", $i); scc = scc "+" $i}} bwca_raw += sprintf("%.0f", $8)
+			bwca=bwca_raw+bwc}
+			END { print scc "|" bwca }')
+		IFS="$OIFS"; unset BWDx OIFS
+		SCC=${1}; BWCA=${2}
+	fi
+
+        if [ $(uci -q get modeminfo.@general[0].decimail) = "1" ]; then
+                LAC=$(printf %d 0x$LAC)
+                CID=$(printf %d 0x$CID)
+        fi
+}
