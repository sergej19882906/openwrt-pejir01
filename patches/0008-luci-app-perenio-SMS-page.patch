diff --git a/package/pejir-sms/root/etc/uci-defaults/41-pejir-sms b/package/pejir-sms/root/etc/uci-defaults/41-pejir-sms
old mode 100644
new mode 100755
index 3a51215..3fb079a
--- a/package/pejir-sms/root/etc/uci-defaults/41-pejir-sms
+++ b/package/pejir-sms/root/etc/uci-defaults/41-pejir-sms
@@ -1,5 +1,5 @@
 #!/bin/sh
-# autodetect AT port at first boot, write it into smsd.conf
+# autodetect AT port, then write the full GM510 smsd.conf
 PORT=""
 for p in /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB3; do
   [ -c "$p" ] || continue
@@ -7,7 +7,33 @@ for p in /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB3; do
   sleep 0.3
   if head -c 60 "$p" 2>/dev/null | grep -q OK; then PORT="$p"; break; fi
 done
-[ -n "$PORT" ] && sed -i "s|^device = .*|device = $PORT|" /etc/smsd.conf
+[ -n "$PORT" ] || PORT="/dev/ttyUSB0"
+
+cat > /etc/smsd.conf <<CONF
+# SMS Server Tools 3 - PEJIR01 / GM510 (generated at first boot)
+devices = GM510
+loglevel = notice
+logfile = /var/log/smsd.log
+pidfile = /var/run/smsd.pid
+infofile = /var/run/smsd.working
+outgoing = /var/spool/sms/outgoing
+checked = /var/spool/sms/checked
+failed = /var/spool/sms/failed
+incoming = /var/spool/sms/incoming
+sent = /var/spool/sms/sent
+receive_before_send = no
+
+[GM510]
+device = $PORT
+baudrate = 115200
+init = AT+CPMS="SM","SM","SM"
+init = AT+CMGF=1
+init = AT+CNMI=2,1,0,2,0
+incoming = yes
+outgoing = yes
+decode_unicode_text = yes
+CONF
+
 mkdir -p /var/spool/sms/incoming /var/spool/sms/outgoing \
          /var/spool/sms/sent /var/spool/sms/failed /var/spool/sms/checked
 /etc/init.d/smstools3 enable 2>/dev/null || true
