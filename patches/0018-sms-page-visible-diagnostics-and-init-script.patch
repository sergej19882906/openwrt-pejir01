+function tail(txt, n) {
+	var lines = (txt || '').split('\n').filter(function(l) { return l.trim() != ''; });
+
+	return lines.slice(-n).join('\n');
+}
+
+/* Последние строки журнала smsd */
+function readLog() {
+	return fs.read(LOG).then(function(t) {
+		return tail(t, 8);
+	}).catch(function() {
+		return fs.read('/var/log/smsd.log.1').then(function(t) {
+			return tail(t, 8);
+		}).catch(function() { return ''; });
+	});
+}
+
+/* Состояние демона, AT-порты и порт, прописанный в smsd.conf */
+function readStatus() {
+	return Promise.all([
+		fs.exec('/etc/init.d/smstools3', [ 'status' ])
+			.catch(function() { return { code: 1, stdout: '', stderr: '' }; }),
+		fs.list('/dev').catch(function() { return []; }),
+		fs.read(CONF).catch(function() { return ''; }),
+		readLog()
+	]).then(function(res) {
+		var svc = res[0], devs = res[1] || [], conf = res[2] || '', log = res[3];
+		var ports = devs.map(function(d) { return d.name; })
+			.filter(function(n) { return /^ttyUSB|^ttyACM/.test(n); });
+		var m = conf.match(/^[ \t]*device[ \t]*=[ \t]*(\S+)/m);
+		var out = (svc.stdout || '') + (svc.stderr || '');
+		var running = /running/i.test(out);
+
+		setText('sms-svc', running ? _('работает (smsd)') : _('не запущен'));
+		setText('sms-ports', ports.length ? ports.join(', ') : _('не найдено (ttyUSB/ttyACM)'));
+		setText('sms-device', m ? m[1] : _('не задан в smsd.conf'));
+		setText('sms-log', log || _('журнала нет'));
+	});
+}
+
+/* Приём входящих SMS из /var/spool/sms/incoming */
+function readInbox() {
+	return fs.list(DIR).catch(function() { return []; }).then(L.bind(function(list) {
