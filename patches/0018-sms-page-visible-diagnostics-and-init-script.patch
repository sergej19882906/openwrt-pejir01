diff --git a/package/pejir-sms/root/etc/init.d/40-pejir-sms b/package/pejir-sms/root/etc/init.d/40-pejir-sms
new file mode 100644
index 0000000..22b3584
--- /dev/null
+++ b/package/pejir-sms/root/etc/init.d/40-pejir-sms
@@ -0,0 +1,92 @@
+#!/bin/sh /etc/rc.common
+# Настройка smsd для LTE-модема GM510: находим AT-порт, пишем /etc/smsd.conf,
+# создаём каталоги очереди и включаем smstools3.
+#
+# Раньше это был uci-defaults: он отрабатывал только при первом включении и
+# успевал раньше, чем модем появился в USB, — порт определялся неверно (или
+# модема ещё не было), а страница SMS в LuCI была скрыта, пока smsd не
+# создавал /var/spool/sms/incoming. Теперь скрипт выполняется при каждой
+# загрузке, а пункт меню SMS виден всегда.
+
+START=92
+STOP=0
+
+CONF="/etc/smsd.conf"
+LOG="/var/log/smsd.log"
+MARKER="# generated by 40-pejir-sms"
+DEFAULT_PORT="/dev/ttyUSB0"
+PROBE_PORTS="/dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB3"
+
+detect_port() {
+	local p
+
+	for p in $PROBE_PORTS; do
+		[ -c "$p" ] || continue
+		printf 'AT\r' > "$p" 2>/dev/null
+		sleep 1
+		if head -c 64 "$p" 2>/dev/null | grep -q 'OK'; then
+			echo "$p"
+			return 0
+		fi
+	done
+
+	return 1
+}
+
+write_conf() {
+	local port="$1"
+
+	# Пользовательский конфиг не трогаем.
+	[ -f "$CONF" ] && ! grep -q "$MARKER" "$CONF" && return 0
+
+	cat > "$CONF" <<CONF
+#
+# Description: Main configuration file for the smsd
+#
+$MARKER
+
+devices = GM510
+incoming = /var/spool/sms/incoming
+outgoing = /var/spool/sms/outgoing
+checked = /var/spool/sms/checked
+failed = /var/spool/sms/failed
+sent = /var/spool/sms/sent
+receive_before_send = no
+autosplit = 3
+logfile = $LOG
+loglevel = 5
+
+[GM510]
+device = $port
+baudrate = 115200
+init = AT+CPMS="SM","SM","SM"
+init = AT+CMGF=1
+init = AT+CNMI=2,1,0,2,0
+incoming = yes
+outgoing = yes
+decode_unicode_text = yes
+CONF
+}
+
+start_service() {
+	local port=""
+
+	mkdir -p /var/spool/sms/incoming /var/spool/sms/outgoing \
+	         /var/spool/sms/sent /var/spool/sms/failed /var/spool/sms/checked
+
+	# Модем может появиться в USB чуть позже, поэтому короткий перебор портов.
+	for i in 1 2 3; do
+		port="$(detect_port)"
+		[ -n "$port" ] && break
+		sleep 2
+	done
+
+	[ -n "$port" ] || port="$DEFAULT_PORT"
+	write_conf "$port"
+
+	/etc/init.d/smstools3 enable >/dev/null 2>&1
+}
+
+stop_service() {
+	return 0
+}
