diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-modem-ctl b/package/pejir-lte-base/root/usr/libexec/pejir-modem-ctl
new file mode 100755
index 0000000..9715fae
--- /dev/null
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-modem-ctl
@@ -0,0 +1,184 @@
+#!/bin/sh
+# Управление модемом GM510: SIM PIN, номер SIM, перезагрузка, режим канала.
+#
+#   pejir-modem-ctl pin-status        - статус SIM PIN        (AT+CPIN?)
+#   pejir-modem-ctl pin-lock          - состояние блокировки   (AT+CLCK="SC",2)
+#   pejir-modem-ctl pin-set <pin>     - ввести PIN             (AT+CPIN="<pin>")
+#   pejir-modem-ctl pin-enable <pin>  - включить блокировку    (AT+CLCK="SC",2,"<pin>")
+#   pejir-modem-ctl pin-disable <pin> - снять блокировку       (AT+CLCK="SC",0,"<pin>")
+#   pejir-modem-ctl cnum              - номер SIM              (AT+CNUM)
+#   pejir-modem-ctl reset             - перезагрузка модема    (AT+ZRST)
+#   pejir-modem-ctl mode              - текущий режим канала   (network.lte.modes)
+#   pejir-modem-ctl mode-apply        - применить режим канала (AT+ZBAND)
+#
+# AT-команды - ровно как в стоковой прошивке Perenio
+# (usr/lib/modem_ubus/common.sh, gosuncn.sh).
+#
+# Режим канала: в стоке для нашего модема (Meig GM510) он НЕ
+# РЕАЛИЗОВАН - usr/lib/modem_ubus/meig-at.sh содержит
+# "set_mode_band() { # TODO: implement; return; }", то есть переключатель
+# в стоковом интерфейсе - мёртвая кнопка. Здесь режим работает по-настоящему:
+# маска LTE обнуляется для "только 3G", маска UMTS - для "только 4G"
+# (AT+ZBAND=<UMTS>,0,0,<LTE>).
+#
+# ВАЖНО: PIN не печатается в вывод - он уходит только модему.
+
+set -u
+
+AT_TIMEOUT="${AT_TIMEOUT:-8}"
+
+# Общий файл с масками диапазонов. Путь можно переопределить -
+# так helper проверяется без устройства.
+BANDS_SH="${PEJIR_BANDS_SH:-/usr/share/pejir/bands.sh}"
+[ -f "$BANDS_SH" ] || BANDS_SH="$(dirname "$0")/../share/pejir/bands.sh"
+[ -f "$BANDS_SH" ] && . "$BANDS_SH"
+
+# --- AT-обмен --------------------------------------------------------------
+# $1 - порт, $2 - команда (без \r). Печатает ответ модема.
+at_ask() {
+	_aport="$1"
+	_acmd="$2"
+	_script="/tmp/pejir-modem-ctl.$$"
+
+	printf '%s\r' "$_acmd" > "$_script"
+	stty -F "$_aport" 115200 raw -echo 2>/dev/null || true
+	_out=$(timeout "$AT_TIMEOUT" atinout "$_script" "$_aport" - 2>/dev/null)
+	rm -f "$_script"
+	printf '%s' "$_out"
+}
+
+# AT-порт: явное переопределение, подтверждённый порт, иначе - перебор.
+find_port() {
+	if [ -n "${PEJIR_AT_PORT:-}" ]; then
+		echo "$PEJIR_AT_PORT"
+		return 0
+	fi
+	if [ -f /etc/pejir/at-port ]; then
+		_p=$(head -n 1 /etc/pejir/at-port 2>/dev/null)
+		[ -n "$_p" ] && [ -c "$_p" ] && { echo "$_p"; return 0; }
+	fi
+	for _p in /dev/ttyUSB2 /dev/ttyUSB1 /dev/ttyUSB0 /dev/ttyACM0; do
+		[ -c "$_p" ] && { echo "$_p"; return 0; }
+	done
+	return 1
+}
+
+# smsd держит AT-порт и забирает ответы модема себе - на время обмена
+# его надо отпустить.
+smsd_stop() {
+	[ -x /etc/init.d/smstools3 ] || return 0
+	pidof smsd >/dev/null 2>&1 || return 0
+	/etc/init.d/smstools3 stop >/dev/null 2>&1
+	sleep 2
+	SMSD_WAS=1
+	return 0
+}
+
+smsd_start() {
+	[ "${SMSD_WAS:-0}" = "1" ] || return 0
+	/etc/init.d/smstools3 start >/dev/null 2>&1
+	SMSD_WAS=0
+	return 0
+}
+
+# Команда модему с освобождением AT-порта.
+modem_cmd() {
+	_p=$(find_port) || { echo "AT-порт модема не найден"; return 1; }
+	smsd_stop
+	_out=$(at_ask "$_p" "$1")
+	smsd_start
+	printf '%s' "$_out"
+}
+
+# --- режим канала ---------------------------------------------------------
+# network.lte.modes: all (auto) | umts (только 3G) | lte (только 4G).
+# Имена как в стоке.
+current_mode() {
+	uci -q get network.lte.modes 2>/dev/null || echo "all"
+}
+
+# Маски диапазонов с учётом режима.
+mode_masks() {
+	_bands="$(uci -q get network.lte.perenio_band 2>/dev/null | tr '\n' ' ')"
+	[ -n "$_bands" ] || _bands="allBands"
+	_masks=$(pejir_bands_calc $_bands)
+	_umts=$(echo "$_masks" | awk '{print $1}')
+	_lte=$(echo "$_masks" | awk '{print $2}')
+
+	case "$(current_mode)" in
+		umts) _lte="0" ;;   # только 3G - LTE выключаем
+		lte)  _umts="0" ;;  # только 4G - UMTS выключаем
+	esac
+
+	echo "$_umts $_lte"
+}
+
+mode_apply() {
+	_masks=$(mode_masks)
+	_umts=$(echo "$_masks" | awk '{print $1}')
+	_lte=$(echo "$_masks" | awk '{print $2}')
+
+	echo "режим канала: $(current_mode)"
+	echo "команда:     AT+ZBAND=$_umts,0,0,$_lte"
+
+	_out=$(modem_cmd "AT+ZBAND=$_umts,0,0,$_lte")
+	echo "ответ:       $_out"
+
+	case "$_out" in
+		*ERROR*|*'command not supported'*)
+			echo "модем отклонил настройку диапазонов"
+			return 1 ;;
+	esac
+
+	echo "режим канала применён"
+	return 0
+}
+
+case "${1:-}" in
+pin-status)
+	modem_cmd 'AT+CPIN?'
+	echo
+	;;
+pin-lock)
+	modem_cmd 'AT+CLCK="SC",2'
+	echo
+	;;
+pin-set)
+	shift
+	[ $# -ge 1 ] || { echo "нужен PIN"; exit 1; }
+	_out=$(modem_cmd "AT+CPIN=\"$1\"")
+	printf '%s\n' "$_out"
+	;;
+pin-enable)
+	shift
+	[ $# -ge 1 ] || { echo "нужен PIN"; exit 1; }
+	_out=$(modem_cmd "AT+CLCK=\"SC\",2,\"$1\"")
+	printf '%s\n' "$_out"
+	;;
+pin-disable)
+	shift
+	[ $# -ge 1 ] || { echo "нужен PIN"; exit 1; }
+	_out=$(modem_cmd "AT+CLCK=\"SC\",0,\"$1\"")
+	printf '%s\n' "$_out"
+	;;
+cnum)
+	modem_cmd 'AT+CNUM'
+	echo
+	;;
+reset)
+	echo "перезагрузка модема (AT+ZRST)..."
+	_out=$(modem_cmd 'AT+ZRST')
+	printf '%s\n' "$_out"
+	;;
+mode)
+	echo "режим канала: $(current_mode)"
+	echo "все режимы:   all (авто), umts (только 3G), lte (только 4G)"
+	;;
+mode-apply)
+	mode_apply
+	;;
+*)
+	echo "usage: pejir-modem-ctl [pin-status|pin-lock|pin-set <pin>|pin-enable <pin>|pin-disable <pin>|cnum|reset|mode|mode-apply]"
+	exit 1
+	;;
+esac
