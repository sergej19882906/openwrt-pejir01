Симптом: туннель поднимался (хендшейк есть), а через минуту-две
интерфейс снова лежал, и маршрут по умолчанию уходил на LTE.

Причина: в init-скрипте pejir-awg стоял procd_add_reload_trigger
network. Перезагрузка сети вызывала start_service, тот делал ifup
интерфейса, ifup пересоздавал интерфейс, а это снова вызывало
перезагрузку сети - замкнутый круг. В журнале это видно как
"pejir-awg: интерфейс Home: перезапуск после загрузки модуля",
затем "Network device 'Home' link is down" без последующего
"setting up now": сеть перезагружалась в момент подъёма.

Исправлено:
- reload-триггер убран: поднимаются только те интерфейсы, которые
  действительно лежат (проверка по статусу netifd);
- сторож больше не трогает живой интерфейс: если интерфейс лежит -
  ifup, если жив, но хендшейка нет - полный перезапуск (ifdown+ifup);
- сторож заодно обновляет зону файрвола (интерфейс могли создать уже
  после старта роутера).
---
 package/pejir-awg/root/etc/init.d/pejir-awg   | 21 +++++++++++++++----
 .../root/usr/libexec/pejir-awg-watch          | 13 ++++++++++++
 2 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/package/pejir-awg/root/etc/init.d/pejir-awg b/package/pejir-awg/root/etc/init.d/pejir-awg
index 5e03b7ca..e7af0615 100644
--- a/package/pejir-awg/root/etc/init.d/pejir-awg
+++ b/package/pejir-awg/root/etc/init.d/pejir-awg
@@ -24,6 +24,13 @@ load_awg_modules() {
 	done
 }
 
+# Поднят ли интерфейс (по статусу netifd).
+iface_up() {
+	ubus call network.interface."$1" status 2>/dev/null |
+		grep -o '"up"[[:space:]]*:[[:space:]]*\(true\|false\)' |
+		head -1 | grep -q true && echo 1 || echo 0
+}
+
 awg_interfaces() {
 	local iface proto
 	for iface in $(uci -q show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)=interface$/\1/p"); do
@@ -47,7 +54,11 @@ start_service() {
 	[ -d /sys/module/amneziawg ] || return 0
 	local iface
 	for iface in $(awg_interfaces); do
-		logger -t pejir-awg "интерфейс $iface: перезапуск после загрузки модуля"
+		# Поднимаем только те интерфейсы, которые действительно лежат:
+		# повторный ifup живого интерфейса пересоздаёт его, а это
+		# вызывает перезагрузку сети и новый цикл.
+		[ "$(iface_up "$iface")" = "1" ] && continue
+		logger -t pejir-awg "интерфейс $iface: подъём после загрузки модуля"
 		ifup "$iface" >/dev/null 2>&1
 	done
 }
@@ -59,6 +70,8 @@ start() {
 	start_service
 }
 
-service_triggers() {
-	procd_add_reload_trigger network
-}
+# Здесь НЕТ procd_add_reload_trigger network: перезагрузка сети вызывает
+# start_service, а тот - ifup, который пересоздаёт интерфейс и снова
+# вызывает перезагрузку сети. Замкнутый круг оставлял туннель лежать
+# (проверено на устройстве: интерфейс поднимался и через минуту снова
+# падал).
diff --git a/package/pejir-awg/root/usr/libexec/pejir-awg-watch b/package/pejir-awg/root/usr/libexec/pejir-awg-watch
index 6634a0b1..96b6a9b3 100755
--- a/package/pejir-awg/root/usr/libexec/pejir-awg-watch
+++ b/package/pejir-awg/root/usr/libexec/pejir-awg-watch
@@ -80,6 +80,8 @@ check_once() {
 	local iface dev up age fails
 
 	for iface in $(awg_interfaces); do
+		# Зона файрвола: интерфейс могли создать уже после старта.
+		[ -x /usr/libexec/pejir-awg-zone ] && /usr/libexec/pejir-awg-zone
 		dev="$(iface_dev "$iface")"
 		[ -n "$dev" ] || continue
 
@@ -108,7 +110,18 @@ check_once() {
 			log "туннель $iface не оживает - снимаем маршрут по умолчанию через него, трафик идёт по LTE"
 			ip route del default dev "$dev" 2>/dev/null
 			count_set "$iface" 0
+		elif [ "$up" = "0" ]; then
+			# Интерфейс лежит - поднимаем. Живой интерфейс не трогаем:
+			# повторный ifup пересоздаёт его и вызывает перезагрузку
+			# сети (замкнутый круг, из-за которого туннель падал).
+			log "интерфейс $iface не поднят - поднимаем"
+			ifup "$iface" >/dev/null 2>&1
 		else
+			# Интерфейс жив, но хендшейка нет - перезапускаем
+			# полным циклом.
+			log "интерфейс $iface жив, но хендшейка нет - перезапускаем"
+			ifdown "$iface" >/dev/null 2>&1
+			sleep 2
 			ifup "$iface" >/dev/null 2>&1
 		fi
 	done
-- 
