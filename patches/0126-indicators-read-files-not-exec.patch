+var BATTERY_FILE = '/tmp/pejir-battery';
+
 function chargeText(mod, d) {
 	switch (mod.chargeStatus(d)) {
 	case 'fast':
@@ -90,14 +95,13 @@ function render(el, mod, d) {
 }
 
 function update() {
-	return fs.exec('/usr/bin/mcu', [ 'getsys' ]).then(function(res) {
+	return fs.read(BATTERY_FILE).then(function(text) {
 		var el = indicator();
 
 		if (!el)
 			return;
 
-		var out = (res && res.stdout) ? res.stdout : '';
-		var d = perenio_battery.parseSys(out);
+		var d = perenio_battery.parseSys(text || '');
 
 		/* mcud не ответил - значок прячем, чтобы не путать. */
 		if (!d) {
@@ -115,7 +119,7 @@ function update() {
 	});
 }
 
-poll.add(update, 15);
+poll.add(update, 30);
