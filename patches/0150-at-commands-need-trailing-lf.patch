 .../root/etc/init.d/47-pejir-lte              | 32 ++++++++++---------
 package/pejir-lte-base/root/usr/bin/mdm-at    |  2 +-
 .../root/usr/libexec/pejir-band               |  2 +-
 .../root/usr/libexec/pejir-modem-ctl          |  2 +-
 .../pejir-sms/root/etc/init.d/40-pejir-sms    |  8 ++---
 5 files changed, 24 insertions(+), 22 deletions(-)

diff --git a/package/pejir-lte-base/root/etc/init.d/47-pejir-lte b/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
