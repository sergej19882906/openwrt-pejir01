--- a/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
+++ b/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
@@ -108,7 +108,7 @@ DEFAULT_APN="${PEJIR_LTE_APN:-internet}"
 
 # Отправить AT-команду на порт и напечатать ответ модема.
 #
-# $1 - порт, $2 - формат команды для printf (например 'AT\r').
+# $1 - порт, $2 - формат команды для printf (например 'AT\r\n').
 # Скорость выставляется перед КАЖДЫМ обменом: порт могли сбросить
 # (например, smsd при старте), и тогда модем снова замолчал бы.
 at_ask() {
@@ -161,17 +161,17 @@ detect_at_port() {
 	         /dev/ttyACM1 /dev/ttyACM0; do
 		[ -c "$p" ] || continue
 
-		out="$(at_ask "$p" 'AT\r')"
+		out="$(at_ask "$p" 'AT\r\n')"
 		case "$out" in
 			*OK*) echo "$p"; return 0 ;;
 		esac
 
-		out="$(at_ask "$p" 'AT+CSQ\r')"
+		out="$(at_ask "$p" 'AT+CSQ\r\n')"
 		case "$out" in
 			*+CSQ*|*OK*) echo "$p"; return 0 ;;
 		esac
 
-		out="$(at_ask "$p" 'AT+CSQ\n')"
+		out="$(at_ask "$p" 'AT+CSQ\r\n')"
 		case "$out" in
 			*+CSQ*|*OK*) echo "$p"; return 0 ;;
 		esac
@@ -286,10 +286,12 @@ sync_apn() {
 	# AT+ZECMCALL (APN, тип PDP, логин, пароль, тип аутентификации).
 	# Логин и пароль уходят только вместе, иначе позиции параметров
 	# сдвинутся и модем примет пароль за логин.
-	# Хелпер печатает команды по одной в строке (без CR), поэтому
-	# перед отправкой переводим перевод строки в CR: GM510 не видит
-	# команду, завершённую только LF.
-	/usr/libexec/pejir-lte-apn 2>/dev/null | tr '\n' '\r' > "$script" || : > "$script"
+	# Хелпер печатает команды по одной в строке (без CR). Файл команды
+	# обязан заканчиваться LF - иначе atinout считает его некорректным
+	# и НИЧЕГО модему не отправляет. Перевод строки в CR делает сам
+	# atinout, поэтому оставляем "\r\n" (GM510 не видит команду,
+	# завершённую только LF).
+	/usr/libexec/pejir-lte-apn 2>/dev/null | awk '{ printf "%s\r\n", $0 }' > "$script" || : > "$script"
 	[ -s "$script" ] || { rm -f "$script"; return 0; }
 	set_port_speed "$port"
 	timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
@@ -339,7 +341,7 @@ sync_bands() {
 			log "для Quectel поддержаны только LTE-полосы - список пуст, ничего не шлю"
 			return 0
 		fi
-		printf 'AT+QCFG="band",1,%s\r' "$q_bands" > "$script"
+		printf 'AT+QCFG="band",1,%s\r\n' "$q_bands" > "$script"
 		set_port_speed "$port"
 		timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 		rm -f "$script"
@@ -364,7 +366,7 @@ sync_bands() {
 			log "для Fibocom поддержаны только LTE-полосы - список пуст, ничего не шлю"
 			return 0
 		fi
-		printf 'AT+XACT=2,,,%s\r' "$fb_bands" > "$script"
+		printf 'AT+XACT=2,,,%s\r\n' "$fb_bands" > "$script"
 		set_port_speed "$port"
 		timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 		rm -f "$script"
@@ -380,7 +382,7 @@ sync_bands() {
 		return 0
 	fi
 
-	printf 'AT+ZBAND=%s,0,0,%s\r' "$umts" "$lte" > "$script"
+	printf 'AT+ZBAND=%s,0,0,%s\r\n' "$umts" "$lte" > "$script"
 	set_port_speed "$port"
 	timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 	rm -f "$script"
@@ -423,7 +425,7 @@ ecm_call() {
 	# (в L8 AT Command Reference - "12.2.7 +CGACT, PDP Context Activate").
 	if [ "$(modem_family)" = "fibocom" ] || [ "$(modem_family)" = "quectel" ] || \
 	   [ "$(modem_family)" = "generic" ]; then
-		printf 'AT+CGACT=1,1\r' > "$script"
+		printf 'AT+CGACT=1,1\r\n' > "$script"
 		set_port_speed "$port"
 		timeout "$ECM_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 		rm -f "$script"
@@ -432,13 +434,13 @@ ecm_call() {
 	fi
 
 	if [ -x /usr/libexec/pejir-lte-apn ]; then
-		/usr/libexec/pejir-lte-apn 2>/dev/null | grep '^AT+ZECMCALL=' | tr '\n' '\r' > "$script" || : > "$script"
+		/usr/libexec/pejir-lte-apn 2>/dev/null | grep '^AT+ZECMCALL=' | awk '{ printf "%s\r\n", $0 }' > "$script" || : > "$script"
 	fi
 	if [ ! -s "$script" ]; then
 		if [ -n "$apn" ]; then
-			printf 'AT+ZECMCALL=1,%s\r' "$apn" > "$script"
+			printf 'AT+ZECMCALL=1,%s\r\n' "$apn" > "$script"
 		else
-			printf 'AT+ZECMCALL=1\r' > "$script"
+			printf 'AT+ZECMCALL=1\r\n' > "$script"
 		fi
 	fi
 	# Ошибку игнорируем: на модемах без ECM-поддержки вызов не нужен,
diff --git a/package/pejir-lte-base/root/usr/bin/mdm-at b/package/pejir-lte-base/root/usr/bin/mdm-at
index a1b16ece..755d394e 100755
