@@ -46,7 +46,7 @@ at_ask() {
 	_acmd="$2"
 	_script="/tmp/pejir-modem-ctl.$$"
 
-	printf '%s\r' "$_acmd" > "$_script"
+	printf '%s\r\n' "$_acmd" > "$_script"
 	stty -F "$_aport" 115200 raw -echo 2>/dev/null || true
 	_out=$(timeout "$AT_TIMEOUT" atinout "$_script" "$_aport" - 2>/dev/null)
 	rm -f "$_script"
