index 0000000..f321ac5
--- /dev/null
+++ b/package/luci-app-perenio/root/usr/share/pejir/wifi-config.sh
@@ -0,0 +1,219 @@
+#!/bin/sh
+# Общая логика настройки Wi-Fi для Perenio PEJIR01.
+#
+# Железо (два радио, разные диапазоны):
+#   MediaTek MT7603E (mt7603e)  — только 2.4 ГГц, 3x3
+#   MediaTek MT7612E (mt76x2e)  — 2.4 + 5 ГГц, 802.11ac 2x2
+#
+# Правильная раскладка:
+#   MT7603E — 2.4 ГГц, канал 1, HT20
+#   MT7612E — 5 ГГц,   канал 36, VHT80
+#
+# Канал 36 выбран потому, что он не требует DFS. Для country 00 у каналов
+# 36-48 в regulatory.db снят флаг NO-IR патчем
+# package/firmware/wireless-regdb/patches/500-world-regd-5GHz.patch,
+# поэтому AP в 5 ГГц работает и без явного указания страны.
+#
+# ПОЧЕМУ РАДИО ИЩУТСЯ ПО PCI-ID, А НЕ ПО ИМЕНИ СЕКЦИИ:
+#
+# 1) Имя секции wifi-device (radio0/radio1) задаёт производитель и может
+#    быть любым, в том числе перепутанным или стоковым.
+#
+# 2) Поле option path в /etc/config/wireless — это СУФФИКС реального
+#    sysfs-пути устройства. Проверка в OpenWrt 25.12
+#    (package/network/config/wifi-scripts/files/usr/share/ucode/wifi/utils.uc,
+#    функция phy_path_match):
+#        let phy_path = realpath(phy_filename(phy, "device"));
+#        return substr(phy_path, -length(path)) == path;
+#    То есть сравнивается окончание строки. Та же логика в iwinfo
+#    (nl80211_phy_path_str) и в генераторе wifi-detect.uc.
+#
+# 3) ТОПОЛОГИЯ PCIe МЕНЯЕТСЯ МЕЖДУ ЯДРАМИ, поэтому путь нельзя
+#    захардкодить. Upstream-скрипт миграции для mt7621
+#    (target/linux/ramips/mt7621/base-files/etc/hotplug.d/ieee80211/05-wifi-migrate)
+#    как раз переписывает пути при смене ядра:
+#        '1e140000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
+#     -> '1e140000.pcie/pci0000:00/0000:00:01.0/0000:01:00.0'
+#    То есть набор корневых портов (0000:00:00.0 / 0000:00:01.0 / ...)
+#    отличается от версии к версии ядра.
+#
+# Поэтому здесь путь ВЫЧИСЛЯЕТСЯ в runtime: берём realpath() каталога
+# /sys/bus/pci/devices/<addr> и отбрасываем префикс /sys/devices/ и
+# "platform/" — ровно так же, как это делает wifi-detect.uc. А к какому
+# радио относится устройство, определяем по PCI device ID:
+#    0x7603 — MT7603E (2.4 ГГц), 0x7612 — MT7612E (5 ГГц).
+# Это устойчиво к любой нумерации шин и к перестановке радио.
+#
+# Файл вызывается из /etc/uci-defaults/50-perenio-wifi (первая загрузка)
+# и из /etc/uci-defaults/51-pejir-wifi-dualband (уже прошитые устройства).
+# Он идемпотентен и НЕ затирает настройки пользователя: SSID, ключ и
+# страна сохраняются, меняются только полоса/канал/ширина канала.
+
+PEJIR_WIFI_SSID_2G='Perenio PEJIR01'
+PEJIR_WIFI_SSID_5G='Perenio PEJIR01-5G'
+PEJIR_WIFI_KEY='pejir012345'
+
+# PCI device ID чипов MediaTek (vendor 0x14c3):
+#   0x7603 — MT7603E, только 2.4 ГГц
+#   0x7612 — MT7612E, 2.4 + 5 ГГц (mt76x2, vht=true)
+PEJIR_WIFI_PCI_ID_2G='0x7603'
+PEJIR_WIFI_PCI_ID_5G='0x7612'
+
+# Запасные пути (если sysfs недоступен) — по данным живого устройства.
+PEJIR_WIFI_PATH_2G='1e140000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
+PEJIR_WIFI_PATH_5G='1e140000.pcie/pci0000:00/0000:00:01.0/0000:02:00.0'
+
+# Найти PCI-устройство с нужным device ID и вернуть его sysfs-путь
+# в формате, который ждёт option path.
+#
+# Реальный путь выглядит так:
+#   /sys/devices/platform/1e140000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0
+# option path — это остаток после "/sys/devices/" и "platform/":
+#   1e140000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0
+pejir_wifi_path_by_pci_id() {
+	local id="$1" dev real
+
+	for dev in /sys/bus/pci/devices/*; do
+		[ -e "$dev/device" ] || continue
+		[ "$(cat "$dev/device" 2>/dev/null)" = "$id" ] || continue
+		real="$(readlink -f "$dev" 2>/dev/null)" || continue
+		[ -n "$real" ] || continue
+
+		# option path — это СУФФИКС реального sysfs-пути (проверка в
+		# OpenWrt: substr(phy_path, -length(path)) == path). Отрезаем
+		# корень sysfs, затем "platform/" — так же, как wifi-detect.uc:
+		#   devpath = replace(devpath, /^\/sys\/devices\//, "")
+		#   if (match(devpath, /^platform\/.*\/pci/))
+		#       devpath = replace(devpath, /^platform\//, "")
+		#
+		# Реальный путь:
+		#   /sys/devices/platform/1e140000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0
+		# Результат:
+		#   1e140000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0
+		real="${real#*/devices/}"
+		case "$real" in
+			platform/*pci*) real="${real#platform/}" ;;
+		esac
+		case "$real" in
+			*pci*) echo "$real"; return 0 ;;
+		esac
+	done
+
+	return 1
+}
+
+# Найти секцию wifi-device по имени устройства (точное совпадение).
+pejir_wifi_iface_by_device() {
+	uci -q show wireless 2>/dev/null \
+		| sed -n "s/^wireless\.\([^.=]*\)\.device='\(.*\)'$/\1|\2/p" \
+		| awk -F'|' -v d="$1" '$2 == d { print $1; exit }'
+}
+
+# Найти секцию wifi-device по PCI-адресу (окончание option path).
+# Это устойчиво к тому, что вендор или прошлая версия прошивки записали
+# в path полный sysfs-путь с другим префиксом: важна только шина/слот.
+pejir_wifi_device_by_pci_addr() {
+	uci -q show wireless 2>/dev/null \
+		| sed -n "s/^wireless\.\([^.=]*\)\.path='\(.*\)'$/\1|\2/p" \
+		| awk -F'|' -v a="$1" '{
+			n = split($2, p, "/")
+			if (p[n] == a) { print $1; exit }
+		}'
+}
+
+pejir_wifi_apply() {
+	local path2g path5g addr2g addr5g r0 r1 i0 i1 ssid0 ssid1 key0 key1 enc0 enc1
+
+	# --- находим радио по PCI device ID ---------------------------------
+	path2g="$(pejir_wifi_path_by_pci_id "$PEJIR_WIFI_PCI_ID_2G")" \
+		|| path2g="$PEJIR_WIFI_PATH_2G"
+	path5g="$(pejir_wifi_path_by_pci_id "$PEJIR_WIFI_PCI_ID_5G")" \
+		|| path5g="$PEJIR_WIFI_PATH_5G"
+
+	addr2g="${path2g##*/}"
+	addr5g="${path5g##*/}"
+
+	# Секции wifi-device: ищем по PCI-адресу (последний элемент пути),
+	# иначе — по самому path.
+	r0="$(pejir_wifi_device_by_pci_addr "$addr2g")"
+	[ -n "$r0" ] || r0="$(pejir_wifi_device_by_pci_addr "$addr5g")"
+	r1="$(pejir_wifi_device_by_pci_addr "$addr5g")"
+
+	if [ -z "$r0" ] && [ -z "$r1" ]; then
+		# Конфига беспроводных нет (первая загрузка) — создаём секции
+		# с путями PCI.
+		r0='radio0'
+		r1='radio1'
+	fi
+	[ -n "$r0" ] || r0='radio0'
+	[ -n "$r1" ] || r1='radio1'
+
+	# --- создаём/обновляем wifi-device ----------------------------------
+	# path пишем только если он отличается от вычисленного: у уже
+	# настроенного устройства пользователь мог править путь руками.
+	[ "$(uci -q get wireless.$r0.path)" = "$path2g" ] || \
+		uci set wireless.$r0.path="$path2g"
+	[ "$(uci -q get wireless.$r0.type)" = "mac80211" ] || \
+		uci set wireless.$r0.type='mac80211'
+	[ "$(uci -q get wireless.$r1.path)" = "$path5g" ] || \
+		uci set wireless.$r1.path="$path5g"
+	[ "$(uci -q get wireless.$r1.type)" = "mac80211" ] || \
+		uci set wireless.$r1.type='mac80211'
+
+	# --- полосы и каналы ------------------------------------------------
+	# MT7603E — только 2.4 ГГц; MT7612E — 5 ГГц.
+	uci set wireless.$r0.band='2g'
+	uci set wireless.$r0.channel='1'
+	uci set wireless.$r0.htmode='HT20'
+	uci set wireless.$r1.band='5g'
+	uci set wireless.$r1.channel='36'
+	uci set wireless.$r1.htmode='VHT80'
+
+	# --- интерфейсы -----------------------------------------------------
+	i0="$(pejir_wifi_iface_by_device "$r0")"
+	i1="$(pejir_wifi_iface_by_device "$r1")"
+	[ -n "$i0" ] || i0="default_$r0"
+	[ -n "$i1" ] || i1="default_$r1"
+
+	uci set wireless.$i0=wifi-iface
+	uci set wireless.$i0.device="$r0"
+	uci set wireless.$i1=wifi-iface
+	uci set wireless.$i1.device="$r1"
+
+	[ -n "$(uci -q get wireless.$i0.mode)" ] || uci set wireless.$i0.mode='ap'
+	[ -n "$(uci -q get wireless.$i0.network)" ] || uci set wireless.$i0.network='lan'
+	[ -n "$(uci -q get wireless.$i1.mode)" ] || uci set wireless.$i1.mode='ap'
+	[ -n "$(uci -q get wireless.$i1.network)" ] || uci set wireless.$i1.network='lan'
+
+	ssid0="$(uci -q get wireless.$i0.ssid)"
+	ssid1="$(uci -q get wireless.$i1.ssid)"
+	[ -n "$ssid0" ] || ssid0="$PEJIR_WIFI_SSID_2G"
+	[ -n "$ssid1" ] || ssid1="$ssid0"
+
+	# Одинаковый SSID в обоих диапазонах неудобен: с телефона не видно,
+	# к какому диапазону подключились. Разводим их, добавив "-5G".
+	[ "$ssid1" = "$ssid0" ] && ssid1="$ssid0-5G"
+
+	key0="$(uci -q get wireless.$i0.key)"
+	key1="$(uci -q get wireless.$i1.key)"
+	enc0="$(uci -q get wireless.$i0.encryption)"
+	enc1="$(uci -q get wireless.$i1.encryption)"
+
+	[ -n "$enc0" ] || enc0='psk2'
+	[ -n "$key0" ] || key0="$PEJIR_WIFI_KEY"
+	[ -n "$enc1" ] || enc1="$enc0"
+	[ -n "$key1" ] || key1="$key0"
+
+	uci set wireless.$i0.ssid="$ssid0"
+	uci set wireless.$i0.encryption="$enc0"
+	uci set wireless.$i0.key="$key0"
+	uci set wireless.$i1.ssid="$ssid1"
+	uci set wireless.$i1.encryption="$enc1"
+	uci set wireless.$i1.key="$key1"
+
+	[ -n "$(uci -q get wireless.$i0.disabled)" ] || uci set wireless.$i0.disabled='0'
+	[ -n "$(uci -q get wireless.$i1.disabled)" ] || uci set wireless.$i1.disabled='0'
+
+	uci commit wireless
+	return 0
+}
