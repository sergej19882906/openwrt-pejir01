Диагностика на устройстве (релиз .32): модем отвечает на AT на
/dev/ttyUSB1 и /dev/ttyUSB2 (и сырым AT, и через atinout, на всех
скоростях), а /dev/ttyUSB0 выдаёт двоичный шум. То есть модем
работоспособен, но в момент загрузки не отвечает: AT-порт GM510
оживает через минуту-две после перечисления USB.

Причина, почему скрипты это не видели:
  * фоновый повтор делал ровно ОДНУ попытку сразу после старта и
    сдавался, хотя модем через минуту отвечал;
  * 47-pejir-lte выходил до ensure_lte_section, и секция network.lte
    оставалась без device - интерфейс не поднимался;
  * 41-pejir-modem записывал неподтверждённый /dev/ttyUSB0, и он
    сохранялся навсегда;
  * в переборе портов неподтверждённый порт из настроек стоял
    первым, а на этой модели ttyUSB0 - как раз мусорный.

Что изменено:
  * 40-pejir-sms: фоновый режим опрашивает модем до 15 минут
    (90 попыток по 10 с) вместо одной попытки; порядок портов -
    подтверждённый, ttyUSB2, ttyUSB1, ttyUSB0, ttyACM, и только
    потом порт из настроек;
  * 47-pejir-lte: фоновый режим ждёт ответа модема до 15 минут;
    USB-NIC модема ищется всегда, AT-команды (APN, ECM data call) -
    только при ответе модема;
  * 41-pejir-modem: неподтверждённый порт не пишется, последний
    живой AT-ответ запоминается в /etc/pejir/at-port;
  * 40-pejir-sms: запасной порт берётся из /etc/pejir/at-port.
---
 .../root/etc/init.d/41-pejir-modem            | 27 ++++++--
 .../root/etc/init.d/47-pejir-lte              | 62 ++++++++++++++++---
 .../pejir-sms/root/etc/init.d/40-pejir-sms    | 59 +++++++++++++-----
 3 files changed, 120 insertions(+), 28 deletions(-)

diff --git a/package/pejir-lte-base/root/etc/init.d/41-pejir-modem b/package/pejir-lte-base/root/etc/init.d/41-pejir-modem
index 4ad37ff..3d31a0e 100644
--- a/package/pejir-lte-base/root/etc/init.d/41-pejir-modem
+++ b/package/pejir-lte-base/root/etc/init.d/41-pejir-modem
@@ -25,24 +25,41 @@ port_alive() {
 	mdm-at "AT" "$p" 2>/dev/null | grep -q "OK"
 }
 
+# Последний порт, подтверждённый живым AT-ответом.
+#
+# Нужен как запасной вариант: если модем при загрузке не отвечает на AT,
+# скрипты SMS и LTE всё равно должны знать, какой порт использовать.
+# Значение пишется только после настоящего AT-ответа, поэтому
+# неподтверждённый /dev/ttyUSB0 сюда не попадёт.
+remember_port() {
+	local p="$1"
+
+	mkdir -p /etc/pejir
+	printf '%s\n' "$p" > /etc/pejir/at-port
+}
+
 start_service() {
 	local port saved
 
 	port="$(mdm-at --port 2>/dev/null)"
-	[ -n "$port" ] || port="/dev/ttyUSB0"
-
 	saved="$(uci -q get modeminfo.@modeminfo[0].device)"
 
 	# Сохранённый пользователем порт не трогаем - но только если модем на
 	# нём действительно отвечает. Раньше порт записывался вслепую: если
 	# AT-порт определить не удалось, подставлялся /dev/ttyUSB0, и он
-	# сохранялся навсегда. Теперь такой порт при следующей загрузке
-	# заменяется найденным (на GM510 это ttyUSB2).
+	# сохранялся навсегда - потом ни SMS, ни LTE не находили правильный
+	# порт. Теперь неподтверждённый порт не записывается вовсе.
 	if [ -n "$saved" ] && port_alive "$saved"; then
+		remember_port "$saved"
 		return 0
 	fi
 
-	write_modeminfo "$port"
+	if [ -n "$port" ]; then
+		write_modeminfo "$port"
+		remember_port "$port"
+	else
+		logger -t pejir-modem "AT-порт модема не определён - оставляем прошлый"
+	fi
 }
 
 stop_service() {
diff --git a/package/pejir-lte-base/root/etc/init.d/47-pejir-lte b/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
index dafdf86..6dde263 100644
--- a/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
+++ b/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
@@ -265,6 +265,20 @@ usb_modem_present() {
 # устройства, а не пробуем AT "в пустоту".
 MODEM_WAIT="${PEJIR_MODEM_WAIT:-120}"
 
+# Ждём появления USB-модема (не AT-ответа: узла /dev/ttyUSB* может не
+# быть ещё минуту после загрузки).
+wait_for_modem_usb() {
+	local waited=0
+
+	while [ "$waited" -lt "$MODEM_WAIT" ]; do
+		usb_modem_present && return 0
+		sleep 5
+		waited=$((waited + 5))
+	done
+	return 1
+}
+
+# Ждём модема И его AT-ответа.
 wait_for_modem() {
 	local waited=0
 
@@ -284,32 +298,62 @@ spawn_retry() {
 
 	if command -v setsid >/dev/null 2>&1; then
 		( env $vars setsid "$script" start >/dev/null 2>&1 & )
+	elif command -v nohup >/dev/null 2>&1; then
+		( env $vars nohup "$script" start >/dev/null 2>&1 & )
 	else
 		( env $vars "$script" start >/dev/null 2>&1 & )
 	fi
 }
 
 start_service() {
-	local ifname proto
-
-	if ! wait_for_modem; then
-		log "модем не появился (USB?) - продолжаем в фоне"
-		if [ "$PEJIR_LTE_RETRY" != "1" ]; then
-			spawn_retry "PEJIR_LTE_RETRY=1 PEJIR_MODEM_WAIT=900" /etc/init.d/47-pejir-lte
+	local ifname proto have_at=""
+
+	if [ "$PEJIR_LTE_RETRY" = "1" ]; then
+		# Фоновый режим: ждём, пока модем ответит на AT (до 15 минут).
+		# Раньше фоновый повтор делал одну попытку и сдавался, хотя
+		# AT-порт GM510 оживает через минуту-две после перечисления.
+		if ! wait_for_modem; then
+			log "модем так и не ответил на AT - APN и ECM пропущены"
+			return 0
 		fi
+
+		ifname="$(detect_ifname)" || ifname=""
+		[ -n "$ifname" ] || return 0
+
+		ensure_lte_section "$ifname"
+		ensure_firewall
+		sync_apn
+		ecm_call
+		ifup lte >/dev/null 2>&1
 		return 0
 	fi
 
+	# AT-команды нужны только для APN и ECM data call. Сам интерфейс
+	# (cdc_ether на этой плате - ethN) работает и без них: если модем уже
+	# в режиме данных, DHCP по ethN поднимает связь без единой AT-команды.
+	# Поэтому NIC ищем всегда, а AT - как дополнение. Раньше при любом
+	# молчании модема скрипт выходил до ensure_lte_section, и секция
+	# network.lte оставалась без device - интерфейс не поднимался вовсе.
+	wait_for_modem_usb
+
 	ifname="$(detect_ifname)" || ifname=""
 	if [ -z "$ifname" ]; then
-		log "USB-NIC модема не найден — интерфейс LTE не поднимаем"
+		log "USB-NIC модема не найден - интерфейс LTE не поднимаем"
+		spawn_retry "PEJIR_LTE_RETRY=1 PEJIR_MODEM_WAIT=900" /etc/init.d/47-pejir-lte
 		return 0
 	fi
 
 	ensure_lte_section "$ifname"
 	ensure_firewall
-	sync_apn
-	ecm_call
+
+	have_at="$(detect_at_port)"
+	if [ -n "$have_at" ]; then
+		sync_apn
+		ecm_call
+	else
+		log "модем пока не отвечает на AT - APN и ECM пропущены, продолжаем в фоне"
+		spawn_retry "PEJIR_LTE_RETRY=1 PEJIR_MODEM_WAIT=900" /etc/init.d/47-pejir-lte
+	fi
 
 	proto="$(uci -q get network.lte.proto)"
 	if [ "$proto" != "none" ]; then
diff --git a/package/pejir-sms/root/etc/init.d/40-pejir-sms b/package/pejir-sms/root/etc/init.d/40-pejir-sms
index 383c6ad..3a91dfb 100644
--- a/package/pejir-sms/root/etc/init.d/40-pejir-sms
+++ b/package/pejir-sms/root/etc/init.d/40-pejir-sms
@@ -69,15 +69,24 @@ set_port_speed() {
 # загрузке не отвечает на AT (не успел инициализироваться), мы знаем
 # правильный порт.
 at_port_candidates() {
-	local saved
+	local verified saved
 
-	saved="$(uci -q get modeminfo.@modeminfo[0].device 2>/dev/null)"
-	[ -n "$saved" ] && echo "$saved"
+	# Подтверждённый живым AT-ответом порт (41-pejir-modem).
+	verified="$(cat /etc/pejir/at-port 2>/dev/null)"
+	[ -n "$verified" ] && echo "$verified"
+
+	# На GM510 AT-порт - ttyUSB2. ttyUSB0 у этой модели мусорный (отвечает
+	# двоичным шумом, а не "OK"), поэтому он в конце перебора.
 	echo /dev/ttyUSB2
 	echo /dev/ttyUSB1
 	echo /dev/ttyUSB0
 	echo /dev/ttyACM0
 	echo /dev/ttyACM1
+
+	# Порт из настроек LuCI-модема - последним: он может быть
+	# неподтверждённым (раньше туда попадал /dev/ttyUSB0 по умолчанию).
+	saved="$(uci -q get modeminfo.@modeminfo[0].device 2>/dev/null)"
+	[ -n "$saved" ] && echo "$saved"
 }
 
 detect_at_port() {
@@ -135,11 +144,20 @@ spawn_retry() {
 
 	if command -v setsid >/dev/null 2>&1; then
 		( env $vars setsid "$script" start >/dev/null 2>&1 & )
+	elif command -v nohup >/dev/null 2>&1; then
+		( env $vars nohup "$script" start >/dev/null 2>&1 & )
 	else
 		( env $vars "$script" start >/dev/null 2>&1 & )
 	fi
 }
 
+# Сколько попыток опроса модема в фоновом режиме и пауза между ними.
+# 90 попыток по 10 с - около 15 минут: AT-порт GM510 оживает через
+# минуту-две после перечисления USB, а раньше фоновый повтор делал
+# ровно ОДНУ попытку сразу и сдавался.
+SMS_TRIES="${PEJIR_SMS_TRIES:-90}"
+SMS_SLEEP="${PEJIR_SMS_SLEEP:-10}"
+
 write_conf() {
 	local port="$1"
 
@@ -196,25 +214,38 @@ start_service() {
 
 	# Ждём появления USB-модема и пробуем AT-порт.
 	wait_for_modem_usb
-	port="$(detect_at_port)"
 
-	if [ -z "$port" ] && [ "$PEJIR_SMS_RETRY" != "1" ]; then
-		# Модем ещё не готов: загрузку не блокируем, продолжаем поиск
-		# в фоне (до 15 минут).
-		logger -t pejir-sms "AT-порт модема пока не найден, поиск продолжается в фоне"
-		spawn_retry "PEJIR_SMS_RETRY=1 PEJIR_MODEM_WAIT=900" /etc/init.d/40-pejir-sms
-		return 0
+	if [ "$PEJIR_SMS_RETRY" = "1" ]; then
+		# Фоновый режим: опрашиваем модем, пока он не ответит на AT
+		# (до 15 минут). Одна попытка была недостаточна: модем после
+		# перечисления USB отвечает на AT не сразу.
+		for i in $(seq 1 "$SMS_TRIES"); do
+			port="$(detect_at_port)"
+			[ -n "$port" ] && break
+			sleep "$SMS_SLEEP"
+		done
+	else
+		port="$(detect_at_port)"
+		if [ -z "$port" ]; then
+			# Модем ещё не готов: загрузку не блокируем, продолжаем
+			# поиск в фоне.
+			logger -t pejir-sms "AT-порт модема пока не найден, поиск продолжается в фоне"
+			spawn_retry "PEJIR_SMS_RETRY=1" /etc/init.d/40-pejir-sms
+			return 0
+		fi
 	fi
 
 	if [ -z "$port" ]; then
-		# Фоновый повтор тоже не дождался ответа AT: берём порт из
-		# modeminfo - он проверен живым AT-запросом в 41-pejir-modem.
-		port="$(uci -q get modeminfo.@modeminfo[0].device 2>/dev/null)"
+		# Фоновый повтор тоже не дождался ответа AT: берём последний
+		# подтверждённый порт (/etc/pejir/at-port пишет 41-pejir-modem
+		# только после настоящего AT-ответа), а не неподтверждённое
+		# значение из настроек.
+		port="$(cat /etc/pejir/at-port 2>/dev/null)"
 		if [ -z "$port" ] || [ ! -c "$port" ]; then
 			logger -t pejir-sms "AT-порт модема не найден, smsd не запущен"
 			return 0
 		fi
-		logger -t pejir-sms "AT-порт не отвечает, берём $port из modeminfo"
+		logger -t pejir-sms "AT-порт не отвечает, берём подтверждённый $port"
 	fi
 
 	write_conf "$port"
-- 
