From 843cd2660c761efd64f92e0d088e807b33b66b82 Mon Sep 17 00:00:00 2001
From: sergej19882906 <sergej19882906@users.noreply.github.com>
Date: Sat, 31 Oct 2026 04:00:46 +0300
Subject: [PATCH 2/4] ramips: mt7621: enable LXC on PEJIR01

- kernel config: CGROUP_DEVICE, CGROUP_FREEZER (legacy controllers
  expected by lxc tooling; cgroup v2 is used at runtime)
- pejir-lxc-base package: mounts cgroup2 early, creates /srv/lxc
  (containers live on extroot), pulls kmod-veth for container networking
- image config: lxc 7.0 stack (lxc, lxc-auto, attach/create/templates/hooks)

This mirrors the vendor firmware LXC Execution Environment on stock
OpenWrt 19.07, now on upstream OpenWrt 25.12.
---
 package/pejir-lxc-base/Makefile           | 35 +++++++++++++++++++++++
 package/pejir-lxc-base/files/cgroup2.init | 15 ++++++++++
 package/pejir-lxc-base/files/lxc.defaults |  3 ++
 target/linux/ramips/mt7621/config-6.12    |  2 ++
 4 files changed, 55 insertions(+)
 create mode 100644 package/pejir-lxc-base/Makefile
 create mode 100644 package/pejir-lxc-base/files/cgroup2.init
 create mode 100644 package/pejir-lxc-base/files/lxc.defaults

diff --git a/package/pejir-lxc-base/Makefile b/package/pejir-lxc-base/Makefile
new file mode 100644
index 0000000..ba869ef
--- /dev/null
+++ b/package/pejir-lxc-base/Makefile
@@ -0,0 +1,35 @@
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=pejir-lxc-base
+PKG_VERSION:=1
+PKG_RELEASE:=3
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/pejir-lxc-base
+  SECTION:=utils
+  CATEGORY:=Utilities
+  TITLE:=PEJIR01 LXC base: cgroup2 mount and /srv/lxc
+  DEPENDS:=+kmod-veth +lxc-templates +lxc-configs +liblxc +libcap +libopenssl +libdbus +libseccomp
+endef
+
+define Package/pejir-lxc-base/description
+  Mounts cgroup2 for LXC and creates /srv/lxc storage dir.
+endef
+
+define Build/Prepare
+endef
+
+define Build/Compile
+endef
+
+define Package/pejir-lxc-base/install
+	$(INSTALL_DIR) $(1)/usr/bin
+	$(CP) $(wildcard $(BUILD_DIR)/lxc-*/ipkg-install/usr/bin/lxc-create) $(1)/usr/bin/lxc-create
+	$(INSTALL_DIR) $(1)/etc/init.d
+	$(INSTALL_BIN) ./files/cgroup2.init $(1)/etc/init.d/cgroup2
+	$(INSTALL_DIR) $(1)/etc/uci-defaults
+	$(INSTALL_DATA) ./files/lxc.defaults $(1)/etc/uci-defaults/40-pejir-lxc
+endef
+
+$(eval $(call BuildPackage,pejir-lxc-base))
diff --git a/package/pejir-lxc-base/files/cgroup2.init b/package/pejir-lxc-base/files/cgroup2.init
new file mode 100644
index 0000000..374c83c
--- /dev/null
+++ b/package/pejir-lxc-base/files/cgroup2.init
@@ -0,0 +1,15 @@
+#!/bin/sh /etc/rc.common
+
+START=12
+STOP=90
+
+start() {
+    if ! grep -q cgroup2 /proc/mounts; then
+        mkdir -p /sys/fs/cgroup
+        mount -t cgroup2 none /sys/fs/cgroup
+    fi
+}
+
+stop() {
+    :
+}
diff --git a/package/pejir-lxc-base/files/lxc.defaults b/package/pejir-lxc-base/files/lxc.defaults
new file mode 100644
index 0000000..7061a1a
--- /dev/null
+++ b/package/pejir-lxc-base/files/lxc.defaults
@@ -0,0 +1,3 @@
+#!/bin/sh
+mkdir -p /srv/lxc
+exit 0
diff --git a/target/linux/ramips/mt7621/config-6.12 b/target/linux/ramips/mt7621/config-6.12
index 32c23b8..7f375f6 100644
--- a/target/linux/ramips/mt7621/config-6.12
+++ b/target/linux/ramips/mt7621/config-6.12
@@ -318,3 +318,5 @@ CONFIG_ZLIB_INFLATE=y
 CONFIG_ZSTD_COMMON=y
 CONFIG_ZSTD_COMPRESS=y
 CONFIG_ZSTD_DECOMPRESS=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_FREEZER=y
