diff --git a/package/pejir-lte-base/root/etc/init.d/48-pejir-at-watch b/package/pejir-lte-base/root/etc/init.d/48-pejir-at-watch
new file mode 100755
index 00000000..4680bb08
--- /dev/null
+++ b/package/pejir-lte-base/root/etc/init.d/48-pejir-at-watch
@@ -0,0 +1,25 @@
+#!/bin/sh /etc/rc.common
+# Сторож AT-порта модема: если модем перестал отвечать, порт
+# перепривязывается (unbind/bind USB-драйвера) и LTE перезапускается.
+# Без этого зависший порт означал перезагрузку роутера.
+#
+# Порядок запуска: 41-pejir-modem (93) инициализирует порт,
+# 47-pejir-lte (94) поднимает связь, а сторож стартует последним (95),
+# чтобы первую проверку он делал не сразу, а через INTERVAL секунд.
+
+START=95
+STOP=0
+USE_PROCD=1
+
+start_service() {
+	procd_open_instance
+	procd_set_param command /usr/libexec/pejir-at-watch watch
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_set_param respawn 3600 5 5
+	procd_close_instance
+}
+
+stop_service() {
+	return 0
+}
diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-at-watch b/package/pejir-lte-base/root/usr/libexec/pejir-at-watch
new file mode 100755
index 00000000..a7d56e46
--- /dev/null
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-at-watch
@@ -0,0 +1,216 @@
+#!/bin/sh
+# Сторож AT-порта модема.
+#
+# Зачем. USB-интерфейс модема иногда "залипает": процесс висит в
+# состоянии D на порту, модем не отвечает на AT, и LTE/SMS/USSD
+# перестают работать до перезагрузки роутера. На USB это лечится
+# перепривязкой драйвера последовательного порта: интерфейс
+# отсоединяется (unbind) и подключается обратно (bind) - порт
+# оживает, модем при этом не перезагружается и LTE не рвётся
+# (сетевая часть модема - другой USB-интерфейс).
+#
+# Команды:
+#   check   - отвечает ли порт на AT (код 0 - да, 1 - нет);
+#   recover - если порт молчит: перепривязать драйвер, найти порт
+#             заново и перезапустить LTE;
+#   watch   - бесконечный цикл: раз в INTERVAL секунд вызывает recover;
+#   status  - короткое состояние для диагностики.
+#
+# Пороги (можно переопределить переменными окружения):
+#   PEJIR_AT_WATCH_INTERVAL - период проверки, с (по умолчанию 300);
+#   PEJIR_AT_WATCH_FAILS    - сколько неудачных проверок подряд
+#                             считать зависанием (по умолчанию 2);
+#   PEJIR_AT_WATCH_MAX      - сколько попыток восстановления за
+#                             одну загрузку (по умолчанию 3).
+
+# Файл с подтверждённым AT-портом и каталог состояния можно переопределить
+# переменными окружения - так helper проверяется тестом без устройства.
+PORT_FILE="${PEJIR_AT_PORT_FILE:-/etc/pejir/at-port}"
+STATE_DIR="${PEJIR_AT_WATCH_STATE:-/tmp/pejir-at-watch}"
+INTERVAL="${PEJIR_AT_WATCH_INTERVAL:-300}"
+FAILS="${PEJIR_AT_WATCH_FAILS:-2}"
+MAX_TRIES="${PEJIR_AT_WATCH_MAX:-3}"
+
+log() {
+	logger -t pejir-at-watch "$*" 2>/dev/null
+	echo "pejir-at-watch: $*" 2>/dev/null
+}
+
+mkdir -p "$STATE_DIR" 2>/dev/null
+
+# Порт, который мы используем.
+current_port() {
+	[ -f "$PORT_FILE" ] && head -n 1 "$PORT_FILE" 2>/dev/null
+}
+
+# Отвечает ли порт на AT.
+#
+# На GM510 ответ зависит от символа конца строки: на "AT\r" модем
+# отвечает "OK", на "AT\n" - молчит. mdm-at уже шлёт правильный
+# терминатор, поэтому пользуемся им.
+port_alive() {
+	local p="$1"
+
+	[ -n "$p" ] || return 1
+	[ -c "$p" ] || return 1
+	mdm-at "AT" "$p" 2>/dev/null | grep -q "OK"
+}
+
+# USB-интерфейс, которому принадлежит tty-устройство.
+#
+# /sys/class/tty/ttyUSB2/device -> ... -> каталог USB-интерфейса
+# (в нём есть bInterfaceNumber). По нему же находится драйвер.
+usb_interface() {
+	local tty="$1" node level=0
+
+	[ -n "$tty" ] || return 1
+	node="$(readlink -f "/sys/class/tty/${tty##*/}/device" 2>/dev/null)" || return 1
+	[ -n "$node" ] || return 1
+	while [ ! -f "$node/bInterfaceNumber" ] && [ "$level" -lt 4 ]; do
+		node="${node%/*}"
+		level=$((level + 1))
+	done
+	[ -f "$node/bInterfaceNumber" ] || return 1
+	printf '%s\n' "$node"
+}
+
+# Перепривязка драйвера последовательного порта.
+rebind_driver() {
+	local tty="$1" iface driver name
+
+	iface="$(usb_interface "$tty")" || return 1
+	driver="$(readlink -f "$iface/driver" 2>/dev/null)"
+	[ -n "$driver" ] || return 1
+	[ -w "$driver/unbind" ] && [ -w "$driver/bind" ] || return 1
+	name="${iface##*/}"
+
+	log "порт $tty не отвечает - перепривязываю драйвер (${driver##*/}, интерфейс $name)"
+	printf '%s' "$name" > "$driver/unbind" 2>/dev/null || return 1
+	sleep 2
+	printf '%s' "$name" > "$driver/bind" 2>/dev/null || return 1
+	return 0
+}
+
+# Найти AT-порт заново и запомнить его.
+redetect_port() {
+	local p
+
+	p="$(mdm-at --port 2>/dev/null)"
+	[ -n "$p" ] || return 1
+	mkdir -p /etc/pejir 2>/dev/null
+	printf '%s\n' "$p" > "$PORT_FILE" 2>/dev/null
+	uci set modeminfo.modeminfo='modeminfo' 2>/dev/null
+	uci set modeminfo.modeminfo.device="$p" 2>/dev/null
+	uci commit modeminfo 2>/dev/null
+	printf '%s\n' "$p"
+}
+
+cmd_check() {
+	local port
+
+	port="$(current_port)"
+	if [ -z "$port" ]; then
+		port="$(mdm-at --port 2>/dev/null)"
+	fi
+	[ -n "$port" ] || return 1
+	port_alive "$port"
+}
+
+cmd_recover() {
+	local port fails tries
+
+	port="$(current_port)"
+	if [ -z "$port" ]; then
+		port="$(mdm-at --port 2>/dev/null)"
+	fi
+	if [ -z "$port" ]; then
+		log "AT-порт не определён - восстановление не требуется"
+		return 0
+	fi
+
+	if port_alive "$port"; then
+		printf '0' > "$STATE_DIR/fails" 2>/dev/null
+		return 0
+	fi
+
+	# Счётчик неудачных проверок: одна неудача - это ещё не зависание.
+	fails="$(cat "$STATE_DIR/fails" 2>/dev/null)"
+	case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
+	fails=$((fails + 1))
+	printf '%s' "$fails" > "$STATE_DIR/fails" 2>/dev/null
+	[ "$fails" -ge "$FAILS" ] || return 0
+
+	tries="$(cat "$STATE_DIR/tries" 2>/dev/null)"
+	case "$tries" in ''|*[!0-9]*) tries=0 ;; esac
+	if [ "$tries" -ge "$MAX_TRIES" ]; then
+		log "попыток восстановления уже $tries - больше не пробую (нужна перезагрузка)"
+		return 1
+	fi
+
+	# Перепривязка имеет смысл только для USB-портов: у /dev/ttyS*
+	# и pts-драйвера "unbind" не существует.
+	case "$port" in
+	/dev/ttyUSB*) ;;
+	*)
+		log "порт $port не USB-серийный - перепривязка невозможна"
+		return 1
+		;;
+	esac
+
+	tries=$((tries + 1))
+	printf '%s' "$tries" > "$STATE_DIR/tries" 2>/dev/null
+
+	if ! rebind_driver "$port"; then
+		log "не удалось перепривязать драйвер порта $port"
+		return 1
+	fi
+
+	# Порт мог сменить имя (ttyUSB2 -> ttyUSB1): ищем заново.
+	sleep 5
+	newport="$(redetect_port)"
+	if [ -z "$newport" ]; then
+		log "после перепривязки AT-порт не найден - модем, похоже, не проснулся"
+		printf '0' > "$STATE_DIR/fails" 2>/dev/null
+		return 1
+	fi
+	log "порт восстановлен: $port -> $newport, перезапускаю LTE"
+	/etc/init.d/47-pejir-lte restart >/dev/null 2>&1
+	printf '0' > "$STATE_DIR/fails" 2>/dev/null
+	return 0
+}
+
+cmd_watch() {
+	while :; do
+		sleep "$INTERVAL"
+		cmd_recover >/dev/null 2>&1
+	done
+}
+
+cmd_status() {
+	local port fails tries
+
+	port="$(current_port)"
+	fails="$(cat "$STATE_DIR/fails" 2>/dev/null)"
+	tries="$(cat "$STATE_DIR/tries" 2>/dev/null)"
+	case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
+	case "$tries" in ''|*[!0-9]*) tries=0 ;; esac
+	echo "порт=$port"
+	echo "неудачных_проверок=$fails"
+	echo "попыток_восстановления=$tries"
+	if port_alive "$port"; then
+		echo "состояние=отвечает"
+	else
+		echo "состояние=молчит"
+	fi
+}
+
+case "$1" in
+check)   cmd_check ;;
+recover) cmd_recover ;;
+watch)   cmd_watch ;;
+status)  cmd_status ;;
+*)
+	echo "usage: $0 {check|recover|watch|status}" >&2
+	exit 2
+	;;
+esac
