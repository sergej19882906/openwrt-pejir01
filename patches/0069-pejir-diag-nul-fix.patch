Свойства device-tree в /proc/device-tree отдаются ядром с нулевым байтом
на конце. rpcd/ubus передаёт stdout как blobmsg-строку, а она обрезается
по первому NUL - из-за этого страница диагностики показывала только
'IoT Perenio Elegance PEJIR01', а весь остальной вывод (USB, модем, LTE,
батарея) терялся.

Теперь весь вывод helper'а прогоняется через tr -d '\000', а блок
'Модель и DTB' показывает модель, compatible, версию ядра, размер FDT
и дерево узлов. Для теста добавлена переменная DT_ROOT.
---
 .../root/usr/libexec/perenio-diag             | 97 ++++++++++++-------
 1 file changed, 60 insertions(+), 37 deletions(-)

diff --git a/package/luci-app-perenio/root/usr/libexec/perenio-diag b/package/luci-app-perenio/root/usr/libexec/perenio-diag
index 75e943b..1e26009 100755
--- a/package/luci-app-perenio/root/usr/libexec/perenio-diag
+++ b/package/luci-app-perenio/root/usr/libexec/perenio-diag
@@ -1,38 +1,61 @@
 #!/bin/sh
-echo "=== Модель и DTB ==="
-cat /proc/device-tree/model 2>/dev/null; echo
-echo -n "узлы device-tree: "; ls /proc/device-tree/ 2>/dev/null | tr "\n" " "; echo
-echo -n "узлы regulator*: "; ls -d /proc/device-tree/regulator* 2>/dev/null | tr "\n" " "; echo
-echo -n "xhci status: "; cat /proc/device-tree/xhci@1e1c0000/status 2>/dev/null; echo
-echo -n "xhci children: "; ls /proc/device-tree/xhci@1e1c0000/ 2>/dev/null | tr "\n" " "; echo
-echo -n "cmdline: "; cat /proc/cmdline 2>/dev/null; echo
-echo "=== USB: сообщения ядра ==="
-dmesg 2>/dev/null | grep -iE "xhci|ehci|ohci|uhci|dwc|usb [0-9]|new .*USB device|option|cdc_ether|cdc_ncm|cdc_mbim|rndis|scsi|uas|regulator" | tail -40
-echo "=== USB: устройства ==="
-echo -n "sysfs: "; ls /sys/bus/usb/devices/ 2>/dev/null | tr "\n" " "; echo
-for d in /sys/bus/usb/devices/*/; do [ -f "$d/idVendor" ] && echo "$(basename $d) $(cat $d/idVendor 2>/dev/null):$(cat $d/idProduct 2>/dev/null) $(cat $d/product 2>/dev/null)"; done
-echo "=== Модем, UART и мультиплексор ==="
-ls -l /dev/ttyUSB* /dev/ttyACM* /dev/cdc-wdm* /dev/umxtty* /dev/ttyS* 2>&1
-echo "--- modeminfo ---"
-uci show modeminfo 2>/dev/null
-echo "=== Разметка памяти: MTD и UBI ==="
-cat /proc/mtd 2>/dev/null
-echo -n "тома UBI: "; for u in /sys/class/ubi/ubi*_*; do [ -f "$u/name" ] && echo -n "$(basename $u)=$(cat $u/name) "; done; echo
-echo -n "imgidx: "; fw_printenv -n imgidx 2>/dev/null; echo
-echo "=== Wi-Fi ==="
-iw dev 2>/dev/null
-grep -E "option (ssid|disabled|country|channel|htmode)" /etc/config/wireless 2>/dev/null
-dmesg 2>/dev/null | grep -iE "mt76|mt7603|mt7612|wiphy|ieee80211|firmware|calib" | tail -25
-echo -n "firmware mt76: "; ls /lib/firmware/ 2>/dev/null | grep -i mt76 | tr "\n" " "; echo
-echo "=== Сеть ==="
-ip -o link show 2>/dev/null
-echo "--- network.lte ---"
-uci show network 2>/dev/null | grep -E "lte|eth[0-9]|usb[0-9]|wan"
-echo "=== Службы ==="
-ps w 2>/dev/null | grep -E "mcud|uartmuxd|smsd|mcu" | grep -v grep
-echo "=== Батарея: mcu ==="
-/usr/bin/mcu getvolt 2>&1; echo
-/usr/bin/mcu getsys 2>&1; echo
-/usr/bin/mcu getver 2>&1; echo
-echo "=== Журнал: usb/mcu/lte ==="
-logread 2>/dev/null | grep -iE "mcu|uartmux|umxtty|usb|lte|modem|smsd" | tail -30
+# Сводная диагностика PEJIR01: USB, LTE, модем, STM32, батарея.
+#
+# ВАЖНО (дефект, который здесь исправлен): свойства device-tree в
+# /proc/device-tree отдаются ядром С НУЛЕВЫМ БАЙТОМ НА КОНЦЕ (строки в FDT
+# null-terminated). rpcd/ubus передаёт stdout как blobmsg-строку, а она
+# обрезается по первому NUL. Из-за этого вывод обрывался сразу после
+# /proc/device-tree/model: страница показывала только «IoT Perenio Elegance
+# PEJIR01», а всё остальное (модель/DTB, USB, модем, LTE, батарея) терялось.
+# Поэтому весь вывод прогоняется через tr -d '\000'.
+#
+# DT_ROOT задаётся только для теста (tests/test-diag.sh), на устройстве
+# используется /proc/device-tree.
+
+DT="${DT_ROOT:-/proc/device-tree}"
+
+main() {
+	echo "=== Модель и DTB ==="
+	printf 'модель: '; tr '\0' ' ' < "$DT/model" 2>/dev/null; echo
+	printf 'совместимость: '; tr '\0' ' ' < "$DT/compatible" 2>/dev/null; echo
+	printf 'версия ядра: '; uname -r 2>/dev/null; echo
+	printf 'размер FDT: '; wc -c < /sys/firmware/fdt 2>/dev/null || echo '?'; echo
+	printf 'дерево: %s\n' "$DT"
+	echo -n "узлы device-tree: "; ls "$DT" 2>/dev/null | tr "\n" " "; echo
+	echo -n "узлы regulator*: "; ls -d "$DT"/regulator* 2>/dev/null | tr "\n" " "; echo
+	echo -n "xhci status: "; cat "$DT"/xhci@1e1c0000/status 2>/dev/null; echo
+	echo -n "xhci children: "; ls "$DT"/xhci@1e1c0000/ 2>/dev/null | tr "\n" " "; echo
+	echo -n "cmdline: "; cat /proc/cmdline 2>/dev/null; echo
+	echo "=== USB: сообщения ядра ==="
+	dmesg 2>/dev/null | grep -iE "xhci|ehci|ohci|uhci|dwc|usb [0-9]|new .*USB device|option|cdc_ether|cdc_ncm|cdc_mbim|rndis|scsi|uas|regulator" | tail -40
+	echo "=== USB: устройства ==="
+	echo -n "sysfs: "; ls /sys/bus/usb/devices/ 2>/dev/null | tr "\n" " "; echo
+	for d in /sys/bus/usb/devices/*/; do [ -f "$d/idVendor" ] && echo "$(basename $d) $(cat $d/idVendor 2>/dev/null):$(cat $d/idProduct 2>/dev/null) $(cat $d/product 2>/dev/null)"; done
+	echo "=== Модем, UART и мультиплексор ==="
+	ls -l /dev/ttyUSB* /dev/ttyACM* /dev/cdc-wdm* /dev/umxtty* /dev/ttyS* 2>&1
+	echo "--- modeminfo ---"
+	uci show modeminfo 2>/dev/null
+	echo "=== Разметка памяти: MTD и UBI ==="
+	cat /proc/mtd 2>/dev/null
+	echo -n "тома UBI: "; for u in /sys/class/ubi/ubi*_*; do [ -f "$u/name" ] && echo -n "$(basename $u)=$(cat $u/name) "; done; echo
+	echo -n "imgidx: "; fw_printenv -n imgidx 2>/dev/null; echo
+	echo "=== Wi-Fi ==="
+	iw dev 2>/dev/null
+	grep -E "option (ssid|disabled|country|channel|htmode)" /etc/config/wireless 2>/dev/null
+	dmesg 2>/dev/null | grep -iE "mt76|mt7603|mt7612|wiphy|ieee80211|firmware|calib" | tail -25
+	echo -n "firmware mt76: "; ls /lib/firmware/ 2>/dev/null | grep -i mt76 | tr "\n" " "; echo
+	echo "=== Сеть ==="
+	ip -o link show 2>/dev/null
+	echo "--- network.lte ---"
+	uci show network 2>/dev/null | grep -E "lte|eth[0-9]|usb[0-9]|wan"
+	echo "=== Службы ==="
+	ps w 2>/dev/null | grep -E "mcud|uartmuxd|smsd|mcu" | grep -v grep
+	echo "=== Батарея: mcu ==="
+	/usr/bin/mcu getvolt 2>&1; echo
+	/usr/bin/mcu getsys 2>&1; echo
+	/usr/bin/mcu getver 2>&1; echo
+	echo "=== Журнал: usb/mcu/lte ==="
+	logread 2>/dev/null | grep -iE "mcu|uartmux|umxtty|usb|lte|modem|smsd" | tail -30
+}
+
+main | tr -d '\000'
