 =?UTF-8?q?=D0=B5=D0=BC=20=D0=B2=D0=B5=D1=80=D1=81=D0=B8=D0=B8=20HOMEd=20?=
 =?UTF-8?q?=D0=B2=20zigbee-setup.sh?=
