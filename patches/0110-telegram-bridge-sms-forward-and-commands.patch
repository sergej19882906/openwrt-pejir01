diff --git a/package/pejir-telegram/root/etc/init.d/49-pejir-tg b/package/pejir-telegram/root/etc/init.d/49-pejir-tg
new file mode 100755
index 00000000..2b0c1c6d
--- /dev/null
+++ b/package/pejir-telegram/root/etc/init.d/49-pejir-tg
@@ -0,0 +1,24 @@
+#!/bin/sh /etc/rc.common
+# Мост Telegram: пересылает входящие SMS в чат и выполняет команды из чата.
+#
+# Запускается последним (START=98), после pejir-autosetup (96) и pejir-led
+# (97), чтобы модем и LTE уже были подняты. Цикл крутится всегда, но при
+# выключенном "enabled" ничего не делает - тогда включение в LuCI
+# начинает работать без перезапуска сервиса.
+
+START=98
+STOP=0
+USE_PROCD=1
+
+start_service() {
+	procd_open_instance
+	procd_set_param command /usr/libexec/pejir-tg watch
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_set_param respawn 3600 5 5
+	procd_close_instance
+}
+
+stop_service() {
+	return 0
+}
diff --git a/package/pejir-telegram/root/usr/libexec/pejir-tg b/package/pejir-telegram/root/usr/libexec/pejir-tg
new file mode 100755
index 00000000..38f2184f
--- /dev/null
+++ b/package/pejir-telegram/root/usr/libexec/pejir-tg
@@ -0,0 +1,448 @@
+#!/bin/sh
+# Telegram-мост PEJIR01.
+#
+# Две роли:
+#   1) пересылать ВХОДЯЩИЕ SMS в чат Telegram (номер, отправитель, время,
+#      текст);
+#   2) принимать КОМАНДЫ из чата: /sms <номер> <текст>, /status, /reboot,
+#      /help, /chatid.
+#
+# Настройки - в uci, секция pejir_telegram.main:
+#   enabled    0|1        - включено ли;
+#   token      токен бота от @BotFather;
+#   chat       ID чата (число, может быть отрицательным - группа);
+#   interval   период опроса, с (по умолчанию 60);
+#   commands   0|1        - разрешены ли команды из чата;
+#   protect    защитный код для опасных команд (/reboot);
+#   whitelist  номера отправителей через запятую - если задан, пересылаются
+#              только SMS от них; пусто - пересылаются все.
+#
+# В образе нет curl, но есть wget-ssl (uclient-fetch с TLS) - поэтому
+# HTTP-запросы идут через wget. JSON разбирает�� наш awk-парсер (в образе
+# jsonfilter есть, но парсер на awk не зависит от лишних пакетов и умеет
+# читать текст с переводами строк).
+
+CFG=pejir_telegram
+SEC=main
+
+# Пути переопределяются переменными окружения - только для тестов
+# (tests/test-telegram.sh). На устройстве берутся обычные значения.
+STATE_DIR="${PEJIR_TG_STATE:-/etc/pejir}"
+SEEN_FILE="$STATE_DIR/tg-seen"
+OFFSET_FILE="$STATE_DIR/tg-offset"
+LAST_FILE="${PEJIR_TG_LAST:-/tmp/pejir-tg-last}"
+SPOOL="${PEJIR_TG_SPOOL:-/var/spool/sms/incoming}"
+SENDSMS="${PEJIR_TG_SENDSMS:-/usr/libexec/pejir-send-sms}"
+API="${PEJIR_TG_API:-https://api.telegram.org}"
+CONF_FILE="${PEJIR_TG_CONF:-}"
+# В образе /usr/bin/wget - это wget-ssl (с TLS). Путь берём из переменной,
+# чтобы тест мог подставить своего wget.
+WGET="${PEJIR_TG_WGET:-wget}"
+
+cfg() {
+	if [ -n "$CONF_FILE" ]; then
+		sed -n "s/^$1=//p" "$CONF_FILE" 2>/dev/null | head -1
+		return 0
+	fi
+	uci -q get "$CFG.$SEC.$1" 2>/dev/null
+}
+
+log() {
+	logger -t pejir-tg "$*" 2>/dev/null
+	echo "pejir-tg: $*" >&2
+}
+
+# --- HTTP ------------------------------------------------------------------
+
+# GET без разбора ответа: печатает тело.
+http_get() {
+	"$WGET" -qO- -T 20 "$1" 2>/dev/null
+}
+
+# POST с готовыми (уже url-encoded) данными.
+http_post() {
+	"$WGET" -qO- -T 20 --post-data "$2" "$1" 2>/dev/null
+}
+
+# Кодирование строки для POST (application/x-www-form-urlencoded).
+# Переводы строк кодируются как %0A, поэтому перед awk меняем их на
+# служебный байт, который awk кодирует правильно.
+urlencode() {
+	printf '%s' "$1" | tr '\n' '\001' | LC_ALL=C awk '
+BEGIN {
+	for (i = 0; i < 256; i++) ord[sprintf("%c", i)] = i
+	nl = sprintf("%c", 1)
+}
+{
+	for (i = 1; i <= length($0); i++) {
+		c = substr($0, i, 1)
+		if (c == nl) { printf "%%0A"; continue }
+		if (c ~ /[A-Za-z0-9]/) { printf "%s", c; continue }
+		if (index("-_.~", c) > 0) { printf "%s", c; continue }
+		printf "%%%02X", ord[c]
+	}
+}'
+}
+
+# --- разбор ответа Telegram ------------------------------------------------
+#
+# Ответ getUpdates - один JSON. Нам нужны по каждому обновлению:
+# update_id, chat.id и text (текст может содержать переводы строк, поэтому
+# разбираем посимвольно до неэкранированной кавычки).
+#
+# Печатает строки: update_id <TAB> chat_id <TAB> текст
+parse_updates() {
+	tr -d '\r\n' | LC_ALL=C awk '
+function unesc(s,   out, i, c, n) {
+	out = ""
+	for (i = 1; i <= length(s); i++) {
+		c = substr(s, i, 1)
+		if (c != "\\") { out = out c; continue }
+		n = substr(s, i + 1, 1)
+		i++
+		if (n == "n") out = out "\n"
+		else if (n == "r") out = out "\r"
+		else if (n == "t") out = out "\t"
+		else if (n == "\\") out = out "\\"
+		else if (n == "\"") out = out "\""
+		else if (n == "u") { out = out "\\u" substr(s, i, 4); i += 4 }
+		else out = out n
+	}
+	return out
+}
+{
+	line = $0
+	n = split(line, part, "\"update_id\":")
+	for (i = 2; i <= n; i++) {
+		chunk = part[i]
+		uid = chunk
+		sub(/[^0-9].*$/, "", uid)
+
+		cid = ""
+		t = chunk
+		if (sub(/.*"chat":\{[\"a-z]*"id":/, "", t)) {
+			sub(/[^0-9-].*$/, "", t)
+			cid = t
+		}
+
+		txt = ""
+		t = chunk
+		if (sub(/.*"text":"/, "", t)) {
+			out = ""
+			for (k = 1; k <= length(t); k++) {
+				c = substr(t, k, 1)
+				if (c == "\\") { out = out c substr(t, k + 1, 1); k++; continue }
+				if (c == "\"") break
+				out = out c
+			}
+			txt = unesc(out)
+		}
+
+		if (uid != "") print uid "\t" cid "\t" txt
+	}
+}'
+}
+
+# --- отправка в чат --------------------------------------------------------
+
+# Отправить текст в чат. $1 - текст. Возвращает 0 при успехе.
+tg_send() {
+	_text="$1"
+	_chat="$(cfg chat)"
+	_token="$(cfg token)"
+
+	[ -n "$_chat" ] || { log "не задан chat ID"; return 1; }
+	[ -n "$_token" ] || { log "не задан токен бота"; return 1; }
+
+	# Telegram не принимает больше 4096 символов в одном сообщении.
+	_len="${#_text}"
+	if [ "$_len" -gt 4000 ]; then
+		_text="$(printf '%s' "$_text" | cut -c1-4000)..."
+	fi
+
+	_data="chat_id=$(urlencode "$_chat")&text=$(urlencode "$_text")"
+	_out="$(http_post "$API/bot$_token/sendMessage" "$_data")"
+
+	case "$_out" in
+	*'"ok":true'*) return 0 ;;
+	esac
+
+	log "отправка не удалась: $(printf '%s' "$_out" | cut -c1-160)"
+	return 1
+}
+
+# --- пересылка входящих SMS ------------------------------------------------
+
+# Уже пересланные сообщения (по имени файла в спуле).
+seen_has() {
+	grep -qxF "$1" "$SEEN_FILE" 2>/dev/null
+}
+
+seen_add() {
+	mkdir -p "$STATE_DIR" 2>/dev/null
+	printf '%s\n' "$1" >> "$SEEN_FILE" 2>/dev/null
+
+	# Список растёт по мере прихода SMS - оставляем только последние
+	# записи, иначе файл на флеше со временем станет большим.
+	_n="$(wc -l < "$SEEN_FILE" 2>/dev/null)"
+	case "$_n" in ''|*[!0-9]*) return 0 ;; esac
+	if [ "$_n" -gt 1000 ]; then
+		tail -500 "$SEEN_FILE" > "$SEEN_FILE.tmp" 2>/dev/null \
+			&& mv -f "$SEEN_FILE.tmp" "$SEEN_FILE" 2>/dev/null
+	fi
+}
+
+# Отправителю разрешено? Пустой whitelist - пересылаем всё.
+sender_allowed() {
+	_wl="$(cfg whitelist)"
+	[ -n "$_wl" ] || return 0
+	_s="$(printf '%s' "$1" | tr -d ' +()-' | tr 'A-Z' 'a-z')"
+	printf '%s' "$_wl" | tr ',' '\n' | while read -r one; do
+		one="$(printf '%s' "$one" | tr -d ' +()-' | tr 'A-Z' 'a-z')"
+		[ -n "$one" ] || continue
+		case "$_s" in
+		*"$one"*) echo yes; break ;;
+		esac
+	done | grep -q yes
+}
+
+cmd_forward() {
+	[ "$(cfg enabled)" = "1" ] || return 0
+	[ -d "$SPOOL" ] || return 0
+
+	_n=0
+	for f in "$SPOOL"/*; do
+		[ -f "$f" ] || continue
+		_name="${f##*/}"
+		seen_has "$_name" && continue
+
+		_from="$(sed -n '1p' "$f" 2>/dev/null | tr -d '\r')"
+		_date="$(sed -n '2p' "$f" 2>/dev/null | tr -d '\r')"
+		_text="$(sed -n '3,$p' "$f" 2>/dev/null | tr -d '\r')"
+
+		sender_allowed "$_from" || { seen_add "$_name"; continue; }
+
+		_msg="SMS от $_from
+$_date
+
+$_text"
+		if tg_send "$_msg"; then
+			seen_add "$_name"
+			_n=$((_n + 1))
+		else
+			# не отмечено - попробуем в следующий раз
+			break
+		fi
+	done
+
+	[ "$_n" -gt 0 ] && log "переслано новых SMS: $_n"
+	return 0
+}
+
+# --- команды из чата -------------------------------------------------------
+
+# Краткая сводка о модеме и LTE.
+status_text() {
+	_port="$(cat /etc/pejir/at-port 2>/dev/null | head -1)"
+	_fam="$(cat /etc/pejir/modem-family 2>/dev/null | tr -d '\r\n')"
+	_ver="$(cat /usr/lib/pejir/version 2>/dev/null | tr -d '\r\n')"
+	_lte="$(uci -q get network.lte.ifname)"
+	[ -n "$_lte" ] || _lte="$(uci -q get network.lte.device)"
+	_up="нет"
+	[ -n "$_lte" ] && [ -d "/sys/class/net/$_lte" ] && _up="да"
+
+	printf 'PEJIR01 %s\n' "${_ver:-версия неизвестна}"
+	printf 'модем: AT-порт %s, семейство %s\n' "${_port:-не определён}" "${_fam:-не определено}"
+	printf 'LTE: интерфейс %s, поднят: %s\n' "${_lte:-не задан}" "$_up"
+	printf 'SMS: входящих %s, неудачных %s\n' \
+		"$(ls -1 "$SPOOL" 2>/dev/null | wc -l | tr -d ' ')" \
+		"$(ls -1 /var/spool/sms/failed 2>/dev/null | wc -l | tr -d ' ')"
+}
+
+help_text() {
+	printf 'Команды:\n/sms <номер> <текст> - отправить SMS\n/status - состояние модема\n/reboot - перезагрузить роутер (нужен защитный код)\n/chatid - показать ID этого чата\n/help - эта справка'
+}
+
+# Выполнить команду из чата. $1 - текст команды, $2 - chat id.
+exec_command() {
+	_cmd="$1"
+	_chat="$2"
+
+	case "$_cmd" in
+	/help*|/start*)
+		tg_send "$(help_text)"
+		;;
+	/chatid*)
+		tg_send "ID этого чата: $_chat"
+		;;
+	/status*)
+		tg_send "$(status_text)"
+		;;
+	/sms\ *|/sms@*)
+		_rest="${_cmd#* }"
+		_to="${_rest%% *}"
+		_body="${_rest#* }"
+		if [ -z "$_to" ] || [ "$_body" = "$_rest" ] || [ -z "$_body" ]; then
+			tg_send "Формат: /sms <номер> <текст>"
+			return 0
+		fi
+		if [ "$(cfg commands)" != "1" ]; then
+			tg_send "Команды выключены - включите их на странице SMS."
+			return 0
+		fi
+		if [ -x "$SENDSMS" ]; then
+			_out="$("$SENDSMS" "$_to" "$_body" 2>&1)"
+			case "$_out" in
+			*[Ss]ent*|*success*|*uccess*|*queued*|*Queued*)
+				tg_send "SMS отправлена на $_to" ;;
+			*)
+				tg_send "Не удалось отправить на $_to: ${_out:-нет ответа}" ;;
+			esac
+		else
+			tg_send "Нет помощника отправки SMS"
+		fi
+		;;
+	/reboot*)
+		if [ "$(cfg commands)" != "1" ]; then
+			tg_send "Команды выключены - включите их на странице SMS."
+			return 0
+		fi
+		_prot="$(cfg protect)"
+		if [ -z "$_prot" ]; then
+			tg_send "Для перезагрузки задан защитный код."
+			return 0
+		fi
+		case "$_cmd" in
+		*"$_prot"*)
+			tg_send "Перезагружаюсь."
+			sleep 2
+			reboot
+			;;
+		*)
+			tg_send "Неверный защитный код."
+			;;
+		esac
+		;;
+	*)
+		tg_send "Не понимаю команду. /help - список команд."
+		;;
+	esac
+}
+
+cmd_commands() {
+	[ "$(cfg enabled)" = "1" ] || return 0
+	_token="$(cfg token)"
+	_chat_cfg="$(cfg chat)"
+	[ -n "$_token" ] || return 0
+
+	_offset="$(cat "$OFFSET_FILE" 2>/dev/null)"
+	case "$_offset" in ''|*[!0-9]*) _offset=0 ;; esac
+
+	_url="$API/bot$_token/getUpdates?timeout=0&limit=10"
+	[ "$_offset" -gt 0 ] && _url="$_url&offset=$_offset"
+
+	_json="$(http_get "$_url")"
+	case "$_json" in
+	*'"ok":true'*) ;;
+	*) return 0 ;;
+	esac
+
+	_max="$_offset"
+	printf '%s' "$_json" | parse_updates | while IFS="$(printf '\t')" read -r _uid _cid _txt; do
+		[ -n "$_uid" ] || continue
+		[ -n "$_cid" ] || continue
+		[ -n "$_txt" ] || continue
+
+		# только из разрешённого чата
+		[ "$_cid" = "$_chat_cfg" ] || continue
+
+		# команды старше 10 минут не выполняем: после обесточивания
+		# Telegram отдаёт всю очередь сразу, иначе выполнились бы
+		# все накопившиеся /reboot разом.
+		_now="$(date +%s 2>/dev/null)"
+		case "$_now" in ''|*[!0-9]*) _now=0 ;; esac
+		if [ "$_now" -gt 1700000000 ]; then
+			_mdate="$(printf '%s' "$_json" | LC_ALL=C awk -v n="$_uid" '
+			{ line = $0 }
+			END {
+				split(line, a, "\"update_id\":")
+				for (i = 2; i <= length(a); i++) {
+					u = a[i]; sub(/[^0-9].*$/, "", u)
+					if (u != n) continue
+					t = a[i]; sub(/.*"date":/, "", t); sub(/[^0-9].*$/, "", t)
+					print t; exit
+				}
+			}')"
+			case "$_mdate" in ''|*[!0-9]*) _mdate=0 ;; esac
+			if [ "$_mdate" -gt 0 ] && [ $((_now - _mdate)) -gt 600 ]; then
+				continue
+			fi
+		fi
+
+		log "команда из чата: $_txt"
+		exec_command "$_txt" "$_cid"
+	done
+
+	# сохраняем новое смещение (последний update_id + 1)
+	_last="$(printf '%s' "$_json" | parse_updates | cut -f1 | sort -n | tail -1)"
+	case "$_last" in ''|*[!0-9]*) _last="$_offset" ;; esac
+	_newoff=$((_last + 1))
+	mkdir -p "$STATE_DIR" 2>/dev/null
+	printf '%s' "$_newoff" > "$OFFSET_FILE.tmp" 2>/dev/null && mv -f "$OFFSET_FILE.tmp" "$OFFSET_FILE" 2>/dev/null
+	return 0
+}
+
+# --- команды CLI -----------------------------------------------------------
+
+cmd_status() {
+	printf 'включено: %s\n' "$(cfg enabled)"
+	printf 'токен: %s\n' "$([ -n "$(cfg token)" ] && echo задан || echo не задан)"
+	printf 'chat ID: %s\n' "$(cfg chat)"
+	printf 'интервал: %s с\n' "$(cfg interval)"
+	printf 'команды из чата: %s\n' "$(cfg commands)"
+	printf 'белый список отправителей: %s\n' "$(cfg whitelist)"
+	printf 'последняя ошибка: %s\n' "$(tail -1 "$LAST_FILE" 2>/dev/null)"
+}
+
+cmd_chatid() {
+	_chat="$(cfg chat)"
+	if [ -n "$_chat" ]; then
+		printf 'chat ID: %s\n' "$_chat"
+		return 0
+	fi
+	printf 'Chat ID не задан.\n'
+	printf 'Как узнать: добавьте бота в чат и напишите ему /chatid - бот ответит тут же.\n'
+}
+
+cmd_test() {
+	if tg_send "Тест PEJIR01: связь с роутером работает."; then
+		printf 'OK: сообщение отправлено\n'
+		return 0
+	fi
+	printf 'НЕ ОТПРАВЛЕНО (см. журнал)\n'
+	return 1
+}
+
+cmd_watch() {
+	_interval="$(cfg interval)"
+	case "$_interval" in ''|*[!0-9]*) _interval=60 ;; esac
+
+	while :; do
+		cmd_forward >/dev/null 2>&1
+		cmd_commands >/dev/null 2>&1
+		sleep "$_interval"
+	done
+}
+
+case "$1" in
+forward)  cmd_forward ;;
+commands) cmd_commands ;;
+watch)    cmd_watch ;;
+status)   cmd_status ;;
+chatid)   cmd_chatid ;;
+test)     cmd_test ;;
+*)
+	echo "usage: $0 {forward|commands|watch|status|chatid|test}" >&2
+	exit 2
+	;;
+esac
