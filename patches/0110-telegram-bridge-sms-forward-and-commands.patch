+++ b/package/pejir-telegram/Makefile
@@ -0,0 +1,45 @@
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=pejir-telegram
+PKG_VERSION:=1
+PKG_RELEASE:=1
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/pejir-telegram
+  SECTION:=utils
+  CATEGORY:=Utilities
+  TITLE:=PEJIR01 Telegram bridge: forward incoming SMS to a chat and accept commands
+  DEPENDS:=+luci-app-perenio +wget-ssl
+endef
+
+define Package/pejir-telegram/description
+  Forwards every incoming SMS to a Telegram chat (sender, date, text) and
+  accepts commands from that chat: /sms <number> <text>, /status, /reboot,
+  /chatid, /help. The chat ID and the bot token are stored in the uci
+  config pejir_telegram and can be filled in from the LuCI SMS page.
+  Only commands from the configured chat are executed, and commands older
+  than 10 minutes are ignored (otherwise a whole offline queue of /reboot
+  would fire at once when the link comes back).
+endef
+
+define Build/Prepare
+endef
+
+define Build/Compile
+endef
+
+define Package/pejir-telegram/install
+	$(INSTALL_DIR) $(1)/etc/init.d
+	$(INSTALL_BIN) ./root/etc/init.d/49-pejir-tg $(1)/etc/init.d/49-pejir-tg
+	$(INSTALL_DIR) $(1)/usr/libexec
+	$(INSTALL_BIN) ./root/usr/libexec/pejir-tg $(1)/usr/libexec/pejir-tg
+	$(INSTALL_DIR) $(1)/etc/config
+	$(INSTALL_CONF) ./root/etc/config/pejir_telegram $(1)/etc/config/pejir_telegram
+endef
+
+define Package/pejir-telegram/conffiles
+/etc/config/pejir_telegram
+endef
+
+$(eval $(call BuildPackage,pejir-telegram))
