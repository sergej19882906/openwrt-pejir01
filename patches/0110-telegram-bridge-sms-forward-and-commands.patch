+	handleTgSave: function() {
+		var en = document.getElementById('tg-enabled');
+		var cm = document.getElementById('tg-commands');
+
+		uci.set('pejir_telegram', 'main', 'enabled', (en && en.checked) ? '1' : '0');
+		uci.set('pejir_telegram', 'main', 'commands', (cm && cm.checked) ? '1' : '0');
