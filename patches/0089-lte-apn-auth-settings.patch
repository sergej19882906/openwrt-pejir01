@@ -0,0 +1,164 @@
+'use strict';
+'require view';
+'require fs';
+'require uci';
+'require ui';
+
+/* Настройки подключения к сети (APN) модема GM510.
+ *
+ * Имена полей - те же, что и в стоковой прошивке Perenio:
+ * network.lte.apn, network.lte.pdptype, network.lte.username,
+ * network.lte.password, network.lte.auth.
+ *
+ * Команды модему собирает /usr/libexec/pejir-lte-apn (AT+CGDCONT и
+ * AT+ZECMCALL - как в стоковом gosuncn.sh), init-скрипт 47-pejir-lte
+ * отправляет их при каждом старте LTE.
+ */
+
+var HELPER = '/usr/libexec/pejir-lte-apn';
+var LTE_INIT = '/etc/init.d/47-pejir-lte';
+
+var PDP_TYPES = [
+	[ 'ip', _('IPv4') ],
+	[ 'ipv6', _('IPv6') ],
+	[ 'ipv4v6', _('IPv4 and IPv6') ]
+];
+
+var AUTH_TYPES = [
+	[ 'none', _('None') ],
+	[ 'pap', _('PAP') ],
+	[ 'chap', _('CHAP') ],
+	[ 'both', _('CHAP and PAP') ]
+];
+
+function cur(key) {
+	var v = uci.get('network', 'lte', key);
+
+	return (v == null) ? '' : String(v);
+}
+
+function setText(id, s) {
+	var el = document.getElementById(id);
+
+	if (el)
+		el.textContent = s;
+}
+
+function input(id, type, value, extra) {
+	var attrs = { 'type': type, 'id': id, 'value': value, 'class': 'cbi-input-text' };
+
+	if (extra)
+		Object.keys(extra).forEach(function(k) { attrs[k] = extra[k]; });
+
+	return E('input', attrs);
+}
+
+function select(id, options, value) {
+	var opts = [];
+
+	options.forEach(function(o) {
+		opts.push(E('option', { 'value': o[0], 'selected': (o[0] == value) }, o[1]));
+	});
+
+	return E('select', { 'id': id, 'class': 'cbi-input-select' }, opts);
+}
+
+function row(title, field) {
+	return E('div', { 'class': 'cbi-value' }, [
+		E('div', { 'class': 'cbi-value-title' }, title),
+		E('div', { 'class': 'cbi-value-field' }, field)
+	]);
+}
+
+return view.extend({
+	handleSave: function(ev) {
+		var btn = ev.currentTarget;
+
+		btn.disabled = true;
+
+		uci.set('network', 'lte', 'apn', document.getElementById('pejir-apn').value);
+		uci.set('network', 'lte', 'pdptype', document.getElementById('pejir-pdptype').value);
+		uci.set('network', 'lte', 'username', document.getElementById('pejir-username').value);
+		uci.set('network', 'lte', 'password', document.getElementById('pejir-password').value);
+		uci.set('network', 'lte', 'auth', document.getElementById('pejir-auth').value);
+
+		return uci.save().then(function() {
+			btn.disabled = false;
+			ui.addNotification(null, E('p', {}, _('Saved. Press "Apply now" to send the settings to the modem.')), 'info');
+		}).catch(function(e) {
+			btn.disabled = false;
+			ui.addNotification(null, E('p', {}, _('Failed to save: ') + (e && e.message ? e.message : e)), 'error');
+		});
+	},
+
+	handleApply: function(ev) {
+		var btn = ev.currentTarget;
+
+		btn.disabled = true;
+		setText('pejir-lte-log', _('Sending the settings to the modem...'));
+
+		return fs.exec(LTE_INIT, [ 'restart' ]).then(function(r) {
+			var out = (r && r.stdout ? r.stdout : '') + (r && r.stderr ? r.stderr : '');
+
+			setText('pejir-lte-log', out.trim() || _('Done'));
+			btn.disabled = false;
+		}).catch(function(e) {
+			setText('pejir-lte-log', _('Error: ') + (e && e.message ? e.message : String(e || '')));
+			btn.disabled = false;
+		});
+	},
+
+	handleShow: function(ev) {
+		var btn = ev.currentTarget;
+
+		btn.disabled = true;
+		setText('pejir-lte-log', _('Reading the modem settings...'));
+
+		return fs.exec(HELPER, []).then(function(r) {
+			var out = (r && r.stdout ? r.stdout : '') + (r && r.stderr ? r.stderr : '');
+
+			setText('pejir-lte-log', out.trim() || _('No data'));
+			btn.disabled = false;
+		}).catch(function(e) {
+			setText('pejir-lte-log', _('Error: ') + (e && e.message ? e.message : String(e || '')));
+			btn.disabled = false;
+		});
+	},
+
+	render: function() {
+		var saveBtn = E('button', { 'class': 'cbi-button cbi-button-save', 'type': 'button' },
+				_('Save'));
+		saveBtn.addEventListener('click', L.bind(this.handleSave, this));
+
+		var applyBtn = E('button', { 'class': 'cbi-button cbi-button-action', 'type': 'button' },
+				_('Apply now'));
+		applyBtn.addEventListener('click', L.bind(this.handleApply, this));
+
+		var showBtn = E('button', { 'class': 'cbi-button cbi-button-neutral', 'type': 'button' },
+				_('Show commands'));
+		showBtn.addEventListener('click', L.bind(this.handleShow, this));
+
+		return E('div', { 'class': 'cbi-section' }, [
+			E('h2', {}, _('LTE settings (PEJIR01)')),
+			E('div', { 'class': 'cbi-section-descr' },
+				_('APN settings for the GM510 modem. The values are stored in network.lte and are sent to the modem as AT+CGDCONT and AT+ZECMCALL, exactly as in the stock firmware.')),
+			row(_('APN'), input('pejir-apn', 'text', cur('apn'))),
+			row(_('PDP type'), select('pejir-pdptype', PDP_TYPES, cur('pdptype') || 'ip')),
+			row(_('Username'), input('pejir-username', 'text', cur('username'))),
+			row(_('Password'), input('pejir-password', 'password', cur('password'))),
+			row(_('Authentication type'), select('pejir-auth', AUTH_TYPES, cur('auth') || 'none')),
+			E('div', { 'class': 'cbi-value' }, [
+				E('div', { 'class': 'cbi-value-title' }, ''),
+				E('div', { 'class': 'cbi-value-field' }, [
+					saveBtn, ' ', applyBtn, ' ', showBtn
+				])
+			]),
+			E('div', { 'class': 'cbi-value' }, [
+				E('div', { 'class': 'cbi-value-title' }, _('Modem log')),
+				E('div', { 'class': 'cbi-value-field' },
+					E('pre', { 'id': 'pejir-lte-log',
+						'style': 'white-space:pre-wrap; font-family:monospace; font-size:12px; max-height:40vh; overflow:auto; border:1px solid #ccc; padding:8px;' }, ''))
+			])
+		]);
+	}
+});
