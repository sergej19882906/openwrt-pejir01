diff --git a/package/pejir-lte-base/root/etc/init.d/47-pejir-lte b/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
index e2fe215..af7b826 100644
--- a/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
+++ b/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
@@ -258,7 +258,15 @@ sync_apn() {
 
 	port="$(detect_at_port)" || return 0
 	script="/tmp/pejir-apn.$$"
-	printf 'AT+CGDCONT=1,"IP","%s"\r' "$apn" > "$script"
+	# Хелпер собирает команды сам: AT+CGDCONT (тип PDP + APN) и
+	# AT+ZECMCALL (APN, тип PDP, логин, пароль, тип аутентификации).
+	# Логин и пароль уходят только вместе, иначе позиции параметров
+	# сдвинутся и модем примет пароль за логин.
+	# Хелпер печатает команды по одной в строке (без CR), поэтому
+	# перед отправкой переводим перевод строки в CR: GM510 не видит
+	# команду, завершённую только LF.
+	/usr/libexec/pejir-lte-apn 2>/dev/null | tr '\n' '\r' > "$script" || : > "$script"
+	[ -s "$script" ] || { rm -f "$script"; return 0; }
 	set_port_speed "$port"
 	timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 	rm -f "$script"
@@ -315,10 +323,18 @@ ecm_call() {
 	# Вендор шлёт APN в самой команде: AT+ZECMCALL=1,<APN>[,...].
 	# Если APN неизвестен - отправляем без него, модем возьмёт текущий
 	# PDP-контекст.
-	if [ -n "$apn" ]; then
-		printf 'AT+ZECMCALL=1,%s\r' "$apn" > "$script"
-	else
-		printf 'AT+ZECMCALL=1\r' > "$script"
+	# Команду собирает хелпер pejir-lte-apn: без логина и пароля форма
+	# остаётся прежней (AT+ZECMCALL=1,<apn>), с логином добавляются
+	# тип PDP, логин, пароль и тип аутентификации (как в стоке).
+	if [ -x /usr/libexec/pejir-lte-apn ]; then
+		/usr/libexec/pejir-lte-apn 2>/dev/null | grep '^AT+ZECMCALL=' | tr '\n' '\r' > "$script" || : > "$script"
+	fi
+	if [ ! -s "$script" ]; then
+		if [ -n "$apn" ]; then
+			printf 'AT+ZECMCALL=1,%s\r' "$apn" > "$script"
+		else
+			printf 'AT+ZECMCALL=1\r' > "$script"
+		fi
 	fi
 	# Ошибку игнорируем: на модемах без ECM-поддержки вызов не нужен,
 	# а AT+CGDCONT уже отработал.
diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-lte-apn b/package/pejir-lte-base/root/usr/libexec/pejir-lte-apn
new file mode 100755
index 0000000..793c266
--- /dev/null
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-lte-apn
@@ -0,0 +1,61 @@
+#!/bin/sh
+# AT-команды настройки подключения модема GM510 (APN и авторизация).
+#
+# ФАКТ (стоковая прошивка Perenio 9.0.4, usr/lib/modem_ubus/gosuncn.sh):
+#   Сток формирует команду одной строкой:
+#       AT+ZECMCALL=1[,<apn>[,<pdp_num>[,<user>[,<pass>[,<auth_num>]]]]]
+#   где pdp_num: 1 - IPv4, 2 - IPv6, 3 - IPv4v6 (get_pdp_type),
+#        auth_num: 1 - PAP, 2 - CHAP (get_auth_type).
+#   Наш порт отправлял только AT+ZECMCALL=1,<apn>, поэтому приватные APN
+#   с логином и паролем не поднимались.
+#
+# Настройки берутся из UCI (те же имена, что и в стоке):
+#   network.lte.apn       - имя APN;
+#   network.lte.pdptype   - ip | ipv6 | ipv4v6;
+#   network.lte.username  - логин;
+#   network.lte.password  - пароль;
+#   network.lte.auth      - none | pap | chap | both.
+#
+# Вывод: строки AT-команд, по одной в строке, без CR. Если APN не задан,
+# ничего не выводится.
+#
+# ВАЖНО: логин и пароль передаются только ВМЕСТЕ. Иначе позиции
+# параметров сдвинутся и модем примет пароль за логин. Без логина и
+# пароля форма команды не меняется: AT+ZECMCALL=1,<apn> проверен на
+# живом устройстве.
+
+uci_get() {
+	uci -q get "network.lte.$1" 2>/dev/null
+}
+
+apn="$(uci_get apn)"
+[ -n "$apn" ] || exit 0
+
+case "$(uci_get pdptype)" in
+	ipv6)   pdp="IPV6";  pdp_num=2 ;;
+	ipv4v6) pdp="IPV4V6"; pdp_num=3 ;;
+	*)      pdp="IP";    pdp_num=1 ;;
+esac
+
+user="$(uci_get username)"
+pass="$(uci_get password)"
+
+case "$(uci_get auth)" in
+	pap)  auth_num=1 ;;
+	chap) auth_num=2 ;;
+	both) auth_num=3 ;;
+	*)    auth_num="" ;;
+esac
+
+# PDP-контекст: тип PDP и APN.
+printf 'AT+CGDCONT=1,"%s","%s"\n' "$pdp" "$apn"
+
+# ECM data call. Параметры авторизации - только вместе с логином и паролем.
+zecm="AT+ZECMCALL=1,$apn"
+if [ -n "$user" ] && [ -n "$pass" ]; then
+	zecm="$zecm,$pdp_num,$user,$pass"
+	[ -n "$auth_num" ] && zecm="$zecm,$auth_num"
+fi
+printf '%s\n' "$zecm"
+
+exit 0
