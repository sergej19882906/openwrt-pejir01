diff --git a/package/pejir-ota/po/ru/luci-app-pejir-ota.po b/package/pejir-ota/po/ru/luci-app-pejir-ota.po
new file mode 100644
index 0000000..cbf9f60
--- /dev/null
+++ b/package/pejir-ota/po/ru/luci-app-pejir-ota.po
@@ -0,0 +1,74 @@
+# Russian translation for the PEJIR01 firmware update page
+# (luci-app-pejir-ota).
+#
+# The source strings are English; this file provides the Russian
+# version, so the page follows the interface language.
+#
+msgid ""
+msgstr ""
+"Content-Type: text/plain; charset=UTF-8\n"
+"Language: ru\n"
+"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"
+
+msgid "Firmware update (PEJIR01)"
+msgstr "Обновление прошивки (PEJIR01)"
+
+msgid "Installed version"
+msgstr "Установленная версия"
+
+msgid "Latest release"
+msgstr "Последний релиз"
+
+msgid "unknown"
+msgstr "неизвестно"
+
+msgid "Check for updates"
+msgstr "Проверить обновления"
+
+msgid "Install update"
+msgstr "Установить обновление"
+
+msgid "An update is available"
+msgstr "Доступно обновление"
+
+msgid "The installed version is up to date"
+msgstr "Установленная версия актуальна"
+
+msgid "Could not reach the release server"
+msgstr "Не удалось связаться с сервером релизов"
+
+msgid "Install the firmware update?"
+msgstr "Установить обновление прошивки?"
+
+msgid "The router will download the new firmware, verify the checksum and flash it. The device reboots during the installation - do not power it off."
+msgstr "Роутер скачает новую прошивку, проверит контрольную сумму и установит её. Устройство перезагрузится во время установки - не отключайте питание."
+
+msgid "Cancel"
+msgstr "Отмена"
+
+msgid "Continue"
+msgstr "Продолжить"
+
+msgid "Could not start the update: "
+msgstr "Не удалось запустить обновление: "
+
+msgid "Updating, please wait..."
+msgstr "Обновление, подождите…"
+
+msgid "Rebooting..."
+msgstr "Перезагрузка…"
+
+msgid "Update failed, see the log below"
+msgstr "Обновление не удалось, смотрите журнал ниже"
+
+msgid "Unknown error"
+msgstr "Неизвестная ошибка"
+
+msgid "No permission to run the update helper: in this firmware the ACL is granted in the read section, but LuCI 25.12 requires write. That means your release is older than .17 - update via the regular \"System -> Firmware update\" page."
+msgstr "Нет прав на запуск помощника обновления: в этой прошивке ACL выдан в секции read, а LuCI 25.12 требует write. Значит, у вас релиз старше .17 - обновитесь обычной страницей «Система → Обновление прошивки»."
+
+msgid "There is no automatic update: the new firmware is downloaded and installed only when you press \"Install update\". The router reboots by itself when the installation is finished."
+msgstr "Автоматического обновления нет: новая прошивка скачивается и устанавливается только после нажатия «Установить обновление». По окончании установки роутер перезагрузится сам."
+
+msgid "Regular firmware update page (always available)"
+msgstr "Обычная страница обновления прошивки (работает всегда)"
