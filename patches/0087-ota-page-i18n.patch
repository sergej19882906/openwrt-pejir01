@@ -51,6 +51,14 @@ define Package/pejir-ota/install
 	$(INSTALL_DIR) $(1)/usr/share/rpcd/acl.d
 	$(INSTALL_DATA) ./root/usr/share/rpcd/acl.d/luci-app-pejir-ota.json \
 		$(1)/usr/share/rpcd/acl.d/luci-app-pejir-ota.json
+	# Русский перевод страницы обновления прошивки. Исходные строки в
+	# JS - английские, поэтому в английском режиме интерфейса страница
+	# не остаётся русской. Каталог .lmo собираем из po/ru штатным
+	# po2lmo (его ставит luci-base как host-инструмент) - так же, как
+	# это делает package luci-app-perenio.
+	$(INSTALL_DIR) $(1)/usr/lib/lua/luci/i18n
+	po2lmo ./po/ru/luci-app-pejir-ota.po \
+		$(1)/usr/lib/lua/luci/i18n/luci-app-pejir-ota.ru.lmo
 endef
 
