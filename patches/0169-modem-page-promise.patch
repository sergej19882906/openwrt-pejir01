В LuCI 25.12 form.Map.render() возвращает PROMISE, а не готовый узел
DOM. Патч 0165 обернул вызов в E('div', {}, [btn, m.render()]) - промис
попал в DOM как узел, и вкладка «Сеть» показывала "[object Promise]"
вместо данных модема.

Теперь карта подставляется в контейнер после разрешения промиса.
---
 .../htdocs/luci-static/resources/view/modem/main.js   | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/package/luci-app-modeminfo/htdocs/luci-static/resources/view/modem/main.js b/package/luci-app-modeminfo/htdocs/luci-static/resources/view/modem/main.js
index 7597ae94..ff6a6178 100644
--- a/package/luci-app-modeminfo/htdocs/luci-static/resources/view/modem/main.js
+++ b/package/luci-app-modeminfo/htdocs/luci-static/resources/view/modem/main.js
@@ -547,7 +547,16 @@ return view.extend({
 			L.resolveDefault(fs.exec(MODEM_CACHE_REFRESH, [ 'refresh' ]), null);
 		});
 
-		return E('div', {}, [ btn, m.render() ]);
+		/* В LuCI 25.12 form.Map.render() возвращает PROMISE, а не готовый
+		 * узел. Если положить промис в E() как узел, страница показывает
+		 * "[object Promise]" вместо таблицы. Поэтому собираем контейнер
+		 * и подставляем карту после её отрисовки. */
+		const node = E('div', {}, [ btn ]);
+
+		return Promise.resolve(m.render()).then(function(mapNode) {
+			node.appendChild(mapNode);
+			return node;
+		});
 	},
 
 	handleSaveApply: null,
