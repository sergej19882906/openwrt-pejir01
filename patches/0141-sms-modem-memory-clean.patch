index 00000000..3bc7f2ac
--- /dev/null
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-modem-sms-clean
@@ -0,0 +1,121 @@
+#!/bin/sh
+# Память модема (SIM) для SMS: сколько там сообщений и как её освободить.
+#
+# ЗАЧЕМ. Модем принимает входящие SMS в память SIM: в smsd.conf стоит
+# init = AT+CPMS="SM","SM","SM" (хранение в SIM). Если память забита
+# старыми сообщениями, модем НЕ МОЖЕТ принять новое сообщение: в журнале
+# smsd каждые 33 секунды появляется
+#
+#     GM510: Message 0, not enough storage space.
+#
+# и входящие SMS не доходят (очередь smstools3 на флешке пустая, а
+# сообщения остаются в модеме).
+#
+# Команды:
+#   status - сколько сообщений в памяти модема (и сколько всего места);
+#   clean  - удалить ВСЕ сообщения из памяти модема.
+#
+# ВАЖНО: clean удаляет сообщения, которые лежат В МОДЕМЕ (в SIM). Это не
+# очередь smstools3 на флешке - её clean не трогает. Всё, что было
+# принято модемом и не прочитано smsd, при очистке пропадёт.
+#
+# Команда удаления всегда вызывается по явному запросу пользователя
+# (кнопка в веб-интерфейсе), молча память модема не чистится.
+
+set -u
+
+PORT_FILE="${PEJIR_AT_PORT_FILE:-/etc/pejir/at-port}"
+TIMEOUT="${PEJIR_MODEM_SMS_TIMEOUT:-6}"
+
+port() {
+	[ -f "$PORT_FILE" ] || return 1
+	head -n 1 "$PORT_FILE" 2>/dev/null
+}
+
+at() {
+	local p
+
+	p="$(port)" || return 1
+	[ -n "$p" ] || return 1
+	MDM_AT_TIMEOUT="$TIMEOUT" mdm-at "$1" "$p" 2>/dev/null
+}
+
+# Ответ AT+CPMS? разбираем на два числа: сколько занято и сколько всего
+# места в первом хранилище (обычно SIM).
+#
+# Форматы ответа разные:
+#   "+CPMS: 12,30,12,30,12,30"
+#   "+CPMS: "SM",12,30"
+#   "+CPMS: 0,30"
+# Берём первые два числа, состоящие только из цифр.
+#
+# LC_ALL=C обязателен: в UTF-8-локали awk перекодирует байты.
+mem_pair() {
+	printf '%s' "$1" | tr -d ' "' | LC_ALL=C awk -F'[:,]' '
+		/\+CPMS:/ {
+			n = 0
+			for (i = 1; i <= NF; i++) {
+				if ($i ~ /^[0-9]+$/) {
+					n++
+					if (n == 1) u = $i
+					if (n == 2) { print u " " $i; exit }
+				}
+			}
+		}'
+}
+
+mem_used() {
+	mem_pair "$1" | cut -d' ' -f1
+}
+
+mem_total() {
+	mem_pair "$1" | cut -d' ' -f2
+}
+
+cmd_status() {
+	local out used total
+
+	out="$(at 'AT+CPMS?')" || {
+		echo "ERROR: модем не ответил на AT+CPMS?"
+		return 1
+	}
+
+	used="$(mem_used "$out")"
+	total="$(mem_total "$out")"
+	echo "RAW=$out"
+	echo "USED=${used:-}"
+	echo "TOTAL=${total:-}"
+	return 0
+}
+
+cmd_clean() {
+	local before after used total
+
+	before="$(at 'AT+CPMS?')"
+	if [ -z "$before" ]; then
+		echo "ERROR: модем не ответил на AT+CPMS? - чистить нечего"
+		return 1
+	fi
+
+	used="$(mem_used "$before")"
+	total="$(mem_total "$before")"
+	echo "до:    ${used:-?}/${total:-?} сообщений в памяти модема"
+
+	# AT+CMGD=1,4 - удалить все сообщения (delflag 4) во всех папках.
+	at 'AT+CMGD=1,4' >/dev/null
+
+	after="$(at 'AT+CPMS?')"
+	used="$(mem_used "$after")"
+	total="$(mem_total "$after")"
+	echo "после: ${used:-?}/${total:-?} сообщений в памяти модема"
+	return 0
+}
+
+case "${1:-}" in
+status) cmd_status ;;
+clean)  cmd_clean ;;
+*)
+	echo "Использование: pejir-modem-sms-clean {status|clean}" >&2
+	exit 1
+	;;
+esac
