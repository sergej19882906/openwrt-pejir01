---
 package/luci-app-atinout/root/usr/bin/luci-app-atinout | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/package/luci-app-atinout/root/usr/bin/luci-app-atinout b/package/luci-app-atinout/root/usr/bin/luci-app-atinout
index f823a57..58d986c 100755
--- a/package/luci-app-atinout/root/usr/bin/luci-app-atinout
+++ b/package/luci-app-atinout/root/usr/bin/luci-app-atinout
@@ -1,3 +1,7 @@
 #!/bin/sh
 
-echo $1 | atinout - $2 -
+# LuCI передаёт неэкранированные аргументы: команда и порт могут содержать
+# пробелы/кавычки, а порт к тому же надо перевести в raw-режим без эха,
+# иначе модем молчит (тот же трюк, что в scripts/modeminfo).
+stty -F "$2" 115200 raw -echo 2>/dev/null
+echo "$1" | atinout - "$2" -
-- 
