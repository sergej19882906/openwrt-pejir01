-			rowSaved(_('Authentication type'), select('pejir-auth', AUTH_TYPES, cur('auth') || 'none'), 'auth'),
-			rowSaved(_('DNS (optional)'), input('pejir-dns', 'text', cur('dns')), 'dns'),
-			rowSaved(_('Channel mode'), select('pejir-mode', CHANNEL_MODES, cur('modes') || 'all'), 'modes'),
+				_('Each field shows the value that is really saved in network.lte. If you change the field and do not press "Save", the value next to it turns red - the change is not saved yet.')),
+			rowSaved(_('APN'), input('pejir-apn', 'text', savedValue('apn')), 'apn'),
+			rowSaved(_('PDP type'), select('pejir-pdptype', PDP_TYPES, savedValue('pdptype')), 'pdptype'),
+			rowSaved(_('Username'), input('pejir-username', 'text', savedValue('username')), 'username'),
+			rowSaved(_('Password'), input('pejir-password', 'password', savedValue('password')), 'password'),
+			rowSaved(_('Authentication type'), select('pejir-auth', AUTH_TYPES, savedValue('auth')), 'auth'),
+			rowSaved(_('DNS (optional)'), input('pejir-dns', 'text', savedValue('dns')), 'dns'),
+			rowSaved(_('Channel mode'), select('pejir-mode', CHANNEL_MODES, savedValue('modes')), 'modes'),
 			E('div', { 'class': 'cbi-value' }, [
 				E('div', { 'class': 'cbi-value-title' }, ''),
 				E('div', { 'class': 'cbi-value-field' }, [
