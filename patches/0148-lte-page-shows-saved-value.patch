+	{ 'id': 'pejir-mode', 'label': _('Channel mode'), 'key': 'modes', 'def': 'all' }
 ];
 
 function cur(key) {
@@ -122,14 +130,84 @@ function select(id, options, value) {
 	return E('select', { 'id': id, 'class': 'cbi-input-select' }, opts);
 }
 
+/* Значения, реально сохранённые в network.lte. */
+var SAVED = {};
+
+/* Перечитать сохранённые значения из конфига. */
+function readSaved() {
+	FIELDS.forEach(function(f) {
+		SAVED[f.key] = cur(f.key);
+	});
+}
+
+/* Сохранённое значение с учётом значения по умолчанию. */
+function savedValue(key) {
+	var f = FIELDS.filter(function(x) { return x.key == key; })[0];
+	var v = SAVED[key];
+
+	if ((v == null) || (v == ''))
+		return (f && f.def) ? f.def : '';
+
+	return String(v);
+}
+
 /* Значение, реально сохранённое в network.lte. */
 function savedText(key) {
-	var v = cur(key);
+	var v = savedValue(key);
 
 	return (v == '') ? _('not set') : v;
 }
 
-/* Обновить колонку "сохранено" и подсветить расхождения с введённым. */
+/* Проставить сохранённые значения в поля ввода: поле всегда должно
+ * показывать то, что реально лежит в конфиге. */
+function fillFromSaved() {
+	FIELDS.forEach(function(f) {
+		var inp = document.getElementById(f.id);
+
+		if (!inp)
+			return;
+
+		var v = savedValue(f.key);
+
+		if (inp.tagName == 'SELECT') {
+			/* Значение из конфига может отсутствовать в списке - тогда
+			 * оставляем то, что выбрано сейчас. */
+			var found = false;
+
+			Array.prototype.forEach.call(inp.options, function(o) {
+				if (o.value == v)
+					found = true;
+			});
+
+			if (found)
+				inp.value = v;
+		}
+		else {
+			inp.value = v;
+		}
+	});
+}
+
+/* Перечитать network.lte с диска (init-скрипт LTE мог дописать туда
+ * свои значения) и обновить поля. */
+function reloadSaved() {
+	return rpc.call('uci', 'get', { 'config': 'network', 'section': 'lte' })
+		.then(function(res) {
+			var vals = (res && res.values) ? res.values : {};
+
+			FIELDS.forEach(function(f) {
+				if (vals[f.key] != null)
+					SAVED[f.key] = String(vals[f.key]);
+			});
+
+			fillFromSaved();
+			refreshSaved();
+		}).catch(function() {
+			/* Перечитать не удалось - показываем то, что есть. */
+		});
+}
+
+/* Обновить соседние ячейки: красным - несохранённые правки. */
 function refreshSaved() {
 	FIELDS.forEach(function(f) {
 		var cell = document.getElementById('pejir-saved-' + f.key);
@@ -138,18 +216,16 @@ function refreshSaved() {
 		if (!cell)
 			return;
 
-		var v = cur(f.key);
-
-		if (inp && inp.value !== v) {
+		if (inp && inp.value !== savedValue(f.key)) {
 			cell.className = 'pejir-saved-diff';
 			cell.style.color = '#c0392b';
-			cell.textContent = _('Saved') + ': ' + savedText(f.key) + ' \u2260';
-			cell.title = _('Differs from the entered value');
+			cell.textContent = _('Not saved') + ': ' + savedText(f.key);
+			cell.title = _('The field has been changed, but not saved yet');
 		}
 		else {
 			cell.className = 'pejir-saved';
 			cell.style.color = '#888';
-			cell.textContent = _('Saved') + ': ' + savedText(f.key);
+			cell.textContent = '';
 			cell.title = '';
 		}
 	});
@@ -180,7 +256,7 @@ function rowSaved(title, field, key) {
 				'id': 'pejir-saved-' + key,
 				'class': 'pejir-saved',
 				'style': 'margin-left:8px;color:#888'
-			}, _('Saved') + ': ' + savedText(key))
+			}, '')
 		])
 	]);
 }
@@ -208,6 +284,9 @@ return view.extend({
 
 		return uci.save().then(function() {
 			btn.disabled = false;
