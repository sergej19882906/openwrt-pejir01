Жалоба: опрос модема и батареи медленный.

ПРИЧИНА. Страница "Батарея и питание" каждые 15 секунд запускала ТРИ
vendor-процесса - "mcu getsys", "mcu getver", "mcu getvolt". Это
клиенты vendor-демона mcud: rpcd на каждый вызов поднимал процесс,
клиент открывал UART-мультиплексор (/dev/umxtty0), ждал ответа от
STM32 и закрывал порт. Страница LuCI всё это время ждала - опрос
получался медленным, веб-интерфейс подтормаживал.

Ровно так же было исправлено для значка в шапке (патч 0126): состояние
батареи собирает фоновый демон pejir-signal и кладёт его в файл,
браузер только читает. Страница осталась последней, кто дёргает STM32
из браузера.

ЧТО СДЕЛАНО:
- демон pejir-signal теперь собирает и версию прошивки STM32, и
  напряжения (файлы /tmp/pejir-battery-ver и /tmp/pejir-battery-volt)
  и кладёт их рядом с основным файлом состояния;
- страница батареи читает три файла вместо трёх запусков процессов.
  В браузере не осталось ни одного вызова mcu;
- батарея опрашивается чаще модема: STM32 - это локальный обмен с
  mcud (модем при этом не занят), поэтому демон обновляет батарею раз
  в 15 с (PEJIR_BATTERY_INTERVAL), а модем - как раньше, раз в минуту
  (PEJIR_SIGNAL_INTERVAL): AT-порт дёргать часто нельзя, его занимает
  smsd;
- у обновления батареи свой замок: страница может попросить обновить
  данные, и два одновременных запроса к mcud не должны идти;
- добавлена команда "pejir-signal battery" - обновить только батарею,
  не трогая AT-порт;
- в ACL добавлены гранты на чтение двух новых файлов.
---
 .../resources/view/perenio/battery.js         |  27 +++--
 .../share/rpcd/acl.d/luci-app-perenio.json    |   6 ++
 .../root/usr/libexec/pejir-signal             | 102 +++++++++++++++---
 3 files changed, 116 insertions(+), 19 deletions(-)

diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/battery.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/battery.js
index 001c5f3e..80c74ade 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/battery.js
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/battery.js
@@ -28,6 +28,19 @@
 
 var ICON_BASE = perenio_battery.ICON_BASE;
 
+/* Данные STM32 собирает фоновый демон pejir-signal (раз в 15 с) и
+ * кладёт их в файлы. Браузер их просто читает.
+ *
+ * Раньше страница сама запускала три vendor-процесса ("mcu getsys",
+ * "mcu getver", "mcu getvolt") каждые 15 секунд: rpcd на каждый вызов
+ * поднимал процесс, а страница ждала его ответа - опрос модема и
+ * батареи был медленным, веб-интерфейс подтормаживал. Ровно так же
+ * было сделано и для значка в шапке (патч 0126) - страница осталась
+ * последней, кто дёргает STM32 из браузера. */
+var BAT_FILE = '/tmp/pejir-battery';
+var VER_FILE = '/tmp/pejir-battery-ver';
+var VOLT_FILE = '/tmp/pejir-battery-volt';
+
 /* Разбор и логика статуса вынесены в общий модуль perenio-battery:
  * те же самые данные нужны значку аккумулятора в шапке. */
 var parseSys = perenio_battery.parseSys;
@@ -125,14 +138,14 @@ return view.extend({
 
 		poll.add(L.bind(function() {
 			return Promise.all([
-				fs.exec('/usr/bin/mcu', [ 'getsys' ]).catch(function() { return null; }),
-				fs.exec('/usr/bin/mcu', [ 'getver' ]).catch(function() { return null; }),
-				fs.exec('/usr/bin/mcu', [ 'getvolt' ]).catch(function() { return null; })
+				fs.read(BAT_FILE).catch(function() { return ''; }),
+				fs.read(VER_FILE).catch(function() { return ''; }),
+				fs.read(VOLT_FILE).catch(function() { return ''; })
 			]).then(L.bind(function(res) {
-				var out = res[0] && res[0].stdout ? res[0].stdout : '';
+				var out = res[0] || '';
 				var d = parseSys(out);
-				var ver = res[1] && res[1].stdout ? res[1].stdout.trim() : '';
-				var voltOut = res[2] && res[2].stdout ? res[2].stdout.trim() : '';
+				var ver = (res[1] || '').trim();
+				var voltOut = (res[2] || '').trim();
 
 				var widget = document.getElementById('batt-widget');
 				var tdV = document.getElementById('batt-volt');
@@ -149,7 +162,7 @@ return view.extend({
 					if (tdV) tdV.textContent = 'n/a';
 					if (tdL) tdL.textContent = 'n/a';
 					if (tdC) tdC.textContent = 'n/a';
-					if (tdS) tdS.textContent = (out || (res[0] && res[0].stderr) || '').trim() || '—';
+					if (tdS) tdS.textContent = out.trim() || '—';
 
 					if (widget)
 						widget.innerHTML = '<em>' + _('mcud is not running') + '</em>';
diff --git a/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json b/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json
index fb96ab44..117f8b28 100644
--- a/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json
+++ b/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json
@@ -21,6 +21,12 @@
 				"/tmp/pejir-battery": [
 					"read"
 				],
+				"/tmp/pejir-battery-ver": [
+					"read"
+				],
+				"/tmp/pejir-battery-volt": [
+					"read"
+				],
 				"/tmp/pejir-signal": [
 					"read"
 				],
diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-signal b/package/pejir-lte-base/root/usr/libexec/pejir-signal
index f2989425..6ececad0 100755
--- a/package/pejir-lte-base/root/usr/libexec/pejir-signal
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-signal
@@ -9,7 +9,8 @@
 # состояния, который LuCI просто читает.
 #
 # Команды:
-#   refresh - один раз опросить модем и обновить файл состояния;
+#   refresh - один раз опросить модем и батарею, обновить файлы;
+#   battery - обновить только батарею (STM32), не трогая AT-порт;
 #   watch   - бесконечный цикл (раз в PEJIR_SIGNAL_INTERVAL секунд);
 #   status  - показать текущее состояние.
 
@@ -19,6 +20,18 @@ INTERVAL="${PEJIR_SIGNAL_INTERVAL:-60}"
 TIMEOUT="${PEJIR_SIGNAL_TIMEOUT:-4}"
 SMS_OUTBOX="${PEJIR_SMS_OUTBOX:-/var/spool/sms/outgoing}"
 BATTERY_STATE="${PEJIR_BATTERY_STATE:-/tmp/pejir-battery}"
+BATTERY_VER="${PEJIR_BATTERY_VER:-/tmp/pejir-battery-ver}"
+BATTERY_VOLT="${PEJIR_BATTERY_VOLT:-/tmp/pejir-battery-volt}"
+BATTERY_LOCK="${PEJIR_BATTERY_LOCK:-/tmp/pejir-battery.lock}"
+
+# Как часто опрашивать STM32 (батарея) и как часто - модем (AT-команды).
+#
+# Раньше оба опроса шли в одном цикле раз в минуту. Но STM32 и модем -
+# разные устройства: батарея - это локальный обмен с mcud по UART
+# (быстро, модем не занимает), а модем - AT-команды, где каждый запрос
+# стоит 1-4 секунды и где порт может быть занят smsd. Батарею можно
+# опрашивать чаще, AT-порт трогать - нельзя.
+BATTERY_INTERVAL="${PEJIR_BATTERY_INTERVAL:-15}"
 LOCK_FILE="${PEJIR_SIGNAL_LOCK:-/tmp/pejir-signal.lock}"
 
 log() {
@@ -101,19 +114,63 @@ lock_stale() {
 # Поэтому состояние батареи, как и сеть, собирает демон, а браузер
 # просто читает файл.
 refresh_battery() {
-	local out
+	local out ver volt
 
 	[ -x /usr/bin/mcu ] || return 1
+
+	# Один опрос за раз: страница LuCI тоже может попросить обновить
+	# данные, а mcud не любит одновременные запросы.
+	lock_stale_battery
+	if ! mkdir "$BATTERY_LOCK" 2>/dev/null; then
+		return 1
+	fi
+	trap 'rmdir "$BATTERY_LOCK" 2>/dev/null' EXIT INT TERM
+
 	out="$(timeout 5 /usr/bin/mcu getsys 2>/dev/null)"
 	case "$out" in
-	*OK*) : ;;
-	*) return 1 ;;
+	*OK*)
+		printf '%s\n' "$out" > "$BATTERY_STATE.tmp" 2>/dev/null &&
+			mv "$BATTERY_STATE.tmp" "$BATTERY_STATE" 2>/dev/null
+		;;
+	*) rmdir "$BATTERY_LOCK" 2>/dev/null; trap - EXIT INT TERM; return 1 ;;
+	esac
+
+	# Версия прошивки STM32 и напряжения - отдельными файлами: страница
+	# "Батарея и питание" показывает их, а запускать процессы из
+	# браузера нельзя (см. комментарий выше).
+	ver="$(timeout 5 /usr/bin/mcu getver 2>/dev/null)"
+	case "$ver" in
+	*OK*) printf '%s\n' "$ver" > "$BATTERY_VER.tmp" 2>/dev/null &&
+		mv "$BATTERY_VER.tmp" "$BATTERY_VER" 2>/dev/null ;;
 	esac
-	printf '%s\n' "$out" > "$BATTERY_STATE.tmp" 2>/dev/null &&
-		mv "$BATTERY_STATE.tmp" "$BATTERY_STATE" 2>/dev/null
+
+	volt="$(timeout 5 /usr/bin/mcu getvolt 2>/dev/null)"
+	case "$volt" in
+	*OK*) printf '%s\n' "$volt" > "$BATTERY_VOLT.tmp" 2>/dev/null &&
+		mv "$BATTERY_VOLT.tmp" "$BATTERY_VOLT" 2>/dev/null ;;
+	esac
+
+	rmdir "$BATTERY_LOCK" 2>/dev/null
+	trap - EXIT INT TERM
+	return 0
 }
 
-cmd_refresh() {
+# Снять протухший замок батареи (если процесс убили).
+lock_stale_battery() {
+	local t now
+
+	[ -d "$BATTERY_LOCK" ] || return 0
+	t="$(stat -c %Y "$BATTERY_LOCK" 2>/dev/null)"
+	case "$t" in
+	''|*[!0-9]*) rm -rf "$BATTERY_LOCK" 2>/dev/null; return 0 ;;
+	esac
+	now="$(date +%s)"
+	[ "$((now - t))" -gt 120 ] && rm -rf "$BATTERY_LOCK" 2>/dev/null
+	return 0
+}
+
+# Опрос модема (AT-команды) - пишет файл состояния сети.
+refresh_modem() {
 	local port csq nw cops rssi pct net op act
 
 	port="$(current_port)"
@@ -161,18 +218,38 @@ cmd_refresh() {
 		echo "operator=${op:-}"
 	} > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null
 
-	# Батарея - отдельным файлом (ответ STM32 целиком).
-	refresh_battery
-
 	rmdir "$LOCK_FILE" 2>/dev/null
 	trap - EXIT INT TERM
 	return 0
 }
 
+# Полное обновление: и модем, и батарея.
+cmd_refresh() {
+	refresh_modem
+	refresh_battery
+}
+
+# Фоновый цикл: батарея - чаще (STM32, модем не занимаем), модем - как
+# раньше, раз в минуту (AT-порт нельзя дёргать часто).
 cmd_watch() {
+	local next_modem next_batt now
+
+	next_modem=0
+	next_batt=0
+
 	while :; do
-		sleep "$INTERVAL"
-		cmd_refresh >/dev/null 2>&1
+		sleep 5
+		now="$(date +%s)"
+
+		if [ "$((now - next_batt))" -ge "$BATTERY_INTERVAL" ]; then
+			next_batt="$now"
+			refresh_battery >/dev/null 2>&1
+		fi
+
+		if [ "$((now - next_modem))" -ge "$INTERVAL" ]; then
+			next_modem="$now"
+			refresh_modem >/dev/null 2>&1
+		fi
 	done
 }
 
@@ -186,6 +263,7 @@ cmd_status() {
 
 case "$1" in
 refresh) cmd_refresh ;;
+battery) refresh_battery ;;
 watch)   cmd_watch ;;
 status)  cmd_status ;;
 *)
-- 
