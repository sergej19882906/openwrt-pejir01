index 0000000..d539edd
--- /dev/null
+++ b/package/luci-proto-amneziawg/po/ru/status.po
@@ -0,0 +1,153 @@
+msgid ""
+msgstr ""
+"Project-Id-Version: luci-proto-amneziawg\n"
+"PO-Revision-Date: 2026-08-17 00:00+0400\n"
+"Last-Translator: \n"
+"Language-Team: Russian\n"
+"Language: ru\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+
+msgid "AmneziaWG Status"
+msgstr "Состояние AmneziaWG"
+
+msgctxt "AmneziaWG instance heading"
+msgid "Instance \"%h\""
+msgstr "Экземпляр «%h»"
+
+msgctxt "No AmneziaWG peer handshake yet"
+msgid "Never"
+msgstr "Никогда"
+
+msgctxt "AmneziaWG keep alive interval"
+msgid "every %s"
+msgstr "каждые %s с"
+
+msgctxt "Tooltip displaying full AmneziaWG peer public key"
+msgid "Public key: %h"
+msgstr "Публичный ключ: %h"
+
+msgctxt "AmneziaWG listen port"
+msgid "Port %d"
+msgstr "Порт %d"
+
+msgid "No AmneziaWG interfaces configured."
+msgstr "Интерфейсы AmneziaWG не настроены."
+
+msgid "Random Trailers"
+msgstr "Случайные хвосты пакетов"
+
+msgid "Cookie Replies"
+msgstr "Ответы Cookie Reply"
+
+msgid "enabled"
+msgstr "включено"
+
+msgid "disabled"
+msgstr "отключено"
+
+msgid "%dd ago"
+msgstr "%d дн. назад"
+
+msgid "No handshake recorded"
+msgstr "Рукопожатий ещё не было"
+
+msgid "Never connected"
+msgstr "Подключений не было"
+
+msgid "Recent handshake"
+msgstr "Недавнее рукопожатие"
+
+msgid "A recent handshake was recorded. This does not continuously test connectivity."
+msgstr "Недавно было зафиксировано рукопожатие. Это не означает непрерывную проверку соединения."
+
+msgid "No recent handshake"
+msgstr "Нет недавнего рукопожатия"
+
+msgid "The last handshake is older than three minutes. An idle peer may still be configured correctly."
+msgstr "Последнее рукопожатие было более трёх минут назад. При этом неактивный узел может быть настроен правильно."
+
+msgid "Copy"
+msgstr "Копировать"
+
+msgid "Copied"
+msgstr "Скопировано"
+
+msgid "Unable to copy the value."
+msgstr "Не удалось скопировать значение."
+
+msgid "No peers reported"
+msgstr "Интерфейс не сообщает об узлах"
+
+msgid "Configured peers will appear here when the interface reports them."
+msgstr "Настроенные узлы появятся здесь, когда интерфейс сообщит о них."
+
+msgid "AmneziaWG peers"
+msgstr "Узлы AmneziaWG"
+
+msgid "Traffic"
+msgstr "Трафик"
+
+msgid "Actions"
+msgstr "Действия"
+
+msgid "Not available"
+msgstr "Недоступно"
+
+msgid "Details"
+msgstr "Подробнее"
+
+msgid "Interface is running"
+msgstr "Интерфейс запущен"
+
+msgid "Interface is not running"
+msgstr "Интерфейс не запущен"
+
+msgid "Start the interface to see runtime peer information."
+msgstr "Запустите интерфейс, чтобы увидеть рабочее состояние узлов."
+
+msgid "Interface details"
+msgstr "Сведения об интерфейсе"
+
+msgid "Edit interface"
+msgstr "Редактировать интерфейс"
+
+msgid "Peers"
+msgstr "Узлы"
+
+msgid "Configuration and runtime information for AmneziaWG interfaces."
+msgstr "Настройки и рабочее состояние интерфейсов AmneziaWG."
+
+msgid "%d interface(s)"
+msgstr "Интерфейсов: %d"
+
+msgid "Updated: %s"
+msgstr "Обновлено: %s"
+
+msgid "Diagnostics"
+msgstr "Диагностика"
+
+msgid "AmneziaWG Diagnostics"
+msgstr "Диагностика AmneziaWG"
+
+msgid "The report excludes private keys, public keys and peer endpoints."
+msgstr "Отчёт не содержит закрытые и публичные ключи, а также адреса удалённых узлов."
+
+msgid "Copy report"
+msgstr "Копировать отчёт"
+
+msgid "Unable to load diagnostics."
+msgstr "Не удалось загрузить диагностические данные."
+
+msgid "Create an AmneziaWG interface or start an existing one to see its status here."
+msgstr "Создайте интерфейс AmneziaWG или запустите существующий, чтобы увидеть здесь его состояние."
+
+msgid "Open network interfaces"
+msgstr "Открыть сетевые интерфейсы"
+
+msgid "Unable to load AmneziaWG status."
+msgstr "Не удалось загрузить состояние AmneziaWG."
+
+msgid "The page will retry automatically."
+msgstr "Страница автоматически повторит попытку."
