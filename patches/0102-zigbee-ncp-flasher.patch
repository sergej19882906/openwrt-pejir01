+/* Запуск обёртки прошивки NCP: fs.exec возвращает {code, stdout, stderr}. */
+function runNcp(action) {
+	return fs.exec(NCP, [action]).then(function(r) {
+		var out = (r && r.stdout ? r.stdout : '');
+		var err = (r && r.stderr ? r.stderr : '');
+		var code = (r && typeof r.code !== 'undefined') ? r.code : 0;
+		return {
+			ok: (code === 0),
+			text: (out ? out : '') + (err ? ((out ? '\n' : '') + err) : '')
+		};
+	}).catch(function(e) {
+		return { ok: false, text: (e && e.message ? e.message : String(e || '')) };
+	});
+}
