Без этого после прошивки не видно, какой том читает загрузчик (rootfs,
rootfs0, rootfs1) и почему не поднимается Wi-Fi: добавляются /proc/mtd,
список томов UBI с именами, значение imgidx, iw dev, параметры
/etc/config/wireless, сообщения ядра по mt76/ieee80211 и наличие
firmware в /lib/firmware.
---
 .../htdocs/luci-static/resources/view/perenio/diag.js    | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
index cfab1e2..abf14ce 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
@@ -25,6 +25,15 @@ var SCRIPT = [
 	'ls -l /dev/ttyUSB* /dev/ttyACM* /dev/cdc-wdm* /dev/umxtty* /dev/ttyS* 2>&1',
 	'echo "--- modeminfo ---"',
 	'uci show modeminfo 2>/dev/null',
+	'echo "=== Разметка памяти: MTD и UBI ==="',
+	'cat /proc/mtd 2>/dev/null',
+	'echo -n "тома UBI: "; for u in /sys/class/ubi/ubi*_*; do [ -f "$u/name" ] && echo -n "$(basename $u)=$(cat $u/name) "; done; echo',
+	'echo -n "imgidx: "; fw_printenv -n imgidx 2>/dev/null; echo',
+	'echo "=== Wi-Fi ==="',
+	'iw dev 2>/dev/null',
+	'grep -E "option (ssid|disabled|country|channel|htmode)" /etc/config/wireless 2>/dev/null',
+	'dmesg 2>/dev/null | grep -iE "mt76|mt7603|mt7612|wiphy|ieee80211|firmware|calib" | tail -25',
+	'echo -n "firmware mt76: "; ls /lib/firmware/ 2>/dev/null | grep -i mt76 | tr "\n" " "; echo',
 	'echo "=== Сеть ==="',
 	'ip -o link show 2>/dev/null',
 	'echo "--- network.lte ---"',
