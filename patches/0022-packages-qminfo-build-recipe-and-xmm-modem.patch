Пакет qminfo из modemfeed нельзя было собрать: в его Makefile не было ни
Build/Prepare, ни Build/Compile, поэтому исходники из src/ никогда не
попадали в каталог сборки, а make запускался в пустом каталоге. Пакет
лежал в дереве, но в образ не попадал — и никогда не попадал.

Добавлены:
- PKG_BUILD_DIR;
- Build/Prepare: копирование ./src/* в каталог сборки;
- Build/Compile: сборка с SYSROOT=$(STAGING_DIR) и
  CROSS_TRIPLE=$(TARGET_CROSS), чтобы pkg-config нашёл qmi-glib.pc из
  staging и компилятор был кросс-компилятором OpenWrt.

Проверено до сборки:
- qmi-glib.pc ставится пакетом libqmi (в openwrt/packages, ветка
  openwrt-25.12: libs/libqmi) в /usr/lib/pkgconfig — того же пакета,
  который указан в DEPENDS;
- libqmi из фида 25.12 — версия 1.36.0-r1, весь используемый qminfo
  API (qmi_client_dms_*, qmi_client_nas_*, qmi_device_allocate_client)
  в ней присутствует;
- mbim-glib не обязателен: прямых вызовов mbim_* в коде нет, нужен
  только флаг QMI_DEVICE_OPEN_FLAGS_MBIM из libqmi.

xmm-modem — пакет без компиляции (PKGARCH:=all, готовит скрипты gcom и
обработчик протокола netifd для Fibocom L850/L860/FM350).
---
 package/qminfo/Makefile | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/package/qminfo/Makefile b/package/qminfo/Makefile
index 7e27fcd..05ae26a 100644
--- a/package/qminfo/Makefile
+++ b/package/qminfo/Makefile
@@ -13,6 +13,8 @@ PKG_RELEASE:=1
 
 include $(INCLUDE_DIR)/package.mk
 
+PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_SOURCE_SUBDIR)
+
 define Package/$(PKG_NAME)
   SECTION:=utils
   CATEGORY:=Utilities
@@ -25,6 +27,17 @@ define Package/$(PKG_NAME)/description
 	QMI info
 endef
 
+define Build/Prepare
+	$(INSTALL_DIR) $(PKG_BUILD_DIR)
+	$(CP) ./src/* $(PKG_BUILD_DIR)/
+endef
+
+define Build/Compile
+	$(MAKE) -C $(PKG_BUILD_DIR) \
+		SYSROOT=$(STAGING_DIR) \
+		CROSS_TRIPLE=$(TARGET_CROSS)
+endef
+
 define Package/$(PKG_NAME)/install
 	$(INSTALL_DIR) $(1)/usr/bin
 	$(INSTALL_BIN) $(PKG_BUILD_DIR)/$(PKG_NAME) $(1)/usr/bin/
