index 0000000..7444bfb
--- /dev/null
+++ b/package/luci-app-perenio/root/usr/libexec/pejir-ussd
@@ -0,0 +1,200 @@
+#!/bin/sh
+# /usr/libexec/pejir-ussd - USSD-запрос к модему (AT+CUSD).
+#
+# Использование:
+#   pejir-ussd [-p ПОРТ] [--restart-lte] КОД
+#
+# Печатает в stdout ответ оператора (одна строка) либо текст ошибки.
+# Код возврата: 0 - ответ получен, 1 - ошибка.
+#
+# Почему отдельный файл, а не "sh -c <текст>":
+#   rpcd проверяет ACL для файла, запускаемого через file.exec, и требует
+#   права на КОНКРЕТНЫЙ путь. Отдельный известный путь позволяет выдать
+#   ровно один грант (write.file["/usr/libexec/pejir-ussd"] = ["exec"])
+#   и не открывать exec для /bin/sh или busybox.
+#
+# Особенность GM510 (как и у многих LTE-модемов):
+#   при активном голосовом/дата-вызове AT-порт перестаёт отвечать.
+#   Поэтому по умолчанию скрипт НЕ трогает соединение - если модем
+#   молчит, в выводе печатается подсказка, а страница LuCI предлагает
+#   повторить запрос с перезапуском LTE (--restart-lte).
+
+SMSD_WAS=0
+RESTART_LTE=0
+PORT=""
+CODE=""
+
+die() {
+	echo "ERROR: $1"
+	exit 1
+}
+
+usage() {
+	echo "usage: pejir-ussd [-p PORT] [--restart-lte] CODE"
+}
+
+while [ $# -gt 0 ]; do
+	case "$1" in
+		-p)
+			PORT="$2"
+			shift 2
+			;;
+		--restart-lte)
+			RESTART_LTE=1
+			shift
+			;;
+		-h|--help)
+			usage
+			exit 0
+			;;
+		*)
+			CODE="$1"
+			shift
+			;;
+	esac
+done
+
+[ -n "$CODE" ] || { usage; exit 1; }
+
+# Код USSD допускает только буквы, цифры и служебные символы - иначе
+# сломается AT-команда.
+case "$CODE" in
+	*[!0-9A-Za-z*#+\-]*)
+		die "invalid USSD code"
+		;;
+esac
+
+# Кандидаты AT-портов: подтверждённый порт из /etc/pejir/at-port, затем
+# штатный порядок. Дубли убираем.
+candidates() {
+	if [ -n "$PORT" ]; then
+		echo "$PORT"
+		return
+	fi
+	if [ -f /etc/pejir/at-port ]; then
+		p=$(head -n 1 /etc/pejir/at-port 2>/dev/null)
+		[ -n "$p" ] && echo "$p"
+	fi
+	echo /dev/ttyUSB2
+	echo /dev/ttyUSB1
+	echo /dev/ttyUSB0
+	echo /dev/ttyACM0
+}
+
+# Обмен с модемом: отправить команду и прочитать ответ. Чтение идёт
+# порциями по секунде и прерывается, как только в ответе встретился
+# маркер want (если он задан), иначе - по истечении secs секунд.
+at_send_read() {
+	_aport="$1"
+	_acmd="$2"
+	_secs="$3"
+	_want="${4:-}"
+
+	stty -F "$_aport" 115200 raw -echo 2>/dev/null || return 1
+	printf '%s\r' "$_acmd" > "$_aport" 2>/dev/null || return 1
+
+	_out=""
+	_i=0
+
+	while [ "$_i" -lt "$_secs" ]; do
+		_chunk=$(timeout 1 cat "$_aport" 2>/dev/null)
+		_out="$_out$_chunk"
+
+		if [ -n "$_want" ]; then
+			case "$_out" in
+				*"$_want"*) break ;;
+			esac
+		fi
+
+		_i=$((_i + 1))
+	done
+
+	printf '%s' "$_out"
+}
+
+# Достать текст USSD из ответа вида  +CUSD: 1,"Balance 100",0
+parse_ussd() {
+	printf '%s\n' "$1" | awk '
+		match($0, /\+CUSD: *[0-9]+, *"/) {
+		s = substr($0, RSTART + RLENGTH)
+		q = index(s, "\"")
+		if (q > 0) {
+			s = substr(s, 1, q - 1)
+			gsub(/\\r|\\n/, " ", s)
+			gsub(/\\"/, "\"", s)
+			print s
+			exit
+		}
+	}'
+}
+
+smsd_stop() {
+	[ -x /etc/init.d/smsd ] || return 0
+	if pidof smsd >/dev/null 2>&1; then
+		SMSD_WAS=1
+		/etc/init.d/smsd stop >/dev/null 2>&1
+		sleep 2
+	fi
+	return 0
+}
+
+smsd_start() {
+	[ "$SMSD_WAS" = "1" ] || return 0
+	/etc/init.d/smsd start >/dev/null 2>&1
+	SMSD_WAS=0
+	return 0
+}
+
+# Один проход по портам: проба живым AT, затем сам USSD-запрос.
+try_ports() {
+	for _p in $(candidates); do
+		[ -c "$_p" ] || continue
+		case "$_p" in
+			*' '*|*'	'*) continue ;;
+		esac
+
+		_probe=$(at_send_read "$_p" 'AT' 3 'OK')
+		case "$_probe" in
+			*OK*) ;;
+			*) continue ;;
+		esac
+
+		_out=$(at_send_read "$_p" "AT+CUSD=1,\"$CODE\",15" 20 '+CUSD')
+		_ans=$(parse_ussd "$_out")
+
+		if [ -n "$_ans" ]; then
+			printf '%s\n' "$_ans"
+			return 0
+		fi
+	done
+	return 1
+}
+
+smsd_stop
+
+if try_ports; then
+	smsd_start
+	exit 0
+fi
+
+# Модем молчит. Если явно попросили - рвём LTE-вызов (на GM510 AT-порт
+# блокируется активным data call) и пробуем ещё раз.
+if [ "$RESTART_LTE" = "1" ]; then
+	echo "LTE restarting..." >&2
+	ifdown lte >/dev/null 2>&1
+	sleep 12
+
+	if try_ports; then
+		ifup lte >/dev/null 2>&1
+		smsd_start
+		exit 0
+	fi
+
+	ifup lte >/dev/null 2>&1
+	smsd_start
+	die "modem did not answer even after LTE restart"
+fi
+
+smsd_start
+echo "modem did not answer (AT port is blocked while the LTE data call is active; retry with the LTE restart option)"
+exit 1
