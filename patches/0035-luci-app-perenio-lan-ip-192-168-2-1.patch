Заводская прошивка использовала 192.168.2.0/24 для LAN, дефолт OpenWrt -
192.168.1.1, что конфликтует с домашним роутером (WAN и LAN в одной
подсети -> NAT не работает). Меняем только если стоит именно дефолт
OpenWrt, свой адрес не трогаем.
---
 package/luci-app-perenio/Makefile                   |  2 ++
 .../root/etc/uci-defaults/50-perenio-network        | 13 +++++++++++++
 2 files changed, 15 insertions(+)
 create mode 100644 package/luci-app-perenio/root/etc/uci-defaults/50-perenio-network

diff --git a/package/luci-app-perenio/Makefile b/package/luci-app-perenio/Makefile
index 1ec4c06..7666e46 100644
--- a/package/luci-app-perenio/Makefile
+++ b/package/luci-app-perenio/Makefile
@@ -35,6 +35,8 @@ define Package/luci-app-perenio/install
 		$(1)/etc/uci-defaults/50-perenio-wifi
 	$(INSTALL_BIN) ./root/etc/uci-defaults/50-perenio-fwenv \
 		$(1)/etc/uci-defaults/50-perenio-fwenv
+	$(INSTALL_BIN) ./root/etc/uci-defaults/50-perenio-network \
+		$(1)/etc/uci-defaults/50-perenio-network
 	$(INSTALL_DIR) $(1)/usr/share/luci/menu.d
 	$(INSTALL_DATA) ./root/usr/share/luci/menu.d/luci-app-perenio.json \
 		$(1)/usr/share/luci/menu.d/luci-app-perenio.json
diff --git a/package/luci-app-perenio/root/etc/uci-defaults/50-perenio-network b/package/luci-app-perenio/root/etc/uci-defaults/50-perenio-network
new file mode 100644
index 0000000..683f4bf
--- /dev/null
+++ b/package/luci-app-perenio/root/etc/uci-defaults/50-perenio-network
@@ -0,0 +1,13 @@
+#!/bin/sh
+# PEJIR01: LAN должен быть в сети 192.168.2.0/24 - так было в заводской
+# прошивке. Дефолт OpenWrt - 192.168.1.1 - конфликтует с домашним
+# роутером (он же обычно 192.168.1.1), из-за чего WAN и LAN оказываются
+# в одной подсети и перестаёт работать NAT.
+#
+# Меняем только если стоит дефолт OpenWrt - свой адрес юзера не трогаем.
+cur="$(uci -q get network.lan.ipaddr)"
+[ "$cur" = "192.168.1.1" ] || exit 0
+
+uci set network.lan.ipaddr='192.168.2.1'
+uci commit network
+exit 0
