Команда "pejir-sms-ctl log" искала журнал только по жёстким путям
(/var/log/smsd.log, /tmp/log/smsd.log и их .1). На устройстве это
правильно, но проверить команду тестом было нельзя - в тестовой
системе таких файлов нет.

Добавлена переменная окружения PEJIR_SMS_LOG: если она задана, журнал
берётся только из этого файла. Поведение по умолчанию не изменилось -
на устройстве переменная не задаётся.

Нужно для теста команды log (хвост журнала, ограничение числа строк).
---
 package/pejir-sms/root/usr/libexec/pejir-sms-ctl | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/package/pejir-sms/root/usr/libexec/pejir-sms-ctl b/package/pejir-sms/root/usr/libexec/pejir-sms-ctl
index 21a82919..441b06d1 100755
--- a/package/pejir-sms/root/usr/libexec/pejir-sms-ctl
+++ b/package/pejir-sms/root/usr/libexec/pejir-sms-ctl
@@ -138,6 +138,16 @@ cmd_log() {
 	[ "$n" -ge 1 ] 2>/dev/null || n=8
 	[ "$n" -le 200 ] 2>/dev/null || n=200
 
+	# Путь к журналу можно переопределить (используется в тестах).
+	if [ -n "${PEJIR_SMS_LOG:-}" ]; then
+		if [ -f "$PEJIR_SMS_LOG" ]; then
+			tail -n "$n" "$PEJIR_SMS_LOG" 2>/dev/null
+		else
+			echo "(журнал smsd не найден)"
+		fi
+		exit 0
+	fi
+
 	for f in /var/log/smsd.log /tmp/log/smsd.log /var/log/smsd.log.1 /tmp/log/smsd.log.1; do
 		if [ -f "$f" ]; then
 			tail -n "$n" "$f" 2>/dev/null
