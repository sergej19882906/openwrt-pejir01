diff --git a/package/modeminfo/root/etc/init.d/pejir-modem-cache b/package/modeminfo/root/etc/init.d/pejir-modem-cache
new file mode 100644
index 00000000..fc7e0d0e
--- /dev/null
+++ b/package/modeminfo/root/etc/init.d/pejir-modem-cache
@@ -0,0 +1,157 @@
+#!/bin/sh /etc/rc.common
+# PEJIR01: фоновый сбор данных модема для веб-интерфейса.
+#
+# Зачем. Страницы LuCI "Модем" и "Оборудование", а также значок модема
+# в шапке запрашивали данные командой /usr/bin/modeminfo прямо из
+# браузера. Эта команда держит AT-порт (обмен с модемом занимает до
+# 90 секунд), из-за чего:
+#   * страница "Модем" висела до минуты - браузер ждал ответа rpcd;
+#   * значок в шапке опрашивал модем каждые 10 секунд и постоянно
+#     конфликтовал с smsd (отправка SMS сбивалась);
+#   * страница "Состояние системы" делала то же самое.
+#
+# Теперь данные собирает этот демон в фоне и кладёт их в файл
+# /tmp/pejir-modem.json, а браузер только читает этот файл (дешёвая
+# операция). Опрос модема идёт раз в PEJIR_MODEM_CACHE_INTERVAL секунд
+# и пропускается, если в очереди исходящих SMS лежит неотправленное
+# сообщение (порт занят smsd).
+#
+# Команды:
+#   refresh - запустить обновление в фоне и сразу вернуть управление;
+#   collect - обновить файл сейчас (в текущем процессе);
+#   watch   - бесконечный цикл обновления;
+#   status  - показать время последнего обновления и признак актуальности.
+
+START=96
+STOP=0
+
+STATE_FILE="${PEJIR_MODEM_STATE:-/tmp/pejir-modem.json}"
+MODEMINFO_BIN="${PEJIR_MODEMINFO_BIN:-/usr/bin/modeminfo}"
+# Путь к самому скрипту (rc.common подменяет $0, поэтому берём из
+# переменной окружения или из initscript).
+SELF="${PEJIR_MODEM_SELF:-${initscript:-/etc/init.d/pejir-modem-cache}}"
+INTERVAL="${PEJIR_MODEM_CACHE_INTERVAL:-180}"
+TIMEOUT="${PEJIR_MODEM_CACHE_TIMEOUT:-120}"
+SMS_OUTBOX="${PEJIR_SMS_OUTBOX:-/var/spool/sms/outgoing}"
+LOCK_DIR="${PEJIR_MODEM_LOCK:-/tmp/pejir-modem-cache.lock}"
+# Замок pejir-signal: если он есть, модем сейчас опрашивает демон
+# состояния сети - в AT-порт лезть нельзя.
+SIGNAL_LOCK="${PEJIR_SIGNAL_LOCK:-/tmp/pejir-signal.lock}"
+PID_FILE="${PEJIR_MODEM_PID:-/tmp/pejir-modem-cache.pid}"
+
+extra_command "refresh" "Refresh modem data in background"
+extra_command "collect" "Refresh modem data now"
+extra_command "watch" "Run cache refresh loop"
+extra_command "status" "Show modem cache state"
+
+log() {
+	logger -t pejir-modem-cache "$*" 2>/dev/null
+}
+
+# Один опрос за раз: демон и кнопка "Обновить" не должны лезть в порт
+# одновременно. Если процесс убили - замок снимаем через 2 минуты.
+lock_stale() {
+	local t now
+
+	[ -d "$LOCK_DIR" ] || return 0
+	t="$(stat -c %Y "$LOCK_DIR" 2>/dev/null)"
+	case "$t" in
+	''|*[!0-9]*) rm -rf "$LOCK_DIR" 2>/dev/null; return 0 ;;
+	esac
+	now="$(date +%s)"
+	[ "$((now - t))" -gt 120 ] && rm -rf "$LOCK_DIR" 2>/dev/null
+	return 0
+}
+
+sms_busy() {
+	[ -n "$(ls -1 "$SMS_OUTBOX" 2>/dev/null | head -1)" ]
+}
+
+do_collect() {
+	local out
+
+	[ -x "$MODEMINFO_BIN" ] || return 1
+
+	# Порт занят демоном состояния сети - ждём следующего цикла.
+	[ -d "$SIGNAL_LOCK" ] && return 1
+
+	# В очереди исходящих SMS лежит неотправленное сообщение: порт
+	# занят smsd, опрос модема сбил бы отправку SMS.
+	sms_busy && return 1
+
+	lock_stale
+	mkdir "$LOCK_DIR" 2>/dev/null || return 1
+
+	out="$(timeout "$TIMEOUT" "$MODEMINFO_BIN" 2>/dev/null)"
+	case "$out" in
+	'{'*)
+		printf '%s\n' "$out" > "$STATE_FILE.tmp" 2>/dev/null &&
+			mv "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null
+		;;
+	*)
+		log "модем не ответил - данные не обновлены"
+		;;
+	esac
+
+	rmdir "$LOCK_DIR" 2>/dev/null
+	return 0
+}
+
+# Обновление в фоне: команда возвращает управление сразу, браузер не
+# ждёт обмена с модемом.
+do_refresh() {
+	if command -v setsid >/dev/null 2>&1; then
+		( setsid "$SELF" collect >/dev/null 2>&1 & )
+	elif command -v nohup >/dev/null 2>&1; then
+		( nohup "$SELF" collect >/dev/null 2>&1 & )
+	else
+		( "$SELF" collect >/dev/null 2>&1 & )
+	fi
+	return 0
+}
+
+do_watch() {
+	while :; do
+		sleep 5
+		if ! sms_busy; then
+			do_collect >/dev/null 2>&1
+		fi
+		sleep "$INTERVAL"
+	done
+}
+
+do_status() {
+	if [ -f "$STATE_FILE" ]; then
+		echo "ts=$(stat -c %Y "$STATE_FILE" 2>/dev/null)"
+		echo "size=$(wc -c < "$STATE_FILE" 2>/dev/null)"
+	else
+		echo "нет данных"
+	fi
+}
+
+refresh() { do_refresh; }
+collect() { do_collect; }
+watch()   { do_watch; }
+status()  { do_status; }
+
+# Без USE_PROCD=1 rc.common вызывает start()/stop() сам.
+start() {
+	if command -v setsid >/dev/null 2>&1; then
+		setsid sh -c "echo \$\$ > $PID_FILE; exec $SELF watch" >/dev/null 2>&1 &
+	else
+		sh -c "echo \$\$ > $PID_FILE; exec $SELF watch" >/dev/null 2>&1 &
+	fi
+}
+
+stop() {
+	local pid
+
+	pid="$(cat "$PID_FILE" 2>/dev/null)"
+	case "$pid" in
+	''|*[!0-9]*) ;;
+	*) kill "$pid" 2>/dev/null ;;
+	esac
+	rm -f "$PID_FILE" 2>/dev/null
+	rmdir "$LOCK_DIR" 2>/dev/null
+	return 0
+}
