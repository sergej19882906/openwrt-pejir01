@@ -189,6 +189,17 @@ function parseMessage(txt) {
 	return { from: from, date: date, text: body.join('\n').trim() };
 }
 
+/* Кеш разобранных сообщений: каталог -> { имя файла: { mtime, msg } }.
+ *
+ * Зачем. Раньше страница каждые 20 секунд перечитывала ВСЕ файлы во
+ * всех четырёх каталогах spool (до 50 файлов в каждом - это до 200
+ * запросов fs.read через rpcd за один цикл). На большом архиве
+ * переписки страница заметно "тупила", а rpcd был загружен.
+ * Теперь файл читается только если он изменился (mtime), поэтому
+ * каждый цикл - это несколько запросов на новые сообщения, а не
+ * две сотни на все подряд. */
+var SPOOL_CACHE = {};
+
 /* Чтение сообщений из каталога spool smstools3. */
 function readSpool(dir) {
 	return fs.list(dir).catch(function() { return []; }).then(L.bind(function(list) {
@@ -203,9 +214,20 @@ function readSpool(dir) {
 		});
 
 		files.sort(function(a, b) { return b.mtime - a.mtime; });
-		files = files.slice(0, 50);
+		files = files.slice(0, 30);
+
+		var cache = SPOOL_CACHE[dir] || (SPOOL_CACHE[dir] = {});
+		var seen = {};
 
 		return Promise.all(files.map(function(f) {
+			var hit = cache[f.name];
+
+			seen[f.name] = 1;
+
+			/* Файл не менялся - берём готовый разбор. */
+			if (hit && hit.mtime === f.mtime)
+				return Promise.resolve(hit.msg);
+
 			return fs.read(dir + '/' + f.name).then(function(txt) {
 				var m = parseMessage(txt);
 
@@ -216,8 +238,18 @@ function readSpool(dir) {
 
 				return { name: f.name, mtime: f.mtime,
 					from: m.from, date: m.date, text: m.text };
+			}).then(function(msg) {
+				if (msg)
+					cache[f.name] = { mtime: f.mtime, msg: msg };
+				return msg;
 			}).catch(function() { return null; });
 		})).then(function(all) {
+			/* Забываем файлы, которых больше нет в каталоге. */
+			Object.keys(cache).forEach(function(n) {
+				if (!seen[n])
+					delete cache[n];
+			});
+
 			return all.filter(function(m) { return m != null; });
 		});
 	}, this));
