Subject: [PATCH] =?UTF-8?q?ramips:=20mt7621:=20=D0=B2=D0=BA=D0=BB=D1=8E?=
 =?UTF-8?q?=D1=87=D0=B8=D1=82=D1=8C=20USB-=D1=85=D0=BE=D1=81=D1=82=20(xhci?=
 =?UTF-8?q?)=20=D0=BD=D0=B0=20PEJIR01?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

В mt7621.dtsi контроллер xhci@1e1c0000 выключен по умолчанию, и
плата PEJIR01 его не включала. Из-за этого в системе не было USB
вообще: не определялась флешка с extroot и не работал LTE-модем
GM510 (он висит на usb0).

Регуляторы питания vbus/vusb33 в dtsi уже включены постоянно, поэтому
достаточно status = "okay".
---
 .../linux/ramips/dts/mt7621_perenio_pejir01-34-BA.dts  | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/target/linux/ramips/dts/mt7621_perenio_pejir01-34-BA.dts b/target/linux/ramips/dts/mt7621_perenio_pejir01-34-BA.dts
index 585d092..97716c0 100644
--- a/target/linux/ramips/dts/mt7621_perenio_pejir01-34-BA.dts
+++ b/target/linux/ramips/dts/mt7621_perenio_pejir01-34-BA.dts
@@ -139,6 +139,16 @@
 	status = "okay";
 };
 
+// USB-хост: xHCI-контроллер MT7621 (обслуживает и USB2, и USB3).
+// В mt7621.dtsi узел выключен по умолчанию, и плата PEJIR01 его не
+// включала — из-за этого в системе не было USB вообще: не работала
+// связь по LTE (GM510 висит на usb0) и не определялась флешка с
+// extroot. Регуляторы питания vbus/vusb33 в dtsi включены постоянно,
+// достаточно status = "okay".
+&xhci {
+	status = "okay";
+};
+
 &i2c {
 	status = "okay";
 };
