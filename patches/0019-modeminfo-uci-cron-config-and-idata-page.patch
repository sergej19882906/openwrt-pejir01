index 0000000..34bb6a4
--- /dev/null
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/idata.js
@@ -0,0 +1,155 @@
+'use strict';
+'require view';
+'require fs';
+'require ui';
+'require poll';
+
+var CONF = '/etc/config/idata';
+var LOADER = '/usr/sbin/idata_load';
+
+/* Разбор конфига UCI в плоский список опций */
+function parseUci(txt) {
+	var section = '';
+	var out = [];
+
+	(txt || '').split('\n').forEach(function(line) {
+		line = line.trim();
+
+		if (!line || line.charAt(0) == '#')
+			return;
+
+		if (line.indexOf('config ') === 0) {
+			section = line.substring(7).replace(/^'(.*)'$/, '$1').split(' ')[0];
+			return;
+		}
+
+		if (line.indexOf('option ') === 0) {
+			var m = line.substring(7).match(/^(\S+)\s+'?([\s\S]*)'?$/);
+
+			if (m)
+				out.push({ section: section, key: m[1], value: m[2] });
+		}
+	});
+
+	return out;
+}
+
+/* Понятные названия для известных опций idata */
+var TITLES = {
+	'ssid24_name': _('Имя Wi-Fi 2.4 ГГц'),
+	'ssid24_pass': _('Пароль Wi-Fi 2.4 ГГц'),
+	'ssid24_cc': _('Страна Wi-Fi 2.4 ГГц'),
+	'ssid5_name': _('Имя Wi-Fi 5 ГГц'),
+	'ssid5_pass': _('Пароль Wi-Fi 5 ГГц'),
+	'ssid5_cc': _('Страна Wi-Fi 5 ГГц'),
+	'admin_pass': _('Заводской пароль root'),
+	'wps_pin': _('WPS PIN'),
+	'mac': _('MAC-адрес'),
+	'serial': _('Серийный номер'),
+	'hardware': _('Аппаратная версия'),
+	'fw_version': _('Версия стоковой прошивки')
+};
+
+function setText(id, s) {
+	var el = document.getElementById(id);
+
+	if (el)
+		el.textContent = s;
+}
+
+return view.extend({
+	render: function() {
+		var loadBtn = E('button', { 'class': 'cbi-button cbi-button-action', 'type': 'button' },
+				_('Загрузить из idata'));
+
+		loadBtn.addEventListener('click', L.bind(this.handleLoad, this));
+
+		var body = E([
+			E('h2', {}, _('Заводские данные (Perenio)')),
+			E('div', { 'class': 'cbi-map' }, [
+				E('div', { 'class': 'cbi-section' }, [
+					E('div', { 'class': 'cbi-section-descr' },
+						_('Данные из заводского раздела idata: имя и пароль штатных Wi-Fi, ' +
+						  'заводской пароль администратора, серийный номер. При первом включении ' +
+						  'они уже применены к прошивке, здесь их можно посмотреть.'))
+				]),
+				E('div', { 'class': 'cbi-section' }, [
+					E('div', { 'id': 'idata-list' },
+						E('em', {}, _('Загрузка…')))
+				]),
+				E('div', { 'class': 'cbi-section' }, [
+					E('div', { 'class': 'cbi-value' }, [
+						E('div', { 'class': 'cbi-value-title' }, ''),
+						E('div', { 'class': 'cbi-value-field' }, loadBtn)
+					]),
+					E('div', { 'class': 'cbi-value-description' },
+						E('span', { 'id': 'idata-status' }, ''))
+				])
+			])
+		]);
+
+		poll.add(L.bind(this.refresh, this), 20);
+
+		return body;
+	},
+
+	refresh: function() {
+		return fs.read(CONF).then(function(txt) {
+			var box = document.getElementById('idata-list');
+
+			if (!box)
+				return;
+
+			var items = parseUci(txt);
+
+			if (!items.length) {
+				box.innerHTML = '<em>' +
+					_('Раздел idata не загружен. Нажмите «Загрузить из idata».') + '</em>';
+				return;
+			}
+
+			var rows = items.map(function(it) {
+				return E('tr', { 'class': 'tr' }, [
+					E('td', { 'class': 'td', 'style': 'white-space:nowrap' },
+						TITLES[it.key] || it.key),
+					E('td', { 'class': 'td', 'style': 'white-space:pre-wrap' },
+						it.value || '—')
+				]);
+			});
+
+			box.innerHTML = '';
+			box.appendChild(E('table', { 'class': 'table' }, [
+				E('tr', { 'class': 'tr table-titles' }, [
+					E('th', { 'class': 'th' }, _('Параметр')),
+					E('th', { 'class': 'th' }, _('Значение'))
+				])
+			].concat(rows)));
+		}).catch(function() {
+			var box = document.getElementById('idata-list');
+
+			if (box)
+				box.innerHTML = '<em>' + _('Файл /etc/config/idata не найден') + '</em>';
+		});
+	},
+
+	handleLoad: function(ev) {
+		setText('idata-status', _('Читаем idata…'));
+
+		return fs.exec(LOADER, [ '--force' ]).then(function(res) {
+			if (res.code != 0) {
+				setText('idata-status',
+					_('Не удалось прочитать idata') + ': ' + (res.stderr || '').trim());
+				return;
+			}
+
+			setText('idata-status', _('Готово'));
+			return this.refresh();
+		}).catch(function(err) {
+			setText('idata-status', _('Ошибка: ') + (err && err.message ? err.message : err));
+		});
+	},
+
+	handleSaveApply: null,
+	handleSave: null,
+	handleReset: null
+});
