diff --git a/package/pejir-lte-base/root/etc/init.d/41-pejir-modem b/package/pejir-lte-base/root/etc/init.d/41-pejir-modem
new file mode 100644
index 0000000..23dc878
--- /dev/null
+++ b/package/pejir-lte-base/root/etc/init.d/41-pejir-modem
@@ -0,0 +1,33 @@
+#!/bin/sh /etc/rc.common
+# Прописываем AT-порт LTE-модема GM510 для luci-app-modeminfo.
+#
+# Без этого раздел «Модем» в LuCI показывает пустые страницы: скрипт
+# modeminfo читает modeminfo.@modeminfo[0].device, а в стоковом
+# /etc/config/modeminfo задан только пустой раздел general.
+
+START=93
+STOP=0
+
+write_modeminfo() {
+	local port="$1"
+
+	# Свой конфиг пользователя не трогаем.
+	uci -q get modeminfo.@modeminfo[0].device >/dev/null 2>&1 && return 0
+
+	uci set modeminfo.modeminfo='modeminfo'
+	uci set modeminfo.modeminfo.device="$port"
+	uci commit modeminfo
+}
+
+start_service() {
+	local port
+
+	port="$(mdm-at --port 2>/dev/null)"
+	[ -n "$port" ] || port="/dev/ttyUSB0"
+
+	write_modeminfo "$port"
+}
+
+stop_service() {
+	return 0
+}
diff --git a/package/pejir-lte-base/root/usr/bin/mdm-at b/package/pejir-lte-base/root/usr/bin/mdm-at
index bf9854b..75f9f4a 100755
--- a/package/pejir-lte-base/root/usr/bin/mdm-at
+++ b/package/pejir-lte-base/root/usr/bin/mdm-at
@@ -1,15 +1,45 @@
 #!/bin/sh
-# GM510 AT helper. Usage: mdm-at "AT+CGDCONT=?" [tty]
+# GM510 AT helper.
+#
+#   mdm-at "AT+CGDCONT=?" [tty]  — выполнить AT-команду на порту
+#   mdm-at --port [tty]           — напечатать AT-порт модема (или "none")
+#
+# AT-порт ищется перебором ttyUSB*/ttyACM* с проверкой ответа "OK".
+
 TTY=${2:-auto}
+
+detect_port() {
+	local p
+
+	for p in /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB3 \
+	         /dev/ttyACM0 /dev/ttyACM1; do
+		[ -c "$p" ] || continue
+		printf 'AT\r' > "$p" 2>/dev/null
+		sleep 1
+		if head -c 64 "$p" 2>/dev/null | grep -q 'OK'; then
+			echo "$p"
+			return 0
+		fi
+	done
+
+	return 1
+}
+
+if [ "$1" = "--port" ]; then
+	if [ "$TTY" = auto ]; then
+		detect_port || echo none
+	else
+		[ -c "$TTY" ] && echo "$TTY" || echo none
+	fi
+	exit 0
+fi
+
 if [ "$TTY" = auto ]; then
-  for p in /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2; do
-    [ -c "$p" ] || continue
-    echo -e "AT\r" > "$p" 2>/dev/null
-    sleep 0.3
-    if head -c 60 "$p" 2>/dev/null | grep -q OK; then TTY="$p"; break; fi
-  done
+	TTY="$(detect_port)"
+	[ -n "$TTY" ] || { echo "no AT port found"; exit 1; }
 fi
+
 [ -c "$TTY" ] || { echo "no AT port found"; exit 1; }
-echo -e "$1\r" > "$TTY"
+printf '%s\r' "$1" > "$TTY"
 sleep 0.7
 head -c 500 "$TTY" | strings
