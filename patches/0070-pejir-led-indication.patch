index 0000000..064f40c
--- /dev/null
+++ b/package/luci-app-perenio/root/etc/init.d/pejir-led
@@ -0,0 +1,28 @@
+#!/bin/sh /etc/rc.common
+# Авто-индикация Perenio (STM32).
+#
+# Фоновый цикл /usr/libexec/pejir-led auto перекрашивает индикаторы,
+# помеченные в /etc/pejir/led.conf как auto, - по состоянию системы
+# (интернет/LTE/Wi-Fi). Логика цветов - как в заводской прошивке
+# (/usr/sbin/pim.lua): хорошо - зелёный, плохо - жёлтый, нет связи -
+# оранжевый.
+#
+# Ручные настройки (из страницы LuCI) помечаются как manual и авто-режим
+# их не трогает.
+
+START=97
+STOP=98
+USE_PROCD=1
+
+start_service() {
+	procd_open_instance
+	procd_set_param command /usr/libexec/pejir-led auto
+	procd_set_param respawn 3600 5 5
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_close_instance
+}
+
+stop_service() {
+	/usr/libexec/pejir-led off >/dev/null 2>&1
+}
diff --git a/package/luci-app-perenio/root/usr/libexec/pejir-led b/package/luci-app-perenio/root/usr/libexec/pejir-led
new file mode 100755
index 0000000..f7936f0
--- /dev/null
+++ b/package/luci-app-perenio/root/usr/libexec/pejir-led
@@ -0,0 +1,262 @@
+#!/bin/sh
+# Управление RGB-индикаторами Perenio PEJIR01.
+#
+# Индикаторы зажигает STM32 (а не ядро): в заводской прошивке /etc/config/led
+# пуст, а светодиодами управляет vendor-сервис через mcud:
+#
+#   mcu -p l <имя>=<значение>
+#
+# (в стоке это делает pim.lua: ubus mcud post {query="l ..."}).
+#
+# Имена индикаторов (сток, /usr/sbin/pim.lua):
+#   i  - интернет (eth0/l2tp/pppoe)
+#   l  - LTE/модем (4G - зелёный, 3G - синий, 2G - голубой)
+#   zb - ZigBee
+#   2  - Wi-Fi 2.4 ГГц
+#   5  - Wi-Fi 5 ГГц
+#   sh - служебный
+#   a  - служебный
+#
+# Значение: <цвет>[*<яркость 00-FF>][,<режим>]
+#   цвета: 0 (выключить), w r g b m y c o
+#   режимы: пусто - постоянно, f - быстрое мигание, 55/11 - мигание,
+#           s10/s25/s3 - скорость (как в стоковых blink*.sh)
+#
+# Команды:
+#   status                     - текущие настройки
+#   set <имя> <цвет> [режим]   - задать индикатор вручную
+#   auto <имя> on|off          - авто-режим для индикатора
+#   off                        - погасить все
+#   demo [секунд]              - мигание (как стоковый blink3.sh)
+#   auto                       - бесконечный цикл авто-режима (для init)
+
+set -u
+
+LEDS="2 5 zb i sh a l"
+# Переопределения путей нужны только тесту (tests/test-led.sh): в образе
+# это /etc/pejir/led.conf и /usr/bin/mcu.
+CONF="${LED_CONF:-/etc/pejir/led.conf}"
+MCU="${MCU_BIN:-/usr/bin/mcu}"
+
+# --- проверка значений -------------------------------------------------------
+
+valid_name() {
+	case " $LEDS " in
+	*" $1 "*) return 0 ;;
+	esac
+	return 1
+}
+
+valid_color() {
+	case "$1" in
+	0|w|r|g|b|m|y|c|o) return 0 ;;
+	esac
+	return 1
+}
+
+valid_mode() {
+	case "$1" in
+	"") return 0 ;;
+	f|55|11|s3|s10|s25) return 0 ;;
+	esac
+	return 1
+}
+
+# --- чтение и запись настроек ------------------------------------------------
+# Формат файла: "<имя> <режим> <цвет> <режим-мигания>", режим = auto|manual.
+
+conf_get() {
+	# Возвращает "<режим> <цвет> [мигание]" для индикатора $1.
+	[ -f "$CONF" ] || return 1
+	line="$(grep "^$1 " "$CONF" 2>/dev/null | head -1)"
+	[ -n "$line" ] || return 1
+	echo "$line" | cut -d' ' -f2-
+}
+
+conf_set() {
+	# $1 - имя, $2 - auto|manual, $3 - цвет, $4 - режим мигания
+	tmp="$CONF.tmp"
+	mkdir -p "$(dirname "$CONF")"
+	[ -f "$CONF" ] && grep -v "^$1 " "$CONF" > "$tmp" 2>/dev/null
+	printf '%s %s %s %s\n' "$1" "$2" "$3" "$4" >> "$tmp"
+	mv -f "$tmp" "$CONF"
+}
+
+conf_init() {
+	[ -f "$CONF" ] && return 0
+	mkdir -p "$(dirname "$CONF")"
+	for l in $LEDS; do
+		case "$l" in
+		i|l|2|5) printf '%s auto g\n' "$l" ;;
+		*) printf '%s manual 0\n' "$l" ;;
+		esac
+	done > "$CONF"
+}
+
+# --- отправка в STM32 --------------------------------------------------------
+
+send_led() {
+	# $1 - "имя=значение"
+	"$MCU" -p l "$1" >/dev/null 2>&1
+}
+
+apply() {
+	# $1 - имя, $2 - значение (цвет[+режим])
+	send_led "$1=$2"
+}
+
+# --- авто-режим: цвета по состоянию системы --------------------------------
+# Упрощённая стоковая логика (pim.lua): хорошо - зелёный, плохо - жёлтый,
+# нет связи - оранжевый.
+
+carrier_up() {
+	# $1 - имя интерфейса
+	[ -r "/sys/class/net/$1/carrier" ] || return 1
+	[ "$(cat "/sys/class/net/$1/carrier" 2>/dev/null)" = "1" ]
+}
+
+auto_color() {
+	case "$1" in
+	i)
+		if ip route show default 2>/dev/null | grep -q .; then echo g
+		elif carrier_up eth0 || carrier_up wan; then echo y
+		else echo o
+		fi
+		;;
+	l)
+		if carrier_up eth1; then echo g
+		else echo o
+		fi
+		;;
+	2)
+		if iw dev radio0 info 2>/dev/null | grep -q Interface; then echo g
+		else echo o
+		fi
+		;;
+	5)
+		if iw dev radio1 info 2>/dev/null | grep -q Interface; then echo g
+		else echo o
+		fi
+		;;
+	*)
+		echo ""
+		;;
+	esac
+}
+
+auto_loop() {
+	conf_init
+	last=""
+	while true; do
+		for l in $LEDS; do
+			set -- $(conf_get "$l")
+			[ "$1" = "auto" ] || continue
+			color="$(auto_color "$l")"
+			[ -n "$color" ] || continue
+			key="$l=$color"
+			[ "$key" = "$last" ] && continue
+			send_led "$key"
+			last="$key"
+		done
+		sleep 10
+	done
+}
+
+# --- команды -----------------------------------------------------------------
+
+cmd_status() {
+	conf_init
+	echo "STATE"
+	for l in $LEDS; do
+		set -- $(conf_get "$l")
+		echo "$l ${1:-manual} ${2:-0} ${3:-}"
+	done
+}
+
+cmd_set() {
+	name="$1"; color="$2"; mode="${3:-}"
+	if ! valid_name "$name"; then
+		echo "ERROR: неизвестный индикатор: $name"
+		return 1
+	fi
+	if ! valid_color "$color"; then
+		echo "ERROR: недопустимый цвет: $color"
+		return 1
+	fi
+	if ! valid_mode "$mode"; then
+		echo "ERROR: недопустимый режим: $mode"
+		return 1
+	fi
+	conf_init
+	val="$color"
+	[ -n "$mode" ] && val="$color,$mode"
+	apply "$name" "$val"
+	conf_set "$name" manual "$color" "$mode"
+	echo "OK $name=$val"
+}
+
+cmd_auto() {
+	name="$1"; state="$2"
+	if ! valid_name "$name"; then
+		echo "ERROR: неизвестный индикатор: $name"
+		return 1
+	fi
+	conf_init
+	set -- $(conf_get "$name")
+	color="${2:-g}"
+	case "$state" in
+	on)
+		conf_set "$name" auto "$color" ""
+		c="$(auto_color "$name")"
+		[ -n "$c" ] && apply "$name" "$c"
+		echo "OK $name auto"
+		;;
+	off)
+		conf_set "$name" manual "$color" ""
+		echo "OK $name manual"
+		;;
+	*)
+		echo "ERROR: auto <имя> on|off"
+		return 1
+		;;
+	esac
+}
+
+cmd_off() {
+	conf_init
+	for l in $LEDS; do
+		apply "$l" "0,s10"
+		conf_set "$l" manual "0" ""
+	done
+	echo "OK all off"
+}
+
+cmd_demo() {
+	secs="${1:-10}"
+	pattern="wrgbmyco"
+	end=$(( $(date +%s) + secs ))
+	while [ "$(date +%s)" -lt "$end" ]; do
+		for l in $LEDS; do
+			c="$(printf '%s' "$pattern" | cut -c$(( ( $(od -An -N1 -tu1 /dev/urandom 2>/dev/null || echo 1) % 8 ) + 1 )))"
+			[ -n "$c" ] && send_led "$l=$c,s3"
+		done
+		sleep 0.4
+	done
+	echo "OK demo finished"
+}
+
+case "${1:-}" in
+status) cmd_status ;;
+set) shift; cmd_set "$@" ;;
+auto)
+	if [ "${2:-}" = "" ]; then auto_loop
+	else shift; cmd_auto "$@"
+	fi
+	;;
+off) cmd_off ;;
+demo) shift; cmd_demo "$@" ;;
+*)
+	echo "Использование: pejir-led status|set <имя> <цвет> [режим]|auto <имя> on|off|off|demo [сек]|auto"
+	exit 1
+	;;
+esac
