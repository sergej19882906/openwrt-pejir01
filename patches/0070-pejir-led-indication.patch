+'use strict';
+'require view';
+'require fs';
+'require ui';
+
+/*
+ * Световая индикация Perenio PEJIR01.
+ *
+ * Индикаторы зажигает STM32: команда уходит через vendor-демон mcud
+ * (`mcu -p l <имя>=<значение>`), ровно как в заводственной прошивке 9.0.4
+ * (там это делает /usr/sbin/pim.lua через ubus mcud post {query="l ..."}).
+ *
+ * Индикаторы: i - интернет, l - LTE, zb - ZigBee, 2 - Wi-Fi 2.4 ГГц,
+ * 5 - Wi-Fi 5 ГГц, sh и a - служебные.
+ *
+ * Значение: <цвет>[,<режим>], где цвет - 0 (выключить) или w r g b m y c o,
+ * режим - пусто (постоянно), f/55/11 (мигание) или s10/s25/s3 (скорость).
+ *
+ * Всё общение с STM32 идёт через /usr/libexec/pejir-led (отдельный файл,
+ * а не "sh -c": rpcd требует грант по конкретному пути файла).
+ */
+
+var LED = '/usr/libexec/pejir-led';
+
+var COLORS = [
+	[ '0',  _('Off') ],
+	[ 'w',  _('White') ],
+	[ 'r',  _('Red') ],
+	[ 'g',  _('Green') ],
+	[ 'b',  _('Blue') ],
+	[ 'm',  _('Magenta') ],
+	[ 'y',  _('Yellow') ],
+	[ 'c',  _('Cyan') ],
+	[ 'o',  _('Orange') ]
+];
+
+var MODES = [
+	[ '',    _('Steady') ],
+	[ 'f',   _('Blink fast') ],
+	[ '55',  _('Blink 55') ],
+	[ '11',  _('Blink 11') ],
+	[ 's10', _('Speed 10') ],
+	[ 's25', _('Speed 25') ],
+	[ 's3',  _('Speed 3') ]
+];
+
+var DESCR = {
+	'i':  _('Internet connection'),
+	'l':  _('LTE / modem'),
+	'zb': _('ZigBee'),
+	'2':  _('Wi-Fi 2.4 GHz'),
+	'5':  _('Wi-Fi 5 GHz'),
+	'sh': _('Service indicator SH'),
+	'a':  _('Service indicator A')
+};
+
+var ORDER = [ 'i', 'l', '2', '5', 'zb', 'sh', 'a' ];
+
+function run(args) {
+	return fs.exec(LED, args).then(function(r) {
+		return (r && r.stdout ? r.stdout : '') +
+			(r && r.stderr ? r.stderr : '');
+	}).catch(function(e) {
+		return _('Failed to run: ') + (e && e.message ? e.message : String(e || ''));
+	});
+}
+
+return view.extend({
+	load: function() {
+		return run([ 'status' ]);
+	},
+
+	render: function(data) {
+		var state = {};
+		var raw = (data && data[0]) ? data[0] : '';
+		var lines = raw.split('\n');
+
+		for (var i = 0; i < lines.length; i++) {
+			var p = lines[i].split(' ');
+			if (p.length >= 3 && p[0] != 'STATE' && p[0] != '')
+				state[p[0]] = { mode: p[1], color: p[2], blink: (p.length > 3 ? p[3] : '') };
+		}
+
+		var rows = [];
+
+		ORDER.forEach(function(name) {
+			var st = state[name] || { mode: 'manual', color: '0', blink: '' };
+
+			var colorSel = E('select', { 'class': 'cbi-input-select',
+				'id': 'led-color-' + name, 'style': 'min-width:120px' },
+				COLORS.map(function(c) {
+					return E('option', {
+						'value': c[0],
+						'selected': (c[0] == st.color) ? 'selected' : null
+					}, c[1]);
+				}));
+
+			var modeSel = E('select', { 'class': 'cbi-input-select',
+				'id': 'led-mode-' + name, 'style': 'min-width:120px' },
+				MODES.map(function(m) {
+					return E('option', {
+						'value': m[0],
+						'selected': (m[0] == st.blink) ? 'selected' : null
+					}, m[1]);
+				}));
+
+			var autoChk = E('input', {
+				'type': 'checkbox',
+				'id': 'led-auto-' + name,
+				'checked': (st.mode == 'auto') ? 'checked' : null
+			});
+
+			rows.push(E('tr', { 'class': 'tr' }, [
+				E('td', { 'class': 'td', 'width': '22%' },
+					E('b', {}, name + ' - ' + (DESCR[name] || ''))),
+				E('td', { 'class': 'td' }, colorSel),
+				E('td', { 'class': 'td' }, modeSel),
+				E('td', { 'class': 'td' },
+					E('label', {}, [ autoChk, ' ' + _('Automatic') ]))
+			]));
+		});
+
+		function applyOne(name) {
+			var color = (document.getElementById('led-color-' + name) || {}).value || '0';
+			var blink = (document.getElementById('led-mode-' + name) || {}).value || '';
+			var auto = document.getElementById('led-auto-' + name);
+
+			if (auto && auto.checked)
+				return run([ 'auto', name, 'on' ]).then(function() {
+					return run([ 'status' ]);
+				});
+
+			return run([ 'set', name, color, blink ]).then(function() {
+				return run([ 'status' ]);
+			});
+		}
+
+		function refresh(text) {
+			return run([ 'status' ]).then(function(s) {
+				var el = document.getElementById('led-out');
+				if (el)
+					el.textContent = text ? (text + '\n' + s) : s;
+			});
+		}
+
+		var self = this;
+
+		return E('div', { 'class': 'cbi-section' }, [
+			E('h2', _('LED indication (Perenio STM32)')),
+			E('p', { 'class': 'cbi-value-description' },
+				_('Indicators are driven by the STM32 microcontroller, exactly as in the stock firmware: mcu -p l <name>=<color>[,<mode>]. Colors: white, red, green, blue, magenta, yellow, cyan, orange; 0 turns the indicator off. Automatic mode paints the indicator by the system state (like the stock pim service).')),
+			E('table', { 'class': 'table' }, [
+				E('tr', { 'class': 'tr table-titles' }, [
+					E('td', { 'class': 'td th' }, _('Indicator')),
+					E('td', { 'class': 'td th' }, _('Color')),
+					E('td', { 'class': 'td th' }, _('Blink mode')),
+					E('td', { 'class': 'td th' }, _('Mode'))
+				])
+			].concat(rows)),
+			E('div', { 'style': 'margin-top:10px; display:flex; gap:8px; flex-wrap:wrap' }, [
+				E('button', { 'class': 'cbi-button cbi-button-apply',
+					'click': ui.createHandlerFn(self, function() {
+						return Promise.all(ORDER.map(applyOne)).then(function() {
+							return refresh(_('Done'));
+						});
+					}) }, _('Apply all')),
+				E('button', { 'class': 'cbi-button cbi-button-neutral',
+					'click': ui.createHandlerFn(self, function() {
+						return run([ 'off' ]).then(function() {
+							return refresh(_('All indicators are off'));
+						});
+					}) }, _('Turn off all')),
+				E('button', { 'class': 'cbi-button cbi-button-neutral',
+					'click': ui.createHandlerFn(self, function() {
+						return run([ 'demo', '10' ]).then(function() {
+							return refresh(_('Demo finished'));
+						});
+					}) }, _('Blink demo (10 s)'))
+			]),
+			E('pre', { 'id': 'led-out',
+				'style': 'white-space:pre-wrap; word-break:break-word; font-family:monospace; font-size:12px; margin-top:10px; max-height:30vh; overflow:auto; border:1px solid #ccc; padding:8px;' },
+				(data && data[0]) ? data[0] : '')
+		]);
+	},
+
+	handleSaveApply: null,
+	handleSave: null,
+	handleReset: null
+});
