ФАКТ с живого устройства (релиз .56, ответ модема GM510 на USSD):

  +CUSD: 0,"00300002e003700310440002e000d000a04200435043a043b04
           30043c0430002e00204120430043a0430043d0441043804380020
           0434043b044f0020044204350431044f002100200416043c043800
           20002a0038003200320023", 17

То есть:
  * в DCS стоит 17, а не 15. По формуле стока (dcs/4)%3 это GSM-7,
    и текст разбирался по одному байту на символ - пользователь видел
    "набор символов";
  * первые 34 байта ответа - служебный заголовок оператора (в нём
    непечатные кодовые точки), дальше идёт настоящий текст UCS-2BE;
  * поэтому прежняя эвристика "есть байт 00 - значит UCS2" давала
    смесь из мусора и текста: заголовок попадал в ответ целиком.

Исправление: схему выбираем не по DCS, а по содержимому ответа.
Разбираем ответ тремя способами (один байт на символ и UCS-2 со
смещениями 0 и 1) и в каждом ищем самый осмысленный участок -
непрерывную последовательность правдоподобных кодовых точек.
Побеждает вариант, где больше букв (у служебного заголовка букв нет),
при равенстве - более длинный участок.

Служебный заголовок при этом отбрасывается целиком: его кодовые точки
непечатные, поэтому в ответ он не попадает.

Проверено тестом tests/test-ussd.sh на реальном ответе с устройства:
было "0\\x02\\ue003...Вакансии для тебя! Жми *822#", стало
"Вакансии для тебя! Жми *822#".
---
 .../root/usr/libexec/pejir-ussd               | 136 +++++++++++++-----
 1 file changed, 102 insertions(+), 34 deletions(-)

diff --git a/package/luci-app-perenio/root/usr/libexec/pejir-ussd b/package/luci-app-perenio/root/usr/libexec/pejir-ussd
index 7fbfa3e..231cdbc 100755
--- a/package/luci-app-perenio/root/usr/libexec/pejir-ussd
+++ b/package/luci-app-perenio/root/usr/libexec/pejir-ussd
@@ -242,29 +242,81 @@ function all_printable(hx,   i, c) {
 }
 
 # ASCII-цифры, пришедшие как hex-байты ("30" = символ '0'), -> число.
-# Первая кодовая точка (2 байта) - как в стоковом dcs.sh (_msg_decode).
-function first_cp(hx,   hi, lo) {
-	if (length(hx) < 4) return -1
-	hi = hexval(substr(hx, 1, 2))
-	lo = hexval(substr(hx, 3, 2))
-	if (hi < 0 || lo < 0) return -1
-	return hi * 256 + lo
+# Правдоподобен ли одиночный символ (кодовая точка) для текста оператора.
+function plausible(cp) {
+	if (cp >= 32 && cp <= 126) return 1           # печатный ASCII
+	if (cp == 9 || cp == 10 || cp == 13) return 1 # таб, LF, CR
+	if (cp == 160) return 1                       # неразрывный пробел
+	if (cp >= 192 && cp <= 255) return 1          # Latin-1
+	if (cp >= 256 && cp <= 383) return 1          # Latin Extended-A
+	if (cp >= 880 && cp <= 1023) return 1         # греческий
+	if (cp >= 1024 && cp <= 1279) return 1        # кириллица
+	if (cp >= 8192 && cp <= 8303) return 1        # пунктуация
+	if (cp >= 8352 && cp <= 8399) return 1        # валюта
+	return 0
 }
 
-# Диапазоны кириллицы Unicode (в т.ч. расширения) - по стоковому dcs.sh.
-# Их наличие означает UCS2 (2 байта на символ), даже если модем написал
-# в DCS 0 (GSM-7).
-function is_cyrillic(cp) {
-	if (cp < 0) return 0
-	# Десятичные константы: mawk (awk по умолчанию в CI) не понимает
-	# hex-литералы (0x0400 у него равно 0).
-	if (cp >= 1024 && cp <= 1279) return 1     # 0400-04ff  Кириллица
-	if (cp >= 1280 && cp <= 1327) return 1     # 0500-052f  Дополнение
-	if (cp >= 11744 && cp <= 11775) return 1   # 2de0-2dff  Расширение A
-	if (cp >= 42560 && cp <= 42655) return 1   # a640-a69f  Расширение B
+# Буква. По буквам выбирается схема: осмысленный текст важнее, чем
+# строка из одних цифр и "e" (служебный заголовок оператора).
+function is_letter(cp) {
+	if (cp >= 65 && cp <= 90) return 1
+	if (cp >= 97 && cp <= 122) return 1
+	if (cp >= 192 && cp <= 214) return 1
+	if (cp >= 216 && cp <= 246) return 1
+	if (cp >= 248 && cp <= 255) return 1
+	if (cp >= 256 && cp <= 383) return 1
+	if (cp >= 880 && cp <= 1023) return 1
+	if (cp >= 1024 && cp <= 1279) return 1
 	return 0
 }
 
+# Самый осмысленный участок при схеме "1 байт на символ".
+# Заполняет RUN_TEXT, RUN_LETTERS, RUN_BYTES, RUN_START.
+function bytes_run(hx,   i, n, cp, cur, cl, cll, best, bl, bll, bb, bs) {
+	n = length(hx); cur = ""; cl = 0; cll = 0
+	best = ""; bl = 0; bll = 0; bb = 0; bs = 0
+	for (i = 1; i + 1 <= n; i += 2) {
+		cp = hexval(substr(hx, i, 2))
+		if (cp < 0) break
+		if (plausible(cp)) {
+			if (cl == 0) bs = int((i - 1) / 2)
+			cur = cur utf8(cp); cl++
+			if (is_letter(cp)) cll++
+			if (cll > bll || (cll == bll && cl > bl)) {
+				best = cur; bl = cl; bll = cll; bb = cl
+			}
+		} else {
+			cur = ""; cl = 0; cll = 0
+		}
+	}
+	RUN_TEXT = best; RUN_LETTERS = bll; RUN_BYTES = bb; RUN_START = bs
+}
+
+# Самый осмысленный участок при схеме UCS-2 (2 байта на символ).
+# offb - смещение в байтах (0 или 1): у ответа оператора со служебным
+# заголовком текст начинается с нечётного байта.
+function ucs2_run(hx, offb,   i, n, hi, lo, cp, cur, cl, cll, best, bl, bll, bb, bs) {
+	n = length(hx); cur = ""; cl = 0; cll = 0
+	best = ""; bl = 0; bll = 0; bb = 0; bs = 0
+	for (i = offb * 2 + 1; i + 3 <= n; i += 4) {
+		hi = hexval(substr(hx, i, 2))
+		lo = hexval(substr(hx, i + 2, 2))
+		if (hi < 0 || lo < 0) break
+		cp = hi * 256 + lo
+		if (plausible(cp)) {
+			if (cl == 0) bs = offb + int((i - 1) / 2)
+			cur = cur utf8(cp); cl++
+			if (is_letter(cp)) cll++
+			if (cll > bll || (cll == bll && cl > bl)) {
+				best = cur; bl = cl; bll = cll; bb = cl * 2
+			}
+		} else {
+			cur = ""; cl = 0; cll = 0
+		}
+	}
+	RUN_TEXT = best; RUN_LETTERS = bll; RUN_BYTES = bb; RUN_START = bs
+}
+
 function ascii_num(s,   i, c, v, n) {
 	v = 0
 	n = length(s)
@@ -318,23 +370,39 @@ function ascii_num(s,   i, c, v, n) {
 	if (qpos < 1) next
 	payload = substr(rest, 1, qpos - 1)
 
-	# Схема по DCS (биты 3-2), как в стоковом dcs.sh.
-	if (dcs >= 0) scheme = int(dcs / 4) % 4
-	else scheme = 3
-
-	if (all_printable(payload)) {
-		ans = bytes_text(payload)
-	} else if (has_nul(payload)) {
-		ans = ucs2_text(payload)
-	} else if (is_cyrillic(first_cp(payload))) {
-		# Модем прислал UCS2, но в DCS написал 0 (GSM-7): ориентируемся
-		# на кодовую точку, как в стоковом dcs.sh.
-		ans = ucs2_text(payload)
-	} else if (scheme == 0 || scheme == 1) {
-		ans = bytes_text(payload)
-	} else {
-		ans = ucs2_text(payload)
+	# ФАКТ (живое устройство, релиз .56): модем GM510 отвечает на USSD
+	# так:
+	#     +CUSD: 0,"<служебный заголовок><текст в UCS-2>", 17
+	# То есть:
+	#   * в DCS стоит 17, а не 15 - схему по DCS угадать нельзя
+	#     (по формуле стока (17/4)%3 = 0 это GSM-7);
+	#   * перед текстом идёт служебный заголовок оператора НЕЧЁТНОЙ
+	#     длины (17 байт), из-за чего сам текст начинается с нечётного
+	#     байта, а после одного повреждённого байта - с чётного;
+	#   * поэтому ищем в ответе самый осмысленный участок текста и
+	#     берём схему по нему, а не наоборот.
+	#
+	# Три кандидата: один байт на символ и UCS-2 со смещениями 0 и 1.
+	# Побеждает тот, где больше букв; при равенстве - длиннее участок.
+	bytes_run(payload)
+	b_text = RUN_TEXT; b_let = RUN_LETTERS; b_bytes = RUN_BYTES; b_start = RUN_START
+	ucs2_run(payload, 0)
+	u0_text = RUN_TEXT; u0_let = RUN_LETTERS; u0_bytes = RUN_BYTES; u0_start = RUN_START
+	ucs2_run(payload, 1)
+	u1_text = RUN_TEXT; u1_let = RUN_LETTERS; u1_bytes = RUN_BYTES; u1_start = RUN_START
+
+	ans = b_text; alet = b_let; abytes = b_bytes; astart = b_start
+	if (u0_let > alet || (u0_let == alet && u0_bytes > abytes)) {
+		ans = u0_text; alet = u0_let; abytes = u0_bytes; astart = u0_start
 	}
+	if (u1_let > alet || (u1_let == alet && u1_bytes > abytes)) {
+		ans = u1_text; alet = u1_let; abytes = u1_bytes; astart = u1_start
+	}
+
+	# Служебный заголовок оператора (34 байта) выбрасываем целиком:
+	# он состоит из непечатных кодовых точек, поэтому в ответ не
+	# попадает. Схема с наибольшим числом букв выигрывает: у текста
+	# оператора букв много, у служебного заголовка - ни одной.
 
 	if (ans == "") ans = bytes_text(payload)
 

