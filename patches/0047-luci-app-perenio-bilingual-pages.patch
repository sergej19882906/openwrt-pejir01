diff --git a/package/luci-app-perenio/Makefile b/package/luci-app-perenio/Makefile
index 52a0dd7..c01094a 100644
--- a/package/luci-app-perenio/Makefile
+++ b/package/luci-app-perenio/Makefile
@@ -2,7 +2,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=luci-app-perenio
 PKG_VERSION:=1.0.0
-PKG_RELEASE:=5
+PKG_RELEASE:=6
 
 PKG_LICENSE:=Apache-2.0
 
@@ -53,6 +53,15 @@ define Package/luci-app-perenio/install
 	$(INSTALL_DIR) $(1)/usr/libexec
 	$(INSTALL_BIN) ./root/usr/libexec/perenio-diag \
 		$(1)/usr/libexec/perenio-diag
+	# Русский перевод наших страниц. Исходные строки в JS - английские,
+	# поэтому в английском режиме интерфейса страницы не остаются
+	# русскими. Каталог .lmo собираем из po/ru штатным po2lmo (его
+	# ставит luci-base как host-инструмент, он доступен в PATH при
+	# установке пакетов - так же, как это делает include/luci.mk для
+	# пакетов luci-i18n-*-ru).
+	$(INSTALL_DIR) $(1)/usr/lib/lua/luci/i18n
+	po2lmo ./po/ru/luci-app-perenio.po \
+		$(1)/usr/lib/lua/luci/i18n/luci-app-perenio.ru.lmo
 endef
 
 $(eval $(call BuildPackage,luci-app-perenio))
