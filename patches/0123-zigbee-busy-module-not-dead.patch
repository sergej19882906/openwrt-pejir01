 				]),
 				E('tr', { 'class': 'tr' }, [
 					E('td', { 'class': 'td' }, _('HOMEd service')),
diff --git a/package/luci-app-perenio/po/ru/luci-app-perenio.po b/package/luci-app-perenio/po/ru/luci-app-perenio.po
index 038053aa..3667a756 100644
--- a/package/luci-app-perenio/po/ru/luci-app-perenio.po
+++ b/package/luci-app-perenio/po/ru/luci-app-perenio.po
@@ -420,8 +420,6 @@ msgid "Show status"
 msgstr "Показать состояние"
 msgid "Working..."
 msgstr "Выполняется..."
-msgid "The EFR32 Zigbee module of the router. It talks to HOMEd over EZSP; if the module does not answer, its NCP firmware is flashed automatically. The flash resets the Zigbee module only and needs internet access to download the firmware."
-msgstr "Модуль Zigbee EFR32 роутера. Он общается с HOMEd по протоколу EZSP; если модуль не отвечает, его NCP-прошивка ставится автоматически. Прошивка перезапускает только модуль Zigbee и требует интернета для загрузки прошивки."
 msgid "Module /dev/umxtty1"
 msgstr "Модуль /dev/umxtty1"
 msgid "NCP firmware (EZSP)"
@@ -580,3 +578,19 @@ msgid "Last saved"
 msgstr "Сохранено в"
 msgid "The saved value is shown next to each field: the field itself keeps what you entered, and the value next to it is what is really stored in network.lte. A red value means the entered value differs from the saved one."
 msgstr "Рядом с каждым полем показано сохранённое значение: само поле сохраняет то, что вы ввели, а значение рядом - то, что действительно записано в network.lte. Красное значение означает, что введённое отличается от сохранённого."
+msgid "answers"
+msgstr "отвечает"
+msgid "does not answer"
+msgstr "не отвечает"
+msgid "port is missing"
