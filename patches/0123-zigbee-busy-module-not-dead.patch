+			'ok': _('answers'),
+			'busy': _('in use by HOMEd'),
+			'busy-ready': _('in use by HOMEd, coordinator ready'),
+			'missing': _('port is missing'),
+			'noresp': _('does not answer')
+		};
 
 		var self = this;
 
@@ -81,20 +90,22 @@ return view.extend({
