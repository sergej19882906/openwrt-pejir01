+msgid "check is not possible - the port is used by HOMEd"
+msgstr "проверка невозможна - порт занят HOMEd"
+msgid "not flashed (stock firmware)"
+msgstr "не перепрошивался (стоковая прошивка)"
+msgid "The EFR32 Zigbee module of the router. It talks to HOMEd over EZSP. While HOMEd is running, it keeps the port, so the module cannot be checked - its state is then taken from the HOMEd log. If the module does not answer, its NCP firmware can be flashed with a Gecko image (.gbl); the flash resets the Zigbee module only and needs internet access to download the firmware."
+msgstr "Модуль Zigbee EFR32 роутера. Он общается с HOMEd по протоколу EZSP. Пока работает HOMEd, он держит порт, поэтому модуль проверить нельзя - состояние берётся из журнала HOMEd. Если модуль не отвечает, его NCP-прошивку можно прошить Gecko-образом (.gbl); прошивка перезапускает только модуль Zigbee и требует интернета для загрузки прошивки."
diff --git a/package/pejir-zigbee-ncp/files/pejir-zigbee-ncp b/package/pejir-zigbee-ncp/files/pejir-zigbee-ncp
index f688b826..e43fb0ab 100755
--- a/package/pejir-zigbee-ncp/files/pejir-zigbee-ncp
+++ b/package/pejir-zigbee-ncp/files/pejir-zigbee-ncp
@@ -87,8 +87,26 @@ power_cycle() {
 	return 0
 }
 
+# Работает ли HOMEd с модулем.
+#
+# ВАЖНО. Пока HOMEd запущен, порт /dev/umxtty1 держит он, и EZSP-
+# рукопожатие с нашей стороны невозможно: модуль не «мёртв», он просто
+# занят. Раньше страница в этом случае показывала "не отвечает - нужна
+# прошивка", то есть предлагала перепрошить исправно работающий модуль
+# (и тем самым сбить координатор HOMEd). Поэтому, если HOMEd запущен,
+# рукопожатие не делаем, а состояние берём из журнала HOMEd.
+homed_running() {
+	pgrep -f "homed-zigbee" >/dev/null 2>&1
+}
+
+# Готов ли координатор в HOMEd (по журналу).
+homed_ready() {
+	logread 2>/dev/null | grep "homed-zigbee" | grep -q "Coordinator ready"
+}
+
 cmd_status() {
 	if [ ! -e "$PORT" ]; then
+		echo "status=missing"
 		log "порта $PORT нет - модуль Zigbee не подключён (uartmuxd не поднялся?)"
 		return 2
 	fi
@@ -96,7 +114,23 @@ cmd_status() {
 	if [ -f "$NCP_VERSION_FILE" ]; then
 		echo "IMAGE $(head -1 "$NCP_VERSION_FILE" 2>/dev/null)"
 	fi
-	pejir-ncp-flash status -p "$PORT"
+	if homed_running; then
+		if homed_ready; then
+			echo "status=busy-ready"
+		else
+			echo "status=busy"
+		fi
+		echo "NCP-ОТВЕТА-НЕ-ПРОВЕРЕНО"
+		log "модуль $PORT занят HOMEd - EZSP-проверка невозможна, состояние взято из журнала HOMEd"
+		return 0
+	fi
+	out="$(pejir-ncp-flash status -p "$PORT" 2>/dev/null)"
+	echo "$out"
+	case "$out" in
+	*NCP-ОТВЕТА-ДА*) echo "status=ok" ;;
+	*) echo "status=noresp" ;;
+	esac
+	return 0
 }
 
 # Запоминаем, каким образом прошит модуль: имя файла и его sha256.
@@ -114,6 +148,10 @@ cmd_ensure() {
 		log "порта $PORT нет - прошивка NCP невозможна, модуль не подключён"
 		return 2
 	fi
+	if homed_running; then
+		log "HOMEd работает с модулем - состояние определяется по журналу HOMEd, прошивка не выполняется"
+		return 0
+	fi
 	if pejir-ncp-flash status -p "$PORT" >/dev/null 2>&1; then
 		log "модуль $PORT отвечает по EZSP - прошивка NCP не нужна"
 		return 0
@@ -138,6 +176,16 @@ cmd_flash() {
 		log "порта $PORT нет - прошивка NCP невозможна, модуль не подключён"
 		return 2
 	fi
+	# HOMEd держит порт модуля. На время прошивки его надо остановить
+	# (иначе EZSP-рукопожатие невозможно), а после прошивки - запустить
+	# обратно, чтобы координатор поднялся заново.
+	homed_was_running=0
+	if homed_running; then
+		homed_was_running=1
+		log "останавливаю HOMEd на время прошивки модуля"
+		/etc/init.d/homed-zigbee stop >/dev/null 2>&1
+		sleep 3
+	fi
 	# Перед прошивкой модуль лучше перезапустить: зависший модуль не
 	# ответит на EZSP-рукопожатие, и прошивка не начнётся.
 	power_cycle
@@ -145,6 +193,11 @@ cmd_flash() {
 	pejir-ncp-flash flash -p "$PORT" -f "$(image_path)" || return 1
 	save_ncp_version
 	log "записана версия NCP: $NCP_VERSION_FILE"
+	[ "$homed_was_running" = "1" ] && {
+		log "запускаю HOMEd обратно"
+		/etc/init.d/homed-zigbee start >/dev/null 2>&1
+	}
+	return 0
 }
 
