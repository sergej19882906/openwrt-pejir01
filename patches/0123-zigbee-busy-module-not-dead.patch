 			E('h2', {}, _('Zigbee module (PEJIR01)')),
 			E('div', { 'class': 'cbi-section-descr' },
-				_('The EFR32 Zigbee module of the router. It talks to HOMEd over EZSP; if the module does not answer, its NCP firmware is flashed automatically. The flash resets the Zigbee module only and needs internet access to download the firmware.')),
+				_('The EFR32 Zigbee module of the router. It talks to HOMEd over EZSP. While HOMEd is running, it keeps the port, so the module cannot be checked - its state is then taken from the HOMEd log. If the module does not answer, its NCP firmware can be flashed with a Gecko image (.gbl); the flash resets the Zigbee module only and needs internet access to download the firmware.')),
 
 			E('table', { 'class': 'table' }, [
 				E('tr', { 'class': 'tr' }, [
 					E('td', { 'class': 'td', 'width': '33%' }, _('Module /dev/umxtty1')),
-					E('td', { 'class': 'td' }, d.status || _('not checked'))
+					E('td', { 'class': 'td' }, statusText[d.status] || _('not checked'))
 				]),
 				E('tr', { 'class': 'tr' }, [
 					E('td', { 'class': 'td' }, _('NCP firmware (EZSP)')),
-					E('td', { 'class': 'td' }, answer ? _('answers, flashing not needed') : _('does not answer - flashing required'))
+					E('td', { 'class': 'td' }, answer ? _('answers, flashing not needed') :
+						(notChecked ? _('check is not possible - the port is used by HOMEd') :
+							_('does not answer - flashing required')))
 				]),
 				E('tr', { 'class': 'tr' }, [
 					E('td', { 'class': 'td' }, _('Flashed NCP image')),
-					E('td', { 'class': 'td' }, d.image || _('unknown'))
