diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
new file mode 100644
index 0000000..7c63f7d
--- /dev/null
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
@@ -0,0 +1,58 @@
+'use strict';
+'require view';
+'require fs';
+'require ui';
+
+/* Сводная диагностика: USB-контроллер и устройства, модем (ttyUSB/cdc-wdm),
+   интерфейс LTE, состояние служб STM32 и данные батареи.
+   Всё собирается одной командой через fs.exec — в LuCI 25.12 чтение
+   произвольных путей (fs.read) ограничено белым списком, а exec —
+   нет. Право file.exec есть в ACL luci-app-perenio (операция write). */
+var SCRIPT = [
+	'echo "=== Модель и DTB ==="',
+	'cat /proc/device-tree/model 2>/dev/null; echo',
+	'echo -n "узлы device-tree: "; ls /proc/device-tree/ 2>/dev/null | tr "\\n" " "; echo',
+	'echo -n "xhci status: "; cat /proc/device-tree/xhci@1e1c0000/status 2>/dev/null; echo',
+	'echo "=== USB: сообщения ядра ==="',
+	'dmesg 2>/dev/null | grep -iE "xhci|ehci|ohci|uhci|dwc|usb [0-9]|new .*USB device|option|cdc_ether|cdc_ncm|cdc_mbim|rndis|scsi|uas" | tail -40',
+	'echo "=== USB: устройства ==="',
+	'echo -n "sysfs: "; ls /sys/bus/usb/devices/ 2>/dev/null | tr "\\n" " "; echo',
+	'cat /sys/bus/usb/devices/*/product 2>/dev/null',
+	'echo "=== Модем, UART и мультиплексор ==="',
+	'ls -l /dev/ttyUSB* /dev/ttyACM* /dev/cdc-wdm* /dev/umxtty* /dev/ttyS* 2>&1',
+	'echo "=== Сеть ==="',
+	'ip -o link show 2>/dev/null',
+	'echo "--- network.lte ---"',
+	'uci show network 2>/dev/null | grep -E "lte|usb0|wan"',
+	'echo "=== Службы ==="',
+	'ps w 2>/dev/null | grep -E "mcud|uartmuxd|smsd|mcu" | grep -v grep',
+	'echo "=== Батарея: mcu ==="',
+	'/usr/bin/mcu getvolt 2>&1; echo',
+	'/usr/bin/mcu getsys 2>&1; echo',
+	'/usr/bin/mcu getver 2>&1; echo',
+	'echo "=== Журнал: usb/mcu/lte ==="',
+	'logread 2>/dev/null | grep -iE "mcu|uartmux|umxtty|usb|lte|modem|smsd" | tail -30'
+].join('; ') + '; true';
+
+return view.extend({
+	load: function() {
+		return fs.exec('/bin/sh', [ '-c', SCRIPT ]).then(function(txt) {
+			return [ txt || '' ];
+		}).catch(function(e) {
+			return [ _('Не удалось выполнить диагностику: ') + (e || '') ];
+		});
+	},
+
+	render: function(data) {
+		return E('div', { 'class': 'cbi-section' }, [
+			E('h2', _('Диагностика USB, LTE и батареи (PEJIR01)')),
+			E('p', { 'class': 'cbi-value-description' }, _('Сводка состояния: USB-контроллер и подключённые устройства, модем, интерфейс LTE, службы STM32 и данные батареи. Скопируйте содержимое блока ниже.')),
+			E('pre', { 'style': 'white-space:pre-wrap; word-break:break-word; font-family:monospace; font-size:12px; max-height:65vh; overflow:auto; border:1px solid #ccc; padding:8px;' },
+				(data && data[0]) ? data[0] : _('(пусто)')),
+			E('button', {
+				'class': 'cbi-button cbi-button-neutral',
+				'click': ui.createHandlerFn(this, function() { window.location.reload(); })
+			}, _('Обновить'))
+		]);
+	}
+});
