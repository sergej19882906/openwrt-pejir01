+			}
+		}
 	}
 }
diff --git a/package/uartmuxd/src/uartmuxd.c b/package/uartmuxd/src/uartmuxd.c
index 0233707..954bb79 100644
--- a/package/uartmuxd/src/uartmuxd.c
+++ b/package/uartmuxd/src/uartmuxd.c
@@ -419,12 +419,6 @@ int main(int argc, char **argv) {
         }
     }
 
-    if (send_startup_sequence(sfd, &cfg) < 0) {
-        perror("startup-seq");
-        close(sfd);
-        return 1;
-    }
-
     struct chan chans[MAX_DLCI];
     memset(chans, 0, sizeof(chans));
     for (int i = 0; i < MAX_DLCI; i++) chans[i].mfd = -1;
@@ -441,6 +435,24 @@ int main(int argc, char **argv) {
         fprintf(stderr, "umxtty%d -> %s (DLCI %d)\n", i, chans[i].pts, chans[i].dlci);
     }
 
+    /* Стартовую команду ("on ...") отправляем ЧЕРЕЗ мультиплексор: пишем
+       её в slave-конец /dev/umxtty0 — ровно как это делает вендорская
+       функция mcu_on ("echo on $1 > /dev/umxtty0"). Раньше команда уходила
+       сырыми байтами прямо в UART мимо HASHMUX-кадрирования, поэтому STM32
+       её не видел: канал оставался закрытым, и данные (в т.ч. напряжение
+       батареи) не приходили. */
+    {
+        int onfd = open(chans[0].pts, O_WRONLY | O_NOCTTY | O_NONBLOCK);
+        if (onfd >= 0) {
+            if (send_startup_sequence(onfd, &cfg) < 0 && cfg.verbose) {
+                perror("startup-seq");
+            }
+            close(onfd);
+        } else if (cfg.verbose) {
+            perror("open umxtty0");
+        }
+    }
+
     struct hashmux_state hm;
     memset(&hm, 0, sizeof(hm));
     hm.rx_addr = 0;
