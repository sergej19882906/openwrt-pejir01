diff --git a/package/luci-app-perenio/root/etc/uci-defaults/50-perenio-ru b/package/luci-app-perenio/root/etc/uci-defaults/50-perenio-ru
new file mode 100755
index 0000000..40bc6cb
--- /dev/null
+++ b/package/luci-app-perenio/root/etc/uci-defaults/50-perenio-ru
@@ -0,0 +1,9 @@
+#!/bin/sh
+# Русский язык интерфейса LuCI по умолчанию.
+#
+# В /etc/config/luci опция lang стоит в "auto" — LuCI тогда берёт язык из
+# заголовка Accept-Language браузера. Явно ставим "ru", чтобы интерфейс был
+# русским независимо от настроек браузера.
+uci set luci.core.lang='ru'
+uci commit luci
+exit 0
