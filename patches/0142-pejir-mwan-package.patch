+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=pejir-mwan
+PKG_VERSION:=1.0.0
+PKG_RELEASE:=1
+
+PKG_LICENSE:=GPL-2.0
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/pejir-mwan
+  SECTION:=net
+  CATEGORY:=Network
+  TITLE:=Multi-WAN (WAN + LTE) policy routing for PEJIR01
+  DEPENDS:=+ip-full +nftables
+endef
+
+define Package/pejir-mwan/description
+  Balances client traffic between the wired WAN and the LTE modem, and
+  switches to the surviving link when one of them goes down.
+
+  Three modes:
+    balance  - new connections are split between WAN and LTE (nft numgen
+               marks a new connection, ip rule sends it to its own routing
+               table);
+    failover - WAN is primary, LTE is the backup, the switch happens on
+               the health check result;
+    pbr      - addresses from the list are sent through LTE, the rest
+               through WAN.
+
+  The module is disabled by default: while it is off it does not touch
+  the routing at all. The main routing table is never modified, so if the
+  module fails the router keeps working as before.
+endef
+
+define Package/pejir-mwan/conffiles
+/etc/config/pejir_mwan
+endef
+
+define Build/Prepare
+endef
+
+define Build/Compile
+endef
+
+define Package/pejir-mwan/install
+	$(INSTALL_DIR) $(1)/etc/config
+	$(INSTALL_CONF) ./root/etc/config/pejir_mwan $(1)/etc/config/pejir_mwan
+	$(INSTALL_DIR) $(1)/etc/init.d
+	$(INSTALL_BIN) ./root/etc/init.d/50-pejir-mwan $(1)/etc/init.d/50-pejir-mwan
+	$(INSTALL_DIR) $(1)/usr/libexec
+	$(INSTALL_BIN) ./root/usr/libexec/pejir-mwan $(1)/usr/libexec/pejir-mwan
+	$(INSTALL_BIN) ./root/usr/libexec/pejir-mwan-ctl $(1)/usr/libexec/pejir-mwan-ctl
+endef
+
+$(eval $(call BuildPackage,pejir-mwan))
