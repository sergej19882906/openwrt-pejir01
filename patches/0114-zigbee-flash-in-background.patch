+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
@@ -61,6 +61,36 @@ function runDiag(path) {
 }
 
 /* Запуск обёртки прошивки NCP: fs.exec возвращает {code, stdout, stderr}. */
+/* Прошивка NCP идёт в фоне: она дольше таймаута запроса браузера,
+ * поэтому запускаем её отдельной командой и следим за журналом. */
+function flashNcpInBackground(box) {
+	return runNcp('flash-bg').then(function(r) {
+		if (!r.ok && r.text && r.text.indexOf('EXIT=') < 0) {
+			if (box) box.textContent = r.text;
+			return null;
+		}
+
+		var tries = 0;
+
+		function pollLog() {
+			return runNcp('log').then(function(res) {
+				var t = (res && res.text) ? res.text : '';
+
+				if (box) box.textContent = t || _('Working...');
+
+				if (t.indexOf('EXIT=') >= 0 || ++tries > 90)
+					return null;
+
+				return new Promise(function(resolve) {
+					setTimeout(resolve, 2000);
+				}).then(pollLog);
+			});
+		}
+
+		return pollLog();
+	});
+}
+
 function runNcp(action) {
 	return fs.exec(NCP, [action]).then(function(r) {
 		var out = (r && r.stdout ? r.stdout : '');
@@ -109,11 +139,21 @@ return view.extend({
 				'click': ui.createHandlerFn(this, function() {
 					var box = document.getElementById('perenio-zigbee-ncp-out');
 					if (box) box.textContent = _('Checking, please wait...');
-					return runNcp('ensure').then(function(r) {
+					/* Только проверка: она быстрая. Прошивка идёт минуты,
+					 * а запрос из браузера не столько живёт. */
+					return runNcp('status').then(function(r) {
 						if (box) box.textContent = r.text ? r.text : _('(no output)');
 					});
 				})
-			}, _('Check / flash NCP firmware')),
+			}, _('Check the module')),
+			E('button', {
+				'class': 'cbi-button cbi-button-neutral',
+				'click': ui.createHandlerFn(this, function() {
+					var box = document.getElementById('perenio-zigbee-ncp-out');
+					if (box) box.textContent = _('Starting, please wait...');
+					return flashNcpInBackground(box);
+				})
+			}, _('Flash NCP firmware')),
 			E('button', {
 				'class': 'cbi-button cbi-button-neutral',
 				'click': ui.createHandlerFn(this, function() { window.location.reload(); })
