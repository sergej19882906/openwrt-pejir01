diff --git a/package/pejir-zigbee-ncp/files/pejir-zigbee-ncp b/package/pejir-zigbee-ncp/files/pejir-zigbee-ncp
index 1a2825a1..f688b826 100755
--- a/package/pejir-zigbee-ncp/files/pejir-zigbee-ncp
+++ b/package/pejir-zigbee-ncp/files/pejir-zigbee-ncp
@@ -28,6 +28,7 @@ PORT="${ZIGBEE_PORT:-/dev/umxtty1}"
 VERSION_FILE=/usr/lib/pejir/version
 NCP_VERSION_FILE=/etc/pejir/ncp-version
 CACHE_DIR=/tmp/pejir-ncp
+LOG_FILE=/var/log/pejir-zigbee-ncp.log
 IMAGE_NAME=NCP_USW_EFR32MG1B-256_678_PA0-PA1-PB11.gbl
 REPO=https://github.com/sergej19882906/openwrt-pejir01/releases/download
 
@@ -56,7 +57,9 @@ download_image() {
 	mkdir -p "$CACHE_DIR" || return 1
 	url="$(image_url)"
 	log "скачиваю образ NCP: $url"
-	if ! wget -q -O "$dst.tmp" "$url"; then
+	# Таймаут обязателен: если GitHub недоступен, wget без таймаута
+	# висит долго, и страница LuCI падает с "XHR request timed out".
+	if ! wget -q -T 30 -O "$dst.tmp" "$url"; then
 		rm -f "$dst.tmp"
 		log "НЕ УДАЛОСЬ скачать образ NCP ($url)"
 		return 1
@@ -144,10 +147,34 @@ cmd_flash() {
 	log "записана версия NCP: $NCP_VERSION_FILE"
 }
 
+# Прошивка в фоне: она занимает минуты (скачивание образа + XMODEM по
+# последовательному порту), а запрос из браузера живёт около 30 секунд.
+# Поэтому запускаем прошивку отдельным процессом, а страница следит за
+# журналом.
+cmd_flash_bg() {
+	if [ ! -e "$PORT" ]; then
+		log "порта $PORT нет - прошивка NCP невозможна, модуль не подключён"
+		return 2
+	fi
+	mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
+	rm -f "$LOG_FILE.done" 2>/dev/null
+	nohup /bin/sh -c "$0 flash > '$LOG_FILE' 2>&1; echo \"EXIT=\$?\" >> '$LOG_FILE'; touch '$LOG_FILE.done'" >/dev/null 2>&1 &
+	log "прошивка NCP запущена в фоне, журнал: $LOG_FILE"
+	return 0
+}
+
+# Журнал фоновой прошивки.
+cmd_log() {
+	[ -f "$LOG_FILE" ] && cat "$LOG_FILE" 2>/dev/null
+	return 0
+}
+
 case "${1:-}" in
-	status) cmd_status ;;
-	ensure) cmd_ensure ;;
-	flash)  cmd_flash ;;
+	status)  cmd_status ;;
+	ensure)  cmd_ensure ;;
+	flash)   cmd_flash ;;
+	flash-bg) cmd_flash_bg ;;
+	log)     cmd_log ;;
 	*)
 		echo "Использование: pejir-zigbee-ncp {status|ensure|flash}"
 		exit 1
