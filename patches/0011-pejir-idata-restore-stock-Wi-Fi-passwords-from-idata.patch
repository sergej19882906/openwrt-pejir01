+define Package/pejir-idata/install
+	$(INSTALL_DIR) $(1)/usr/sbin
+	$(INSTALL_BIN) ./files/idata_load $(1)/usr/sbin/idata_load
+	$(INSTALL_BIN) ./files/idata_flash $(1)/usr/sbin/idata_flash
+	$(INSTALL_BIN) ./files/idata_getconf $(1)/usr/sbin/idata_getconf
+	$(INSTALL_DATA) ./files/idata_lib.sh $(1)/usr/sbin/idata_lib.sh
+	$(INSTALL_DIR) $(1)/etc/uci-defaults
+	$(INSTALL_BIN) ./root/etc/uci-defaults/20-pejir-idata $(1)/etc/uci-defaults/20-pejir-idata
