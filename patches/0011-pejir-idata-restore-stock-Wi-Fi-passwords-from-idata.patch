+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=pejir-idata
+PKG_VERSION:=9.0.4
+PKG_RELEASE:=1
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/pejir-idata
+  SECTION:=utils
+  CATEGORY:=Utilities
+  TITLE:=PEJIR01 idata partition tools (vendor binaries)
+endef
+
+define Package/pejir-idata/description
+  Vendor idata_load/flash/getconf from stock 9.0.4 firmware.
+  idata_load imports the factory idata NAND partition (MAC, Wi-Fi
+  SSID/keys, passwords, SN, WPS PIN) into UCI as idata.device.*.
+  uci-defaults maps them into OpenWrt: Wi-Fi SSID/keys/country and
+  root password are restored from stock settings at first boot.
+endef
+
+define Build/Prepare
+endef
+
+define Build/Compile
+endef
