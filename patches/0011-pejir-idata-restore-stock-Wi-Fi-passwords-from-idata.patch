diff --git a/package/pejir-idata/root/etc/uci-defaults/20-pejir-idata b/package/pejir-idata/root/etc/uci-defaults/20-pejir-idata
new file mode 100755
index 0000000..3e7a396
--- /dev/null
+++ b/package/pejir-idata/root/etc/uci-defaults/20-pejir-idata
@@ -0,0 +1,41 @@
+#!/bin/sh
+# Load factory idata partition into UCI (idata.device.*)
+/usr/sbin/idata_load --force >/dev/null 2>&1 || exit 0
+
+# --- Wi-Fi: restore stock SSID/keys/country -------------------------------
+map_wifi() { # $1=idata ssid key  $2=radio  $3=suffix
+    local name pass cc
+    name=$(uci -q get idata.device.ssid$3_name)
+    pass=$(uci -q get idata.device.ssid$3_pass)
+    cc=$(uci -q get idata.device.ssid$3_cc)
+    [ -z "$name" ] && return
+    local iface
+    for iface in $(uci -q show wireless | sed -n "s/wireless\.\(.*\)\.device='$2'$/\1/p"); do
+        uci set wireless.$iface.ssid="$name"
+        [ -n "$pass" ] && {
+            uci set wireless.$iface.encryption='psk2'
+            uci set wireless.$iface.key="$pass"
+        }
+        [ -n "$cc" ] && uci set wireless.$2.country="$cc"
+    done
+}
+[ "$(uci -q get wireless.radio0)" ] && map_wifi x radio0 24
+[ "$(uci -q get wireless.radio1)" ] && map_wifi x radio1 5
+uci commit wireless 2>/dev/null
+
+# --- root password from stock admin_pass ---------------------------------
+AP=$(uci -q get idata.device.admin_pass)
+if [ -n "$AP" ]; then
+    (echo "$AP"; sleep 1; echo "$AP") | passwd root >/dev/null 2>&1
+fi
+
+# --- WPS PIN (stored for reference) --------------------------------------
+WP=$(uci -q get idata.device.wps_pin)
+[ -n "$WP" ] && {
+    for r in radio0 radio1; do
+        [ "$(uci -q get wireless.$r)" ] && uci set wireless.$r.wps_pin="$WP"
+    done
+    uci commit wireless 2>/dev/null
+}
+
+exit 0
