+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
@@ -5,52 +5,21 @@
 
 /* Сводная диагностика: USB-контроллер и устройства, модем (ttyUSB/cdc-wdm),
    интерфейс LTE, состояние служб STM32 и данные батареи.
-   Всё собирается одной командой через fs.exec — в LuCI 25.12 чтение
-   произвольных путей (fs.read) ограничено белым списком, а exec —
-   нет. Право file.exec есть в ACL luci-app-perenio (операция write). */
-var SCRIPT = [
-	'echo "=== Модель и DTB ==="',
-	'cat /proc/device-tree/model 2>/dev/null; echo',
-	'echo -n "узлы device-tree: "; ls /proc/device-tree/ 2>/dev/null | tr "\\n" " "; echo',
-	'echo -n "узлы regulator*: "; ls -d /proc/device-tree/regulator* 2>/dev/null | tr "\\n" " "; echo',
-	'echo -n "xhci status: "; cat /proc/device-tree/xhci@1e1c0000/status 2>/dev/null; echo',
-	'echo -n "xhci children: "; ls /proc/device-tree/xhci@1e1c0000/ 2>/dev/null | tr "\\n" " "; echo',
-	'echo -n "cmdline: "; cat /proc/cmdline 2>/dev/null; echo',
-	'echo "=== USB: сообщения ядра ==="',
-	'dmesg 2>/dev/null | grep -iE "xhci|ehci|ohci|uhci|dwc|usb [0-9]|new .*USB device|option|cdc_ether|cdc_ncm|cdc_mbim|rndis|scsi|uas|regulator" | tail -40',
-	'echo "=== USB: устройства ==="',
-	'echo -n "sysfs: "; ls /sys/bus/usb/devices/ 2>/dev/null | tr "\\n" " "; echo',
-	'for d in /sys/bus/usb/devices/*/; do [ -f "$d/idVendor" ] && echo "$(basename $d) $(cat $d/idVendor 2>/dev/null):$(cat $d/idProduct 2>/dev/null) $(cat $d/product 2>/dev/null)"; done',
-	'echo "=== Модем, UART и мультиплексор ==="',
-	'ls -l /dev/ttyUSB* /dev/ttyACM* /dev/cdc-wdm* /dev/umxtty* /dev/ttyS* 2>&1',
-	'echo "--- modeminfo ---"',
-	'uci show modeminfo 2>/dev/null',
-	'echo "=== Разметка памяти: MTD и UBI ==="',
-	'cat /proc/mtd 2>/dev/null',
-	'echo -n "тома UBI: "; for u in /sys/class/ubi/ubi*_*; do [ -f "$u/name" ] && echo -n "$(basename $u)=$(cat $u/name) "; done; echo',
-	'echo -n "imgidx: "; fw_printenv -n imgidx 2>/dev/null; echo',
-	'echo "=== Wi-Fi ==="',
-	'iw dev 2>/dev/null',
-	'grep -E "option (ssid|disabled|country|channel|htmode)" /etc/config/wireless 2>/dev/null',
-	'dmesg 2>/dev/null | grep -iE "mt76|mt7603|mt7612|wiphy|ieee80211|firmware|calib" | tail -25',
-	'echo -n "firmware mt76: "; ls /lib/firmware/ 2>/dev/null | grep -i mt76 | tr "\n" " "; echo',
-	'echo "=== Сеть ==="',
-	'ip -o link show 2>/dev/null',
-	'echo "--- network.lte ---"',
-	'uci show network 2>/dev/null | grep -E "lte|eth[0-9]|usb[0-9]|wan"',
-	'echo "=== Службы ==="',
-	'ps w 2>/dev/null | grep -E "mcud|uartmuxd|smsd|mcu" | grep -v grep',
-	'echo "=== Батарея: mcu ==="',
-	'/usr/bin/mcu getvolt 2>&1; echo',
-	'/usr/bin/mcu getsys 2>&1; echo',
-	'/usr/bin/mcu getver 2>&1; echo',
-	'echo "=== Журнал: usb/mcu/lte ==="',
-	'logread 2>/dev/null | grep -iE "mcu|uartmux|umxtty|usb|lte|modem|smsd" | tail -30'
-].join('; ') + '; true';
+   Всё собирается одной командой, но сам скрипт лежит в файле
+   /usr/libexec/perenio-diag, а не передаётся аргументом "sh -c".
+
+   Почему не "sh -c <текст>": в LuCI 25.12 вызов идёт через rpcd, где длина
+   командной строки ограничена 1024 байтами (RPC_CMDLINE_MAX_SIZE в
+   rpcd/plugins/file.c), а наш скрипт диагностики вдвое длиннее. Кроме
+   того, "/bin/sh" - симлинок на busybox, а rpcd резолвит симлинки и
+   требует права на ЦЕЛЕВОЙ путь ("/bin/busybox"), то есть разрешение
+   пришлось бы выдавать и на сам busybox. Отдельный файл обходит обе
+   проблемы: аргументов нет, путь один и известный. */
+var DIAG = '/usr/libexec/perenio-diag';
 
 return view.extend({
 	load: function() {
-		return fs.exec('/bin/sh', [ '-c', SCRIPT ]).then(function(txt) {
+		return fs.exec(DIAG, []).then(function(txt) {
 			return [ txt || '' ];
 		}).catch(function(e) {
 			return [ _('Не удалось выполнить диагностику: ') + (e || '') ];
diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/idata.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/idata.js
index 34bb6a4..5822378 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/idata.js
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/idata.js
@@ -124,11 +124,21 @@ return view.extend({
 					E('th', { 'class': 'th' }, _('Значение'))
 				])
 			].concat(rows)));
-		}).catch(function() {
+		}).catch(function(e) {
 			var box = document.getElementById('idata-list');
 
-			if (box)
-				box.innerHTML = '<em>' + _('Файл /etc/config/idata не найден') + '</em>';
+			if (!box)
+				return;
+
+			/* Раньше здесь для ЛЮБОЙ ошибки показывалось "файл не найден",
+			   из-за чего отказ в доступе (Permission denied) выглядел как
+			   отсутствие файла. Различаем эти случаи. */
+			var denied = (e && e.name == 'PermissionError');
+			box.innerHTML = '<em>' +
+				(denied
+					? _('Нет доступа к /etc/config/idata (проверьте ACL luci-app-perenio)')
+					: _('Файл /etc/config/idata не найден')) +
