 		});
 	},
 
diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
index 1c750f1..e5019e8 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
@@ -46,7 +46,10 @@ function readStatus() {
 			.filter(function(n) { return /^ttyUSB|^ttyACM/.test(n); });
 		var m = conf.match(/^[ \t]*device[ \t]*=[ \t]*(\S+)/m);
 		var out = (svc.stdout || '') + (svc.stderr || '');
-		var running = /running/i.test(out);
+		/* procd печатает "not running" для упавшего сервиса, а эта строка
+		   содержит "running" - прежняя проверка /running/i считала упавший
+		   smsd работающим. Теперь ищем именно "running" в начале строки. */
+		var running = /^\s*running\b/im.test(out);
 
 		setText('sms-svc', running ? _('работает (smsd)') : _('не запущен'));
 		setText('sms-ports', ports.length ? ports.join(', ') : _('не найдено (ttyUSB/ttyACM)'));
diff --git a/package/luci-app-perenio/root/usr/libexec/perenio-diag b/package/luci-app-perenio/root/usr/libexec/perenio-diag
new file mode 100755
index 0000000..75e943b
--- /dev/null
+++ b/package/luci-app-perenio/root/usr/libexec/perenio-diag
@@ -0,0 +1,38 @@
+#!/bin/sh
+echo "=== Модель и DTB ==="
+cat /proc/device-tree/model 2>/dev/null; echo
+echo -n "узлы device-tree: "; ls /proc/device-tree/ 2>/dev/null | tr "\n" " "; echo
+echo -n "узлы regulator*: "; ls -d /proc/device-tree/regulator* 2>/dev/null | tr "\n" " "; echo
+echo -n "xhci status: "; cat /proc/device-tree/xhci@1e1c0000/status 2>/dev/null; echo
+echo -n "xhci children: "; ls /proc/device-tree/xhci@1e1c0000/ 2>/dev/null | tr "\n" " "; echo
+echo -n "cmdline: "; cat /proc/cmdline 2>/dev/null; echo
+echo "=== USB: сообщения ядра ==="
+dmesg 2>/dev/null | grep -iE "xhci|ehci|ohci|uhci|dwc|usb [0-9]|new .*USB device|option|cdc_ether|cdc_ncm|cdc_mbim|rndis|scsi|uas|regulator" | tail -40
+echo "=== USB: устройства ==="
+echo -n "sysfs: "; ls /sys/bus/usb/devices/ 2>/dev/null | tr "\n" " "; echo
+for d in /sys/bus/usb/devices/*/; do [ -f "$d/idVendor" ] && echo "$(basename $d) $(cat $d/idVendor 2>/dev/null):$(cat $d/idProduct 2>/dev/null) $(cat $d/product 2>/dev/null)"; done
+echo "=== Модем, UART и мультиплексор ==="
+ls -l /dev/ttyUSB* /dev/ttyACM* /dev/cdc-wdm* /dev/umxtty* /dev/ttyS* 2>&1
+echo "--- modeminfo ---"
+uci show modeminfo 2>/dev/null
+echo "=== Разметка памяти: MTD и UBI ==="
+cat /proc/mtd 2>/dev/null
+echo -n "тома UBI: "; for u in /sys/class/ubi/ubi*_*; do [ -f "$u/name" ] && echo -n "$(basename $u)=$(cat $u/name) "; done; echo
+echo -n "imgidx: "; fw_printenv -n imgidx 2>/dev/null; echo
+echo "=== Wi-Fi ==="
+iw dev 2>/dev/null
+grep -E "option (ssid|disabled|country|channel|htmode)" /etc/config/wireless 2>/dev/null
+dmesg 2>/dev/null | grep -iE "mt76|mt7603|mt7612|wiphy|ieee80211|firmware|calib" | tail -25
+echo -n "firmware mt76: "; ls /lib/firmware/ 2>/dev/null | grep -i mt76 | tr "\n" " "; echo
+echo "=== Сеть ==="
+ip -o link show 2>/dev/null
+echo "--- network.lte ---"
+uci show network 2>/dev/null | grep -E "lte|eth[0-9]|usb[0-9]|wan"
+echo "=== Службы ==="
+ps w 2>/dev/null | grep -E "mcud|uartmuxd|smsd|mcu" | grep -v grep
+echo "=== Батарея: mcu ==="
+/usr/bin/mcu getvolt 2>&1; echo
+/usr/bin/mcu getsys 2>&1; echo
+/usr/bin/mcu getver 2>&1; echo
+echo "=== Журнал: usb/mcu/lte ==="
+logread 2>/dev/null | grep -iE "mcu|uartmux|umxtty|usb|lte|modem|smsd" | tail -30
diff --git a/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json b/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json
index 32af9a9..64c97b3 100644
--- a/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json
+++ b/package/luci-app-perenio/root/usr/share/rpcd/acl.d/luci-app-perenio.json
@@ -2,11 +2,29 @@
 	"luci-app-perenio": {
 		"description": "Grant access to Perenio STM32 status and SMS",
 		"read": {
+			"file": {
+				"/etc/config/idata": [ "read" ],
+				"/etc/smsd.conf": [ "read" ],
+				"/var/log/smsd.log": [ "read" ],
+				"/var/log/smsd.log.1": [ "read" ],
+				"/var/spool/sms/incoming": [ "list" ],
+				"/var/spool/sms/incoming/*": [ "read" ],
+				"/dev": [ "list" ]
+			},
 			"ubus": {
 				"file": [ "list", "read" ]
 			}
 		},
 		"write": {
+			"file": {
+				"/usr/bin/mcu getvolt": [ "exec" ],
+				"/usr/bin/mcu getsys": [ "exec" ],
+				"/usr/bin/mcu getver": [ "exec" ],
+				"/usr/sbin/idata_load --force": [ "exec" ],
+				"/usr/bin/sendsms *": [ "exec" ],
+				"/etc/init.d/smstools3 status": [ "exec" ],
+				"/usr/libexec/perenio-diag": [ "exec" ]
+			},
 			"ubus": {
 				"file": [ "exec" ]
 			}
