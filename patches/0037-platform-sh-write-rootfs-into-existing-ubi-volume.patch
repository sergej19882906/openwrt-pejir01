From c6cf0d069596e55e4028dae149443a6374d5765e Mon Sep 17 00:00:00 2001
From: "port port@local" <port@local>
Date: Sat, 21 Nov 2026 16:13:56 +0000
Subject: [PATCH] =?UTF-8?q?platform.sh:=20=D0=BF=D0=B8=D1=81=D0=B0=D1=82?=
 =?UTF-8?q?=D1=8C=20rootfs=20=D0=B2=20=D1=81=D1=83=D1=89=D0=B5=D1=81=D1=82?=
 =?UTF-8?q?=D0=B2=D1=83=D1=8E=D1=89=D0=B8=D0=B9=20UBI-=D1=82=D0=BE=D0=BC,?=
 =?UTF-8?q?=20=D0=BD=D0=B5=20=D1=82=D1=80=D0=BE=D0=B3=D0=B0=D1=8F=20rootfs?=
 =?UTF-8?q?=5Fdata?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

После удаления sing-box rootfs (~14 МБ) помещается в существующий том
rootfs (24 МБ), поэтому пересоздавать тома больше не нужно.

- пишем rootfs прямо в существующий том: имя и номер тома сохраняются,
  значит загрузчик находит корень как раньше;
- том rootfs_data (overlay с настройками) не трогаем - его пересоздание
  стирало Wi-Fi/LTE/пароли, а platform_copy_config для платы не задан;
- перед записью отключаем ubiblock тома: том rootfs смонтирован как
  корень, а ядро при записи требует эксклюзивного доступа (EBUSY);
- аварийный путь (образ не помещается) пересоздаёт только том rootfs и
  с тем же номером, а rootfs_data - последним и с -m, как в upstream
  nand.sh (иначе -m заберёт всё место и под rootfs его не останется).
---
 .../mt7621/base-files/lib/upgrade/platform.sh | 92 +++++++++++++------
 1 file changed, 63 insertions(+), 29 deletions(-)

diff --git a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
index b1d3423..0269581 100644
--- a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
+++ b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
@@ -153,9 +153,13 @@ perenio_do_upgrade() {
 		[ -f "$ubivol/name" ] || continue
 		volname="$(cat "$ubivol/name")"
 		[ "$volname" = "kernel" ] || continue
-		dev="$(nand_find_volume "$(basename "$ubivol" | cut -d_ -f1)" "$volname")"
+		ubidev="$(basename "$ubivol" | cut -d_ -f1)"
+		dev="$(nand_find_volume "$ubidev" "$volname")"
 		[ -n "$dev" ] || continue
 		echo "запись ядра в UBI-том $volname (/dev/$dev)"
+		# Как и для rootfs: том мог быть открыт через ubiblock, а
+		# ядро требует эксклюзивного доступа при записи.
+		nand_remove_ubiblock "$dev" 2>/dev/null || :
 		$cmd < "$tar_file" | tar xOf - "$board_dir/kernel" | \
 			ubiupdatevol "/dev/$dev" -s "$kernel_len" - || :
 	done
@@ -166,23 +170,28 @@ perenio_do_upgrade() {
 		return 1
 	fi
 
-	# Том rootfs, созданный старыми прошивками, рассчитан на 24 МБ, а наш
-	# rootfs больше - запись в него не влезает ("will not fit volume").
-	# Поэтому перед записью пересоздаём тома: rootfs под размер нового
-	# образа и rootfs_data заново (место освобождается автоматически).
-	# Настройки при этом сохраняются штатным механизмом sysupgrade
-	# (/tmp/sysupgrade.tgz -> восстановление при первом старте).
-	for ubivol in /sys/class/ubi/ubi*_*; do
-		[ -f "$ubivol/name" ] || continue
-		volname="$(cat "$ubivol/name")"
-		if [ "$volname" = "rootfs_data" ]; then
-			ubidev="$(basename "$ubivol" | cut -d_ -f1)"
-			echo "пересоздание тома rootfs_data"
-			ubirmvol "/dev/$ubidev" -N rootfs_data 2>/dev/null
-			ubimkvol "/dev/$ubidev" -N rootfs_data -m 2>/dev/null
-		fi
-	done
-
+	# Запись rootfs в UBI-тома.
+	#
+	# Том rootfs на устройстве рассчитан на прежний образ (около 24 МБ),
+	# а наш rootfs после удаления sing-box - около 14 МБ, то есть он в
+	# этот том ПОМЕЩАЕТСЯ. Поэтому пишем прямо в существующий том:
+	# ubiupdatevol сам стирает том перед записью (в ядре
+	# ubi_start_update делает unmap всех LEB), а имя и номер тома
+	# сохраняются - значит загрузчик, как и раньше, находит корень.
+	#
+	# Том rootfs_data (overlay с настройками) НЕ трогаем: его
+	# пересоздание стёрло бы Wi-Fi/LTE/пароли, а восстановления из
+	# sysupgrade.tgz для этой платы нет (platform_copy_config не
+	# определён).
+	#
+	# Если образ всё же не помещается (например, вернули sing-box),
+	# пересоздаём только том rootfs - с тем же номером, чтобы ссылка
+	# загрузчика на ubiblock0_N осталась верной. И лишь в крайнем
+	# случае, когда свободного места не хватает, освобождаем
+	# rootfs_data - и создаём тома в порядке upstream nand.sh: сначала
+	# rootfs под точный размер, потом rootfs_data (-m). Обратный
+	# порядок недопустим: rootfs_data с -m забирает весь остаток
+	# места, и под rootfs его уже не останется.
 	ok=0
 	bad=0
 	for ubivol in /sys/class/ubi/ubi*_*; do
@@ -192,19 +201,44 @@ perenio_do_upgrade() {
 			rootfs|rootfs[0-9]*) ;;
 			*) continue ;;
 		esac
-		dev="$(nand_find_volume "$(basename "$ubivol" | cut -d_ -f1)" "$volname")"
+		ubidev="$(basename "$ubivol" | cut -d_ -f1)"
+		volid="${ubivol##*_}"
+		dev="$(nand_find_volume "$ubidev" "$volname")"
 		[ -n "$dev" ] || continue
-		echo "запись rootfs ($rootfs_len байт) в UBI-том $volname (/dev/$dev)"
-		# Пересоздаём том под точный размер образа: старый том меньше,
-		# и ubiupdatevol отказывается ("will not fit volume").
-		if [ "$volname" = "rootfs" ]; then
-			ubidev="$(basename "$ubivol" | cut -d_ -f1)"
-			ubirmvol "/dev/$ubidev" -N "$volname" 2>/dev/null
-			ubimkvol "/dev/$ubidev" -N "$volname" -s "$rootfs_len" 2>/dev/null
-			dev="$(nand_find_volume "$ubidev" "$volname")"
-			[ -n "$dev" ] || { bad=$((bad + 1)); continue; }
-			echo "том пересоздан: /dev/$dev ($rootfs_len байт)"
+		echo "запись rootfs ($rootfs_len байт) в UBI-том $volname (/dev/$dev, номер $volid)"
+
+		# Том rootfs смонтирован как корень (/dev/ubiblock0_N), и том
+		# держит открытым сам ubiblock. Ядро требует эксклюзивного
+		# доступа к тому при записи (ubi_start_update -> get_exclusive),
+		# поэтому блочное устройство надо сначала отключить. Без этого
+		# запись падает с "device or resource busy".
+		nand_remove_ubiblock "$dev" 2>/dev/null || :
+
+		# Основной путь: записать на место, том не пересоздаём.
+		if $cmd < "$tar_file" | tar xOf - "$board_dir/root" | \
+			ubiupdatevol "/dev/$dev" -s "$rootfs_len" -; then
+			ok=$((ok + 1))
+			continue
+		fi
+
+		# Не поместилось - пересоздаём том rootfs под точный размер
+		# образа, сохраняя номер тома.
+		echo "том $volname не вмещает образ, пересоздаём (номер $volid)"
+		ubirmvol "/dev/$ubidev" -N "$volname" 2>/dev/null
+		if ! ubimkvol "/dev/$ubidev" -n "$volid" -N "$volname" -s "$rootfs_len" 2>/dev/null; then
+			# Свободного места не хватило - освобождаем overlay.
+			# Это аварийный путь: настройки при этом теряются.
+			echo "не хватило места под том $volname, освобождаем rootfs_data"
+			ubirmvol "/dev/$ubidev" -N rootfs_data 2>/dev/null
+			ubimkvol "/dev/$ubidev" -n "$volid" -N "$volname" -s "$rootfs_len" 2>/dev/null
+			# rootfs_data пересоздаём ПОСЛЕ rootfs и с -m: он забирает
+			# весь остаток места (порядок как в upstream nand.sh).
+			# Обратный порядок недопустим - под rootfs места не останется.
+			ubimkvol "/dev/$ubidev" -N rootfs_data -m 2>/dev/null
 		fi
+		dev="$(nand_find_volume "$ubidev" "$volname")"
+		[ -n "$dev" ] || { bad=$((bad + 1)); continue; }
+		echo "том пересоздан: /dev/$dev ($rootfs_len байт, номер $volid)"
 		if $cmd < "$tar_file" | tar xOf - "$board_dir/root" | \
 			ubiupdatevol "/dev/$dev" -s "$rootfs_len" -; then
 			ok=$((ok + 1))
