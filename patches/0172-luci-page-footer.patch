+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/lte.js
@@ -262,7 +262,7 @@ function rowSaved(title, field, key) {
 }
 
 return view.extend({
-	handleSave: function(ev) {
+	saveSettings: function(ev) {
 		var btn = ev.currentTarget;
 
 		btn.disabled = true;
@@ -448,7 +448,7 @@ return view.extend({
 
 		var saveBtn = E('button', { 'class': 'cbi-button cbi-button-save', 'type': 'button' },
 				_('Save'));
-		saveBtn.addEventListener('click', L.bind(this.handleSave, this));
+		saveBtn.addEventListener('click', L.bind(this.saveSettings, this));
 
 		var applyBtn = E('button', { 'class': 'cbi-button cbi-button-action', 'type': 'button' },
 				_('Apply now'));
@@ -602,5 +602,10 @@ return view.extend({
 						'style': 'white-space:pre-wrap; font-family:monospace; font-size:12px; max-height:40vh; overflow:auto; border:1px solid #ccc; padding:8px;' }, ''))
 			])
 		]);
-	}
+	},
+	/* Подвал LuCI («Сохранить», «Сбросить») на странице не нужен: кнопки
+	 * свои, а форма собрана вручную, а не на form.Map. */
+	handleSaveApply: null,
+	handleSave: null,
+	handleReset: null
 });
diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/mwan.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/mwan.js
index 4a9aec52..64fc4879 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/mwan.js
