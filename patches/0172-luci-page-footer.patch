Стандартный подвал LuCI («Сохранить и применить», «Сохранить»,
«Сбросить») рисуется на любой странице, если обработчики не отключены.
Наши страницы собраны вручную, а не на form.Map, поэтому подвал ничего
не делает - а на странице multi-WAN «Сохранить» показывался дважды
(своя кнопка и кнопка подвала).

- свои обработчики сохранения переименованы в saveSettings (иначе
  подвал вызывал бы их ещё раз);
- на страницах multi-WAN, LTE, диагностики и обновления подвал
  отключён: handleSaveApply/handleSave/handleReset = null.
---
 .../luci-static/resources/view/perenio/diag.js      |  8 +++++++-
 .../luci-static/resources/view/perenio/lte.js       | 11 ++++++++---
 .../luci-static/resources/view/perenio/mwan.js      | 13 ++++++++++---
 .../luci-static/resources/view/perenio/ota.js       |  8 +++++++-
 4 files changed, 32 insertions(+), 8 deletions(-)

diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
index a624da5b..4797d51b 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/diag.js
@@ -159,5 +159,11 @@ return view.extend({
 				'click': ui.createHandlerFn(this, function() { window.location.reload(); })
 			}, _('Refresh'))
 		]);
-	}
+	},
+	/* Подвал LuCI («Сохранить», «Сбросить») на странице не нужен: она
+	 * собрана вручную, а не на form.Map, и своих кнопок подвал не
+	 * заменяет. */
+	handleSaveApply: null,
+	handleSave: null,
+	handleReset: null
 });
diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/lte.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/lte.js
index 3cdad70e..3568276a 100644
