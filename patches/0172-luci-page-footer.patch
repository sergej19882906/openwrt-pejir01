 		applyBtn.addEventListener('click', L.bind(self.handleApply, self));
 		enableBtn.addEventListener('click', L.bind(self.handleEnable, self));
 		disableBtn.addEventListener('click', L.bind(self.handleDisable, self));
@@ -250,7 +250,7 @@ return view.extend({
 		return body;
 	},
 
-	handleSave: function(ev) {
+	saveSettings: function(ev) {
 		var btn = ev.currentTarget;
 
 		btn.disabled = true;
@@ -317,5 +317,12 @@ return view.extend({
 		});
 	},
 
-	handleSaveApply: null
+	/* Стандартный подвал LuCI («Сохранить», «Сбросить») на этой странице
+	 * ничего не делает: страница собрана вручную, а не на form.Map.
+	 * Свои кнопки («Сохранить», «Применить», «Включить», «Выключить»)
+	 * есть, поэтому подвал убираем - иначе «Сохранить» показывается
+	 * дважды. */
+	handleSaveApply: null,
+	handleSave: null,
+	handleReset: null
 });
diff --git a/package/pejir-ota/htdocs/luci-static/resources/view/perenio/ota.js b/package/pejir-ota/htdocs/luci-static/resources/view/perenio/ota.js
