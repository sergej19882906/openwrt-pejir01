diff --git a/package/modeminfo/root/etc/uci-defaults/60-perenio-modeminfo b/package/modeminfo/root/etc/uci-defaults/60-perenio-modeminfo
index a5ea31f..d772a17 100755
--- a/package/modeminfo/root/etc/uci-defaults/60-perenio-modeminfo
+++ b/package/modeminfo/root/etc/uci-defaults/60-perenio-modeminfo
@@ -5,6 +5,9 @@
 # и все поля страницы остаются пустыми. Порт по умолчанию - подтверждённый
 # AT-порт модема GM510 на этой плате (ttyUSB2). Если у пользователя секция
 # уже создана (через LuCI -> Модем -> Настройка), ничего не меняем.
+#
+# Приоритет порта: /etc/pejir/at-port (подтверждённый порт от 41-pejir-modem),
+# иначе штатный /dev/ttyUSB2.
 
 # LuCI создаёт ИМЕНОВАННЫЙ раздел ("config modeminfo 'modeminfo'"),
 # поэтому проверяем оба вида: и именованный, и анонимный. Если раздел
@@ -14,9 +17,12 @@ if [ -n "$(uci -q get modeminfo.modeminfo.device)" ] ||
 	exit 0
 fi
 
+PORT="$(head -n 1 /etc/pejir/at-port 2>/dev/null)"
+[ -n "$PORT" ] || PORT="/dev/ttyUSB2"
+
 uci -q delete modeminfo.@modeminfo[0] 2>/dev/null
 uci set modeminfo.@modeminfo[0]='modeminfo'
-uci set modeminfo.@modeminfo[0].device='/dev/ttyUSB2'
+uci set modeminfo.@modeminfo[0].device="$PORT"
 uci set modeminfo.@modeminfo[0].qmi_mode='0'
 uci set modeminfo.@modeminfo[0].decimail='1'
 uci commit modeminfo
