diff --git a/package/luci-app-perenio/root/usr/libexec/pejir-send-sms b/package/luci-app-perenio/root/usr/libexec/pejir-send-sms
new file mode 100755
index 0000000..51ffde5
--- /dev/null
+++ b/package/luci-app-perenio/root/usr/libexec/pejir-send-sms
@@ -0,0 +1,7 @@
+#!/bin/sh
+# Обёртка над sendsms для LuCI (rpcd ACL-грант без wildcard).
+# Вызов строго с двумя аргументами: номер и текст.
+
+[ $# -eq 2 ] || exit 64
+
+exec /usr/bin/sendsms "$1" "$2"
diff --git a/package/luci-app-perenio/root/usr/libexec/pejir-sms-clean b/package/luci-app-perenio/root/usr/libexec/pejir-sms-clean
new file mode 100755
index 0000000..f390649
--- /dev/null
+++ b/package/luci-app-perenio/root/usr/libexec/pejir-sms-clean
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Удаление сообщения из спула smstools3 по имени файла (LuCI "SMS").
+# Аргумент - ровно одно имя файла без путевых компонентов: защита от traversal.
+
+[ $# -eq 1 ] || exit 64
+
+case "$1" in
+	''|*/*|*..*|.|..)
+		exit 1
+		;;
+esac
+
+for d in outgoing sent failed incoming; do
+	f="/var/spool/sms/$d/$1"
+	[ -f "$f" ] && { rm -f "$f"; exit 0; }
+done
+
+exit 1
