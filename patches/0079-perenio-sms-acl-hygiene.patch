diff --git a/package/luci-app-atinout/htdocs/luci-static/resources/view/modem/atcommands.js b/package/luci-app-atinout/htdocs/luci-static/resources/view/modem/atcommands.js
index d63018b..a6e03fc 100644
--- a/package/luci-app-atinout/htdocs/luci-static/resources/view/modem/atcommands.js
+++ b/package/luci-app-atinout/htdocs/luci-static/resources/view/modem/atcommands.js
@@ -108,8 +108,27 @@ return view.extend({
 		portSelect.disabled = true;
 		var currentValue = portSelect.value;
 
-		this.scanPorts().then(function(ports) {
-			var currentPort = currentValue;
+		Promise.all([
+			this.scanPorts(),
+			L.resolveDefault(fs.read_direct('/etc/pejir/at-port'), '')
+		]).then(function(res) {
+			var ports = res[0] || [];
+			/* Подтверждённый AT-порт (пишет 41-pejir-modem). Первая строка файла -
+			 * путь к порту, например /dev/ttyUSB2. ttyUSB0 на GM510 - diag-порт,
+			 * для AT-команд не пригоден, поэтому при наличии подтверждённого
+			 * поднимаем его в начало списка и делаем портом по умолчанию. */
+			var verified = String(res[1] || '').trim().split('\n')[0].trim();
+
+			if (verified && ports.indexOf(verified) != -1) {
+				ports = ports.filter(function(p) { return p != verified; });
+				ports.sort();
+				ports.unshift(verified);
+			} else {
+				verified = '';
+			}
+
+			var currentPort = currentValue ||
+				(verified && ports.indexOf(verified) != -1 ? verified : '');
 
 			while (portSelect.firstChild) {
 				portSelect.removeChild(portSelect.firstChild);
@@ -119,7 +138,9 @@ return view.extend({
 			portSelect.appendChild(emptyOption);
 
 			ports.forEach(function(port) {
-				var option = E('option', { value: port }, port);
+				var label = (port == verified) ?
+					'%s (%s)'.format(port, _('verified')) : port;
+				var option = E('option', { value: port }, label);
 				if (port === currentPort) {
 					option.setAttribute('selected', 'selected');
 				}
