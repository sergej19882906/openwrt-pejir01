@@ -5,6 +5,9 @@
 'require poll';
 
 var DIR = '/var/spool/sms/incoming';
+var DIR_OUT = '/var/spool/sms/outgoing';
+var DIR_SENT = '/var/spool/sms/sent';
+var DIR_FAILED = '/var/spool/sms/failed';
 var CONF = '/etc/smsd.conf';
 var LOG = '/var/log/smsd.log';
 
@@ -58,16 +61,18 @@ function readStatus() {
 	});
 }
 
-/* Приём входящих SMS из /var/spool/sms/incoming */
-function readInbox() {
-	return fs.list(DIR).catch(function() { return []; }).then(L.bind(function(list) {
+/* Чтение сообщений из каталога spool smstools3.
+ * Формат файла: первая строка - номер (у входящих отправитель, у исходящих
+ * получатель), вторая - дата, дальше - текст сообщения. */
+function readSpool(dir) {
+	return fs.list(dir).catch(function() { return []; }).then(L.bind(function(list) {
 		var files = (list || []).filter(function(f) { return f.type == 'file'; });
 
 		files.sort(function(a, b) { return b.mtime - a.mtime; });
 		files = files.slice(0, 50);
 
 		return Promise.all(files.map(function(f) {
-			return fs.read(DIR + '/' + f.name).then(function(txt) {
+			return fs.read(dir + '/' + f.name).then(function(txt) {
 				var lines = (txt || '').split('\n');
 
 				return { name: f.name, mtime: f.mtime,
@@ -77,34 +82,57 @@ function readInbox() {
 		})).then(function(all) {
 			return all.filter(function(m) { return m != null; });
 		});
-	}, this)).then(function(msgs) {
-		var box = document.getElementById('sms-list');
+	}, this));
+}
 
-		if (!box)
-			return;
+/* Отрисовка списка сообщений в таблицу */
+function renderMsgs(boxId, msgs, whoLabel) {
+	var box = document.getElementById(boxId);
 
-		if (!msgs.length) {
-			box.innerHTML = '<em>' + _('No SMS') + '</em>';
-			return;
-		}
+	if (!box)
+		return;
 
-		var rows = msgs.map(function(m) {
-			return E('tr', { 'class': 'tr' }, [
-				E('td', { 'class': 'td', 'style': 'white-space:nowrap' },
-					new Date(m.mtime * 1000).toLocaleString()),
-				E('td', { 'class': 'td' }, m.from),
-				E('td', { 'class': 'td', 'style': 'white-space:pre-wrap' }, m.text)
-			]);
-		});
+	if (!msgs.length) {
+		box.innerHTML = '<em>' + _('No SMS') + '</em>';
+		return;
+	}
 
-		box.innerHTML = '';
-		box.appendChild(E('table', { 'class': 'table' }, [
-			E('tr', { 'class': 'tr table-titles' }, [
-				E('th', { 'class': 'th' }, _('Time')),
-				E('th', { 'class': 'th' }, _('Sender')),
-				E('th', { 'class': 'th' }, _('Text'))
-			])
-		].concat(rows)));
+	var rows = msgs.map(function(m) {
+		return E('tr', { 'class': 'tr' }, [
+			E('td', { 'class': 'td', 'style': 'white-space:nowrap' },
+				new Date(m.mtime * 1000).toLocaleString()),
+			E('td', { 'class': 'td' }, m.from),
+			E('td', { 'class': 'td', 'style': 'white-space:pre-wrap' }, m.text)
+		]);
+	});
+
+	box.innerHTML = '';
+	box.appendChild(E('table', { 'class': 'table' }, [
+		E('tr', { 'class': 'tr table-titles' }, [
+			E('th', { 'class': 'th' }, _('Time')),
+			E('th', { 'class': 'th' }, whoLabel),
+			E('th', { 'class': 'th' }, _('Text'))
+		])
+	].concat(rows)));
+}
+
+/* Приём входящих SMS из /var/spool/sms/incoming */
+function readInbox() {
+	return readSpool(DIR).then(function(msgs) {
+		renderMsgs('sms-list', msgs, _('Sender'));
+	});
+}
+
+/* Исходящие: в очереди на отправку, отправленные и неотправленные */
+function readOutbox() {
+	return Promise.all([
+		readSpool(DIR_OUT),
+		readSpool(DIR_SENT),
+		readSpool(DIR_FAILED)
+	]).then(function(all) {
+		renderMsgs('sms-out-list', all[0], _('Recipient'));
+		renderMsgs('sms-sent-list', all[1], _('Recipient'));
+		renderMsgs('sms-failed-list', all[2], _('Recipient'));
 	});
 }
 
@@ -187,12 +215,32 @@ return view.extend({
 
 					E('div', { 'class': 'cbi-value-description' },
 						_('Files from /var/spool/sms/incoming (smstools3): the first line is the sender, the second is the time, the rest is the message.'))
-				])
+				]),
+
+			E('div', { 'class': 'cbi-section' }, [
+				E('div', { 'class': 'cbi-section-descr' },
+					_('Outgoing SMS')),
+
+				E('div', { 'class': 'cbi-value-title' }, _('Queued for sending')),
+				E('div', { 'id': 'sms-out-list' },
+					E('em', {}, _('Loading…'))),
