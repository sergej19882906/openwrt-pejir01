+				E('div', { 'class': 'cbi-value-description' },
+					_('Files from /var/spool/sms/outgoing, /var/spool/sms/sent and /var/spool/sms/failed (smstools3): the first line is the number, the second is the time, the rest is the message.'))
+			]),
 			])
 		]);
 
 		poll.add(L.bind(function() {
-			return Promise.all([ readStatus(), readInbox() ]);
+			return Promise.all([ readStatus(), readInbox(), readOutbox() ]);
 		}, this), 20);
 
 		return body;
