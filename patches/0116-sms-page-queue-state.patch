@@ -564,3 +564,5 @@ msgid "Starting, please wait..."
 msgstr "Запуск, подождите..."
 msgid "Saving..."
 msgstr "Сохранение..."
+msgid "Queue state"
+msgstr "Состояние очереди"
diff --git a/package/pejir-sms/root/usr/libexec/pejir-sms-ctl b/package/pejir-sms/root/usr/libexec/pejir-sms-ctl
index 16b16a18..a27dfb0b 100755
--- a/package/pejir-sms/root/usr/libexec/pejir-sms-ctl
+++ b/package/pejir-sms/root/usr/libexec/pejir-sms-ctl
@@ -2,6 +2,7 @@
 # Управление SMS: экспорт переписки и шаблоны текста.
 #
 # Команды:
+#   status                 состояние SMS: smsd, журнал, очереди, порты;
 #   export                 выгрузить все сообщения в /www/sms-export-<время>.txt
 #                         (файл отдаёт uhttpd, его можно скачать из браузера);
 #   templates              показать сохранённые шаблоны (нумерованные);
@@ -95,13 +96,35 @@ cmd_template_del() {
 	echo "OK шаблон $n удалён"
 }
 
+# Состояние SMS: работает ли smsd, есть ли журнал, что в очередях.
+# Нужно, чтобы на странице было видно причину, а не пустое окно.
+cmd_status() {
+	echo "POOL=$POOL"
+	echo "smsd_running=$(ps w 2>/dev/null | grep -c "[s]msd" || true)"
+	echo "journal=/var/log/smsd.log"
+	if [ -f /var/log/smsd.log ]; then
+		echo "journal_size=$(wc -c < /var/log/smsd.log 2>/dev/null | tr -d " ")"
+	else
+		echo "journal_size=0"
+		echo "journal_note=файла /var/log/smsd.log нет - smsd не запущен или ещё не писал журнал"
+	fi
+	for d in incoming outgoing sent failed; do
+		n=0
+		[ -d "$POOL/$d" ] && n="$(ls -1 "$POOL/$d" 2>/dev/null | wc -l | tr -d " ")"
+		echo "queue_$d=$n"
+	done
+	echo "smsd_port=$(sed -n "s/^device = //p" /etc/smsd.conf 2>/dev/null | head -1)"
+	echo "at_port=$(cat /etc/pejir/at-port 2>/dev/null | head -1)"
+}
+
 case "${1:-}" in
+	status)       cmd_status ;;
 	export)       cmd_export ;;
 	templates)    cmd_templates ;;
 	template-add) shift; cmd_template_add "$@" ;;
 	template-del) shift; cmd_template_del "$1" ;;
 	*)
-		echo "Использование: pejir-sms-ctl {export|templates|template-add <текст>|template-del <N>}" >&2
+		echo "Использование: pejir-sms-ctl {status|export|templates|template-add <текст>|template-del <N>}" >&2
 		exit 1
 		;;
 esac
