 .../po/ru/luci-app-perenio.po                 |  2 ++
 .../pejir-sms/root/usr/libexec/pejir-sms-ctl  | 25 ++++++++++++++++++-
 3 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
index ef774b50..57b997e9 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
@@ -90,9 +90,12 @@ function readStatus() {
 			.catch(function() { return { code: 1, stdout: '', stderr: '' }; }),
 		fs.list('/dev').catch(function() { return []; }),
 		fs.read(CONF).catch(function() { return ''; }),
-		readLog()
+		readLog(),
+		fs.exec(SMSCTL, [ 'status' ])
+			.catch(function() { return { code: 1, stdout: '', stderr: '' }; })
 	]).then(function(res) {
 		var svc = res[0], devs = res[1] || [], conf = res[2] || '', log = res[3];
+		var st = res[4] || {};
 		var ports = devs.map(function(d) { return d.name; })
 			.filter(function(n) { return /^ttyUSB|^ttyACM/.test(n); });
 		var m = conf.match(/^[ \t]*device[ \t]*=[ \t]*(\S+)/m);
@@ -111,6 +114,13 @@ function readStatus() {
 		setText('sms-ports', ports.length ? ports.join(', ') : _('not found (ttyUSB/ttyACM)'));
 		setText('sms-device', m ? m[1] : _('not set in smsd.conf'));
 		setText('sms-log', log || _('no log'));
+
+		/* Состояние очереди: сколько сообщений в каждой папке, какой
+		 * порт прописан в smsd.conf и есть ли журнал. Без этого при
+		 * пустом журнале непонятно, что именно сломалось. */
+		var stOut = (st.stdout || '') + (st.stderr || '');
+
+		setText('sms-state', stOut.trim() || _('unknown'));
 	});
 }
 
@@ -698,6 +708,10 @@ return view.extend({
 					E('div', { 'class': 'k' }, _('Port in smsd.conf')),
 					E('div', { 'class': 'v', 'id': 'sms-device' }, _('checking…'))
 				]),
+				E('div', { 'class': 'pejir-sms-kv' }, [
+					E('div', { 'class': 'k' }, _('Queue state')),
+					E('div', { 'class': 'v', 'id': 'sms-state' }, _('checking…'))
+				]),
 				E('div', { 'class': 'pejir-sms-note' }, _('smsd log')),
 				E('pre', { 'id': 'sms-log', 'class': 'pejir-sms-log' }, '')
 			])
diff --git a/package/luci-app-perenio/po/ru/luci-app-perenio.po b/package/luci-app-perenio/po/ru/luci-app-perenio.po
