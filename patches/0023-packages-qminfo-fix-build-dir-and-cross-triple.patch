Две ошибки в рецепте qminfo.

1. PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_SOURCE_SUBDIR) — переменная
   PKG_SOURCE_SUBDIR в OpenWrt задаётся только если у пакета есть
   PKG_SOURCE_VERSION (include/download.mk). У qminfo источника нет,
   поэтому путь получался без имени каталога, и каталогом сборки
   становился корень build_dir. Штамп prepare оказывался рядом с
   чужими файлами, а STAMP_BUILT (считается в include/package.mk до
   нашего присваивания) указывал на build_dir/.../qminfo-0.0.3,
   которого никто не создавал:
     touch: cannot touch '.../qminfo-0.0.3/.built_check': No such file
   Строку убираем — работает штатный дефолт фреймворка
   $(BUILD_DIR)/$(PKG_NAME)-$(PKG_VERSION).

2. CROSS_TRIPLE=$(TARGET_CROSS) — TARGET_CROSS в OpenWrt заканчивается
   дефисом (mipsel-openwrt-linux-musl-), а исходный Makefile qminfo
   строит имя компилятора как $(CROSS_TRIPLE)-gcc. Получалось
   mipsel-openwrt-linux-musl--gcc. Отдаём тройку без дефиса.
---
 package/qminfo/Makefile | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/package/qminfo/Makefile b/package/qminfo/Makefile
index 05ae26a..7688862 100644
--- a/package/qminfo/Makefile
+++ b/package/qminfo/Makefile
@@ -13,8 +13,6 @@ PKG_RELEASE:=1
 
 include $(INCLUDE_DIR)/package.mk
 
-PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_SOURCE_SUBDIR)
-
 define Package/$(PKG_NAME)
   SECTION:=utils
   CATEGORY:=Utilities
@@ -35,7 +33,7 @@ endef
 define Build/Compile
 	$(MAKE) -C $(PKG_BUILD_DIR) \
 		SYSROOT=$(STAGING_DIR) \
-		CROSS_TRIPLE=$(TARGET_CROSS)
+		CROSS_TRIPLE=$(patsubst %-,%,$(TARGET_CROSS))
 endef
 
 define Package/$(PKG_NAME)/install
