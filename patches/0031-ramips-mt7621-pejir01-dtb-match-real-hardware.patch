Проверено на живом устройстве (заводской DTB вендора и вывод dmesg):

* i2c и третий UART (uartlite3) в заводском DTB выключены — оставляем
  так же, чтобы не занимать лишние пины.
* Кнопка на плате — это WPS (gpio 18), а не reset: с gpio-keys/reset
  нажатие кнопки перезагружало бы роутер. Ставим gpio-keys-polled
  с кодом 0x211 (KEY_WPS) — как в заводском DTB (в dt-bindings этого
  ядра символа KEY_WPS нет, поэтому код числом).
* Разделы kernel0/crash/crash_syslog у нас были помечены read-only, а у
  вендора kernel0 writable. Убираем read-only: иначе запись ядра в
  активный слот не проходит (см. следующий патч про platform.sh).
* В platform.sh: правильный комментарий (загрузчик берёт ядро из MTD
  kernel0/kernel1, том UBI "kernel" он не читает), чтение imgidx из
  раздела Config, повтор записи ядра после снятия read-only через sysfs.
---
 .../dts/mt7621_perenio_pejir01-34-BA.dts      | 24 +++++++++++--------
 1 file changed, 14 insertions(+), 10 deletions(-)

diff --git a/target/linux/ramips/dts/mt7621_perenio_pejir01-34-BA.dts b/target/linux/ramips/dts/mt7621_perenio_pejir01-34-BA.dts
index 97716c0..b923b55 100644
--- a/target/linux/ramips/dts/mt7621_perenio_pejir01-34-BA.dts
+++ b/target/linux/ramips/dts/mt7621_perenio_pejir01-34-BA.dts
@@ -14,13 +14,20 @@
 		bootargs = "console=ttyS0,115200n8";
 	};
 
-	keys {
-		compatible = "gpio-keys";
+	// Кнопка на плате — это WPS (gpio 18), как в заводском DTB вендора.
+	// Раньше здесь был gpio-keys с "reset" на том же gpio: нажатие WPS
+	// приводило к перезагрузке роутера. Опрос (polled), как у вендора.
+	gpio_keys_polled {
+		compatible = "gpio-keys-polled";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		poll-interval = <20>;
 
-		reset {
-			label = "reset";
+		wps {
+			label = "wps";
 			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
-			linux,code = <KEY_RESTART>;
+			linux,code = <0x211>;   /* KEY_WPS: в dt-bindings этого ядра нет,
+					   код взят как в заводском DTB вендора */
 		};
 	};
 
@@ -79,13 +86,11 @@
 		partition@140000 {
 			label = "crash";
 			reg = <0x140000 0x40000>;
-			read-only;
 		};
 
 		partition@180000 {
 			label = "crash_syslog";
 			reg = <0x180000 0x40000>;
-			read-only;
 		};
 
 		partition@1c0000 {
@@ -97,7 +102,6 @@
 		partition@200000 {
 			label = "kernel0";
 			reg = <0x200000 0x400000>;
-			read-only;
 		};
 
 		partition@600000 {
@@ -132,7 +136,7 @@
 };
 
 &uartlite3 {
-	status = "okay";
+	status = "disabled";
 };
 
 &pcie {
@@ -150,7 +154,7 @@
 };
 
 &i2c {
-	status = "okay";
+	status = "disabled";
 };
 
 &switch0 {
