--- a/package/pejir-lte-base/root/usr/bin/mdm-at
+++ b/package/pejir-lte-base/root/usr/bin/mdm-at
@@ -36,6 +36,9 @@ PROBE_TIMEOUT="${MDM_AT_TIMEOUT:-5}"
 # Поэтому перед каждой AT-командой выставляем скорость через stty.
 AT_BAUD="${MDM_AT_BAUD:-115200}"
 
+# Очистка буфера AT-порта перед обменом (см. pejir-at-drain).
+AT_DRAIN="${PEJIR_AT_DRAIN:-$(dirname "$0")/../libexec/pejir-at-drain}"
+
 set_port_speed() {
 	[ -c "$1" ] || return 1
 	stty -F "$1" "$AT_BAUD" raw -echo 2>/dev/null
@@ -49,6 +52,9 @@ detect_port() {
 	for p in /dev/ttyUSB2 /dev/ttyUSB1 /dev/ttyUSB0 /dev/ttyUSB3 \
 	         /dev/ttyACM1 /dev/ttyACM0; do
 		[ -c "$p" ] || continue
+		# Чистим буфер: иначе проба заберёт ответ от предыдущей
+		# команды и найдёт "порт" там, где модем уже не отвечает.
+		"$AT_DRAIN" "$p" 0.15 >/dev/null 2>&1
 		set_port_speed "$p"
 		out="$(timeout "$PROBE_TIMEOUT" atinout "$script" "$p" - 2>/dev/null)"
 		case "$out" in
@@ -67,6 +73,7 @@ detect_port() {
