diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-at-drain b/package/pejir-lte-base/root/usr/libexec/pejir-at-drain
new file mode 100755
index 00000000..0285dfcd
--- /dev/null
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-at-drain
@@ -0,0 +1,34 @@
+#!/bin/sh
+# Очистить буфер AT-порта модема.
+#
+#   pejir-at-drain <порт> [таймаут]
+#
+# Зачем. atinout читает из порта всё, что там уже лежит, и сразу
+# выходит. Хвост от предыдущей команды (а он есть почти всегда: в порт
+# ходят модем, сторож AT-порта, smsd и демон сигнала) приводит к тому,
+# что мы получаем ответ на ПРЕДЫДУЩУЮ команду, а настоящий ответ
+# приходит позже и остаётся в буфере до следующего вызова.
+#
+# На практике это выглядело так: первый ответ пустой, helper делал ещё
+# две попытки с паузой по 2 с - и страница LuCI висела 7 секунд,
+# показывая данные от предыдущей команды. Сейчас AT+CSQ на устройстве
+# отвечает за 0.04 с.
+#
+# Ничего не отправляем модему: только читаем и выбрасываем накопленное.
+set -u
+
+PORT="${1:-}"
+TMO="${2:-0.15}"
+
+[ -n "$PORT" ] || {
+	echo "использование: pejir-at-drain <порт> [таймаут]" >&2
+	exit 1
+}
+[ -e "$PORT" ] || exit 0
+
+# Неблокирующее чтение: порт не должен висеть в read() вечно.
+[ -c "$PORT" ] && stty -F "$PORT" 115200 raw -echo min 0 time 1 2>/dev/null
+
+timeout "$TMO" cat "$PORT" >/dev/null 2>&1
+
+exit 0
diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-band b/package/pejir-lte-base/root/usr/libexec/pejir-band
index 8a85b0c0..0a5bb30f 100644
--- a/package/pejir-lte-base/root/usr/libexec/pejir-band
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-band
@@ -20,6 +20,9 @@ BANDS_SH="/usr/share/pejir/bands.sh"
 
 AT_TIMEOUT="${AT_TIMEOUT:-8}"
 
+# Очистка буфера AT-порта перед обменом (см. pejir-at-drain).
+AT_DRAIN="${PEJIR_AT_DRAIN:-$(dirname "$0")/pejir-at-drain}"
+
 # --- AT-обмен --------------------------------------------------------------
 # $1 - порт, $2 - команда (без \r). Печатает ответ модема.
 at_ask() {
@@ -27,6 +30,7 @@ at_ask() {
 	_acmd="$2"
 	_script="/tmp/pejir-band.$$"
 
+	"$AT_DRAIN" "$_aport" 0.15 >/dev/null 2>&1
 	printf '%s\r\n' "$_acmd" > "$_script"
 	stty -F "$_aport" 115200 raw -echo 2>/dev/null || true
 	_out=$(timeout "$AT_TIMEOUT" atinout "$_script" "$_aport" - 2>/dev/null)
diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-modem-ctl b/package/pejir-lte-base/root/usr/libexec/pejir-modem-ctl
index 71a8705d..deef40ef 100755
--- a/package/pejir-lte-base/root/usr/libexec/pejir-modem-ctl
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-modem-ctl
@@ -33,6 +33,9 @@ AT_TIMEOUT="${AT_TIMEOUT:-12}"
 # модем не готов. С одной попытки такой обмен выглядит как поломка.
 AT_RETRIES="${AT_RETRIES:-3}"
 
+# Очистка буфера AT-порта перед обменом (см. pejir-at-drain).
+AT_DRAIN="${PEJIR_AT_DRAIN:-$(dirname "$0")/pejir-at-drain}"
+
 # Общий файл с масками диапазонов. Путь можно переопределить -
 # так helper проверяется без устройства.
 BANDS_SH="${PEJIR_BANDS_SH:-/usr/share/pejir/bands.sh}"
@@ -46,6 +49,10 @@ at_ask() {
 	_acmd="$2"
 	_script="/tmp/pejir-modem-ctl.$$"
 
+	# Перед командой чистим буфер порта: иначе atinout отдаст ответ на
+	# предыдущую команду (или пустоту), а настоящий ответ придёт позже.
+	"$AT_DRAIN" "$_aport" 0.15 >/dev/null 2>&1
+
 	printf '%s\r\n' "$_acmd" > "$_script"
 	stty -F "$_aport" 115200 raw -echo 2>/dev/null || true
 	_out=$(timeout "$AT_TIMEOUT" atinout "$_script" "$_aport" - 2>/dev/null)
@@ -75,7 +82,13 @@ smsd_stop() {
 	[ -x /etc/init.d/smstools3 ] || return 0
 	pidof smsd >/dev/null 2>&1 || return 0
 	/etc/init.d/smstools3 stop >/dev/null 2>&1
-	sleep 2
+	# Ждём реального выхода smsd вместо фиксированной паузы: обычно он
+	# останавливается за доли секунды, и страница LuCI не должна ждать.
+	_n=0
+	while [ "$_n" -lt 2 ] && pidof smsd >/dev/null 2>&1; do
+		sleep 1
+		_n=$((_n + 1))
+	done
 	SMSD_WAS=1
 	return 0
 }
@@ -118,9 +131,9 @@ modem_cmd() {
 	while [ "$_n" -le "$AT_RETRIES" ]; do
 		_out=$(at_ask "$_p" "$1")
 		[ -n "$(printf '%s' "$_out" | tr -d ' \r\n')" ] && break
-		# Ответа нет: ждём пару секунд и пробуем ещё раз. Номер SIM
+		# Ответа нет: ждём секунду и пробуем ещё раз. Номер SIM
 		# (AT+CNUM) модем отдаёт медленно - он читает его с карты.
-		[ "$_n" -lt "$AT_RETRIES" ] && sleep 2
+		[ "$_n" -lt "$AT_RETRIES" ] && sleep 1
 		_n=$((_n + 1))
 	done
 
