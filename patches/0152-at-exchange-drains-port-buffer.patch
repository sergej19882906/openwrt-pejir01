+	timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 		rm -f "$script"
 		log "диапазоны модема заданы (Quectel QCFG=band,1,$q_bands)"
 		return 0
@@ -368,7 +378,8 @@ sync_bands() {
 		fi
 		printf 'AT+XACT=2,,,%s\r\n' "$fb_bands" > "$script"
 		set_port_speed "$port"
-		timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
+		"$AT_DRAIN" "$port" 0.15 >/dev/null 2>&1
+	timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 		rm -f "$script"
 		log "диапазоны модема заданы (Fibocom XACT=2,,,$fb_bands)"
 		return 0
@@ -384,6 +395,7 @@ sync_bands() {
 
 	printf 'AT+ZBAND=%s,0,0,%s\r\n' "$umts" "$lte" > "$script"
 	set_port_speed "$port"
+	"$AT_DRAIN" "$port" 0.15 >/dev/null 2>&1
 	timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 	rm -f "$script"
 	log "диапазоны модема заданы: $bands (ZBAND=$umts,0,0,$lte)"
@@ -427,7 +439,8 @@ ecm_call() {
 	   [ "$(modem_family)" = "generic" ]; then
 		printf 'AT+CGACT=1,1\r\n' > "$script"
 		set_port_speed "$port"
-		timeout "$ECM_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
+		"$AT_DRAIN" "$port" 0.15 >/dev/null 2>&1
+	timeout "$ECM_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 		rm -f "$script"
 		log "PDP-контекст активирован (AT+CGACT=1,1) - данные идут по USB-NCM"
 		return 0
@@ -446,6 +459,7 @@ ecm_call() {
 	# Ошибку игнорируем: на модемах без ECM-поддержки вызов не нужен,
 	# а AT+CGDCONT уже отработал.
 	set_port_speed "$port"
+	"$AT_DRAIN" "$port" 0.15 >/dev/null 2>&1
 	timeout "$ECM_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
