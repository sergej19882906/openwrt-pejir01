+
 	printf "$fmt" > "$script"
 	set_port_speed "$p"
 	out="$(timeout "$AT_TIMEOUT" atinout "$script" "$p" - 2>/dev/null)"
@@ -294,6 +302,7 @@ sync_apn() {
 	/usr/libexec/pejir-lte-apn 2>/dev/null | awk '{ printf "%s\r\n", $0 }' > "$script" || : > "$script"
 	[ -s "$script" ] || { rm -f "$script"; return 0; }
