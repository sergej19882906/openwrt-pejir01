@@ -0,0 +1,107 @@
+#!/bin/sh
+# Управление SMS: экспорт переписки и шаблоны текста.
+#
+# Команды:
+#   export                 выгрузить все сообщения в /www/sms-export-<время>.txt
+#                         (файл отдаёт uhttpd, его можно скачать из браузера);
+#   templates              показать сохранённые шаблоны (нумерованные);
+#   template-add <текст>   добавить шаблон;
+#   template-del <N>       удалить шаблон по номеру;
+#
+# Очередь SMS лежит в /var/spool/sms (на флешке - bind-mount), файлы
+# smstools3: первая строка - отправитель, вторая - время, остальное - текст.
+
+set -u
+
+POOL="${PEJIR_SPOOL_POOL:-/var/spool/sms}"
+TEMPLATES="${PEJIR_SMS_TEMPLATES:-/etc/pejir/sms-templates}"
+WWW="${PEJIR_SMS_WWW:-/www}"
+
+log() { echo "[sms-ctl] $*"; }
+
+# Все файлы очереди (входящие, отправленные, неотправленные, неудачные).
+queue_files() {
+	for d in incoming sent outgoing failed; do
+		[ -d "$POOL/$d" ] || continue
+		for f in "$POOL/$d"/*; do
+			[ -f "$f" ] && echo "$f"
+		done
+	done
+}
+
+dump_one() {
+	f="$1"
+	who="$(head -n 1 "$f" 2>/dev/null)"
+	when="$(sed -n '2p' "$f" 2>/dev/null)"
+	body="$(sed -n '3,$p' "$f" 2>/dev/null)"
+	printf -- '--- %s | %s ---\n%s\n\n' "$who" "$when" "$body"
+}
+
+cmd_export() {
+	ts="$(date +%Y%m%d-%H%M%S)"
+	out="$WWW/sms-export-$ts.txt"
+	mkdir -p "$WWW" 2>/dev/null
+	rm -f "$WWW"/sms-export-*.txt 2>/dev/null
+	{
+		echo "# Экспорт SMS PEJIR01"
+		echo "# время: $(date '+%Y-%m-%d %H:%M:%S')"
+		echo
+	} > "$out"
+	n=0
+	for f in $(queue_files); do
+		dump_one "$f" >> "$out"
+		n=$((n + 1))
+	done
+	echo >> "$out"
+	echo "# всего сообщений: $n" >> "$out"
+	if [ ! -s "$out" ]; then
+		rm -f "$out"
+		echo "ERROR очередь SMS пуста"
+		return 1
+	fi
+	echo "OK $out ($n)"
+}
+
+cmd_templates() {
+	if [ ! -s "$TEMPLATES" ]; then
+		echo "(шаблонов нет)"
+		return 0
+	fi
+	i=0
+	while IFS= read -r line; do
+		i=$((i + 1))
+		printf '%d: %s\n' "$i" "$line"
+	done < "$TEMPLATES"
+}
+
+cmd_template_add() {
+	text="$*"
+	[ -n "$text" ] || { echo "ERROR пустой текст"; return 1; }
+	mkdir -p "$(dirname "$TEMPLATES")" 2>/dev/null
+	printf '%s\n' "$text" >> "$TEMPLATES"
+	echo "OK добавлен шаблон"
+}
+
+cmd_template_del() {
+	n="$1"
+	case "$n" in
+	''|*[!0-9]*) echo "ERROR нужен номер шаблона"; return 1 ;;
+	esac
+	[ -s "$TEMPLATES" ] || { echo "ERROR шаблонов нет"; return 1; }
+	total="$(wc -l < "$TEMPLATES" | tr -d ' ')"
+	[ "$n" -ge 1 ] && [ "$n" -le "$total" ] || { echo "ERROR нет шаблона $n"; return 1; }
+	tmp="$TEMPLATES.tmp"
+	sed "${n}d" "$TEMPLATES" > "$tmp" && mv -f "$tmp" "$TEMPLATES"
+	echo "OK шаблон $n удалён"
+}
+
+case "${1:-}" in
+	export)       cmd_export ;;
+	templates)    cmd_templates ;;
+	template-add) shift; cmd_template_add "$@" ;;
+	template-del) shift; cmd_template_del "$1" ;;
+	*)
+		echo "Использование: pejir-sms-ctl {export|templates|template-add <текст>|template-del <N>}" >&2
+		exit 1
+		;;
+esac
