diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/zigbee.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/zigbee.js
new file mode 100644
index 0000000..28bf468
--- /dev/null
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/zigbee.js
@@ -0,0 +1,128 @@
+'use strict';
+'require view';
+'require fs';
+'require ui';
+
+/*
+ * Zigbee-модуль Perenio PEJIR01 (EFR32MG1) и стек HOMEd.
+ *
+ * Модуль доступен как /dev/umxtty1: uartmuxd мультиплексирует /dev/ttyS1
+ * в umxtty0=STM32, umxtty1=Zigbee, umxtty2=Z-Wave.
+ *
+ * HOMEd говорит с модулем по протоколу EZSP (adapter=ezsp). Если модуль
+ * на это не отвечает, его нужно перепрошить Gecko-образом (.gbl) через
+ * XMODEM - это делает /usr/bin/pejir-zigbee-ncp (ensure).
+ *
+ * Если модуль завис, его штатно перезапускают через STM32:
+ *   mcu -g "setpwr zigbee=off"; sleep 2; mcu -g "setpwr zigbee=on"
+ * Это делает обёртка перед прошивкой.
+ */
+
+var NCP = '/usr/bin/pejir-zigbee-ncp';
+var HOMED_INIT = '/etc/init.d/homed-zigbee';
+
+function run(path, args) {
+	return fs.exec(path, args).then(function(r) {
+		return (r && r.stdout ? r.stdout : '') +
+			(r && r.stderr ? r.stderr : '');
+	}).catch(function(e) {
+		return _('Failed to run: ') + (e && e.message ? e.message : String(e || ''));
+	});
+}
+
+function kv(out) {
+	var d = {};
+	(out || '').split('\n').forEach(function(l) {
+		var i = l.indexOf('=');
+		if (i > 0)
+			d[l.substring(0, i).trim()] = l.substring(i + 1).trim();
+	});
+	return d;
+}
+
+return view.extend({
+	load: function() {
+		return Promise.all([
+			run(NCP, [ 'status' ]),
+			run(HOMED_INIT, [ 'status' ])
+		]);
+	},
+
+	render: function(data) {
+		var ncpOut = (data && data[0]) ? data[0] : '';
+		var homedOut = (data && data[1]) ? data[1] : '';
+		var d = kv(ncpOut);
+		var installed = /NCP-ОТВЕТА-ДА|NCP-ОТВЕТА-ДА/.test(ncpOut) || /NCP-ОТВЕТА-ДА/.test(ncpOut);
+		var answer = /NCP-ОТВЕТА-ДА/.test(ncpOut);
+
+		var self = this;
+
+		function outBox(id, text) {
+			return E('pre', { 'id': id,
+				'style': 'white-space:pre-wrap; word-break:break-word; font-family:monospace; font-size:12px; max-height:35vh; overflow:auto; border:1px solid #ccc; padding:8px;' },
+				text || '');
+		}
+
+		function actionBtn(text, path, args) {
+			var b = E('button', { 'class': 'cbi-button cbi-button-neutral', 'type': 'button' }, text);
+			b.addEventListener('click', ui.createHandlerFn(self, function() {
+				var box = document.getElementById('perenio-zigbee-out');
+				if (box) box.textContent = _('Working...');
+				return run(path, args).then(function(out) {
+					if (box) box.textContent = out.trim() || _('Done');
+				});
+			}));
+			return b;
+		}
+
+		var panelUrl = 'http://' + (uci.get('network', 'lan', 'ipaddr') || '192.168.2.1') + ':8080';
+
+		return E('div', { 'class': 'cbi-section' }, [
+			E('h2', {}, _('Zigbee module (PEJIR01)')),
+			E('div', { 'class': 'cbi-section-descr' },
+				_('The EFR32 Zigbee module of the router. It talks to HOMEd over EZSP; if the module does not answer, its NCP firmware is flashed automatically. The flash resets the Zigbee module only and needs internet access to download the firmware.')),
+
+			E('table', { 'class': 'table' }, [
+				E('tr', { 'class': 'tr' }, [
+					E('td', { 'class': 'td', 'width': '33%' }, _('Module /dev/umxtty1')),
+					E('td', { 'class': 'td' }, d.status || _('not checked'))
+				]),
+				E('tr', { 'class': 'tr' }, [
+					E('td', { 'class': 'td' }, _('NCP firmware (EZSP)')),
+					E('td', { 'class': 'td' }, answer ? _('answers, flashing not needed') : _('does not answer - flashing required'))
+				]),
+				E('tr', { 'class': 'tr' }, [
+					E('td', { 'class': 'td' }, _('Flashed NCP image')),
+					E('td', { 'class': 'td' }, d.image || _('unknown'))
+				]),
+				E('tr', { 'class': 'tr' }, [
+					E('td', { 'class': 'td' }, _('HOMEd service')),
+					E('td', { 'class': 'td' }, homedOut.trim() || _('not installed'))
+				])
+			]),
+
+			E('div', { 'class': 'cbi-value' }, [
+				E('div', { 'class': 'cbi-value-title' }, _('Actions')),
+				E('div', { 'class': 'cbi-value-field' }, [
+					actionBtn(_('Check / flash NCP firmware'), NCP, [ 'ensure' ]),
+					' ',
+					actionBtn(_('Check the module'), NCP, [ 'status' ]),
+					' ',
+					actionBtn(_('Restart HOMEd'), HOMED_INIT, [ 'restart' ]),
+					' ',
+					E('a', { 'class': 'cbi-button cbi-button-neutral', 'href': panelUrl, 'target': '_blank' },
+						[ _('Open the HOMEd panel') ])
+				])
+			]),
+
+			E('div', { 'class': 'cbi-value-description' },
+				_('If the module hangs, restart it through the STM32: mcu -g "setpwr zigbee=off", wait 2 s, mcu -g "setpwr zigbee=on", then check again.')),
+
+			outBox('perenio-zigbee-out', ncpOut + (homedOut ? '\n' + homedOut : ''))
+		]);
+	},
+
+	handleSaveApply: null,
+	handleSave: null,
+	handleReset: null
+});
