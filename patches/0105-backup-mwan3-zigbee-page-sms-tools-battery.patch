 # Один проход по портам: проба живым AT, затем сам USSD-запрос.
+# Сохранение сырого ответа USSD в /tmp/pejir-ussd-raw.txt
+# (текст ответа + его шестнадцатеричный вид - по нему видно, как именно
+# модем закодировал текст).
+save_raw_ussd() {
+	_f="$1"
+	_p="$2"
+	{
+		echo "# порт: $_p"
+		echo "# время: $(date '+%Y-%m-%d %H:%M:%S')"
+		echo "--- текст ---"
+		cat "$_f" 2>/dev/null
+		echo
+		echo "--- hex ---"
+		hexdump -v -C "$_f" 2>/dev/null | head -20
+	} > /tmp/pejir-ussd-raw.txt 2>/dev/null
+}
+
 try_ports() {
 	for _p in $(candidates); do
 		[ -c "$_p" ] || continue
@@ -443,6 +460,9 @@ try_ports() {
 
