+		# СЫРОЙ ответ сохраняем: если разбор не сработал, по нему видно,
+		# что именно прислал модем (нужно для правки разбора).
+		save_raw_ussd "$_out" "$_p"
 		_ans=$(parse_ussd "$_out")
 		rm -f "$_out"
 
