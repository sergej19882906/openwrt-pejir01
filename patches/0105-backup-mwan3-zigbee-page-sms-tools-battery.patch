diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-mwan3 b/package/pejir-lte-base/root/usr/libexec/pejir-mwan3
new file mode 100755
index 0000000..30ddef2
--- /dev/null
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-mwan3
@@ -0,0 +1,125 @@
+#!/bin/sh
+# Резервный канал LTE (mwan3) для Perenio PEJIR01.
+#
+# В образе стоит mwan3, но он не настроен: интерфейс LTE (network.lte)
+# не входит ни в одну группу WAN, поэтому "переключить интернет на LTE"
+# приходится делать руками. Этот helper готовит простую и предсказуемую
+# схему:
+#
+#   * основной канал - проводной WAN (network.wan);
+#   * резервный - LTE (network.lte);
+#   * при падении WAN (не отвечает ping) трафик уходит в LTE;
+#   * при восстановлении WAN трафик возвращается обратно.
+#
+# Команды:
+#   status   - что настроено сейчас (mwan3, участники, активный канал);
+#   setup    - настроить схему "WAN основной, LTE резервный";
+#   remove   - убрать настройку и вернуть обычную маршрутизацию.
+#
+# Ничего не делается молча: setup/remove меняют маршрутизацию, поэтому
+# вызываются только по явной команде (кнопка в LuCI).
+
+set -u
+
+CFG=mwan3
+WAN_IF="${PEJIR_MWAN_WAN:-wan}"
+LTE_IF="${PEJIR_MWAN_LTE:-lte}"
+TRACK_IP="1.1.1.1 8.8.8.8"
+
+log() { echo "[mwan3] $*"; }
+
+mwan_get() { uci -q get "$CFG.$1" 2>/dev/null; }
+
+cmd_status() {
+	echo "STATUS"
+	echo "mwan3_present=$( [ -x /etc/init.d/mwan3 ] && echo yes || echo no )"
+	echo "wan_ifname=$WAN_IF"
+	echo "lte_ifname=$LTE_IF"
+	echo "wan_configured=$( [ -n "$(mwan_get interfaces.$WAN_IF.enabled)" ] && echo yes || echo no )"
+	echo "lte_configured=$( [ -n "$(mwan_get interfaces.$LTE_IF.enabled)" ] && echo yes || echo no )"
+	echo "members=$(uci -q show "$CFG" 2>/dev/null | grep -c '=member' || true)"
+	echo "policies=$(uci -q show "$CFG" 2>/dev/null | grep -c '=policy' || true)"
+	echo "rules=$(uci -q show "$CFG" 2>/dev/null | grep -c '=rule' || true)"
+	echo "default_route:"
+	ip route show default 2>/dev/null | sed 's/^/  /'
+	echo "mwan3_log:"
+	logread 2>/dev/null | grep -i mwan3 | tail -5 | sed 's/^/  /'
+}
+
+cmd_setup() {
+	# Интерфейсы и участники.
+	uci set "$CFG.globals=globals"
+	uci set "$CFG.globals.mmx_mask=0x3F00"
+
+	uci set "$CFG.interfaces.$WAN_IF=interface"
+	uci set "$CFG.interfaces.$WAN_IF.enabled=1"
+	uci set "$CFG.interfaces.$WAN_IF.family=ipv4"
+	uci set "$CFG.interfaces.$WAN_IF.reliability=2"
+	uci -q delete "$CFG.interfaces.$WAN_IF.track_ip" 2>/dev/null
+	for ip in $TRACK_IP; do
+		uci add_list "$CFG.interfaces.$WAN_IF.track_ip" "$ip"
+	done
+
+	uci set "$CFG.interfaces.$LTE_IF=interface"
+	uci set "$CFG.interfaces.$LTE_IF.enabled=1"
+	uci set "$CFG.interfaces.$LTE_IF.family=ipv4"
+	uci set "$CFG.interfaces.$LTE_IF.reliability=1"
+	uci -q delete "$CFG.interfaces.$LTE_IF.track_ip" 2>/dev/null
+	for ip in $TRACK_IP; do
+		uci add_list "$CFG.interfaces.$LTE_IF.track_ip" "$ip"
+	done
+
+	uci set "$CFG.members.wan_primary=member"
+	uci set "$CFG.members.wan_primary.interface=$WAN_IF"
+	uci set "$CFG.members.wan_primary.metric=1"
+	uci set "$CFG.members.wan_primary.reliability=1"
+
+	uci set "$CFG.members.lte_backup=member"
+	uci set "$CFG.members.lte_backup.interface=$LTE_IF"
+	uci set "$CFG.members.lte_backup.metric=2"
+	uci set "$CFG.members.lte_backup.reliability=1"
+
+	# Политика: сначала WAN, при его недоступности - LTE.
+	uci set "$CFG.policies.wan_then_lte=policy"
+	uci set "$CFG.policies.wan_then_lte.use_member=wan_primary"
+	uci set "$CFG.policies.wan_then_lte.fallback=wan_then_lte_lte"
+	uci set "$CFG.policies.wan_then_lte_lte=policy"
+	uci set "$CFG.policies.wan_then_lte_lte.use_member=lte_backup"
+
+	uci set "$CFG.rules.default_rule=rule"
+	uci set "$CFG.rules.default_rule.policy=wan_then_lte"
+	uci set "$CFG.rules.default_rule.use_ip=wan_then_lte"
+
+	uci commit "$CFG"
+
+	# mwan3 должен стартовать после того, как поднялись интерфейсы.
+	/etc/init.d/mwan3 enable >/dev/null 2>&1
+	/etc/init.d/mwan3 restart >/dev/null 2>&1
+
+	log "настроено: основной канал $WAN_IF, резервный $LTE_IF"
+	cmd_status
+}
+
+cmd_remove() {
+	# Убираем только свои секции, чужие настройки mwan3 не трогаем.
+	for s in members.wan_primary members.lte_backup \
+		 policies.wan_then_lte policies.wan_then_lte_lte \
+		 rules.default_rule \
+		 interfaces.$WAN_IF interfaces.$LTE_IF; do
+		uci -q delete "$CFG.$s" 2>/dev/null
+	done
+	uci commit "$CFG"
+	/etc/init.d/mwan3 restart >/dev/null 2>&1
+	log "настройка резервного канала убрана"
+	cmd_status
+}
+
+case "${1:-}" in
+	status) cmd_status ;;
+	setup)  cmd_setup ;;
+	remove) cmd_remove ;;
+	*)
+		echo "Использование: pejir-mwan3 {status|setup|remove}" >&2
+		exit 1
+		;;
+esac
