+# Выгрузка всей переписки одним блоком.
+#
+# ЗАЧЕМ. Страница SMS раньше читала файлы очереди сама: список каталога
+# плюс fs.read каждого файла. При 30 файлах в каждом из четырёх
+# каталогов это до 120 запросов к rpcd за один цикл опроса (20 секунд) -
+# страница заметно "тупила", а rpcd был загружен. Теперь helper
+# отдаёт всю переписку за ОДИН запрос.
+#
+# ФОРМАТ. Каждое сообщение начинается со строки
+#   @@MSG<TAB>каталог<TAB>имя файла<TAB>mtime
+# после неё идёт содержимое файла (как его записал smstools3).
+cmd_dump() {
+	local d f m
+
+	for d in incoming outgoing sent failed; do
+		[ -d "$POOL/$d" ] || continue
+
+		ls -1t "$POOL/$d" 2>/dev/null | head -30 | while IFS= read -r f; do
+			case "$f" in
+			*-concatenated) continue ;;
+			esac
+			[ -f "$POOL/$d/$f" ] || continue
+
+			m="$(stat -c %Y "$POOL/$d/$f" 2>/dev/null)"
+			printf '@@MSG\t%s\t%s\t%s\n' "$d" "$f" "$m"
+			cat "$POOL/$d/$f" 2>/dev/null
+		done
+	done
+}
+
+# AT-порты модема. Раньше страница брала весь список /dev через
+# fs.list - это тысячи записей ради нескольких нужных.
+cmd_ports() {
+	local d
+
+	for d in /dev/ttyUSB* /dev/ttyACM*; do
+		[ -e "$d" ] || continue
+		echo "${d#/dev/}"
+	done
+}
+
 case "${1:-}" in
 	status)       cmd_status ;;
+	dump)         cmd_dump ;;
+	ports)        cmd_ports ;;
 	log)          shift; cmd_log "${1:-8}" ;;
 	export)       cmd_export ;;
 	templates)    cmd_templates ;;
 	template-add) shift; cmd_template_add "$@" ;;
 	template-del) shift; cmd_template_del "$1" ;;
 	*)
-		echo "Использование: pejir-sms-ctl {status|log [строк]|export|templates|template-add <текст>|template-del <N>}" >&2
+		echo "Использование: pejir-sms-ctl {status|dump|ports|log [строк]|export|templates|template-add <текст>|template-del <N>}" >&2
 		exit 1
 		;;
 esac
