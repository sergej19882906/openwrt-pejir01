@@ -70,6 +70,11 @@ define Package/$(PKG_NAME)/install
 	$(CP) ./root/usr/share/modeminfo/scripts/modeminfo  $(1)/usr/share/modeminfo/scripts/
 	$(CP) ./root/usr/share/modeminfo/scripts/GENERIC* $(1)/usr/share/modeminfo/scripts/
 	$(CP) ./root/etc/config/* $(1)/etc/config
+	# Секция config modeminfo с AT-портом: без неё /usr/bin/modeminfo
+	# выдаёт пустой {"modem": []}, и страница LuCI "Модем" пуста.
+	$(INSTALL_DIR) $(1)/etc/uci-defaults
+	$(INSTALL_BIN) ./root/etc/uci-defaults/60-perenio-modeminfo \
+		$(1)/etc/uci-defaults/60-perenio-modeminfo
 endef
 
 define Package/$(PKG_NAME)-telegram/install
@@ -89,7 +94,7 @@ $(eval $(call SerialPlugin,meig,+kmod-usb-serial-option,MEIGLink SLM750-R2/SLM82
 $(eval $(call SerialPlugin,sierra,+kmod-usb-serial-qualcomm,Sierra Wireless EM7455,SIERRA))
