diff --git a/package/modeminfo/root/etc/uci-defaults/60-perenio-modeminfo b/package/modeminfo/root/etc/uci-defaults/60-perenio-modeminfo
new file mode 100755
index 0000000..039bfa5
--- /dev/null
+++ b/package/modeminfo/root/etc/uci-defaults/60-perenio-modeminfo
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Создаём секцию config modeminfo для пакета modeminfo (LuCI "Модем").
+#
+# Без этой секции /usr/bin/modeminfo выдаёт пустой {"modem": []},
+# и все поля страницы остаются пустыми. Порт по умолчанию - подтверждённый
+# AT-порт модема GM510 на этой плате (ttyUSB2). Если у пользователя секция
+# уже создана (через LuCI -> Модем -> Настройка), ничего не меняем.
+
+[ -n "$(uci -q get modeminfo.@modeminfo[0].device)" ] && exit 0
+
+uci -q delete modeminfo.@modeminfo[0] 2>/dev/null
+uci set modeminfo.@modeminfo[0]='modeminfo'
+uci set modeminfo.@modeminfo[0].device='/dev/ttyUSB2'
+uci set modeminfo.@modeminfo[0].qmi_mode='0'
+uci set modeminfo.@modeminfo[0].decimail='1'
+uci commit modeminfo
+
+exit 0
diff --git a/package/modeminfo/root/usr/share/modeminfo/scripts/GOSUN b/package/modeminfo/root/usr/share/modeminfo/scripts/GOSUN
index 114dc14..ce46e9b 100644
--- a/package/modeminfo/root/usr/share/modeminfo/scripts/GOSUN
+++ b/package/modeminfo/root/usr/share/modeminfo/scripts/GOSUN
@@ -46,7 +46,7 @@ function modem_data(){
 			
 		;;
 	esac
-	if [ $(uci -q get modeminfo.@generic[0].decimail) -eq 1 ]; then
+	if [ "$(uci -q get modeminfo.@general[0].decimail)" = "1" ]; then
                 LAC=$(printf %d 0x$LAC)
                 CID=$(printf %d 0x$CID)
         fi	
diff --git a/package/modeminfo/root/usr/share/modeminfo/scripts/modeminfo b/package/modeminfo/root/usr/share/modeminfo/scripts/modeminfo
index e865049..36ee7b1 100644
--- a/package/modeminfo/root/usr/share/modeminfo/scripts/modeminfo
+++ b/package/modeminfo/root/usr/share/modeminfo/scripts/modeminfo
@@ -13,6 +13,9 @@ function get_device_info() {
 	esac
 	modem_family
 	GSCRIPT="$RES/scripts/${FAMILY}.at"
+	# Модем не отвечает на AT, пока порт не переведён в raw-режим
+	# без эха (иначе ответы не приходят вовсе).
+	stty -F "$DEVPORT" 115200 raw -echo 2>/dev/null
 	O=$(atinout $GSCRIPT $DEVPORT - |grep -v '^$')
 }
 
@@ -27,6 +30,9 @@ function get_port() {
 			fi
 		done
 	DEVPORT=$(uci -q get modeminfo.@modeminfo[${s}].device)
+	# Модем не отвечает на AT, пока порт не переведён в raw-режим
+	# без эха (иначе ответы не приходят вовсе).
+	stty -F "$DEVPORT" 115200 raw -echo 2>/dev/null
 	O=$(atinout $GSCRIPT $DEVPORT - |grep -v '^$')
 }
 
