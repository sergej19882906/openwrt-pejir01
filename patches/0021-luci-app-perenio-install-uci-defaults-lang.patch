Рецепт install перечислял файлы из root/ поимённо и не включал
etc/uci-defaults/50-perenio-ru. Файл лежал в дереве пакета, но в образ
не попадал — поэтому uci set luci.core.lang='ru' не выполнялся при первой
загрузке, и LuCI показывал русский интерфейс только если браузер сам
присылал Accept-Language: ru.

Добавлена установка 50-perenio-ru в /etc/uci-defaults с режимом 0755 —
так же, как это делает пакет pejir-idata для 20-pejir-idata.

В рецепте install нет комментариев с '#': он склеивается в одну команду,
и такой комментарий съел бы всё до конца строки.
---
 package/luci-app-perenio/Makefile | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/package/luci-app-perenio/Makefile b/package/luci-app-perenio/Makefile
index f33cfba..1e13da2 100644
--- a/package/luci-app-perenio/Makefile
+++ b/package/luci-app-perenio/Makefile
@@ -26,14 +26,17 @@ define Package/luci-app-perenio/install
 	$(INSTALL_DIR) $(1)/www/luci-static/resources/view/perenio
 	$(INSTALL_DATA) ./htdocs/luci-static/resources/view/perenio/*.js \
 		$(1)/www/luci-static/resources/view/perenio/
+	$(INSTALL_DIR) $(1)/etc/config
+	$(INSTALL_DATA) ./root/etc/config/cron $(1)/etc/config/cron
+	$(INSTALL_DIR) $(1)/etc/uci-defaults
+	$(INSTALL_BIN) ./root/etc/uci-defaults/50-perenio-ru \
+		$(1)/etc/uci-defaults/50-perenio-ru
 	$(INSTALL_DIR) $(1)/usr/share/luci/menu.d
 	$(INSTALL_DATA) ./root/usr/share/luci/menu.d/luci-app-perenio.json \
 		$(1)/usr/share/luci/menu.d/luci-app-perenio.json
 	$(INSTALL_DIR) $(1)/usr/share/rpcd/acl.d
 	$(INSTALL_DATA) ./root/usr/share/rpcd/acl.d/luci-app-perenio.json \
 		$(1)/usr/share/rpcd/acl.d/luci-app-perenio.json
-	$(INSTALL_DIR) $(1)/etc/config
-	$(INSTALL_DATA) ./root/etc/config/cron $(1)/etc/config/cron
 endef
 
 $(eval $(call BuildPackage,luci-app-perenio))
