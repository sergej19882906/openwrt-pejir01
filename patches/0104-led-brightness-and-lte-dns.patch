@@ -29,6 +29,15 @@
 #   off                        - погасить все
 #   demo [секунд]              - мигание (как стоковый blink3.sh)
 #   auto                       - бесконечный цикл авто-режима (для init)
+#   brightness <0-7>           - общая яркость индикаторов
+#
+# ЯРКОСТЬ. Светодиодами управляет STM32, и у него есть общий уровень
+# яркости 0..7: команда "mcu setbright N" (vendor-клиент просто передаёт
+# строку в mcud, а дальше её выполняет прошивка STM32). В заводской
+# прошивке этот уровень выставляется один раз при загрузке из
+# /etc/init.d/stm32_setup. У нас такого скрипта нет, поэтому уровень
+# хранится в /etc/pejir/led-brightness и применяется при старте
+# авто-режима.
 
 set -u
 
@@ -37,6 +46,7 @@ LEDS="2 5 zb i sh a l"
 # это /etc/pejir/led.conf и /usr/bin/mcu.
 CONF="${LED_CONF:-/etc/pejir/led.conf}"
 MCU="${MCU_BIN:-/usr/bin/mcu}"
+BRIGHT_CONF="${BRIGHT_CONF:-/etc/pejir/led-brightness}"
 
 # --- проверка значений -------------------------------------------------------
 
@@ -93,6 +103,40 @@ conf_init() {
 	done > "$CONF"
 }
 
+# --- яркость ----------------------------------------------------------------
+
+bright_get() {
+	# Текущий сохранённый уровень яркости (0..7). Если файла нет - 1
+	# (как в заводской прошивке: минимальная яркость).
+	[ -f "$BRIGHT_CONF" ] || { echo 1; return 0; }
+	b="$(head -1 "$BRIGHT_CONF" 2>/dev/null | tr -cd '0-9')"
+	[ -n "$b" ] || b=1
+	[ "$b" -le 7 ] 2>/dev/null || b=1
+	echo "$b"
+}
+
+bright_set() {
+	# $1 - уровень 0..7
+	case "$1" in
+	''|*[!0-7]*)
+		echo "ERROR: яркость должна быть числом от 0 до 7"
+		return 1
+		;;
+	esac
+	mkdir -p "$(dirname "$BRIGHT_CONF")"
+	printf '%s\n' "$1" > "$BRIGHT_CONF"
+	# Команда уходит в STM32 через vendor-клиент (default-метод - post).
+	"$MCU" setbright "$1" >/dev/null 2>&1
+	echo "OK brightness=$1"
+}
+
+bright_apply() {
+	# Применяет сохранённый уровень (при старте авто-режима).
+	b="$(bright_get)"
+	"$MCU" setbright "$b" >/dev/null 2>&1
+	echo "$b"
+}
+
 # --- отправка в STM32 --------------------------------------------------------
 
 send_led() {
@@ -146,6 +190,9 @@ auto_color() {
 
 auto_loop() {
 	conf_init
+	# Восстанавливаем общий уровень яркости: в заводской прошивке его
+	# выставляет /etc/init.d/stm32_setup при загрузке, у нас - здесь.
+	bright_apply >/dev/null 2>&1
 	last=""
 	while true; do
 		for l in $LEDS; do
@@ -171,6 +218,7 @@ cmd_status() {
 		set -- $(conf_get "$l")
 		echo "$l ${1:-manual} ${2:-0} ${3:-}"
 	done
+	echo "BRIGHTNESS $(bright_get)"
 }
 
 cmd_set() {
@@ -261,6 +309,7 @@ cmd_demo() {
 
 case "${1:-}" in
 status) cmd_status ;;
+brightness) shift; bright_set "${1:-}" ;;
 set) shift; cmd_set "$@" ;;
 auto)
 	if [ "${2:-}" = "" ]; then auto_loop
@@ -271,7 +320,7 @@ off) cmd_off ;;
 blank) cmd_blank ;;
 demo) shift; cmd_demo "$@" ;;
 *)
-	echo "Использование: pejir-led status|set <имя> <цвет> [режим]|auto <имя> on|off|off|blank|demo [сек]|auto"
+	echo "Использование: pejir-led status|set <имя> <цвет> [режим]|auto <имя> on|off|off|blank|demo [сек]|brightness <0-7>|auto"
 	exit 1
 	;;
 esac
