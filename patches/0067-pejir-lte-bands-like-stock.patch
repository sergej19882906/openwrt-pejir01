+# Диапазоны 3G/4G - ровно как в стоковой прошивке Perenio:
+# AT+ZBAND=<UMTS>,0,0,<LTE>. Список диапазонов берётся из
+# network.lte.perenio_band (там же, где и в стоке). Если список не задан -
+# ничего не шлём, настройки модема остаются как есть.
+sync_bands() {
+	local port script bands masks umts lte
+
+	bands="$(uci -q get network.lte.perenio_band | tr '\n' ' ')"
+	[ -n "$bands" ] || return 0
+
+	[ -f /usr/share/pejir/bands.sh ] && . /usr/share/pejir/bands.sh
+	masks="$(pejir_bands_calc $bands)"
+	umts="$(echo "$masks" | awk '{print $1}')"
+	lte="$(echo "$masks" | awk '{print $2}')"
+
+	port="$(detect_at_port)" || return 0
+	script="/tmp/pejir-band.$$"
+	printf 'AT+ZBAND=%s,0,0,%s\r' "$umts" "$lte" > "$script"
+	set_port_speed "$port"
+	timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
+	rm -f "$script"
+	log "диапазоны модема заданы: $bands (ZBAND=$umts,0,0,$lte)"
+}
