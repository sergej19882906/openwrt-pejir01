diff --git a/package/pejir-lte-base/root/usr/libexec/pejir-band b/package/pejir-lte-base/root/usr/libexec/pejir-band
new file mode 100644
index 0000000..36161c5
--- /dev/null
+++ b/package/pejir-lte-base/root/usr/libexec/pejir-band
@@ -0,0 +1,113 @@
+#!/bin/sh
+# Диапазоны 3G/4G модема GOCUNCN Welink GM510.
+#
+#   pejir-band show     - показать настройку и текущие диапазоны модема
+#   pejir-band apply    - применить список из network.lte.perenio_band
+#   pejir-band set ...  - применить указанные диапазоны (umts01 lte01 ...)
+#
+# Настройка выполняется командой AT+ZBAND=<UMTS>,0,0,<LTE> - так же,
+# как в стоковой прошивке Perenio (GOSUNCN, /usr/lib/modem_ubus/gosuncn.sh).
+#
+# Настройка хранится в UCI: network.lte.perenio_band (список имён).
+#
+# Ошибка stty НЕ фатальна: на этом устройстве stty всегда отвечает
+# "unable to perform all requested operations", хотя порт рабочий.
+
+set -u
+
+BANDS_SH="/usr/share/pejir/bands.sh"
+[ -f "$BANDS_SH" ] && . "$BANDS_SH"
+
+AT_TIMEOUT="${AT_TIMEOUT:-8}"
+
+# --- AT-обмен --------------------------------------------------------------
+# $1 - порт, $2 - команда (без \r). Печатает ответ модема.
+at_ask() {
+	_aport="$1"
+	_acmd="$2"
+	_script="/tmp/pejir-band.$$"
+
+	printf '%s\r' "$_acmd" > "$_script"
+	stty -F "$_aport" 115200 raw -echo 2>/dev/null || true
+	_out=$(timeout "$AT_TIMEOUT" atinout "$_script" "$_aport" - 2>/dev/null)
+	rm -f "$_script"
+	printf '%s' "$_out"
+}
+
+# Подтверждённый AT-порт (его пишет 41-pejir-modem), иначе - перебор.
+find_port() {
+	if [ -f /etc/pejir/at-port ]; then
+		_p=$(head -n 1 /etc/pejir/at-port 2>/dev/null)
+		[ -n "$_p" ] && [ -c "$_p" ] && { echo "$_p"; return 0; }
+	fi
+	for _p in /dev/ttyUSB2 /dev/ttyUSB1 /dev/ttyUSB0 /dev/ttyACM0; do
+		[ -c "$_p" ] && { echo "$_p"; return 0; }
+	done
+	return 1
+}
+
+show_current() {
+	_p=$(find_port) || { echo "AT-порт модема не найден"; return 1; }
+	echo "порт: $_p"
+	echo "--- AT+ZBAND? ---"
+	at_ask "$_p" 'AT+ZBAND?'
+}
+
+apply_bands() {
+	_bands="$*"
+	[ -n "$_bands" ] || _bands=$(uci -q get network.lte.perenio_band | tr '\n' ' ')
+	[ -n "$_bands" ] || _bands="allBands"
+
+	set -- $_bands
+	_masks=$(pejir_bands_calc "$@")
+	_umts=$(echo "$_masks" | awk '{print $1}')
+	_lte=$(echo "$_masks" | awk '{print $2}')
+
+	echo "диапазоны: $*"
+	echo "команда:   AT+ZBAND=$_umts,0,0,$_lte"
+
+	_p=$(find_port) || { echo "AT-порт модема не найден"; return 1; }
+
+	# smsd держит AT-порт и забирает ответы модема себе - на время
+	# обмена его надо отпустить.
+	_smsd=0
+	if pidof smsd >/dev/null 2>&1; then
+		_smsd=1
+		/etc/init.d/smstools3 stop >/dev/null 2>&1
+		sleep 2
+	fi
+
+	_out=$(at_ask "$_p" "AT+ZBAND=$_umts,0,0,$_lte")
+	echo "ответ:     $_out"
+
+	[ "$_smsd" = "1" ] && { /etc/init.d/smstools3 start >/dev/null 2>&1; }
+
+	case "$_out" in
+		*ERROR*|*'command not supported'*)
+			echo "модем отклонил настройку диапазонов"
+			return 1 ;;
+	esac
+
+	echo "диапазоны применены"
+	return 0
+}
+
+case "${1:-show}" in
+	show)
+		echo "=== настройка в UCI ==="
+		uci -q get network.lte.perenio_band || echo "не задана (по умолчанию используются все диапазоны)"
+		echo
+		show_current
+		;;
+	apply)
+		apply_bands
+		;;
+	set)
+		shift
+		apply_bands "$@"
+		;;
+	*)
+		echo "usage: pejir-band [show|apply|set <диапазоны>...]"
+		exit 1
+		;;
+esac
diff --git a/package/pejir-lte-base/root/usr/share/pejir/bands.sh b/package/pejir-lte-base/root/usr/share/pejir/bands.sh
new file mode 100644
index 0000000..1205701
--- /dev/null
+++ b/package/pejir-lte-base/root/usr/share/pejir/bands.sh
@@ -0,0 +1,86 @@
+# Диапазоны 3G/4G для модема GOCUNCN Welink GM510.
+#
+# Общий файл: его подключают и init-скрипт LTE (47-pejir-lte), и
+# помощник /usr/libexec/pejir-band, который вызывается со страницы LuCI.
+# Один источник правды - маски диапазонов.
+#
+# Настройка модема делается командой
+#   AT+ZBAND=<UMTS>,0,0,<LTE>
+# где UMTS и LTE - битовые маски разрешённых диапазонов (в hex, без
+# префикса 0x) либо "all".
+#
+# Значения масок взяты из стоковой прошивки Perenio (2021, GOSUNCN,
+# /usr/lib/modem_ubus/gosuncn.sh) - там ровно эти же команды и эти же
+# маски, поэтому настройка совпадает со стоком.
+#
+# Список хранится в UCI: network.lte.perenio_band - список имён
+# диапазонов (как в стоке). Допустимые имена:
+#   umts01 umts08 lte01 lte03 lte07 lte08 lte20 lte38
+# плюс служебные:
+#   umtsALL - все 3G, lteALL - все 4G, allBands - все вместе.
+
+pejir_bands_names() {
+	echo "umts01 umts08 lte01 lte03 lte07 lte08 lte20 lte38"
+}
+
+pejir_bands_mask() {
+	# $1 - имя диапазона; печатает маску (hex, без 0x) или пусто
+	case "$1" in
+		umts01)   echo "400000" ;;
+		umts08)   echo "2000000000000" ;;
+		lte01)    echo "1" ;;
+		lte03)    echo "4" ;;
+		lte07)    echo "40" ;;
+		lte08)    echo "80" ;;
+		lte20)    echo "80000" ;;
+		lte38)    echo "2000000000" ;;
+		*)        echo "" ;;
+	esac
+}
+
+pejir_bands_label() {
+	case "$1" in
+		umts01)   echo "3G: диапазон 1 (2100 МГц)" ;;
+		umts08)   echo "3G: диапазон 8 (900 МГц)" ;;
+		lte01)    echo "4G: диапазон 1 (2100 МГц)" ;;
+		lte03)    echo "4G: диапазон 3 (1800 МГц)" ;;
+		lte07)    echo "4G: диапазон 7 (2600 МГц)" ;;
+		lte08)    echo "4G: диапазон 8 (900 МГц)" ;;
+		lte20)    echo "4G: диапазон 20 (800 МГц)" ;;
+		lte38)    echo "4G: диапазон 38 (2600 МГц, TDD)" ;;
+		umtsALL)  echo "3G: все диапазоны" ;;
+		lteALL)   echo "4G: все диапазоны" ;;
+		allBands) echo "3G и 4G: все диапазоны" ;;
+		*)        echo "$1" ;;
+	esac
+}
+
+# Посчитать маски UMTS и LTE по списку имён.
+# Результат: "umts_mask lte_mask" (пусто - all).
+pejir_bands_calc() {
+	_umts=""
+	_lte=""
+	_ucalc=0
+	_lcalc=0
+
+	for _b in $*; do
+		case "$_b" in
+			umts01)   _ucalc=$((_ucalc + 0x0000000400000)) ;;
+			umts08)   _ucalc=$((_ucalc + 0x2000000000000)) ;;
+			umtsALL)  _umts="all" ;;
+			lte01)    _lcalc=$((_lcalc + 0x0000000000001)) ;;
+			lte03)    _lcalc=$((_lcalc + 0x0000000000004)) ;;
+			lte07)    _lcalc=$((_lcalc + 0x0000000000040)) ;;
+			lte08)    _lcalc=$((_lcalc + 0x0000000000080)) ;;
+			lte20)    _lcalc=$((_lcalc + 0x0000000080000)) ;;
+			lte38)    _lcalc=$((_lcalc + 0x0002000000000)) ;;
+			lteALL)   _lte="all" ;;
+			allBands) _umts="all"; _lte="all" ;;
+		esac
+	done
+
+	[ -n "$_umts" ] || _umts=$(printf '%x' "$_ucalc")
+	[ -n "$_lte" ] || _lte=$(printf '%x' "$_lcalc")
+
+	echo "$_umts $_lte"
+}
