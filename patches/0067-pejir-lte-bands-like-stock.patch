diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/bands.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/bands.js
new file mode 100644
index 0000000..09b07f9
--- /dev/null
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/bands.js
@@ -0,0 +1,153 @@
+'use strict';
+'require view';
+'require fs';
+'require uci';
+'require ui';
+
+/* Диапазоны 3G/4G модема GM510.
+ *
+ * Настройка полностью повторяет стоковую прошивку Perenio: список
+ * диапазонов хранится в UCI (network.lte.perenio_band), а модему
+ * отправляется AT+ZBAND=<UMTS>,0,0,<LTE>. Маски диапазонов - те же,
+ * что в стоке (usr/lib/modem_ubus/gosuncn.sh).
+ *
+ * Список диапазонов применяется:
+ *   - кнопкой "Применить сейчас" (сразу, через /usr/libexec/pejir-band);
+ *   - при каждом старте LTE (init-скрипт 47-pejir-lte).
+ *
+ * Если список не задан, модем работает на всех диапазонах (обычная
+ * настройка по умолчанию модема) - ничего не отправляется.
+ */
+
+var BANDS = [
+	[ 'umts01', _('3G: band 1 (2100 MHz)') ],
+	[ 'umts08', _('3G: band 8 (900 MHz)') ],
+	[ 'lte01', _('4G: band 1 (2100 MHz)') ],
+	[ 'lte03', _('4G: band 3 (1800 MHz)') ],
+	[ 'lte07', _('4G: band 7 (2600 MHz)') ],
+	[ 'lte08', _('4G: band 8 (900 MHz)') ],
+	[ 'lte20', _('4G: band 20 (800 MHz)') ],
+	[ 'lte38', _('4G: band 38 (2600 MHz, TDD)') ]
+];
+
+var BAND = '/usr/libexec/pejir-band';
+
+function currentBands() {
+	var s = uci.get('network', 'lte', 'perenio_band');
+
+	if (s == null)
+		return [];
+
+	if (Array.isArray(s))
+		return s;
+
+	return String(s).split(/\s+/).filter(function(x) { return x != ''; });
+}
+
+function setText(id, s) {
+	var el = document.getElementById(id);
+
+	if (el)
+		el.textContent = s;
+}
+
+return view.extend({
+	handleSave: function(ev) {
+		var boxes = document.querySelectorAll('.pejir-band-box');
+		var val = [];
+
+		for (var i = 0; i < boxes.length; i++) {
+			if (boxes[i].checked)
+				val.push(boxes[i].value);
+		}
+
+		uci.set('network', 'lte', 'perenio_band', val);
+		return uci.save().then(function() {
+			ui.addNotification(null, E('p', {}, _('Saved. Press "Apply now" to send the setting to the modem.')), 'info');
+		}).catch(function(e) {
+			ui.addNotification(null, E('p', {}, _('Failed to save: ') + (e && e.message ? e.message : e)), 'error');
+		});
+	},
+
+	handleApply: function(ev) {
+		var btn = ev.currentTarget;
+
+		btn.disabled = true;
+		setText('pejir-bands-log', _('Sending the setting to the modem...'));
+
+		return fs.exec(BAND, [ 'apply' ]).then(function(r) {
+			var out = (r && r.stdout ? r.stdout : '') + (r && r.stderr ? r.stderr : '');
+
+			setText('pejir-bands-log', out.trim() || _('Done'));
+			btn.disabled = false;
+		}).catch(function(e) {
+			setText('pejir-bands-log', _('Error: ') + (e && e.message ? e.message : String(e || '')));
+			btn.disabled = false;
+		});
+	},
+
+	handleShow: function(ev) {
+		var btn = ev.currentTarget;
+
+		btn.disabled = true;
+		setText('pejir-bands-log', _('Reading the modem bands...'));
+
+		return fs.exec(BAND, [ 'show' ]).then(function(r) {
+			var out = (r && r.stdout ? r.stdout : '') + (r && r.stderr ? r.stderr : '');
+
+			setText('pejir-bands-log', out.trim() || _('No data'));
+			btn.disabled = false;
+		}).catch(function(e) {
+			setText('pejir-bands-log', _('Error: ') + (e && e.message ? e.message : String(e || '')));
+			btn.disabled = false;
+		});
+	},
+
+	render: function() {
+		var sel = currentBands();
+		var rows = [];
+
+		BANDS.forEach(function(b) {
+			var id = 'pejir-band-' + b[0];
+
+			rows.push(E('div', { 'class': 'cbi-value' }, [
+				E('div', { 'class': 'cbi-value-title' }, b[1]),
+				E('div', { 'class': 'cbi-value-field' },
+					E('input', { 'type': 'checkbox', 'class': 'pejir-band-box',
+						'id': id, 'value': b[0],
+						'checked': sel.indexOf(b[0]) >= 0 }))
+			]));
+		});
+
+		var saveBtn = E('button', { 'class': 'cbi-button cbi-button-save', 'type': 'button' },
+				_('Save'));
+		saveBtn.addEventListener('click', L.bind(this.handleSave, this));
+
+		var applyBtn = E('button', { 'class': 'cbi-button cbi-button-action', 'type': 'button' },
+				_('Apply now'));
+		applyBtn.addEventListener('click', L.bind(this.handleApply, this));
+
+		var showBtn = E('button', { 'class': 'cbi-button cbi-button-neutral', 'type': 'button' },
+				_('Show current'));
+		showBtn.addEventListener('click', L.bind(this.handleShow, this));
+
+		return E('div', { 'class': 'cbi-section' }, [
+			E('h2', {}, _('3G/4G bands (PEJIR01)')),
+			E('div', { 'class': 'cbi-section-descr' },
+				_('Allowed frequency bands for the GM510 modem. The list is stored in network.lte.perenio_band and applied with the AT+ZBAND command, exactly as in the stock firmware. If nothing is selected, the modem keeps all bands enabled by default.')),
+			E('div', { 'class': 'cbi-map' }, rows),
+			E('div', { 'class': 'cbi-value' }, [
+				E('div', { 'class': 'cbi-value-title' }, ''),
+				E('div', { 'class': 'cbi-value-field' }, [
+					saveBtn, ' ', applyBtn, ' ', showBtn
+				])
+			]),
+			E('div', { 'class': 'cbi-value' }, [
+				E('div', { 'class': 'cbi-value-title' }, _('Band log')),
+				E('div', { 'class': 'cbi-value-field' },
+					E('pre', { 'id': 'pejir-bands-log',
+						'style': 'white-space:pre-wrap; font-family:monospace; font-size:12px; max-height:40vh; overflow:auto; border:1px solid #ccc; padding:8px;' }, ''))
+			])
+		]);
+	}
+});
