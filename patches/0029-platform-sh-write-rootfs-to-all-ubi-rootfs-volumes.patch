Загрузчик на PEJIR01 выбирает систему по U-Boot env imgidx и читает UBI-том
rootfs0 или rootfs1 (см. sw-description заводской прошивки: mtdname=
kernel0/kernel1, volume=rootfs0/rootfs1, bootenv imgidx=0/1). Наш
platform.sh писал rootfs только в том "rootfs" и только на одном UBI-устройстве:
если загрузчик читает rootfs0/rootfs1 (или другое ubiN) — обновление
проходило без ошибок, а устройство оставалось на старой прошивке.

Теперь:
  * ядро пишется в kernel0, kernel1 и kernel (если такие разделы есть);
  * rootfs пишется во ВСЕ тома, чьё имя начинается с rootfs (rootfs,
    rootfs0, rootfs1; rootfs_data пропускается), на всех UBI-устройствах;
  * ошибка записи в отдельный том не валит обновление, но если не записан
    ни один том — обновление считается неуспешным;
  * в лог пишется разметка MTD, список томов UBI и значение imgidx.
---
 .../mt7621/base-files/lib/upgrade/platform.sh | 71 ++++++++++++++++---
 1 file changed, 60 insertions(+), 11 deletions(-)

diff --git a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
index 9436468..fb8afbc 100644
--- a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
+++ b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
@@ -25,30 +25,79 @@ platform_check_image() {
 }
 
 # Perenio PEJIR01: ядро лежит в MTD-разделах kernel0/kernel1 (по 4 МиБ),
-# rootfs — в UBI. MTD-раздела "kernel" здесь нет, а U-Boot выбирает
-# активный слот A/B по переменной imgidx, значение которой нам неизвестно.
-# Поэтому новый kernel пишем в оба слота — ровно так же, как это делает
-# factory.bin. U-Boot env при этом не трогаем: если запись не удалась,
-# устройство всё равно загрузится со старым ядром из активного слота.
+# rootfs — в UBI. У вендора таких томов два: rootfs0 и rootfs1, активный
+# слот выбирает U-Boot по переменной imgidx (sw-description заводской
+# прошивки: mtdname="kernel0"/"kernel1", volume="rootfs0"/"rootfs1",
+# bootenv imgidx=0/1). OpenWrt же создаёт свой том "rootfs", а номер
+# UBI-устройства (ubi0/ubi1) при загрузке может меняться.
+#
+# Поэтому пишем ядро в оба слота, а rootfs — во ВСЕ тома, чьё имя
+# начинается с rootfs (кроме rootfs_data), на всех UBI-устройствах: так
+# не приходится угадывать, какой том читает загрузчик. Ошибка записи в
+# отдельный том не валит обновление (важно, чтобы прошивка встала), но
+# если не записан ни один том — обновление считается неуспешным.
 perenio_do_upgrade() {
 	local tar_file="$1"
 	local cmd="${2:-cat}"
-	local board_dir part idx
+	local board_dir part idx ubivol volname dev rootfs_len ok bad
 
 	board_dir="$($cmd < "$tar_file" | tar tf - | grep -m 1 '^sysupgrade-.*/$')"
 	board_dir="${board_dir%/}"
 
-	for part in kernel0 kernel1; do
+	echo "=== Perenio: разделы MTD ==="
+	cat /proc/mtd 2>/dev/null
+
+	echo "=== Perenio: тома UBI ==="
+	for ubivol in /sys/class/ubi/ubi*_*; do
+		[ -f "$ubivol/name" ] || continue
+		echo "$(basename "$ubivol"): $(cat "$ubivol/name")"
+	done
+
+	echo "=== Perenio: активный слот ==="
+	echo "imgidx=$(fw_printenv -n imgidx 2>/dev/null)"
+
+	for part in kernel0 kernel1 kernel; do
 		idx="$(find_mtd_index "$part")"
 		[ -n "$idx" ] || continue
-		echo "writing kernel to $part"
+		echo "запись ядра в MTD-раздел $part"
 		$cmd < "$tar_file" | tar xOf - "$board_dir/kernel" | \
 			mtd write - "$part" || return 1
 	done
 
-	# rootfs уходит в UBI; kernel в UBI этому устройству не нужен
-	CI_KERNPART=none
-	nand_do_upgrade "$tar_file" "$cmd"
+	rootfs_len="$($cmd < "$tar_file" | tar xOf - "$board_dir/root" | wc -c)"
+	if [ "$rootfs_len" -eq 0 ]; then
+		echo "Perenio: в образе нет rootfs"
+		return 1
+	fi
+
+	ok=0
+	bad=0
+	for ubivol in /sys/class/ubi/ubi*_*; do
+		[ -f "$ubivol/name" ] || continue
+		volname="$(cat "$ubivol/name")"
+		case "$volname" in
+			rootfs|rootfs[0-9]*) ;;
+			*) continue ;;
+		esac
+		dev="$(nand_find_volume "$(basename "$ubivol" | cut -d_ -f1)" "$volname")"
+		[ -n "$dev" ] || continue
+		echo "запись rootfs ($rootfs_len байт) в UBI-том $volname (/dev/$dev)"
+		if $cmd < "$tar_file" | tar xOf - "$board_dir/root" | \
+			ubiupdatevol "/dev/$dev" -s "$rootfs_len" -; then
+			ok=$((ok + 1))
+		else
+			bad=$((bad + 1))
+			echo "Perenio: не удалось записать том $volname"
+		fi
+	done
+
+	if [ "$ok" -eq 0 ]; then
+		echo "Perenio: не записан ни один UBI-том rootfs* (попыток: $bad)"
+		return 1
+	fi
+
+	echo "Perenio: rootfs записан в $ok том(ов), ошибок: $bad"
+	return 0
 }
 
 platform_do_upgrade() {
