Факты с живого устройства:
* окружение загрузчика лежит в разделе "Config" (mtd1), а не в "Bootloader"
  (mtd0, там только значения по умолчанию); в нём imgidx=1, то есть
  загрузчик читает kernel1;
* kernel1 writable, kernel0 закрыт read-only — это защищённый запасной
  слот с заводским ядром;
* утилита mtd на устройстве не находит раздел по имени (нет
  /etc/mtd.config), писать надо по /dev/mtdN.

Поэтому:
* ядро пишем в активный слот (по imgidx) первым, второй — по
  возможности, и ошибка второго слота больше не обрывает обновление;
* окружение читаем из раздела "Config", затем из "Bootloader";
* пишем по /dev/mtdN, а не по имени раздела.
---
 .../mt7621/base-files/lib/upgrade/platform.sh | 68 +++++++++++++++----
 1 file changed, 55 insertions(+), 13 deletions(-)

diff --git a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
index 06e18dc..8b71fcf 100644
--- a/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
+++ b/target/linux/ramips/mt7621/base-files/lib/upgrade/platform.sh
@@ -50,15 +50,19 @@ platform_check_image() {
 # bootenv imgidx=0/1). OpenWrt же создаёт свой том "rootfs", а номер
 # UBI-устройства (ubi0/ubi1) при загрузке может меняться.
 #
-# Поэтому пишем ядро в оба слота, а rootfs — во ВСЕ тома, чьё имя
-# начинается с rootfs (кроме rootfs_data), на всех UBI-устройствах: так
-# не приходится угадывать, какой том читает загрузчик. Ошибка записи в
-# отдельный том не валит обновление (важно, чтобы прошивка встала), но
+# Проверено на живом устройстве: загрузчик берёт ядро ИМЕННО из MTD
+# kernel0/kernel1 (там лежит заводское 6.6.119), а том UBI "kernel"
+# (куда OpenWrt кладёт ядро) загрузчик не читает вовсе. Поэтому ядро
+# пишем в оба слота (и заодно в том "kernel" — на случай смены
+# загрузчика), а rootfs — во ВСЕ тома, чьё имя начинается с rootfs
+# (кроме rootfs_data), на всех UBI-устройствах: так не приходится
+# угадывать, какой том читает ядро (root=/dev/ubiblock0_N). Ошибка записи
+# в отдельный том не валит обновление (важно, чтобы прошивка встала), но
 # если не записан ни один том — обновление считается неуспешным.
 perenio_do_upgrade() {
 	local tar_file="$1"
 	local cmd="${2:-cat}"
-	local board_dir part idx ubivol volname dev rootfs_len kernel_len ok bad
+	local board_dir part idx envidx ubivol volname dev rootfs_len kernel_len ok bad kok imgidx
 
 	board_dir="$($cmd < "$tar_file" | tar tf - | grep -m 1 '^sysupgrade-.*/$')"
 	board_dir="${board_dir%/}"
@@ -73,20 +77,58 @@ perenio_do_upgrade() {
 	done
 
 	echo "=== Perenio: активный слот ==="
-	echo "imgidx=$(fw_printenv -n imgidx 2>/dev/null)"
+	imgidx="$(fw_printenv -n imgidx 2>/dev/null)"
+	if [ -z "$imgidx" ]; then
+		# fw_printenv на устройстве бесполезен (нет /etc/fw_env.config),
+		# а окружение загрузчика лежит в разделе "Config" (mtd1), а не в
+		# "Bootloader" (mtd0) — там только копия значений по умолчанию.
+		for envpart in Config Bootloader; do
+			envidx="$(find_mtd_index "$envpart")"
+			[ -n "$envidx" ] || continue
+			imgidx="$(strings "/dev/mtd$envidx" 2>/dev/null | \
+				sed -n 's/^imgidx=//p' | head -1)"
+			[ -n "$imgidx" ] && break
+		done
+	fi
+	echo "imgidx=${imgidx:-?} (0 = kernel0, 1 = kernel1)"
+
+	# Активный слот — тот, который указывает imgidx (у нас 1 => kernel1).
+	# Именно его читает загрузчик, поэтому пишем ядро в него; второй слот
+	# у вендора закрыт read-only и служит резервным (в нём остаётся
+	# заводское ядро, с которого можно загрузиться, сменив imgidx).
+	case "$imgidx" in
+		0) kernel_slots="kernel0 kernel1" ;;
+		1) kernel_slots="kernel1 kernel0" ;;
+		*) kernel_slots="kernel1 kernel0" ;;
+	esac
 
-	for part in kernel0 kernel1 kernel; do
+	kok=0
+	for part in $kernel_slots; do
 		idx="$(find_mtd_index "$part")"
 		[ -n "$idx" ] || continue
 		echo "запись ядра в MTD-раздел $part"
+		if $cmd < "$tar_file" | tar xOf - "$board_dir/kernel" | \
+			mtd write - "/dev/mtd$idx"; then
+			kok=$((kok + 1))
+			continue
+		fi
+		# Раздел может быть закрыт read-only — снимаем флаг и пробуем
+		# ещё раз. Неудача здесь не валит обновление: главное, чтобы
+		# ядро попало в активный слот.
+		echo "запись в $part не удалась, снимаем read-only и повторяем"
+		printf '0' > "/sys/class/mtd/mtd$idx/flags" 2>/dev/null
 		$cmd < "$tar_file" | tar xOf - "$board_dir/kernel" | \
-			mtd write - "$part" || return 1
+			mtd write - "/dev/mtd$idx" && kok=$((kok + 1))
 	done
+	if [ "$kok" -eq 0 ]; then
+		echo "Perenio: ядро не записано ни в один MTD-раздел"
+		return 1
+	fi
+	echo "Perenio: ядро записано в $kok слот(ов)"
 
-	# Ядро также кладём в UBI-том "kernel" — именно из него OpenWrt-овский
-	# u-boot берёт образ при загрузке (тома kernel/rootfs/rootfs_data — это
-	# стандартная раскладка NAND-варианта OpenWrt). Раньше ядро писалось
-	# только в MTD kernel0/kernel1, и загрузчик продолжал поднимать старый.
+	# Ядро кладём и в UBI-том "kernel" — на этом устройстве загрузчик
+	# его не читает (он берёт ядро из MTD kernel0/kernel1), но при смене
+	# загрузчика на OpenWrt-овский том окажется валидным.
 	kernel_len="$($cmd < "$tar_file" | tar xOf - "$board_dir/kernel" | wc -c)"
 	for ubivol in /sys/class/ubi/ubi*_*; do
 		[ -f "$ubivol/name" ] || continue
@@ -96,7 +138,7 @@ perenio_do_upgrade() {
 		[ -n "$dev" ] || continue
 		echo "запись ядра в UBI-том $volname (/dev/$dev)"
 		$cmd < "$tar_file" | tar xOf - "$board_dir/kernel" | \
-			ubiupdatevol "/dev/$dev" -s "$kernel_len" - || return 1
+			ubiupdatevol "/dev/$dev" -s "$kernel_len" - || :
 	done
 
 	rootfs_len="$($cmd < "$tar_file" | tar xOf - "$board_dir/root" | wc -c)"
-- 
2.39.5

