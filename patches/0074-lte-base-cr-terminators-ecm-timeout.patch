---
 package/pejir-lte-base/root/etc/init.d/47-pejir-lte | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/package/pejir-lte-base/root/etc/init.d/47-pejir-lte b/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
index 39cd514..2d73d4c 100644
--- a/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
+++ b/package/pejir-lte-base/root/etc/init.d/47-pejir-lte
@@ -78,6 +78,9 @@ detect_ifname() {
 # init-скрипт не доходит до конца. Поэтому каждый вызов обёрнут в
 # timeout: порт, который не ответил, просто пропускаем.
 AT_TIMEOUT="${AT_TIMEOUT:-5}"
+# AT+ZECMCALL может набирать сеанс заметно дольше обычных AT-опросов:
+# общий AT_TIMEOUT=5 режет вызов на полуобороте, поэтому набор сеанса живёт на собственном таймауте.
+ECM_TIMEOUT="${ECM_TIMEOUT:-30}"
 
 # Скорость линии модема.
 #
@@ -255,7 +258,7 @@ sync_apn() {
 
 	port="$(detect_at_port)" || return 0
 	script="/tmp/pejir-apn.$$"
-	printf 'AT+CGDCONT=1,"IP","%s"\n' "$apn" > "$script"
+	printf 'AT+CGDCONT=1,"IP","%s"\r' "$apn" > "$script"
 	set_port_speed "$port"
 	timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 	rm -f "$script"
@@ -313,14 +316,14 @@ ecm_call() {
 	# Если APN неизвестен - отправляем без него, модем возьмёт текущий
 	# PDP-контекст.
 	if [ -n "$apn" ]; then
-		printf 'AT+ZECMCALL=1,%s\n' "$apn" > "$script"
+		printf 'AT+ZECMCALL=1,%s\r' "$apn" > "$script"
 	else
-		printf 'AT+ZECMCALL=1\n' > "$script"
+		printf 'AT+ZECMCALL=1\r' > "$script"
 	fi
 	# Ошибку игнорируем: на модемах без ECM-поддержки вызов не нужен,
 	# а AT+CGDCONT уже отработал.
 	set_port_speed "$port"
-	timeout "$AT_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
+	timeout "$ECM_TIMEOUT" atinout "$script" "$port" - >/dev/null 2>&1
 	rm -f "$script"
 	log "ECM data call (AT+ZECMCALL=1${apn:+,}$apn) отправлен модему"
 }
-- 
