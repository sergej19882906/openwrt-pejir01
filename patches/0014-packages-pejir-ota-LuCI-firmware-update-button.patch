+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=pejir-ota
+PKG_VERSION:=1.0.0
+PKG_RELEASE:=1
+
+PKG_LICENSE:=Apache-2.0
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/pejir-ota
+  SECTION:=utils
+  CATEGORY:=Utilities
+  TITLE:=PEJIR01 firmware update helper (LuCI button)
+  DEPENDS:=+wget-ssl +luci-base
+endef
+
+define Package/pejir-ota/description
+  Firmware update for the PEJIR01 port.
+  Adds a "Firmware update (PEJIR01)" page under System in LuCI and the
+  /usr/bin/pejir-ota helper behind it. The helper compares the running
+  build (version marker in /usr/lib/pejir/version) with the latest GitHub
+  release and, only on an explicit request, downloads the sysupgrade
+  image, verifies its sha256 against the release sha256sums, checks it
+  with "sysupgrade --test" and flashes it.
+  There is no automatic update: nothing is scheduled, nothing is
+  downloaded and nothing is written to flash until the user presses the
+  button.
+endef
+
+define Build/Prepare
+endef
+
+define Build/Compile
+endef
+
+define Package/pejir-ota/install
+	$(INSTALL_DIR) $(1)/usr/bin
+	$(INSTALL_BIN) ./files/pejir-ota $(1)/usr/bin/pejir-ota
+	$(INSTALL_DIR) $(1)/usr/lib/pejir
+	$(INSTALL_DATA) ./files/version $(1)/usr/lib/pejir/version
+	$(INSTALL_DIR) $(1)/etc/config
+	$(INSTALL_CONF) ./root/etc/config/pejir_ota $(1)/etc/config/pejir_ota
+	$(INSTALL_DIR) $(1)/www/luci-static/resources/view/perenio
+	$(INSTALL_DATA) ./htdocs/luci-static/resources/view/perenio/ota.js \
+		$(1)/www/luci-static/resources/view/perenio/ota.js
+	$(INSTALL_DIR) $(1)/usr/share/luci/menu.d
+	$(INSTALL_DATA) ./root/usr/share/luci/menu.d/luci-app-pejir-ota.json \
+		$(1)/usr/share/luci/menu.d/luci-app-pejir-ota.json
+	$(INSTALL_DIR) $(1)/usr/share/rpcd/acl.d
+	$(INSTALL_DATA) ./root/usr/share/rpcd/acl.d/luci-app-pejir-ota.json \
+		$(1)/usr/share/rpcd/acl.d/luci-app-pejir-ota.json
+endef
+
+$(eval $(call BuildPackage,pejir-ota))
diff --git a/package/pejir-ota/files/pejir-ota b/package/pejir-ota/files/pejir-ota
new file mode 100644
index 0000000..c3dd012
--- /dev/null
+++ b/package/pejir-ota/files/pejir-ota
@@ -0,0 +1,214 @@
+#!/bin/sh
+# pejir-ota — проверка и установка обновлений прошивки Perenio PEJIR01.
+#
+# Автоматического обновления нет: образ ставится только по явной команде,
+# то есть по кнопке «Install update» в LuCI (Система → Firmware update).
+#
+# Команды:
+#   check    сравнить установленную версию с последним релизом на GitHub
+#   install  скачать образ, сверить сумму и запустить sysupgrade (в фоне)
+#   status   состояние фоновой установки и хвост журнала
+#   flash    внутренняя команда, запускается из install в фоне
+
+. /lib/functions.sh
+
+CFG="pejir_ota"
+WORK="/tmp/pejir-ota"
+LOG="/tmp/pejir-ota.log"
+STATE="/tmp/pejir-ota.state"
+API="https://api.github.com"
+
+cfgval() { uci -q get "$CFG.$1" 2>/dev/null; }
+
+REPO="$(cfgval repo)"
+[ -n "$REPO" ] || REPO="sergej19882906/openwrt-pejir01"
+
+ASSET="$(cfgval asset)"
+[ -n "$ASSET" ] || ASSET="openwrt-ramips-mt7621-perenio_pejir01-34-BA-squashfs-sysupgrade.bin"
+
+# Версия собранного образа лежит в ROM (/usr/lib/pejir/version), а не в
+# /etc: при sysupgrade с сохранением настроек файлы /etc восстанавливаются
+# из старой системы, и маркер версии устарел бы.
+INSTALLED="$(cat /usr/lib/pejir/version 2>/dev/null)"
+[ -n "$INSTALLED" ] || INSTALLED="$(cfgval version)"
+[ -n "$INSTALLED" ] || INSTALLED="unknown"
+
+KEEP="$(cfgval keep_settings)"
+[ -n "$KEEP" ] || KEEP="1"
+
+log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"$LOG"; }
+
+# Абсолютный путь к самому себе: фоновый процесс надо запускать тем же
+# файлом, которым вызвали скрипт, а не жёстко зашитым путём.
+SELF="$0"
+case "$SELF" in
+	/*) : ;;
+	*)  SELF="$(command -v "$SELF" 2>/dev/null || echo /usr/bin/pejir-ota)" ;;
+esac
+
+# Числовой счётчик релиза: 25.12.6-pejir01.11 -> 11
+relnum() { echo "$1" | sed -n 's/.*pejir01\.\([0-9][0-9]*\)$/\1/p'; }
+
+# Тег последнего релиза, например v25.12.6-pejir01.11
+latest_tag() {
+	wget -q -T 30 -O - "$API/repos/$REPO/releases/latest" 2>/dev/null \
+		| sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
+		| head -n1
+}
+
+cmd_check() {
+	local tag cur cur_n lat_n
+
+	tag="$(latest_tag)"
+	if [ -z "$tag" ]; then
+		# Связи с GitHub нет — но установленную версию показать надо.
+		echo "installed=$INSTALLED"
+		echo "latest="
+		echo "available=no"
+		echo "error=Не удалось получить список релизов (нет связи с GitHub?)"
+		return 1
+	fi
+
+	cur="$INSTALLED"
+	cur_n="$(relnum "$cur")"
+	lat_n="$(relnum "$tag")"
+
+	echo "installed=$cur"
+	echo "latest=$tag"
+	echo "url=https://github.com/$REPO/releases/tag/$tag"
+
+	if [ -z "$cur_n" ] || [ -z "$lat_n" ]; then
+		echo "available=yes"
+		echo "note=Версия в образе неизвестна, обновление рекомендуется"
+	elif [ "$lat_n" -gt "$cur_n" ]; then
+		echo "available=yes"
+	else
+		echo "available=no"
+	fi
+	return 0
+}
+
+cmd_install() {
+	local d fpid
+
+	fpid="$(cat "$WORK/flash.pid" 2>/dev/null || echo 0)"
+	if [ "$(cat "$STATE" 2>/dev/null)" = "running" ] && [ -n "$fpid" ] && [ "$fpid" -gt 0 ] 2>/dev/null \
+	   && [ -d "/proc/$fpid" ]; then
+		echo "error=Обновление уже выполняется (pid $fpid)"
+		return 1
+	fi
+
+	d="$(cmd_check)"
+	echo "$d"
+	case "$d" in
+		*available=yes*) : ;;
+		*) echo "error=Обновлений нет"; return 1 ;;
+	esac
+
+	: >"$LOG"
+	rm -f "$WORK/flash.pid"
+	echo "running" >"$STATE"
+	# Отсоединяем процесс от вызывающего: иначе rpcd будет ждать закрытия
+	# канала вывода и запрос из LuCI зависнет на всё время прошивки.
+	( "$SELF" flash >>"$LOG" 2>&1 </dev/null & )
+	sleep 2
+	if [ ! -s "$WORK/flash.pid" ]; then
+		echo "failed" >"$STATE"
+		echo "error=Не удалось запустить фоновое обновление, смотрите $LOG"
+		return 1
+	fi
+	echo "started=yes"
+	return 0
+}
+
+cmd_flash() {
+	local tag url img rc
+
+	mkdir -p "$WORK" || return 1
+	img="$WORK/$ASSET"
+	# PID фоновой прошивки: по нему install понимает, что обновление
+	# ещё идёт, а не зависло после аварийного завершения.
+	echo "$$" >"$WORK/flash.pid"
+
+	log "=== Начало обновления ==="
+	tag="$(latest_tag)"
+	if [ -z "$tag" ]; then
+		log "ОШИБКА: не удалось получить тег последнего релиза"
+		echo "failed" >"$STATE"
+		return 1
+	fi
+	log "Последний релиз: $tag"
+
+	url="https://github.com/$REPO/releases/download/$tag/$ASSET"
+	log "Скачиваю $ASSET ..."
+	wget -q -T 60 -O "$img" "$url" >>"$LOG" 2>&1
+	rc=$?
+	if [ $rc -ne 0 ] || [ ! -s "$img" ]; then
+		log "ОШИБКА: скачивание не удалось (код $rc)"
+		echo "failed" >"$STATE"
+		return 1
+	fi
+	log "Скачано: $(wc -c <"$img") байт"
+
+	log "Скачиваю sha256sums ..."
+	wget -q -T 60 -O "$WORK/sha256sums" \
+		"https://github.com/$REPO/releases/download/$tag/sha256sums" >>"$LOG" 2>&1
+	rc=$?
+	if [ $rc -ne 0 ] || [ ! -s "$WORK/sha256sums" ]; then
+		log "ОШИБКА: не удалось скачать sha256sums (код $rc)"
+		echo "failed" >"$STATE"
+		return 1
+	fi
+
+	log "Проверяю контрольную сумму ..."
+	if ! ( cd "$WORK" && grep -F " $ASSET" sha256sums | sha256sum -c - ) >>"$LOG" 2>&1; then
+		log "ОШИБКА: контрольная сумма не совпала"
+		echo "failed" >"$STATE"
+		return 1
+	fi
+	log "Контрольная сумма совпала"
+
+	log "Проверяю образ (sysupgrade --test) ..."
+	sysupgrade --test "$img" >>"$LOG" 2>&1
+	rc=$?
+	if [ $rc -ne 0 ]; then
+		log "ОШИБКА: образ не прошёл проверку (код $rc)"
+		echo "failed" >"$STATE"
+		return 1
+	fi
+	log "Образ проверен"
+
+	log "Прошиваю (sysupgrade) ..."
+	if [ "$KEEP" = "1" ]; then
+		sysupgrade "$img" >>"$LOG" 2>&1
+	else
+		sysupgrade -n "$img" >>"$LOG" 2>&1
+	fi
+	rc=$?
+	if [ $rc -ne 0 ]; then
+		log "ОШИБКА: sysupgrade завершился с кодом $rc"
+		echo "failed" >"$STATE"
+		return 1
+	fi
+
+	log "Готово, устройство перезагружается"
+	echo "rebooting" >"$STATE"
+	return 0
+}
+
+cmd_status() {
+	echo "state=$(cat "$STATE" 2>/dev/null || echo idle)"
+	echo "--- log ---"
+	tail -n 25 "$LOG" 2>/dev/null
+}
+
+case "${1:-}" in
+	check)   cmd_check ;;
+	install) cmd_install ;;
+	status)  cmd_status ;;
+	flash)   cmd_flash ;;
+	*)
+		echo "Использование: pejir-ota {check|install|status}" >&2
+		exit 1
+		;;
+esac
