new file mode 100644
index 0000000..c71bca3
--- /dev/null
+++ b/package/pejir-ota/htdocs/luci-static/resources/view/perenio/ota.js
@@ -0,0 +1,181 @@
+'use strict';
+'require view';
+'require fs';
+'require ui';
+'require poll';
+
+/* Разбор вывода pejir-ota вида "key=value" */
+function kv(out) {
+	var o = {};
+
+	(out || '').split('\n').forEach(function(line) {
+		var i = line.indexOf('=');
+
+		if (i > 0)
+			o[line.substring(0, i).trim()] = line.substring(i + 1).trim();
+	});
+
+	return o;
+}
+
+function setText(id, s) {
+	var el = document.getElementById(id);
+
+	if (el)
+		el.textContent = s;
+}
+
+/* Следить за ходом прошивки и дождаться перезагрузки */
+function watchUpdate() {
+	var stop = poll.add(function() {
+		return fs.exec('/usr/bin/pejir-ota', [ 'status' ]).then(function(res) {
+			var d = kv(res.stdout);
+			var el = document.getElementById('pejir-ota-log');
+
+			if (el)
+				el.textContent = res.stdout;
+
+			if (d.state == 'running' || d.state == 'rebooting' || d.state == 'done') {
+				var b = document.getElementById('pejir-ota-install');
+				if (b)
+					b.disabled = true;
+			}
+
+			if (d.state == 'rebooting' || d.state == 'done') {
+				stop();
+				setText('pejir-ota-status', _('Rebooting…'));
+				ui.awaitReconnect(window.location.host, '192.168.1.1');
+			}
+			else if (d.state == 'failed') {
+				stop();
+				setText('pejir-ota-status', _('Update failed, see the log below.'));
+			}
+		}).catch(function() {});
+	});
+}
+
+return view.extend({
+	load: function() {
+		return fs.exec('/usr/bin/pejir-ota', [ 'check' ])
+			.catch(function() { return { code: 1, stdout: '', stderr: '' }; });
+	},
+
+	handleCheck: function(ev) {
+		var btn = ev.currentTarget;
+
+		btn.disabled = true;
+
+		return fs.exec('/usr/bin/pejir-ota', [ 'check' ]).then(function(res) {
+			var d = kv(res.stdout);
+			var b;
+
+			if (res.code != 0) {
+				setText('pejir-ota-status',
+					_('Cannot reach the release server') +
+					(res.stderr ? ': ' + res.stderr.trim() : ''));
+				return;
+			}
+
+			setText('pejir-ota-installed', d.installed || '?');
+			setText('pejir-ota-latest', d.latest || '?');
+			setText('pejir-ota-status', d.available == 'yes'
+				? _('Update available') + (d.note ? ' — ' + d.note : '')
+				: _('The installed version is up to date'));
+
+			b = document.getElementById('pejir-ota-install');
+			if (b)
+				b.disabled = (d.available != 'yes');
+		}).catch(function(e) {
+			setText('pejir-ota-status', e.message);
+		}).finally(function() {
+			btn.disabled = false;
+		});
+	},
+
+	handleInstall: function(ev) {
+		return new Promise(function(resolve, reject) {
+			ui.showModal(_('Install firmware update?'), [
+				E('p', {}, _('The router will download the new firmware, verify the checksum ' +
+					'and flash it. The device reboots during the installation — do not ' +
+					'power it off.')),
+				E('div', { 'class': 'right' }, [
+					E('button', {
+						'class': 'btn',
+						'click': function() { ui.hideModal(); reject(); }
+					}, [ _('Cancel') ]),
+					' ',
+					E('button', {
+						'class': 'btn cbi-button-action important',
+						'click': function() { ui.hideModal(); resolve(); }
+					}, [ _('Continue') ])
+				])
+			]);
+		}).then(function() {
+			return fs.exec('/usr/bin/pejir-ota', [ 'install' ]);
+		}).then(function(res) {
+			if (res.code != 0) {
+				ui.addNotification(null, E('p',
+					_('Failed to start the update: ') + (res.stderr || '').trim()));
+				return;
+			}
+
+			setText('pejir-ota-status', _('Updating, please wait…'));
+			watchUpdate();
+		}).catch(function(e) {
+			if (e)
+				ui.addNotification(null, E('p', e.message));
+		});
+	},
+
+	render: function(res) {
+		var d = kv(res && res.stdout);
+		var failed = !res || res.code != 0;
+		var status = failed
+			? _('Cannot reach the release server')
+			: (d.available == 'yes' ? _('Update available') : _('The installed version is up to date'));
+		var btnCheck = E('button', {
+			'class': 'cbi-button cbi-button-action',
+			'id': 'pejir-ota-check',
+			'click': ui.createHandlerFn(this, 'handleCheck')
+		}, [ _('Check for updates') ]);
+		var btnInstall = E('button', {
+			'class': 'cbi-button cbi-button-action important',
+			'id': 'pejir-ota-install',
+			'click': ui.createHandlerFn(this, 'handleInstall')
+		}, [ _('Install update') ]);
+
+		btnInstall.disabled = (d.available != 'yes');
+
+		return E('div', { 'class': 'cbi-section' }, [
+			E('h2', {}, _('Firmware update (PEJIR01)')),
+			E('div', { 'class': 'cbi-section' }, [
+				E('table', { 'class': 'table' }, [
+					E('tr', { 'class': 'tr' }, [
+						E('td', { 'class': 'td', 'width': '33%' }, _('Installed version')),
+						E('td', { 'class': 'td', 'id': 'pejir-ota-installed' },
+							d.installed || _('unknown'))
+					]),
+					E('tr', { 'class': 'tr' }, [
+						E('td', { 'class': 'td' }, _('Latest release')),
+						E('td', { 'class': 'td', 'id': 'pejir-ota-latest' }, d.latest || '…')
+					])
+				]),
+				E('div', { 'class': 'cbi-value-description', 'id': 'pejir-ota-status' },
+					status),
+				E('div', { 'class': 'cbi-value' }, [
+					btnCheck,
+					' ',
+					btnInstall
+				]),
+				E('pre', {
+					'id': 'pejir-ota-log',
+					'style': 'max-height:320px; overflow:auto; white-space:pre-wrap'
+				}, ''),
+				E('div', { 'class': 'cbi-value-description' },
+					_('There is no automatic update: the new firmware is downloaded and installed ' +
+					  'only when you press "Install update". The router reboots by itself when ' +
+					  'the installation is finished.'))
+			])
+		]);
+	}
+});
