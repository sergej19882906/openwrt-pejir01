Проверка релиза .65 на устройстве показала: в /var/spool/sms/incoming
лежит не только два сообщения, но и служебный файл GM510-concatenated -
это сборка многочастевых PDU, которую smstools3 держит для склейки
длинных сообщений. Сообщением он не является: ни номера, ни даты, ни
текста в нем нет, только hex-PDU, и в переписке он выглядел как
мусорный элемент.

Теперь такие файлы пропускаются при чтении очереди. Заодно отбрасываются
файлы, из которых не удалось получить ни номера, ни даты, ни текста, -
на случай других служебных файлов smstools3.

Разбор сообщений проверен на РЕАЛЬНОМ файле с устройства (GM510,
заголовки From/From_TOA/Sent/Alphabet/Length, пустая строка, тело):
номер берётся из From, дата из Sent, текст - только из тела.
---
 .../luci-static/resources/view/perenio/sms.js     | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
index 0368881c..a50d6abb 100644
--- a/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
+++ b/package/luci-app-perenio/htdocs/luci-static/resources/view/perenio/sms.js
@@ -192,7 +192,15 @@ function parseMessage(txt) {
 /* Чтение сообщений из каталога spool smstools3. */
 function readSpool(dir) {
 	return fs.list(dir).catch(function() { return []; }).then(L.bind(function(list) {
-		var files = (list || []).filter(function(f) { return f.type == 'file'; });
+		/* smstools3 кладёт рядом с сообщениями служебный файл
+		 * "<модем>-concatenated" - это сборка многочастевых PDU, а не
+		 * сообщение. В переписке он выглядел как мусорный элемент без
+		 * номера и даты, поэтому такие файлы пропускаем. */
+		var files = (list || []).filter(function(f) {
+			if (f.type != 'file')
+				return false;
+			return !/-concatenated$/.test(f.name);
+		});
 
 		files.sort(function(a, b) { return b.mtime - a.mtime; });
 		files = files.slice(0, 50);
@@ -201,6 +209,11 @@ function readSpool(dir) {
 			return fs.read(dir + '/' + f.name).then(function(txt) {
 				var m = parseMessage(txt);
 
+				/* Файл без номера, без даты и без текста - не
+				 * сообщение (служебный мусор smstools3). */
+				if (!m.from && !m.date && !m.text)
+					return null;
+
 				return { name: f.name, mtime: f.mtime,
 					from: m.from, date: m.date, text: m.text };
 			}).catch(function() { return null; });
