+    transition: width 0.2s cubic-bezier(0.2, 0, 0, 1);
+  }
+  .main-left.active {
+    transition-duration: 0.3s;
+  }
+}
+@media screen and (max-width: 600px) {
+  header .fill .container {
+    flex-wrap: nowrap;
+  }
+  header .fill .container .header-actions {
+    max-width: calc(100% - 2.5rem - var(--action-gap));
+  }
+  header .fill .container .flex1 {
+    flex: 1 1 0;
+    gap: var(--control-gap);
+  }
+  header .fill .container .flex1 .brand {
+    font-size: 1.25rem;
+  }
+  header .fill .container .status {
+    flex: 0 1 auto;
+  }
+  header .fill .container .status span {
+    font-size: 0.6875rem;
+    padding: 0.25rem 0.5rem;
+    white-space: normal;
+  }
+  #argon-appearance .argon-appearance-trigger {
+    width: 1.5rem;
+    height: 1.5rem;
+  }
+  #argon-appearance .argon-appearance-trigger::before {
+    width: 0.875rem;
+    height: 0.875rem;
+  }
+  :root {
+    --page-gutter: 1rem;
+    --section-inset: 1rem;
+  }
+  .mobile-hide {
+    display: none;
+  }
+  .cbi-value {
+    flex-direction: column;
+  }
+  .cbi-value > .cbi-value-title,
+  .cbi-value > .cbi-value-field {
+    flex: 0 1 auto;
+    width: 100%;
+  }
+  .cbi-value > .cbi-value-title {
+    padding-inline-end: 0;
+    text-align: start;
+  }
+  .cbi-dynlist p {
+    padding: 0.5rem 1rem;
+  }
+  body {
+    overflow-x: hidden;
+  }
+  .node-main-login .main .main-right #maincontent .container .cbi-map .cbi-section .cbi-section-node .cbi-value .cbi-value-field {
+    width: 16rem;
