+/* Оформление страницы "SMS (Perenio)".
+ *
+ * Страница рассчитана прежде всего на телефон: переписка показана
+ * пузырями (входящие слева, отправленные справа), счётчики - на
+ * вкладках, служебные блоки - карточками. Все стили scoped классом
+ * .pejir-sms, чтобы не задевать остальные страницы LuCI.
+ */
+
+/* Размеры считаем по границе: иначе поля во 100% вылезают за карточку. */
+.pejir-sms *,
+.pejir-sms *::before,
+.pejir-sms *::after {
+	box-sizing: border-box;
+}
+
+.pejir-sms {
+	--ps-accent: #1a73e8;
+	--ps-accent-soft: #e8f0fe;
+	--ps-in: #f1f3f4;
+	--ps-err: #c5221f;
+	--ps-err-soft: #fce8e6;
+	--ps-ok: #137333;
+	--ps-ok-soft: #e6f4ea;
+	--ps-text: #202124;
+	--ps-muted: #5f6368;
+	--ps-line: #e2e4e8;
+}
+
+/* --- Шапка --- */
+.pejir-sms-head {
+	background: #fff;
+	border: 1px solid var(--ps-line);
+	border-radius: 14px;
+	padding: 14px 14px 12px;
+	margin: 0 0 12px;
+	box-shadow: 0 1px 2px rgba(0, 0, 0, .05);
+}
+
+.pejir-sms-title {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	gap: 10px;
+	margin: 0 0 10px;
+}
+
+.pejir-sms-title h2 {
+	margin: 0;
+	font-size: 19px;
+	font-weight: 600;
+	line-height: 1.2;
+}
+
+.pejir-sms-pill {
+	display: inline-block;
+	font-size: 11px;
+	font-weight: 600;
+	padding: 4px 10px;
+	border-radius: 999px;
+	background: var(--ps-ok-soft);
+	color: var(--ps-ok);
+	white-space: nowrap;
+}
+
+.pejir-sms-pill.bad {
+	background: var(--ps-err-soft);
+	color: var(--ps-err);
+}
+
+.pejir-sms-pill.grey {
+	background: #f1f3f4;
+	color: var(--ps-muted);
+}
+
+/* --- Вкладки --- */
+.pejir-sms-tabs {
+	display: flex;
+	flex-wrap: wrap;
+	gap: 6px;
+	padding-bottom: 2px;
+}
+
+.pejir-sms-tabs::-webkit-scrollbar {
+	display: none;
+}
+
+.pejir-sms-tab {
+	flex: 0 0 auto;
+	font-size: 12.5px;
+	line-height: 1.2;
+	padding: 7px 10px;
+	border-radius: 999px;
+	background: #f1f3f4;
+	color: var(--ps-muted);
+	border: 1px solid transparent;
+	cursor: pointer;
+	white-space: nowrap;
+}
+
+.pejir-sms-tab:hover {
