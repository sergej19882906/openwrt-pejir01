+}
+
+.pejir-sms-del {
+	margin-left: 6px;
+	font-size: 11px;
+	line-height: 1.4;
+	/* Тема Argon задаёт button { height: 2.5rem } - без этого кнопка
+	 * получается вдвое выше текста и ломает строку пузыря. */
+	height: auto;
+	min-height: 0;
+	padding: 2px 8px;
+	border-radius: 999px;
+	border: 1px solid var(--ps-line);
+	background: #fff;
+	color: var(--ps-muted);
+	cursor: pointer;
+}
+
+.pejir-sms-del:hover {
+	color: var(--ps-err);
+	border-color: var(--ps-err);
+}
+
+.pejir-sms-row.out .pejir-sms-del {
+	background: rgba(255, 255, 255, .18);
+	border-color: rgba(255, 255, 255, .35);
+	color: #fff;
+}
+
+/* На розовом пузыре (не отправлено) кнопка должна быть читаемой. */
+.pejir-sms-row.err .pejir-sms-del {
+	background: #fff;
+	border-color: #f0b4ae;
+	color: var(--ps-err);
+}
+
+/* --- Формы --- */
+.pejir-sms-card .cbi-value {
+	margin-bottom: 8px;
+}
+
+.pejir-sms-input,
+.pejir-sms-textarea {
+	width: 100%;
+	border: 1px solid #dadce0;
+	border-radius: 10px;
+	padding: 10px 12px;
+	font-size: 15px;
+	font-family: inherit;
+	color: var(--ps-text);
+	outline: none;
+	background: #fff;
+}
+
+.pejir-sms-input:focus,
+.pejir-sms-textarea:focus {
+	border-color: var(--ps-accent);
+}
+
+.pejir-sms-textarea {
+	margin-top: 8px;
+	resize: vertical;
+}
+
+.pejir-sms-actions {
+	display: flex;
+	gap: 8px;
+	margin-top: 10px;
+	flex-wrap: wrap;
+}
+
+.pejir-sms-actions .cbi-button {
