+/* Все сообщения в одном списке с указанием направления.
+ * dir: in - входящее, queued - в очереди на отправку, out - отправлено,
+ * err - не отправлено. */
+function allMessages() {
+	var out = [];
+
+	MSGS.inbox.forEach(function(m) { out.push({ m: m, dir: 'in' }); });
+	MSGS.out.forEach(function(m) { out.push({ m: m, dir: 'queued' }); });
+	MSGS.sent.forEach(function(m) { out.push({ m: m, dir: 'out' }); });
+	MSGS.failed.forEach(function(m) { out.push({ m: m, dir: 'err' }); });
+
+	out.sort(function(a, b) { return a.m.mtime - b.m.mtime; });
+	return out;
+}
+
+/* Фильтр поиска работает по номеру и тексту сообщения. */
+function matchFilter(x) {
+	if (!FILTER)
+		return true;
+
+	var q = FILTER.toLowerCase();
+
+	return ((x.m.from || '') + ' ' + (x.m.text || '')).toLowerCase().indexOf(q) >= 0;
+}
+
+/* Сообщение попадает в активную вкладку? */
+function matchTab(x) {
+	switch (TAB) {
+	case 'inbox':
+		return x.dir === 'in';
+	case 'out':
+		return x.dir === 'out' || x.dir === 'queued';
+	case 'failed':
+		return x.dir === 'err';
+	default:
+		return true;
+	}
+}
+
