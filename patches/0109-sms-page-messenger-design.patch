+.pejir-sms-log {
+	background: #f8f9fa;
+	border: 1px solid var(--ps-line);
+	border-radius: 10px;
+	padding: 10px;
+	font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+	font-size: 11px;
+	line-height: 1.5;
+	white-space: pre-wrap;
+	word-break: break-word;
+	max-height: 30vh;
+	overflow: auto;
+	margin: 0;
+}
+
+.pejir-sms-empty {
+	text-align: center;
+	color: var(--ps-muted);
+	font-size: 14px;
+	padding: 18px 0;
+}
+
+.pejir-sms-note {
+	font-size: 12px;
+	color: var(--ps-muted);
+	margin-top: 8px;
+}
+
+/* --- Шаблоны --- */
+.pejir-sms-tpl {
+	display: flex;
+	align-items: center;
+	gap: 8px;
+	padding: 6px 0;
+	border-bottom: 1px solid #f1f3f4;
+	font-size: 13px;
+}
+
+.pejir-sms-tpl .txt {
+	flex: 1 1 auto;
+	min-width: 0;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.pejir-sms-tpl .cbi-button {
+	flex: 0 0 auto;
+	padding: 3px 10px;
+	font-size: 12px;
+}
+
+@media (max-width: 480px) {
+	.pejir-sms-bubble {
+		max-width: 82%;
+	}
+
+	.pejir-sms-card,
+	.pejir-sms-head {
+		border-radius: 12px;
+	}
+}
