+}
+
+/* --- Служебные значения --- */
+.pejir-sms-kv {
+	display: flex;
+	gap: 10px;
+	font-size: 13px;
+	padding: 5px 0;
+	border-bottom: 1px solid #f1f3f4;
+}
+
+.pejir-sms-kv:last-child {
