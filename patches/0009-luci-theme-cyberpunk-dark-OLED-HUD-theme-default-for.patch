+[data-page="admin-status-realtime-wireless"] svg text {
+  fill: var(--cp-text-soft) !important;
+  font-weight: 600;
+  text-shadow: 0 0 8px rgba(0, 212, 255, 0.32) !important;
+}
+
+#map > .cbi-section > svg #load01,
+#map > .cbi-section > svg #load05,
+#map > .cbi-section > svg #load15 {
+  fill-opacity: 0.34 !important;
+}
+
+#map > .cbi-section > svg #load01 {
+  fill: #ff3366 !important;
+  stroke: #ff3366 !important;
+}
+
+#map > .cbi-section > svg #load05 {
+  fill: #ff7a2f !important;
+  stroke: #ff7a2f !important;
+}
+
+#map > .cbi-section > svg #load15 {
+  fill: #f59e0b !important;
+  stroke: #f59e0b !important;
+}
+
+#channel_graph polyline,
+#channel_graph path {
+  filter: drop-shadow(0 0 8px rgba(0, 212, 255, 0.18));
+}
+
+[data-page^="admin-network-firewall"] .zonebadge,
+[data-page^="admin-network-firewall"] .zone-forwards {
+  color: var(--cp-text) !important;
+}
+
+[data-page^="admin-network-firewall"] .zonebadge > strong,
+[data-page^="admin-network-firewall"] .zonebadge > em,
+[data-page^="admin-network-firewall"] .zonebadge > span,
+[data-page^="admin-network-firewall"] .zonebadge .ifacebadge,
+[data-page^="admin-network-firewall"] .zone-forwards strong,
+[data-page^="admin-network-firewall"] .zone-forwards em,
+[data-page^="admin-network-firewall"] .zone-forwards span {
+  color: #051018 !important;
+  font-weight: 700;
+  text-shadow: 0 1px rgba(255, 255, 255, 0.32);
+}
+
+[data-page^="admin-network-firewall"] .zonebadge-empty,
+[data-page^="admin-network-firewall"] .zonebadge-empty strong,
+[data-page^="admin-network-firewall"] .zonebadge-empty em,
+[data-page^="admin-network-firewall"] .zone-forwards .zone-dest .zonebadge-empty,
+[data-page^="admin-network-firewall"] .zone-forwards .zone-dest .zonebadge-empty * {
+  color: #e6f7ff !important;
+  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.75);
+}
+
+[data-page^="admin-network-firewall"] .zonebadge-empty {
+  background:
+    repeating-linear-gradient(45deg, rgba(130, 146, 166, 0.34), rgba(130, 146, 166, 0.34) 5px, rgba(5, 7, 13, 0.46) 5px, rgba(5, 7, 13, 0.46) 10px) !important;
+  border: 1px solid rgba(148, 163, 184, 0.34) !important;
+}
+
+header .fill .status span[data-indicator="poll-status"][data-style="inactive"],
+#xhr_poll_status > .label[data-indicator="poll-status"][data-style="inactive"],
+#xhr_poll_status > span.label[data-style="inactive"] {
+  background: rgba(18, 31, 51, 0.92) !important;
+  border: 1px solid rgba(0, 212, 255, 0.36) !important;
+  color: var(--cp-text) !important;
+  box-shadow: inset 0 1px rgba(255, 255, 255, 0.06), 0 0 14px rgba(0, 212, 255, 0.12) !important;
+}
+
+header .fill .status span[data-indicator="poll-status"][data-style="inactive"]:hover,
+#xhr_poll_status > .label[data-indicator="poll-status"][data-style="inactive"]:hover,
+#xhr_poll_status > span.label[data-style="inactive"]:hover {
+  background: rgba(0, 212, 255, 0.18) !important;
+  color: #e6f7ff !important;
+  border-color: rgba(0, 212, 255, 0.62) !important;
+}
+
+.cbi-progressbar::after {
+  color: #f8fdff !important;
+  font-weight: 700;
+  text-shadow:
+    0 1px 2px rgba(0, 0, 0, 0.95),
+    0 0 4px rgba(5, 7, 13, 0.95),
+    0 0 8px rgba(0, 212, 255, 0.24);
+}
+
+/* Keep foreground/background pairs together, including legacy LuCI selectors.
+ * Opaque gradients keep contrast independent of the wallpaper underneath.
+ */
+.btn,
+button,
+.cbi-button,
+.cbi-input-apply,
+.cbi-button-edit.important,
+.cbi-button-apply.important,
+.cbi-button-reload.important,
+.cbi-button-action.important,
+.cbi-page-actions .cbi-button-apply,
+.cbi-section-actions .cbi-button-edit,
+.cbi-button[value="Submit"],
+.cbi-button[value="Upload"],
+.cbi-button[value$="Apply"],
+.cbi-button[onclick="addKey(event)"] {
+  background: linear-gradient(135deg, #00d4ff, #008fbc) !important;
+  color: #021018 !important;
+  text-shadow: none !important;
+}
+
+.btn.primary,
+.cbi-page-actions .cbi-button-save,
+.cbi-page-actions .cbi-button-apply + .cbi-button-save,
+.cbi-button-save,
+.cbi-button-positive,
+.cbi-button-add,
+.cbi-button-success,
+.cbi-button-download,
+.cbi-button-link,
+.cbi-button-find,
+.cbi-button-reload,
+.cbi-input-save,
+.cbi-input-find,
+.cbi-input-reload,
+.cbi-button[value="Enable"],
+.cbi-button[value="Scan"],
+.cbi-button[value^="Back"],
+.cbi-button-neutral[onclick="handleConfig(event)"] {
+  background: linear-gradient(135deg, #22c55e, #009b64) !important;
+  color: #03150b !important;
+}
+
+.btn.danger,
+.cbi-section-remove > .cbi-button,
+.cbi-button-remove,
+.cbi-button-reset,
+.cbi-button-negative,
+.cbi-input-remove,
+.cbi-button[value="Stop"],
+.cbi-button[value="Kill"],
+.cbi-button[onclick="reboot(this)"],
+.cbi-button-neutral[value="Restart"] {
+  background: linear-gradient(135deg, #bd1747, #9c214a) !important;
+  color: #fff !important;
+}
+
+/* Gradients replace the legacy arrow image, so show the native button value.
+ * OpenClash also sets font-size: 0; its rule must not hide these labels.
+ * The old scaleY(-1) flipped the image and would invert the up label as well.
+ */
+.cbi-button-up,
+.cbi-button-down {
+  font-size: 0.875rem !important;
+  transform: none !important;
+}
+
+/* Neutral and disabled controls must not retain a bright button foreground. */
+.cbi-button-neutral,
+.cbi-button-neutral[onclick="handleConfig(event)"],
+.cbi-button-neutral[value="Restart"],
+.cbi-button-neutral[value="Disable"],
+.cbi-value input[type="password"] + .cbi-button-neutral,
+.btn[value="Hide"],
+.btn[value="隐藏"],
+.cbi-button[value="Hide"],
+.cbi-button[value="隐藏"],
+.cbi-section .right .btn,
+.cbi-section .right .cbi-button {
+  background: #121f33 !important;
+  color: #e6f7ff !important;
+}
+
+/* Match contextual button specificity without affecting disabled text inputs. */
+body :is(.btn, button, .cbi-button, .cbi-input-apply, .cbi-input-save,
+         .cbi-input-find, .cbi-input-reload, .cbi-input-remove):is([disabled], .cbi-button-disabled),
+.cbi-page-actions .cbi-button-apply + .cbi-button-save[disabled] {
+  background: #121f33 !important;
+  color: #9fb6c8 !important;
+  opacity: 1 !important;
+  filter: none !important;
+  box-shadow: none !important;
+}
