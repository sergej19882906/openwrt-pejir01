+            }
+
+            .menu[data-title="Bandwidth_Monitor"]:before {
+                content: "\e90d";
+                color: #2dce89;
+            }
+
+            .menu[data-title="Docker"]:before {
+                content: "\e911";
+                color: #6699ff;
+            }
+
+            .menu[data-title="Statistics"]:before {
+                content: "\e913";
+                color: #8965e0;
+            }
+
+            .menu[data-title="Control"]:before {
+                content: "\e912";
+                color: var(--primary);
+            }
+
+            .menu[data-title="Asterisk"]:before {
+                content: "\e914";
+                color: #fb6340;
+            }
+
+            // Logout link styling
+            a[data-title="Log_out"],
